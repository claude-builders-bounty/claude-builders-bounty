{
  "name": "claude-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code PR review agent that turns a GitHub PR diff into a structured Markdown review.",
  "bin": {
    "claude-review": "bin/claude-review.mjs"
  },
  "scripts": {
    "review": "node bin/claude-review.mjs",
    "test": "node scripts/verify-samples.mjs",
    "sample:react": "node bin/claude-review.mjs --pr https://github.com/facebook/react/pull/32781 --out samples/react-32781.md",
    "sample:node": "node bin/claude-review.mjs --pr https://github.com/nodejs/node/pull/58362 --out samples/node-58362.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
