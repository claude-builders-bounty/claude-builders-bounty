#!/usr/bin/env python3
"""
claude-review: Claude Code PR Review Agent
Usage: claude-review --pr https://github.com/owner/repo/pull/123
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request

GH_API = "https://api.github.com"

def gh(args):
    """Run gh CLI and return stdout."""
    gh_bin = os.environ.get("GH_BIN") or shutil.which("gh")
    if not gh_bin:
        raise RuntimeError("gh CLI not found. Install GitHub CLI or set GH_BIN=/path/to/gh")
    cmd = [gh_bin] + args
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"gh {' '.join(args)} failed: {result.stderr}")
    return result.stdout

def get_pr_details(pr_url):
    parts = pr_url.rstrip("/").split("/")
    owner, repo = parts[-4], parts[-3]
    pr_number = int(parts[-1])
    repo_slug = f"{owner}/{repo}"
    return repo_slug, pr_number, owner, repo

def get_pr_metadata(repo_slug, pr_number):
    data = json.loads(gh(["api", f"repos/{repo_slug}/pulls/{pr_number}", "--jq", "."]))
    return {
        "title": data.get("title", ""),
        "body": data.get("body", ""),
        "changed_files": data.get("changed_files", 0),
        "additions": data.get("additions", 0),
        "deletions": data.get("deletions", 0),
        "state": data.get("state", ""),
        "is_draft": data.get("draft", False),
    }

def get_diff(repo_slug, pr_number):
    """Get the PR diff via GitHub REST API."""
    token = os.environ.get("GITHUB_TOKEN") or gh(["auth", "token"]).strip()
    req = urllib.request.Request(
        f"{GH_API}/repos/{repo_slug}/pulls/{pr_number}",
        headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github.v3.diff"}
    )
    with urllib.request.urlopen(req) as r:
        return r.read().decode("utf-8", errors="replace")

def build_analysis_prompt(repo_slug, pr_number, metadata, diff):
    diff_preview = diff[:15000]  # Limit to first 15k chars

    prompt = f"""You are reviewing GitHub PR #{pr_number} from {repo_slug}.

## PR Title: {metadata['title']}
## Changed Files: {metadata['changed_files']}
## Additions: {metadata['additions']} | Deletions: {metadata['deletions']}
## State: {metadata['state']} {'(DRAFT)' if metadata['is_draft'] else ''}

## Diff (truncated to 15k chars):
{diff_preview}

## Your Task:
Analyze this PR diff and produce a structured Markdown review comment with:
1. **Summary of changes** (2-3 sentences)
2. **Identified risks** (bullet list)
3. **Improvement suggestions** (bullet list)
4. **Confidence score**: Low / Medium / High

Be specific and technical. Focus on real issues, not style preferences.
"""
    return prompt

def call_claude(prompt):
    import anthropic
    client = anthropic.Anthropic()
    response = client.messages.create(
        model="claude-sonnet-4-20250514",
        max_tokens=2048,
        messages=[{"role": "user", "content": prompt}]
    )
    return response.content[0].text

def main():
    parser = argparse.ArgumentParser(description="Claude PR Review Agent")
    parser.add_argument("--pr", required=True, help="PR URL, e.g. https://github.com/owner/repo/pull/123")
    parser.add_argument("--output", help="Output file (default: stdout)")
    args = parser.parse_args()

    print(f"Fetching PR details from {args.pr}...")
    repo_slug, pr_number, owner, repo = get_pr_details(args.pr)

    print("Getting PR metadata...")
    metadata = get_pr_metadata(repo_slug, pr_number)

    print("Fetching diff...")
    diff = get_diff(repo_slug, pr_number)

    print("Building analysis prompt...")
    prompt = build_analysis_prompt(repo_slug, pr_number, metadata, diff)

    print("Sending to Claude for analysis...")
    try:
        review = call_claude(prompt)
    except Exception as e:
        review = f"[Claude API error: {e}]"

    output = f"""# Claude PR Review — {repo_slug} PR #{pr_number}

**PR URL:** {args.pr}

{review}

---
*Generated by claude-review agent*
"""

    if args.output:
        with open(args.output, "w") as f:
            f.write(output)
        print(f"Review written to {args.output}")
    else:
        print(output)

if __name__ == "__main__":
    main()
