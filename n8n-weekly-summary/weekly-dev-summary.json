      {
        "displayName": "GitHub Repository",
        "name": "githubRepo",
        "type": "string",
        "default": "owner/repo",
        "description": "Format: owner/repo (e.g., facebook/react)"
      },
      {
        "displayName": "Webhook URL (Discord/Slack)",
        "name": "webhookUrl",
        "type": "string",
        "default": "",
        "description": "Incoming webhook URL for Discord or Slack"
      },
