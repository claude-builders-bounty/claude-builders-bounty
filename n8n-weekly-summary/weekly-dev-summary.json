{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "id": "1a2b3c4d-1111-4000-8000-000000000001",
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{}]
        },
        "rules": [
          {
            "rule": {
              "repeat": {
                "hour": 17,
                "minute": 0,
                "weekday": 5
              },
              "triggerAt": {},
              "type": "cron"
            }
          }
        ]
      }
    },
    {
      "id": "1a2b3c4d-2222-4000-8000-000000000002",
      "name": "Set Date Range",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "since",
              "value": "={{ $now.minus(7, 'days').toISO('YYYY-MM-DDTHH:mm:ss') }}"
            },
            {
              "name": "until",
              "value": "={{ $now.toISO('YYYY-MM-DDTHH:mm:ss') }}"
            },
            {
              "name": "repo",
              "value": "={{ $json.owner }}/{{ $json.repo }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-3333-4000-8000-000000000003",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 200],
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits?since={{ $json.since }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-4444-4000-8000-000000000004",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 400],
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/issues?state=closed&since={{ $json.since }}&per_page=50&filter=all",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-5555-4000-8000-000000000005",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 600],
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls?state=closed&sort=updated&direction=desc&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-6666-4000-8000-000000000006",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [850, 400],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "1a2b3c4d-7777-4000-8000-000000000007",
      "name": "Build Summary Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1050, 400],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "prompt",
              "value": "=Generate a narrative weekly development summary in MARKDOWN for the GitHub repository {{ $json.repo }}.\n\n## Week: {{ $json.since }} to {{ $json.until }}\n\n### Commits This Week\n{{ $json.commits.map(c => `- [${c.sha.slice(0,7)}] ${c.commit.message.split('\\n')[0]} (${c.commit.author.name})`).join('\\n') }}\n\n### Closed Issues This Week\n{{ $json.issues.filter(i => !i.pull_request).map(i => `- #${i.number}: ${i.title}`).join('\\n') }}\n\n### Merged PRs This Week\n{{ $json.prs.filter(pr => pr.merged_at && new Date(pr.merged_at) > new Date($json.since)).map(pr => `- #${pr.number}: ${pr.title} (${pr.user.login})`).join('\\n') }}\n\n### Summary Requirements\nWrite in a friendly, narrative style. Include:\n1. **What happened this week** — biggest changes, key features shipped\n2. **Bug fixes & maintenance** — notable fixes and housekeeping\n3. **Looking ahead** — any ongoing work or upcoming changes\n4. **Shout-outs** — thank contributors by name if applicable\n\nKeep it concise (3-5 paragraphs). Use markdown formatting.\nLanguage: EN"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-8888-4000-8000-000000000008",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 400],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "sendBody": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 2048
            }
          ]
        },
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 2048,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ $json.prompt | toJson }}\n    }\n  ]\n}",
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-9999-4000-8000-000000000009",
      "name": "Extract Summary Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1450, 400],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "summary",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-aaaa-4000-8000-00000000000a",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1650, 400],
      "parameters": {
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "content": "=## Weekly Dev Summary 🚀\n\n{{ $json.summary }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [{ "node": "Set Date Range", "type": "main", "index": 0 }]
      ]
    },
    "Set Date Range": {
      "main": [
        [{ "node": "Fetch Commits", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Commits": {
      "main": [
        [{ "node": "Merge Results", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [{ "node": "Merge Results", "type": "main", "index": 1 }]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [{ "node": "Merge Results", "type": "main", "index": 2 }]
      ]
    },
    "Merge Results": {
      "main": [
        [{ "node": "Build Summary Prompt", "type": "main", "index": 0 }]
      ]
    },
    "Build Summary Prompt": {
      "main": [
        [{ "node": "Claude API", "type": "main", "index": 0 }]
      ]
    },
    "Claude API": {
      "main": [
        [{ "node": "Extract Summary Text", "type": "main", "index": 0 }]
      ]
    },
    "Extract Summary Text": {
      "main": [
        [{ "node": "Send to Discord", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": []
}
