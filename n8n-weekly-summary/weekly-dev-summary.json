{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "cronExpression": "0 17 * * 5",
              "timezone": "UTC"
            }
          ]
        }
      },
      "id": "1",
      "name": "Weekly Cron (Friday 5pm UTC)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "const { $now, $parameter } = require('n8n-core');\nconst repo = $parameter['githubRepo'];\nconst owner = repo.split('/')[0];\nconst repoName = repo.split('/')[1];\nconst since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\n\nreturn [\n  { json: { owner, repo: repoName, since } },\n  { json: { owner, repo: repoName, since, type: 'issues' } },\n  { json: { owner, repo: repoName, since, type: 'prs' } }\n];"
      },
      "id": "2",
      "name": "Build GitHub API Params",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits?since={{$json.since}}&per_page=100",
        "method": "GET",
        "options": {},
        "authentication": "none",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.githubApi.token }}"
            }
          ]
        }
      },
      "id": "3",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 200],
      "credentials": {
        "httpHeaderAuth": "githubApi"
      }
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/issues?state=closed&since={{$json.since}}&per_page=100",
        "method": "GET",
        "options": {},
        "authentication": "none",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.githubApi.token }}"
            }
          ]
        }
      },
      "id": "4",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300],
      "credentials": {
        "httpHeaderAuth": "githubApi"
      }
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/pulls?state=closed&sort=updated&direction=desc&per_page=100",
        "method": "GET",
        "options": {},
        "authentication": "none",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.githubApi.token }}"
            }
          ]
        }
      },
      "id": "5",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 400],
      "credentials": {
        "httpHeaderAuth": "githubApi"
      }
    },
    {
      "parameters": {
        "functionCode": "const commits = $node['Fetch Commits'].json;\nconst issues = $node['Fetch Closed Issues'].json;\nconst prs = $node['Fetch Merged PRs'].json;\n\nconst mergedPrs = prs.filter(p => p.merged_at);\nconst weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nconst commitSummary = commits.slice(0, 15).map(c => `- ${c.commit.message.split('\\n')[0]} (${c.sha.slice(0,7)})`).join('\\n');\nconst issueSummary = issues.slice(0, 10).map(i => `- #${i.number}: ${i.title}`).join('\\n');\nconst prSummary = mergedPrs.slice(0, 10).map(p => `- #${p.number}: ${p.title} (merged ${new Date(p.merged_at).toLocaleDateString()})`).join('\\n');\n\nreturn [\n  {\n    json: {\n      commitCount: commits.length,\n      issueCount: issues.length,\n      prCount: mergedPrs.length,\n      commitSummary,\n      issueSummary,\n      prSummary,\n      weekStart: weekAgo.toISOString().split('T')[0],\n      weekEnd: new Date().toISOString().split('T')[0],\n      repo: $parameter['githubRepo'],\n      language: $parameter['language'] || 'EN'\n    }\n  }\n];"
      },
      "id": "6",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "functionCode": "const data = $node['Aggregate Data'].json[0].json;\nconst lang = data.language === 'FR' ? 'French' : 'English';\n\nconst prompt = `Generate a concise, narrative weekly development summary in ${lang} for the repository ${data.repo} covering ${data.weekStart} to ${data.weekEnd}.\n\nData:\n- ${data.commitCount} commits\n- ${data.issueCount} issues closed\n- ${data.prCount} PRs merged\n\nRecent commits:\n${data.commitSummary || '(none)'}\n\nClosed issues:\n${data.issueSummary || '(none)'}\n\nMerged PRs:\n${data.prSummary || '(none)'}\n\nWrite a 3-4 paragraph summary suitable for a team update. Tone: professional, concise, highlights impact over volume. No bullet lists in final output — flowing prose. Do not mention this prompt.`;\n\nreturn [{ json: { prompt, model: 'claude-sonnet-4-20250514', maxTokens: 800 } }];"
      },
      "id": "7",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {},
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-api-key",
              "value": "={{ $credentials.claudeApi.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "model",
              "value": "={{ $json.model }}"
            },
            {
              "name": "max_tokens",
              "value": "={{ $json.maxTokens }}"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": {{ $json.prompt }}}]"
            }
          ]
        }
      },
      "id": "8",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300],
      "credentials": {
        "httpHeaderAuth": "claudeApi"
      }
    },
    {
      "parameters": {
        "functionCode": "const response = $node['Call Claude API'].json;\nconst summary = response.content?.[0]?.text || 'Failed to generate summary.';\nconst data = $node['Aggregate Data'].json[0].json;\n\nreturn [{ json: { summary, repo: data.repo, weekStart: data.weekStart, weekEnd: data.weekEnd } }];"
      },
      "id": "9",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "url": "={{ $parameter['webhookUrl'] }}",
        "method": "POST",
        "options": {},
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "content",
              "value": "=**Weekly Dev Summary: {{ $json.repo }} ({{ $json.weekStart }} – {{ $json.weekEnd }})**\\n\\n{{ $json.summary }}"
            }
          ]
        }
      },
      "id": "10",
      "name": "Send to Discord/Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm UTC)": {
      "main": [
        [
          {
            "node": "Build GitHub API Params",
