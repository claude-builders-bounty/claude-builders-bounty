{"name": "Weekly GitHub Activity Summary (Claude AI)", "nodes": [{"parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "0 17 * * 5"}]}}, "id": "trigger-weekly", "name": "Weekly Trigger (Fri 5pm)", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [240, 300]}, {"parameters": {"resource": "repository", "repositoryId": "={{ $json.repo || $env.GITHUB_REPO }}", "options": {}}, "id": "get-repo-info", "name": "Get Repo Info", "type": "n8n-nodes-base.github", "typeVersion": 2.1, "position": [460, 200], "credentials": {"githubApi": {"id": "github-credentials", "name": "GitHub Account"}}}, {"parameters": {"resource": "commit", "repositoryId": "={{ $json.repo || $env.GITHUB_REPO }}", "since": "={{ $now.minus({days: 7}).toFormat('yyyy-MM-dd\\THH:mm:ssZZ') }}", "options": {}}, "id": "get-commits", "name": "Get Weekly Commits", "type": "n8n-nodes-base.github", "typeVersion": 2.1, "position": [460, 340], "credentials": {"githubApi": {"id": "github-credentials", "name": "GitHub Account"}}}, {"parameters": {"resource": "issue", "repositoryId": "={{ $('Get Repo Info').item.json.id || $env.GITHUB_REPO }}", "state": "closed", "since": "={{ $now.minus({days: 7}).toFormat('yyyy-MM-dd\\TH:mm:ssZZ') }}", "options": {}}, "id": "get-closed-issues", "name": "Get Closed Issues", "type": "n8n-nodes-base.github", "typeVersion": 2.1, "position": [460, 480], "credentials": {"githubApi": {"id": "github-credentials", "name": "GitHub Account"}}}, {"parameters": {"resource": "pullRequest", "repositoryId": "={{ $('Get Repo Info').item.json.id || $env.GITHUB_REPO }}", "state": "closed", "since": "={{ $now.minus({days: 7}).toFormat('yyyy-MM-dd\\THH:mm:ssZZ') }}", "options": {}}, "id": "get-merged-prs", "name": "Get Merged PRs", "type": "n8n-nodes-base.github", "typeVersion: 2.1, "position": [460, 620], "credentials": {"githubApi": {"id": "github-credentials", "name": "GitHub Account"}}}, {"parameters": {"jsCode": "// Aggregate all GitHub data into a structured summary\nconst repo = $input.first().json;\nconst commits = $('Get Weekly Commits').all();\nconst issues = $('Get Closed Issues').all();\nconst prs = $('Get Merged PRs').all();\n\n// Build commit summary\nconst commitAuthors = [...new Set(commits.map(c => c.json.commit?.author?.name || c.json.author?.login).filter(Boolean))];\nconst topFiles = {};\ncommits.forEach(c => {\n  (c.json.files || []).forEach(f => {\n    const filename = f.filename || f.filename;\n    topFiles[filename] = (topFiles[filename] || 0) + 1;\n  });\n});\nconst sortedFiles = Object.entries(topFiles)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 10)\n  .map(([f, c]) => `${f} (${c} changes)`);\n\n// Build issue summary\nconst issueLabels = {};\nissues.forEach(i => {\n  (i.json.labels || []).forEach(l => {\n    const name = l.name || l;\n    issueLabels[name] = (issueLabels[name] || 0) + 1;\n  });\n});\n\n// Build PR summary\nconst prAuthors = [...new Set(prs.map(p => p.json.user?.login || p.json.author?.login).filter(Boolean))];\n\nconst language = $env.LANGUAGE || 'EN';\n\nreturn [{\n  json: {\n    repo: repo.full_name || repo.name || $env.GITHUB_REPO,\n    period: {\n      from: $now.minus({ days: 7 }).toFormat('yyyy-MM-dd'),\n      to: $now.toFormat('yyyy-MM-dd')\n    },\n    stats: {\n      totalCommits: commits.length,\n      totalIssuesClosed: issues.length,\n      totalPRsMerged: prs.length,\n      contributors: [...new Set([...commitAuthors, ...prAuthors])].length\n    },\n    commits: {\n      count: commits.length,\n      authors: commitAuthors,\n      topFiles: sortedFiles\n    },\n    issues: {\n      count: issues.length,\n      labels: Object.entries(issueLabels).map(([k,v]) => ({label: k, count: v}))\n    },\n    pullRequests: {\n      count: prs.length,\n      authors: prAuthors\n    },\n    language: language\n  }\n}];"}, "id": "aggregate-data", "name": "Aggregate Data", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [680, 400]}, {"parameters": {"method": "POST", "url": "=https://api.anthropic.com/v1/messages", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}"}, {"name": "anthropic-version", "value": "2023-06-01"}, {"name": "content-type", "value": "application/json"}]}, "sendBody": true, "bodyParameters": {"parameters": [{"name": "model", "value": "claude-sonnet-4-20250514"}, {"name": "max_tokens", "value": "1024"}, {"name": "system", "value": "=You are a helpful assistant that writes weekly development summaries for engineering teams. Be concise but informative. Use markdown formatting. The output will be posted in Slack/Discord or sent via email."}, {"name": "messages", "value": "=[{\"role\": \"user\", \"content\": \"Generate a weekly development activity summary for the following data. Language: {{ $json.language }}\\n\\n## Repository: {{ $json.repo }}\\n## Period: {{ $json.period.from }} to {{ $json.period.to }}\\n\\n### Stats\\n- Commits: {{ $json.stats.totalCommits }}\\n- Issues Closed: {{ $json.stats.totalIssuesClosed }}\\n- PRs Merged: {{ $json.stats.totalPRsMerged }}\\n- Active Contributors: {{ $json.stats.contributors }}\\n\\n### Commit Activity\\n- Total commits this week: {{ $json.commits.count }}\\n- Authors: {{ $json.commits.authors.join(', ') }}\\n- Most changed files:\\n{{ $json.commits.topFiles.map(f => '- ' + f).join('\\n') }}\\n\\n### Issues\\n- Closed this week: {{ $json.issues.count }}\\n{{ $json.issues.labels.map(l => '- ' + l.label + ': ' + l.count).join('\\n') }}\\n\\n### Pull Requests\\n- Merged this week: {{ $json.pullRequests.count }}\\n- By: {{ $json.pullRequests.authors.join(', ') }}\\n\\nPlease write a narrative summary (2-3 paragraphs) highlighting key achievements, notable contributions, and any concerns. Use a professional but engaging tone.\"}]}"]}}, "options": {}}, "id": "claude-summarize", "name": "Generate Summary (Claude API)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [900, 400]}, {"parameters": {"jsCode": "// Extract Claude response text\nconst response = $input.first().json;\nlet summaryText = '';\n\nif (response.content && Array.isArray(response.content)) {\n  const textBlock = response.content.find(b => b.type === 'text');\n  if (textBlock) summaryText = textBlock.text;\n}\n\nif (!summaryText && response.text) {\n  summaryText = response.text;\n}\n\nconst data = $('Aggregate Data').first().json;\nconst language = data.language || 'EN';\n\nconst header = language === 'FR'\n  ? `📊 **Résumé Hebdomadaire — ${data.repo}**\\n📅 ${data.period.from} → ${data.period.to}\\n\\n`\n  : `📊 **Weekly Dev Summary — ${data.repo}**\\n📅 ${data.period.from} → ${data.period.to}\\n\\n`;\n\nreturn [{\n  json: {\n    summary: header + summaryText,\n    rawResponse: response,\n    metadata: data\n  }\n}];"}, "id": "format-output", "name": "Format Output", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 400]}, {"parameters": {"method": "POST", "url": "={{ $env.WEBHOOK_URL || '' }}", "sendBody": true, "specifyBody": "string", "body": "={\"text\": \"{{ $json.summary }}\"}", "options": {}}, "id": "send-webhook", "name": "Send to Slack/Discord", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1340, 300]}, {"parameters": {"fromEmail": "={{ $env.EMAIL_FROM || 'noreply@weekly-summary.dev' }}", "toEmail": "={{ $env.EMAIL_TO || '' }}", "subject": "=📊 Weekly Summary: {{ $('Aggregate Data').first().json.repo }} ({{ $('Format Output').first().json.metadata.period.from }})", "emailType": "html", "text": "={{ '<pre>' + $json.summary + '</pre>' }}"}, "id": "send-email", "name": "Send Email (Fallback)", "type": "n8n-nodes-base.emailSend", "typeVersion": 2, "position": [1340, 520]}], "connections": {"Weekly Trigger (Fri 5pm)": {"main": [[{"node": "Get Repo Info", "type": "main", "index": 0}]]}, "Get Repo Info": {"main": [[{"node": "Get Weekly Commits", "type": "main", "index": 0}, {"node": "Get Closed Issues", "type": "main", "index": 0}, {"node": "Get Merged PRs", "type": "main", "index": 0}]]}, "Get Weekly Commits": {"main": [[{"node": "Aggregate Data", "type": "main", "index": 0}]]}, "Get Closed Issues": {"main": [[{"node": "Aggregate Data", "type": "main", "index": 0}]]}, "Get Merged PRs": {"main": [[{"node": "Aggregate Data", "type": "main", "index": 0}]]}, "Aggregate Data": {"main": [[{"node": "Generate Summary (Claude API)", "type": "main", "index": 0}]]}, "Generate Summary (Claude API)": {"main": [[{"node": "Format Output", "type": "main", "index": 0}]]}, "Format Output": {"main": [[{"node": "Send to Slack/Discord", "type": "main", "index": 0}, {"node": "Send Email (Fallback)", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}}