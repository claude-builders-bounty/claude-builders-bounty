{
  "name": "Weekly GitHub Dev Summary (Claude AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [5],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Weekly Trigger (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "var-repo",
              "name": "GITHUB_REPO",
              "value": "your-org/your-repo",
              "type": "string"
            },
            {
              "id": "var-lang",
              "name": "LANGUAGE",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "var-discord",
              "name": "DISCORD_WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
              "type": "string"
            },
            {
              "id": "var-model",
              "name": "CLAUDE_MODEL",
              "value": "claude-sonnet-4-20250514",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  since: sevenDaysAgo.toISOString(),\n  until: now.toISOString(),\n  weekLabel: sevenDaysAgo.toISOString().slice(0,10) + ' – ' + now.toISOString().slice(0,10),\n  GITHUB_REPO: $input.first().json.GITHUB_REPO,\n  LANGUAGE: $input.first().json.LANGUAGE,\n  DISCORD_WEBHOOK_URL: $input.first().json.DISCORD_WEBHOOK_URL,\n  CLAUDE_MODEL: $input.first().json.CLAUDE_MODEL\n}];"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_REPO }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "X-GitHub-Api-Version", "value": "2022-11-28"}
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "since", "value": "={{ $json.since }}"},
            {"name": "until", "value": "={{ $json.until }}"},
            {"name": "per_page", "value": "100"}
          ]
        },
        "options": {
          "response": {"response": {"responseFormat": "json"}}
        }
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 100],
      "credentials": {
        "httpHeaderAuth": {"id": "github-token-cred", "name": "GitHub Token"}
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Calculate Date Range').first().json.GITHUB_REPO }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "X-GitHub-Api-Version", "value": "2022-11-28"}
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "state", "value": "closed"},
            {"name": "since", "value": "={{ $('Calculate Date Range').first().json.since }}"},
            {"name": "per_page", "value": "50"}
          ]
        },
        "options": {
          "response": {"response": {"responseFormat": "json"}}
        }
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300],
      "credentials": {
        "httpHeaderAuth": {"id": "github-token-cred", "name": "GitHub Token"}
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Calculate Date Range').first().json.GITHUB_REPO }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "X-GitHub-Api-Version", "value": "2022-11-28"}
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "state", "value": "closed"},
            {"name": "per_page", "value": "50"},
            {"name": "sort", "value": "updated"},
            {"name": "direction", "value": "desc"}
          ]
        },
        "options": {
          "response": {"response": {"responseFormat": "json"}}
        }
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 500],
      "credentials": {
        "httpHeaderAuth": {"id": "github-token-cred", "name": "GitHub Token"}
      }
    },
    {
      "parameters": {
        "jsCode": "// Collect data from all three upstream nodes\nconst config = $('Calculate Date Range').first().json;\nconst since = new Date(config.since);\n\n// Commits — raw array (n8n spreads array responses into items)\nconst commitItems = $('Get Commits').all();\nconst commits = commitItems\n  .map(i => i.json)\n  .filter(c => c.commit)  // skip error responses\n  .slice(0, 30);\n\n// Issues — exclude PRs (GitHub returns PRs in the issues list too)\nconst issueItems = $('Get Closed Issues').all();\nconst issues = issueItems\n  .map(i => i.json)\n  .filter(i => i.closed_at && new Date(i.closed_at) >= since && !i.pull_request)\n  .slice(0, 20);\n\n// PRs — only merged ones in range\nconst prItems = $('Get Merged PRs').all();\nconst prs = prItems\n  .map(i => i.json)\n  .filter(p => p.merged_at && new Date(p.merged_at) >= since)\n  .slice(0, 20);\n\n// Build structured summary for Claude\nconst langInstruction = config.LANGUAGE === 'FR'\n  ? 'Répondez entièrement en français.'\n  : 'Respond entirely in English.';\n\nconst commitList = commits.map(c =>\n  `- ${c.commit.message.split('\\n')[0]} (@${c.author?.login || 'unknown'})`\n).join('\\n');\n\nconst issueList = issues.map(i =>\n  `- #${i.number}: ${i.title} (closed by @${i.closed_by?.login || '?'})`\n).join('\\n');\n\nconst prList = prs.map(p =>\n  `- #${p.number}: ${p.title} (merged by @${p.merged_by?.login || '?'}, +${p.additions}/-${p.deletions})`\n).join('\\n');\n\nconst prompt = `${langInstruction}\n\nYou are a technical writer generating a weekly activity digest for an engineering team. Write a 3-4 paragraph narrative summary of the week's GitHub activity for the repository \\`${config.GITHUB_REPO}\\`.\n\nWeek: ${config.weekLabel}\n\n## Commits (${commits.length} total)\n${commitList || '(none)'}\n\n## Closed Issues (${issues.length})\n${issueList || '(none)'}\n\n## Merged Pull Requests (${prs.length})\n${prList || '(none)'}\n\nWrite in a clear, enthusiastic tone. Highlight the most impactful changes. Group related changes thematically. End with a brief forward-looking sentence based on any open work you can infer. Keep it under 400 words.`;\n\nreturn [{\n  prompt,\n  model: config.CLAUDE_MODEL,\n  discord_webhook: config.DISCORD_WEBHOOK_URL,\n  week_label: config.weekLabel,\n  repo: config.GITHUB_REPO,\n  stats: {\n    commits: commits.length,\n    issues: issues.length,\n    prs: prs.length\n  }\n}];"
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Format Data for Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "={{ $json.model }}",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ]
        },
        "options": {
          "response": {"response": {"responseFormat": "json"}}
        }
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1150, 300],
      "credentials": {
        "httpHeaderAuth": {"id": "anthropic-key-cred", "name": "Anthropic API Key"}
      }
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $('Call Claude API').first().json;\nconst meta = $('Format Data for Claude').first().json;\n\nconst summaryText = claudeResponse.content?.[0]?.text || 'Claude did not return a summary.';\n\nconst embed = {\n  username: 'DevDigest Bot',\n  embeds: [\n    {\n      title: `📊 Weekly Dev Summary — ${meta.repo}`,\n      description: summaryText,\n      color: 5793266,\n      footer: {\n        text: `Week of ${meta.week_label} · ${meta.stats.commits} commits · ${meta.stats.prs} PRs merged · ${meta.stats.issues} issues closed`\n      }\n    }\n  ]\n};\n\nreturn [{\n  discord_webhook: meta.discord_webhook,\n  payload: embed\n}];"
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Format Discord Embed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.discord_webhook }}",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Weekly Trigger (Friday 5PM)": {
      "main": [[{"node": "Config Variables", "type": "main", "index": 0}]]
    },
    "Config Variables": {
      "main": [[{"node": "Calculate Date Range", "type": "main", "index": 0}]]
    },
    "Calculate Date Range": {
      "main": [
