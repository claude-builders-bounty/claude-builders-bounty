          {"node": "Get Commits", "type": "main", "index": 0},
          {"node": "Get Closed Issues", "type": "main", "index": 0},
          {"node": "Get Merged PRs", "type": "main", "index": 0}
        ]
      ]
    },
    "Get Commits": {
      "main": [[{"node": "Format Data for Claude", "type": "main", "index": 0}]]
    },
    "Get Closed Issues": {
      "main": [[{"node": "Format Data for Claude", "type": "main", "index": 1}]]
    },
    "Get Merged PRs": {
      "main": [[{"node": "Format Data for Claude", "type": "main", "index": 2}]]
    },
    "Format Data for Claude": {
      "main": [[{"node": "Call Claude API", "type": "main", "index": 0}]]
    },
    "Call Claude API": {
      "main": [[{"node": "Format Discord Embed", "type": "main", "index": 0}]]
    },
    "Format Discord Embed": {
      "main": [[{"node": "Post to Discord", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
