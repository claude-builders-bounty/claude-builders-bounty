{
  "name": "Claude Code - Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "e4b2d3d9-953e-4363-8a30-c3d6d07c2a5a",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "github_repo",
              "value": "owner/repo"
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "discord_webhook_url",
              "value": "https://discord.com/api/webhooks/..."
            }
          ]
        }
      },
      "id": "90b1e17e-7a47-49d6-8b2b-47702f3a4664",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $json.github_repo + '/events' }}",
        "authentication": "none",
        "options": {
          "headers": {
            "property": [
              {
                "name": "Accept",
                "value": "application/vnd.github.v3+json"
              },
              {
                "name": "User-Agent",
                "value": "n8n-workflow"
              }
            ]
          }
        }
      },
      "id": "ab812d6a-5431-4e78-8314-b1eb21f57871",
      "name": "Fetch GitHub Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-7-sonnet-20250219"
            },
            {
              "name": "max_tokens",
              "value": "1024"
            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"user\", \"content\": \"Summarize the following GitHub activity for the week in \" + $('Config Variables').item.json.language + \":\\n\" + JSON.stringify($json) }] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f5e40798-2eb7-4d98-b80c-0d33e145efb0",
      "name": "Generate Summary (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config Variables').item.json.discord_webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"content\": \"**Weekly Dev Summary**\\n\\n\" + $json.content[0].text } }}",
        "options": {}
      },
      "id": "c1f6b8b0-5110-44ec-b8d4-518df9df219d",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config Variables": {
      "main": [
        [
          {
            "node": "Fetch GitHub Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch GitHub Activity": {
      "main": [
        [
          {
            "node": "Generate Summary (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary (Claude)": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
