{
  "name": "Weekly GitHub Dev Summary via Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": 5,
              "triggerAtHour": 17
            }
          ]
        }
      },
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "requestMethod": "GET",
        "url": "={{ $json.config ? $json.config.repo_api : 'https://api.github.com/repos/kramsg1/claude-builders-bounty/pulls?state=closed&sort=updated&direction=desc' }}",
        "authentication": "genericCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "headers": {
            "User-Agent": "n8n-weekly-summary"
          }
        },
        "jsonParameters": true,
        "options__headers": {
          "User-Agent": "n8n-weekly-summary"
        }
      },
      "name": "Fetch GitHub Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "You are a developer relations assistant. Generate a concise, professional weekly summary of GitHub repository activity.\n\nInput: {{ JSON.stringify($json, null, 2) }}\n\nRequirements:\n- Summary of key changes and merged PRs\n- Highlight any issues closed\n- Note any significant contributions\n- Keep it brief (3-5 paragraphs max)\n- Format as clean Markdown\n\nOutput:",
        "systemMessage": "You summarize GitHub activity clearly and concisely. Focus on what was accomplished, not just what happened.",
        "temperature": 0.3,
        "maxTokens": 1000
      },
      "name": "Claude API Summary",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "fromEmail": "weekly-summary@yourdomain.com",
        "toEmail": "{{ $json.config ? $json.config.recipient : 'your-email@example.com' }}",
        "subject": "=Weekly Dev Summary - claude-builders-bounty",
        "text": "=Weekly GitHub Activity Summary\n\n{{ $json[\"choices\"][0][\"message\"][\"content\"] }}\n\n---\nGenerated by n8n + Claude workflow on {{ $now.format('YYYY-MM-DD') }}",
        "attachmentsUi": {}
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 3,
      "position": [910, 300]
    }
  ],
  "connections": {
    "Weekly Schedule": {
      "main": [
        [
          {
            "node": "Fetch GitHub Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch GitHub Activity": {
      "main": [
        [
          {
            "node": "Claude API Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API Summary": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 60
  },
  "variables": [
    {
      "id": "config",
      "name": "config",
      "value": "{\"repo_api\": \"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/pulls?state=closed&sort=updated&direction=desc\", \"recipient\": \"your-email@example.com\"}",
      "type": "json"
    }
  ],
  "meta": {
    "templateCredsSetup": false,
    "instanceId": "weekly-summary-workflow-v1"
  }
}