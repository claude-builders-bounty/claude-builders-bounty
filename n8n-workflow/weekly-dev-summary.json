{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "dayOfWeek",
              "hours": 17,
              "minutes": 0,
              "day": 5
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300],
      "notes": "Every Friday at 5pm"
    },
    {
      "parameters": {
        "owner": "{{$env.GITHUB_OWNER}}",
        "repository": "{{$env.GITHUB_REPO}}",
        "additionalFields": {
          "since": "{{$jmespath( \"now().sub(@, \\\"7d\\\")\", $now)}}"
        }
      },
      "id": "commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 200],
      "credentials": {
        "githubApi": "GitHub"
      }
    },
    {
      "parameters": {
        "owner": "{{$env.GITHUB_OWNER}}",
        "repository": "{{$env.GITHUB_REPO}}",
        "additionalFields": {
          "state": "closed",
          "since": "{{$jmespath( \"now().sub(@, \\\"7d\\\")\", $now)}}"
        }
      },
      "id": "issues",
      "name": "Get Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 350],
      "credentials": {
        "githubApi": "GitHub"
      }
    },
    {
      "parameters": {
        "owner": "{{$env.GITHUB_OWNER}}",
        "repository": "{{$env.GITHUB_REPO}}",
        "additionalFields": {
          "state": "closed",
          "since": "{{$jmespath( \"now().sub(@, \\\"7d\\\")\", $now)}}"
        }
      },
      "id": "pulls",
      "name": "Get PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 500],
      "credentials": {
        "githubApi": "GitHub"
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "merge",
        "options": {}
      },
      "id": "merge",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [650, 350]
    },
    {
      "parameters": {
        "prompt": "You are a developer relations assistant. Write a weekly development summary report based on the following GitHub activity:\n\nCommits ({{ $json.commits.length }}):\n{{ $json.commits.map(c => '- ' + c.commit.message).join('\\n') }}\n\nClosed Issues ({{ $json.issues.length }}):\n{{ $json.issues.map(i => '- #' + i.number + ': ' + i.title).join('\\n') }}\n\nMerged PRs ({{ $json.prs.length }}):\n{{ $json.prs.map(p => '- #' + p.number + ': ' + p.title).join('\\n') }}\n\nWrite an engaging, narrative summary in {{ $env.LANGUAGE || 'English' }}. Structure it as:\n\n1. **Overview** - 2-3 sentences about the week's activity\n2. **Highlights** - Key commits and features\n3. **Issues Resolved** - Notable bug fixes\n4. **Pull Requests** - Major changes merged\n5. **Looking Ahead** - Brief mention of what's next\n\nKeep it concise but informative. Use emoji sparingly for visual interest.",
        "model": "claude-sonnet-4-20250514"
      },
      "id": "claude",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 350],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "headers": {
          "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
          "anthropic-version": "2023-06-01"
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "url": "{{$env.WEBHOOK_URL}}",
        "method": "POST",
        "body": {
          "content": "={{ $json.content[0].text }}"
        },
        "options": {
          "header": {
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "webhook",
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 350]
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Issues": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Get PRs": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Send to Discord/Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-03-28T00:00:00.000Z",
