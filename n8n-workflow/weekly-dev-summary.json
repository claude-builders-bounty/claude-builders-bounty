      	  "specifyBody": "text",
      	  "body": "Subject: Weekly Dev Summary — {{ $('Every Friday 5pm').item.json.week_label }}\n\n{{ $json.summary_text }}",
      "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
