{
  "name": "Weekly GitHub Dev Summary (Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtDay": 5,
              "triggerAtHour": 17,
              "mode": "custom"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Weekly Trigger (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits?since={{ $json.since }}&until={{ $json.until }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/issues?state=closed&since={{ $json.since }}&sort=updated&direction=desc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls?state=closed&sort=updated&direction=desc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst commits = $input.all().map(item => item.json);\nconst commitSummaries = commits.map(c => `- ${c.commit.message.split('\\n')[0]} (${c.sha.slice(0,7)} by ${c.commit.author?.name || 'unknown'})`).join('\\n');\nreturn [{ json: { commitSummaries, count: commits.length } }];\n"
      },
      "id": "format-commits",
      "name": "Format Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.claudeApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": "2000"
            },
            {
              "name": "messages",
              "value": "=[{\"role\":\"user\",\"content\":\"Generate a weekly development summary for the repo. Be concise, narrative, and highlight key achievements.\\n\\nCommits this week:\\n{{ $json.commitSummaries }}\\n\\nClosed issues: {{ $json.issueCount }}\\nMerged PRs: {{ $json.prCount }}\\n\\nWrite in {{ $json.language || 'EN' }}. Format as a friendly team update suitable for Slack/Discord.\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "claude-summary",
      "name": "Generate Summary (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1150,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhookUrl }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.summary }}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-webhook",
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1400,
        400
      ]
    }
  ],
  "connections": {
    "Weekly Trigger (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Format Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Commits": {
      "main": [
        [
          {
            "node": "Generate Summary (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary (Claude)": {
      "main": [
        [
          {
            "node": "Send to Discord/Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "github"
    },
    {
      "name": "claude"
    },
    {
      "name": "weekly-summary"
    }
  ]
}