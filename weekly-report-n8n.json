{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 168}]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Friday 5PM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $json.repo_owner + '/' + $json.repo_name + '/commits?since=' + $json.since_date }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "={{ 'Bearer ' + $json.github_token }}"},
            {"name": "Accept", "value": "application/vnd.github+json"}
          ]
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $json.repo_owner + '/' + $json.repo_name + '/issues?state=closed&since=' + $json.since_date }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "={{ 'Bearer ' + $json.github_token }}"},
            {"name": "Accept", "value": "application/vnd.github+json"}
          ]
        }
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $json.repo_owner + '/' + $json.repo_name + '/pulls?state=closed&sort=updated&direction=desc' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "={{ 'Bearer ' + $json.github_token }}"},
            {"name": "Accept", "value": "application/vnd.github+json"}
          ]
        }
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 600]
    },
    {
      "parameters": {
        "jsCode": "// Merge all fetched data into a single summary context\nconst commits = $input.all()[0]?.json || [];\nconst issues = $input.all()[1]?.json || [];\nconst prs = $input.all()[2]?.json || [];\n\nconst summary = {\n  repo: $json.repo_owner + '/' + $json.repo_name,\n  week_of: $json.since_date,\n  total_commits: commits.length,\n  total_issues_closed: issues.length,\n  total_prs_merged: prs.length,\n  commits: commits.slice(0, 20).map(c => ({message: c.commit?.message, author: c.commit?.author?.name, date: c.commit?.author?.date})),\n  issues: issues.slice(0, 10).map(i => ({title: i.title, number: i.number, closed_at: i.closed_at})),\n  prs: prs.slice(0, 10).map(p => ({title: p.title, number: p.number, merged_at: p.merged_at}))\n};\n\nreturn {json: summary};"
      },
      "id": "merge-data",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "claude-sonnet-4-20250514"},
            {"name": "max_tokens", "value": 4000},
            {"name": "system", "value": "You are a technical writer. Generate a concise, professional weekly development summary. Format in Markdown with clear sections: Highlights, Commits, Issues Closed, PRs Merged, and Next Week Outlook."},
            {"name": "messages[0][role]", "value": "user"},
            {"name": "messages[0][content]", "value": "={{ JSON.stringify($json) }}"}
          ]
        },
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{ $json.anthropic_api_key }}"},
            {"name": "anthropic-version", "value": "2023-06-01"}
          ]
        }
      },
      "id": "claude-summary",
      "name": "Claude API — Narrative Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 400]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.smtp_from }}",
        "toEmail": "={{ $json.report_recipients }}",
        "subject": "={{ 'Weekly Dev Summary - ' + $json.repo_owner + '/' + $json.repo_name + ' (' + $json.week_label + ')' }}",
        "text": "={{ $json.content[0].text }}"
      },
      "id": "send-email",
      "name": "Send Report Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 400]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5PM)": {
      "main": [[
        {"node": "Fetch Commits", "type": "main", "index": 0},
        {"node": "Fetch Closed Issues", "type": "main", "index": 0},
        {"node": "Fetch Merged PRs", "type": "main", "index": 0}
      ]]
    },
    "Fetch Commits": {"main": [[{"node": "Merge GitHub Data", "type": "main", "index": 0}]]},
    "Fetch Closed Issues": {"main": [[{"node": "Merge GitHub Data", "type": "main", "index": 1}]]},
    "Fetch Merged PRs": {"main": [[{"node": "Merge GitHub Data", "type": "main", "index": 2}]]},
    "Merge GitHub Data": {"main": [[{"node": "Claude API — Narrative Summary", "type": "main", "index": 0}]]},
    "Claude API — Narrative Summary": {"main": [[{"node": "Send Report Email", "type": "main", "index": 0}]]}
  }
}
