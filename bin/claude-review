#!/usr/bin/env python3
"""Small executable entry point for the dependency-free review agent."""

from __future__ import annotations

from pathlib import Path
import runpy


if __name__ == "__main__":
    runpy.run_path(
        str(Path(__file__).resolve().parents[1] / "agents" / "claude-review" / "claude_review.py"),
        run_name="__main__",
    )
