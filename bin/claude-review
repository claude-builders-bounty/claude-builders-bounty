#!/usr/bin/env python3
"""
CLI entrypoint for Claude Code PR Review Agent.
Usage:
  claude-review --pr https://github.com/owner/repo/pull/123 [--output review.md]
"""
import sys
import os
import argparse
from pathlib import Path

# Add repo root to path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agents.claude_review.review_engine import parse_pr_url, fetch_pr_diff, generate_review_from_diff

def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Review Agent")
    parser.add_argument("--pr", required=True, help="GitHub Pull Request URL (e.g. https://github.com/owner/repo/pull/123)")
    parser.add_argument("--token", default=os.getenv("GITHUB_TOKEN"), help="GitHub API Token (optional for public repos)")
    parser.add_argument("--diff-file", help="Local diff file to evaluate (optional)")
    parser.add_argument("--output", help="Path to write the generated markdown review")

    args = parser.parse_args()

    try:
        if args.diff_file:
            with open(args.diff_file, "r") as f:
                diff = f.read()
            pr_title = f"Local Diff: {args.diff_file}"
        else:
            owner, repo, pull_number = parse_pr_url(args.pr)
            print(f"🔍 Fetching diff for {owner}/{repo}#{pull_number}...")
            diff = fetch_pr_diff(owner, repo, pull_number, args.token)
            pr_title = f"{owner}/{repo}#{pull_number}"

        print("🤖 Analyzing PR diff and generating structured review...")
        review = generate_review_from_diff(diff, pr_title=pr_title, pr_url=args.pr)

        if args.output:
            with open(args.output, "w") as f:
                f.write(review)
            print(f"✅ Review successfully written to {args.output}")
        else:
            print("\n" + "=" * 60)
            print(review)
            print("=" * 60 + "\n")

    except Exception as e:
        print(f"❌ Error during PR review: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
