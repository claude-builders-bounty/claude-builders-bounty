#!/usr/bin/env python3
"""Review a GitHub PR diff and print a structured Markdown review."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Iterable

PR_RE = re.compile(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)")


@dataclass
class Finding:
    level: str
    message: str


def parse_pr_url(url: str) -> tuple[str, str, str]:
    match = PR_RE.fullmatch(url.rstrip("/"))
    if not match:
        raise ValueError("expected PR URL like https://github.com/owner/repo/pull/123")
    return match.group(1), match.group(2), match.group(3)


def github_get(url: str, accept: str) -> str:
    headers = {"Accept": accept, "User-Agent": "claude-review-cli"}
    token = os.getenv("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as response:
        return response.read().decode("utf-8", errors="replace")


def fetch_pr(owner: str, repo: str, number: str) -> dict:
    raw = github_get(
        f"https://api.github.com/repos/{owner}/{repo}/pulls/{number}",
        "application/vnd.github+json",
    )
    return json.loads(raw)


def fetch_diff(owner: str, repo: str, number: str) -> str:
    return github_get(
        f"https://api.github.com/repos/{owner}/{repo}/pulls/{number}",
        "application/vnd.github.v3.diff",
    )


def changed_files(diff: str) -> list[str]:
    files = []
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            files.append(line.split(" b/", 1)[-1])
    return files


def added_lines(diff: str) -> list[str]:
    return [line[1:] for line in diff.splitlines() if line.startswith("+") and not line.startswith("+++")]


def removed_lines(diff: str) -> list[str]:
    return [line[1:] for line in diff.splitlines() if line.startswith("-") and not line.startswith("---")]


def analyze(diff: str, files: Iterable[str]) -> tuple[list[Finding], list[str], str]:
    risks: list[Finding] = []
    suggestions: list[str] = []
    added = added_lines(diff)
    removed = removed_lines(diff)
    file_list = list(files)
    joined_added = "\n".join(added)

    if any(re.search(r"(api[_-]?key|secret|token|password)\s*[=:]", line, re.I) for line in added):
        risks.append(Finding("High", "Possible secret or credential-like value added."))
        suggestions.append("Move credentials to environment variables or secret storage.")

    if any("TODO" in line or "FIXME" in line for line in added):
        risks.append(Finding("Medium", "New TODO/FIXME markers may indicate unfinished work."))
        suggestions.append("Resolve TODOs or link them to tracked follow-up issues.")

    if any("console.log" in line or "debugger" in line for line in added):
        risks.append(Finding("Low", "Debug statements appear in added code."))
        suggestions.append("Remove debug output before merge unless it is intentional logging.")

    if any(re.search(r"except\s*:\s*$", line) or re.search(r"catch\s*\([^)]*\)\s*{\s*}", line) for line in added):
        risks.append(Finding("Medium", "Broad or empty error handling can hide production failures."))
        suggestions.append("Handle expected errors explicitly and log unexpected failures.")

    if any(f.endswith(("package.json", "requirements.txt", "Cargo.toml", "pyproject.toml")) for f in file_list):
        suggestions.append("Confirm dependency changes are reflected in lockfiles and security checks.")

    if len(added) > 400 and not any("test" in f.lower() or "spec" in f.lower() for f in file_list):
        risks.append(Finding("Medium", "Large code change without obvious test files."))
        suggestions.append("Add or update tests covering the main changed path.")

    if not risks:
        risks.append(Finding("Low", "No obvious static-review risks found in the diff."))

    if not suggestions:
        suggestions.append("Run the project test/build pipeline and include the result before merge.")

    churn = len(added) + len(removed)
    if churn < 80 and not any(r.level == "High" for r in risks):
        confidence = "High"
    elif any(r.level == "High" for r in risks) or churn > 600:
        confidence = "Low"
    else:
        confidence = "Medium"

    return risks, suggestions, confidence


def render(pr: dict, diff: str) -> str:
    files = changed_files(diff)
    risks, suggestions, confidence = analyze(diff, files)
    additions = len(added_lines(diff))
    deletions = len(removed_lines(diff))
    title = pr.get("title", "PR")
    user = (pr.get("user") or {}).get("login", "unknown")

    lines = [
        "# PR Review",
        "",
        "## Summary",
        f"This PR, **{title}**, was opened by `{user}` and changes {len(files)} file(s) with {additions} added and {deletions} removed lines.",
        "The diff was reviewed for common correctness, safety, dependency, and maintainability risks.",
        "",
        "## Identified risks",
    ]
    lines.extend(f"- **{risk.level}:** {risk.message}" for risk in risks)
    lines.extend(["", "## Improvement suggestions"])
    lines.extend(f"- {item}" for item in dict.fromkeys(suggestions))
    lines.extend(["", f"## Confidence: {confidence}"])
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="Review a GitHub PR and print Markdown output.")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    args = parser.parse_args()

    try:
        owner, repo, number = parse_pr_url(args.pr)
        pr = fetch_pr(owner, repo, number)
        diff = fetch_diff(owner, repo, number)
    except (ValueError, urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    print(render(pr, diff), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
