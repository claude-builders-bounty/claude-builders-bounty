{
  "name": "Weekly GitHub Dev Summary — n8n + Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "GITHUB_OWNER",
              "value": "claude-builders-bounty"
            },
            {
              "name": "GITHUB_REPO",
              "value": "claude-builders-bounty"
            },
            {
              "name": "LANGUAGE",
              "value": "EN"
            },
            {
              "name": "DESTINATION_TYPE",
              "value": "discord"
            },
            {
              "name": "DISCORD_WEBHOOK_URL",
              "value": ""
            },
            {
              "name": "EMAIL_TO",
              "value": ""
            }
          ]
        },
        "options": {}
      },
      "id": "set-variables",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Variables').item.json.GITHUB_OWNER }}/{{ $('Set Variables').item.json.GITHUB_REPO }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-commits",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Variables').item.json.GITHUB_OWNER }}/{{ $('Set Variables').item.json.GITHUB_REPO }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-issues",
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Variables').item.json.GITHUB_OWNER }}/{{ $('Set Variables').item.json.GITHUB_REPO }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-pulls",
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 600]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate GitHub activity data from the three API calls\n// and build a formatted prompt for Claude\n\nconst lang = $('Set Variables').item.json.LANGUAGE || 'EN';\nconst owner = $('Set Variables').item.json.GITHUB_OWNER;\nconst repo = $('Set Variables').item.json.GITHUB_REPO;\n\nconst commits = $input.all()[0].json;\nconst issues = $input.all()[1].json;\nconst pulls = $input.all()[2].json;\n\nconst commitList = Array.isArray(commits) ? commits.slice(0, 20).map(c => {\n  const msg = c.commit?.message?.split('\\n')[0] || 'no message';\n  return `- ${msg} (by ${c.commit?.author?.name || 'unknown'})`;\n}).join('\\n') : 'No commits this week.';\n\nconst issueList = Array.isArray(issues) ? issues.filter(i => !i.pull_request).slice(0, 20).map(i => {\n  return `- #${i.number} ${i.title} (closed)`;\n}).join('\\n') : 'No closed issues this week.';\n\nconst prList = Array.isArray(pulls) ? pulls.filter(p => p.merged_at).slice(0, 20).map(p => {\n  return `- #${p.number} ${p.title} (merged by ${p.merged_by?.login || 'unknown'})`;\n}).join('\\n') : 'No merged PRs this week.';\n\nconst languageInstruction = lang === 'FR'\n  ? 'Tu es un assistant qui redige un resume hebdomadaire narratif en francais.'\n  : 'You are an assistant that writes a weekly narrative summary in English.';\n\nconst prompt = `${languageInstruction}\\n\\nWrite a short, professional weekly development summary for the repository ${owner}/${repo}. Use only the data provided below. Format the output in markdown with sections for Commits, Closed Issues, and Merged Pull Requests. Include a brief overall tone note at the top.\\n\\n### Commits This Week\\n${commitList}\\n\\n### Closed Issues This Week\\n${issueList}\\n\\n### Merged Pull Requests This Week\\n${prList}\\n\\nNow write the weekly summary:`;\n\nreturn {\n  prompt: prompt,\n  lang: lang,\n  repo: `${owner}/${repo}`\n};"
      },
      "id": "code-aggregate",
      "name": "Aggregate & Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 2048,\n  \"system\": \"={{ $('Set Variables').item.json.LANGUAGE === 'FR' ? 'Tu es un assistant technique qui redige des resumes de developpement hebdomadaires en francais. Sois concis et professionnel.' : 'You are a technical assistant that writes weekly development summaries in English. Be concise and professional.' }}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $json.prompt }}\"\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "claude-api",
      "name": "Claude API Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "jsCode": "// Extract Claude's response text from the API response\nconst response = $input.first().json;\nconst content = response.content || [];\nconst textBlocks = content.filter(b => b.type === 'text');\nconst summaryText = textBlocks.map(b => b.text).join('\\n\\n');\n\nconst repo = $('Set Variables').item.json.GITHUB_REPO || 'repository';\nconst owner = $('Set Variables').item.json.GITHUB_OWNER || 'owner';\n\nreturn {\n  summary: summaryText || 'No summary generated.',\n  subject: `Weekly Dev Summary — ${owner}/${repo}`,\n  repo: `${owner}/${repo}`\n};"
      },
      "id": "code-extract",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "jsCode": "// Route to the correct delivery method based on DESTINATION_TYPE\nconst destType = $('Set Variables').item.json.DESTINATION_TYPE || 'discord';\nif (destType === 'discord') {\n  return [{ json: $input.first().json, delivery: 'discord' }];\n} else if (destType === 'email') {\n  return [{ json: $input.first().json, delivery: 'email' }];\n}\nreturn [{ json: $input.first().json, delivery: 'discord' }];"
      },
      "id": "switch-delivery",
      "name": "Delivery Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1450, 400],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.delivery }}",
                    "rightValue": "discord",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.delivery }}",
                    "rightValue": "email",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Variables').item.json.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"content\": \"={{ '**' + $('Extract Summary').item.json.subject + '**\\n\\n' + $('Extract Summary').item.json.summary }}\"\n}",
        "options": {}
      },
      "id": "discord-webhook",
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM || 'n8n@example.com' }}",
        "toEmail": "={{ $('Set Variables').item.json.EMAIL_TO }}",
        "subject": "={{ $('Extract Summary').item.json.subject }}",
        "text": "={{ $('Extract Summary').item.json.summary }}",
        "options": {}
      },
      "id": "email-send",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1650, 500],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP"
        }
      }
    }
  ],
  "connections": {
    "Every Friday 5pm": {
      "main": [
        [
          {
