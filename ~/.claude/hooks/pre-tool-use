#!/bin/bash

# Hook to block dangerous bash commands in Claude Code
# This script is called before any bash command is executed

# Get the current working directory
PROJECT_PATH=$(pwd)

# Get timestamp
TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")

# Read the command from arguments
COMMAND="$1"

# Define dangerous patterns
DANGEROUS_PATTERNS=(
  "rm -rf"
  "DROP TABLE"
  "git push --force"
  "TRUNCATE"
  "DELETE FROM.*WHERE"
)

# Check if command matches any dangerous pattern
BLOCKED=false
for pattern in "${DANGEROUS_PATTERNS[@]}"; do
  if [[ "$COMMAND" =~ $pattern ]]; then
    BLOCKED=true
    break
  fi
done

# If command is dangerous, block it and log
if [ "$BLOCKED" = true ]; then
  # Log the blocked attempt
  echo "[$TIMESTAMP] Blocked command: '$COMMAND' in project: $PROJECT_PATH" >> ~/.claude/hooks/blocked.log
  
  # Display message to Claude
  echo "⚠️  Command blocked: '$COMMAND'"
  echo "This command matches a dangerous pattern and has been prevented for safety."
  echo "If you believe this is a mistake, you can bypass this check by using the '!' prefix."
  
  # Exit with non-zero status to prevent execution
  exit 1
fi

# If not dangerous, allow execution
exit 0