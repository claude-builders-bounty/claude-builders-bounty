    # Mocking the response from the GitHub API
    mock_response = MagicMock()
    mock_response.json.return_value = {'id': 'comment_id'  # Adjust according to the actual API response
    sub_agent.post_comment('pr_number', 'repo', 'comment_body')
    sub_agent.post_comment('pr_number', 'repo', 'comment_body')
    assert sub_agent.last_comment_id == 'comment_id'  # Adjust according to the actual API response

