{
  "name": "Weekly Dev Summary (Claude + GitHub)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "week",
              "hour": 17,
              "minute": 0,
              "weekday": [
                5
              ]
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Weekly Schedule (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "githubRepo",
              "value": "={{ $json.repo || 'owner/repo' }}"
            },
            {
              "name": "githubToken",
              "value": "={{ $json.githubToken || '' }}"
            },
            {
              "name": "language",
              "value": "={{ $json.language || 'EN' }}"
            },
            {
              "name": "deliveryChannel",
              "value": "={{ $json.deliveryChannel || 'slack' }}"
            },
            {
              "name": "slackWebhook",
              "value": "={{ $json.slackWebhook || '' }}"
            },
            {
              "name": "claudeApiKey",
              "value": "={{ $json.claudeApiKey || '' }}"
            },
            {
              "name": "claudeModel",
              "value": "claude-sonnet-4-20250514"
            }
          ]
        },
        "options": {}
      },
      "id": "config-vars",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate Monday and Friday of the current week\nconst now = new Date();\nconst dayOfWeek = now.getDay();\nconst monday = new Date(now);\nconst daysSinceMonday = dayOfWeek === 0 ? 6 : dayOfWeek - 1;\nmonday.setDate(now.getDate() - daysSinceMonday);\nmonday.setHours(0, 0, 0, 0);\nconst friday = new Date(monday);\nfriday.setDate(monday.getDate() + 4);\nfriday.setHours(23, 59, 59, 999);\nif (now < friday) {\n    monday.setDate(monday.getDate() - 7);\n    friday.setDate(friday.getDate() - 7);\n}\nreturn {\n    since: monday.toISOString(),\n    until: friday.toISOString(),\n    repo: items[0].json.githubRepo,\n    githubToken: items[0].json.githubToken,\n    language: items[0].json.language,\n    deliveryChannel: items[0].json.deliveryChannel,\n    slackWebhook: items[0].json.slackWebhook,\n    claudeApiKey: items[0].json.claudeApiKey,\n    claudeModel: items[0].json.claudeModel\n};"
      },
      "id": "date-calc",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits?since={{ $json.since }}&until={{ $json.until }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "github-commits",
      "name": "Fetch GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        150
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/issues?state=closed&since={{ $json.since }}&per_page=100&sort=updated&direction=desc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        450
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls?state=closed&sort=updated&direction=desc&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        750
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition"
      },
      "id": "merge-data",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1100,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all()[0]?.json?.data || [];\nconst issues = $input.all()[1]?.json?.data || [];\nconst prs = $input.all()[2]?.json?.data || [];\nconst config = $input.all()[3]?.json || {};\nconst mergedPRs = (prs || []).filter(pr => \n    pr.merged_at && new Date(pr.merged_at) >= new Date(config.since) && new Date(pr.merged_at) <= new Date(config.until)\n);\nconst closedIssues = (issues || []).filter(issue => \n    !issue.pull_request && issue.closed_at && new Date(issue.closed_at) >= new Date(config.since) && new Date(issue.closed_at) <= new Date(config.until)\n);\nconst authorStats = {};\nfor (const commit of commits) {\n    const author = commit.commit?.author?.name || 'Unknown';\n    if (!authorStats[author]) authorStats[author] = 0;\n    authorStats[author]++;\n}\nconst prompt = `You are a senior engineering manager writing a weekly development summary.\nRepository: ${config.repo}\nPeriod: ${config.since} to ${config.until}\n## Commits (${commits.length} total)\n${commits.map(c => `- ${c.commit?.message?.split('\\\\n')[0] || 'No message'} (by ${c.commit?.author?.name || 'Unknown'})`).join('\\\\n')}\n## Commit Count by Author\n${Object.entries(authorStats).map(([a, n]) => `- ${a}: ${n} commits`).join('\\\\n')}\n## Merged Pull Requests (${mergedPRs.length})\n${mergedPRs.map(pr => `- #${pr.number}: ${pr.title} (by ${pr.user?.login || 'Unknown'})`).join('\\\\n')}\n## Closed Issues (${closedIssues.length})\n${closedIssues.map(issue => `- #${issue.number}: ${issue.title} (by ${issue.user?.login || 'Unknown'})`).join('\\\\n')}\nPlease write a ${config.language === 'FR' ? 'French' : 'English'} narrative summary covering:\n1. **Overview**: What kind of week was it?\n2. **Key Highlights**: Most important PRs merged, significant commits\n3. **Issues Resolved**: Notable bug fixes or feature requests closed\n4. **Contributors**: Who was active this week\n5. **Looking Ahead**: Any patterns worth noting\nKeep it concise, friendly, and informative.`;\nreturn { prompt: prompt, config: config };"
      },
      "id": "prompt-builder",
      "name": "Build Prompt for Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1350,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "sendBody": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.config.claudeApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $json.config.claudeModel }}"
            },
            {
              "name": "max_tokens",
              "value": 4096
            },
            {
              "name": "messages",
              "value": [
                [
                  {
                    "name": "role",
                    "value": "user"
                  },
                  {
                    "name": "content",
                    "value": "={{ $json.prompt }}"
                  }
                ]
              ]
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "claude-api",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const summary = $input.first().json;\nconst config = $input.first().json.$_config || $json.config;\nlet formattedOutput = `\ud83d\udcca *Weekly Dev Summary* \u2014 ${config.repo}\\n`;\nformattedOutput += `\ud83d\udcc5 Period: ${config.since} to ${config.until}\\n\\n`;\nformattedOutput += summary.content?.[0]?.text || summary.content || JSON.stringify(summary);\nreturn { text: formattedOutput, repo: config.repo, period: `${config.since} \u2014 ${config.until}`, language: config.language };"
      },
      "id": "format-output",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1850,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.slackWebhook }}",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "unfurl_links",
              "value": true
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "slack-delivery",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        350
      ]
    }
  ],
