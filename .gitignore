# =================
# gongzuoqu 专用 .gitignore
# 依据 6 文件夹规范 + 实际文件类型生成
# =================

# --- 00_linshiqu: 临时/可删，全忽略 ---
/00_linshiqu/**

# --- 通用构建/运行产物 ---
# Electron / Node
node_modules/
dist/
build/
release/
*.log
*.tmp
electron-*.log
vite*.log
pet-startup-*.log
stdout-*.tmp
stderr-*.tmp

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/
.venv/
venv/
env/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 环境变量 / 密钥 / 凭证（绝不入库）
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
secrets.*
credentials.*
*cookie*.json
*auth*.json
*token*.json

# 大模型/推理缓存
*.bin
*.gguf
*.safetensors
model_cache/
hf_cache/
ollama/

# 归档/压缩
*.zip
*.tar.gz
*.7z
*.rar

# --- 03_xiangmu_geli_wenjianjia: 项目隔离区 ---
# 每个子项目自行维护自己的 .gitignore（建议）
# 这里只忽略通用的构建产物和二进制产出
/03_xiangmu_geli_wenjianjia/*/release/
/03_xiangmu_geli_wenjianjia/*/dist/
/03_xiangmu_geli_wenjianjia/*/build/
/03_xiangmu_geli_wenjianjia/*/node_modules/
/03_xiangmu_geli_wenjianjia/*/__pycache__/
/03_xiangmu_geli_wenjianjia/*/.pytest_cache/
/03_xiangmu_geli_wenjianjia/*/*.log
/03_xiangmu_geli_wenjianjia/*/*.tmp

# --- 04_dinggao_jiaofuqu / 05_guidang_fengcunqu ---
# 定稿/归档通常只放最终交付物，不忽略（按需保留）
# 但排除临时编辑缓存
/04_dinggao_jiaofuqu/*~
/04_dinggao_jiaofuqu/*.tmp
/05_guidang_fengcunqu/*~
/05_guidang_fengcunqu/*.tmp

# --- 01_kefuyong_gongjuku / 02_waizhi_zhishiku ---
# 可复用脚本/知识库：正常纳入版本控制
# 仅忽略可能产生的缓存
/01_kefuyong_gongjuku/__pycache__/
/01_kefuyong_gongjuku/*.pyc
/02_waizhi_zhishiku/__pycache__/
/02_waizhi_zhishiku/*.pyc

# =================
# 说明：
# - 00_linshiqu 整个忽略：符合“临时/可删”语义
# - 密钥/Cookie/Token 绝对不入库（安全红线）
# - Electron/Node/Python 产物全忽略
# - 子项目建议各自再加一层 .gitignore 精细控制
# =================