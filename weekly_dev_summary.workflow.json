{
  "nodes": [
    {
      "parameters": {
        "trigger": "cron",
        "cron": "0 17 * * 5"
      },
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        100
      ]
    },
    {
      "parameters": {
        "repository": "your-repo",
        "since": "={{$json[\"date\"]}}",
        "until": "={{$json[\"date\"]}}"
      },
      "name": "GitHub",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        300,
        100
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "Generate a narrative summary of the GitHub repo's activity for the week of {{=$json[\"date\"]}}",
        "maxTokens": 1024
      },
      "name": "Claude API",
      "type": "n8n-nodes-base.claudeApi",
      "typeVersion": 1,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "to": "your-email",
        "subject": "Weekly Dev Summary",
        "text": "={{$json[\"summary\"]}}"
      },
      "name": "Email",
      "type": "n8n-nodes-base.email",
      "typeVersion": 1,
      "position": [
        700,
        100
      ]
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        "GitHub"
      ]
    },
    "GitHub": {
      "main": [
        "Claude API"
      ]
    },
    "Claude API": {
      "main": [
        "Email"
      ]
    }
  }
}
