{
  "name": "GitHub + Claude Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Weekly Schedule (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/={{$env.GITHUB_REPO || 'owner/repo'}}/commits?since={{new Date(Date.now() - 7*24*60*60*1000).toISOString()}}",
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-Claude-Summary"
            }
          ]
        }
      },
      "id": "2",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a professional weekly developer summary for our team based on these recent GitHub commits:\\n\\n\" + JSON.stringify($json)\n    }\n  ]\n}"
      },
      "id": "3",
      "name": "Claude Sonnet Summary Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "url": "={{$env.DISCORD_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"📢 **Weekly Engineering Digest**\\n\\n\" + $json.content[0].text\n}"
      },
      "id": "4",
      "name": "Deliver via Discord / Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Weekly Schedule (Friday 5PM)": {
      "main": [[{"node": "Fetch Weekly Commits", "type": "main", "index": 0}]]
    },
    "Fetch Weekly Commits": {
      "main": [[{"node": "Claude Sonnet Summary Engine", "type": "main", "index": 0}]]
    },
    "Claude Sonnet Summary Engine": {
      "main": [[{"node": "Deliver via Discord / Slack Webhook", "type": "main", "index": 0}]]
    }
  }
}
