{
  "name": "Weekly Dev Summary (GitHub + Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "repo", "value": "={{ $env.GITHUB_REPO }}", "type": "string" },
            { "id": "2", "name": "language", "value": "={{ $env.SUMMARY_LANGUAGE || 'EN' }}", "type": "string" },
            { "id": "3", "name": "since", "value": "={{ new Date(Date.now() - 7*24*60*60*1000).toISOString() }}", "type": "string" },
            { "id": "4", "name": "until", "value": "={{ new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits?since={{ $json.since }}&until={{ $json.until }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "n8n-weekly-summary" }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 180],
      "credentials": { "httpHeaderAuth": { "id": "github-auth", "name": "GitHub PAT" } }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').item.json.repo }}/pulls?state=closed&sort=updated&direction=desc&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "n8n-weekly-summary" }
          ]
        },
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": { "httpHeaderAuth": { "id": "github-auth", "name": "GitHub PAT" } }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').item.json.repo }}/issues?state=closed&since={{ $('Config').item.json.since }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "n8n-weekly-summary" }
          ]
        },
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 420],
      "credentials": { "httpHeaderAuth": { "id": "github-auth", "name": "GitHub PAT" } }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').item.json;\nconst sinceMs = new Date(cfg.since).getTime();\n\nconst commits = ($('Fetch Commits').all() || []).map(i => i.json).flat().filter(c => c && c.commit).map(c => ({\n  sha: c.sha.slice(0, 7),\n  message: c.commit.message.split('\\n')[0],\n  author: c.commit.author.name,\n  date: c.commit.author.date\n}));\n\nconst prsRaw = ($('Fetch Merged PRs').all() || []).map(i => i.json).flat();\nconst prs = prsRaw.filter(p => p && p.merged_at && new Date(p.merged_at).getTime() >= sinceMs).map(p => ({\n  number: p.number,\n  title: p.title,\n  author: p.user?.login,\n  merged_at: p.merged_at,\n  url: p.html_url\n}));\n\nconst issuesRaw = ($('Fetch Closed Issues').all() || []).map(i => i.json).flat();\nconst issues = issuesRaw.filter(i => i && !i.pull_request && i.closed_at).map(i => ({\n  number: i.number,\n  title: i.title,\n  closed_at: i.closed_at,\n  url: i.html_url\n}));\n\nreturn [{ json: { repo: cfg.repo, language: cfg.language, since: cfg.since, until: cfg.until, commits, prs, issues, counts: { commits: commits.length, prs: prs.length, issues: issues.length } } }];"
      },
      "id": "aggregate",
      "name": "Aggregate Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a technical writer producing a weekly engineering digest. Write a concise narrative summary (300-500 words) in {{ $json.language === 'FR' ? 'French' : 'English' }} for the repo {{ $json.repo }} covering {{ $json.since }} to {{ $json.until }}.\\n\\nStructure: (1) Headline (one sentence), (2) Highlights (3-5 bullets on themes, not raw lists), (3) Merged PRs of note, (4) Issues resolved, (5) Contributor shoutouts. Markdown formatted.\\n\\nData (JSON):\\n{{ JSON.stringify({ counts: $json.counts, commits: $json.commits.slice(0,50), prs: $json.prs.slice(0,30), issues: $json.issues.slice(0,30) }) }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude",
      "name": "Claude Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = resp.content?.[0]?.text || 'No summary generated.';\nconst cfg = $('Aggregate Activity').item.json;\nconst header = `*Weekly Dev Summary — ${cfg.repo}*\\n_${cfg.since.slice(0,10)} → ${cfg.until.slice(0,10)}_\\n${cfg.counts.commits} commits · ${cfg.counts.prs} PRs · ${cfg.counts.issues} issues closed\\n\\n`;\nreturn [{ json: { text: header + text, raw: text } }];"
      },
      "id": "format",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"text\": {{ JSON.stringify($json.text) }} }",
        "options": {}
      },
      "id": "slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "Weekly Cron (Fri 5pm)": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[
      { "node": "Fetch Commits", "type": "main", "index": 0 },
      { "node": "Fetch Merged PRs", "type": "main", "index": 0 },
      { "node": "Fetch Closed Issues", "type": "main", "index": 0 }
    ]] },
    "Fetch Commits": { "main": [[{ "node": "Aggregate Activity", "type": "main", "index": 0 }]] },
    "Fetch Merged PRs": { "main": [[{ "node": "Aggregate Activity", "type": "main", "index": 0 }]] },
    "Fetch Closed Issues": { "main": [[{ "node": "Aggregate Activity", "type": "main", "index": 0 }]] },
    "Aggregate Activity": { "main": [[{ "node": "Claude Summarize", "type": "main", "index": 0 }]] },
    "Claude Summarize": { "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]] },
    "Format Message": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0",
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "bounty-05" }, { "name": "weekly-summary" }]
}
