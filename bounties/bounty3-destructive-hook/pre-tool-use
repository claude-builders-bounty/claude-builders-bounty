#!/usr/bin/env python3
"""
pre-tool-use hook — Blocks destructive bash commands in Claude Code.

Install: Copy to ~/.claude/hooks/pre-tool-use and chmod +x
"""

import json
import os
import re
import sys
from datetime import datetime

BLOCKED_PATTERNS = [
    # File system destruction
    (r'\brm\s+(-rf|--recursive)\b', 'Recursive force delete (rm -rf) — use a trash directory or git clean instead'),
    (r'\brm\s+(-f|--force)\s+/', 'Force delete from root — this would destroy the system'),
    (r'\bmkfs\.', 'Filesystem creation — destroys existing data'),
    (r'\bdd\s+if=.*\sof=', 'Raw disk write — can overwrite the entire filesystem'),
    
    # Database destruction
    (r'\bDROP\s+(TABLE|DATABASE|SCHEMA)\b', 'Destructive DDL statement — DROP cannot be rolled back'),
    (r'\bTRUNCATE\b', 'Table truncation — all data lost, no WHERE clause filter'),
    (r'\bDELETE\s+FROM\b(?!.*\bWHERE\b)', 'Unconditional DELETE — no WHERE clause means all rows deleted'),
    
    # Git force operations
    (r'\bgit\s+push\s+--force\b', 'Force push — will overwrite remote history and disrupt collaborators'),
    (r'\bgit\s+push\s+-f\b', 'Force push (short flag) — see above'),
    (r'\bgit\s+reset\s+--hard\b', 'Hard reset — discards all uncommitted changes'),
    (r'\bgit\s+clean\s+-fd\b', 'Force clean — permanently removes untracked files'),
    
    # System operations
    (r'\bshutdown\b', 'System shutdown'),
    (r'\breboot\b', 'System reboot'),
    (r'\bpoweroff\b', 'System power-off'),
    (r'\bchmod\s+777\b', 'Overly permissive chmod — security risk'),
    (r'\bchown\s+-R\b', 'Recursive ownership change — can break system permissions'),
    
    # Package / config
    (r'\bsudo\s+apt\s+(remove|purge|autoremove)\b', 'Package removal — removes software from the system'),
    (r'\bsp_ctl\s+(unload|remove)\b', 'Security policy removal'),
]

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")


def log_block(command: str, reason: str, cwd: str):
    """Log blocked commands with timestamp and context."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    timestamp = datetime.now().isoformat()
    entry = f"[{timestamp}] BLOCKED: {reason}\n  Command: {command}\n  Project: {cwd}\n---\n"
    with open(LOG_FILE, "a") as f:
        f.write(entry)


def check_command(command: str) -> tuple[bool, str]:
    """Check if a command matches any blocked pattern. Returns (is_blocked, reason)."""
    for pattern, reason in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return True, reason
    return False, ""


def main():
    # Read the hook input from stdin (Claude Code hooks receive JSON on stdin)
    try:
        raw_input = sys.stdin.read()
        if not raw_input:
            # No input means normal operation — allow
            sys.exit(0)
        
        data = json.loads(raw_input)
    except (json.JSONDecodeError, Exception):
        # If we can't parse, allow the command to proceed
        sys.exit(0)

    # Extract the command being executed
    command = ""
    cwd = os.getcwd()
    
    # Handle different hook input formats
    if isinstance(data, dict):
        command = data.get("command", "") or data.get("args", {}).get("command", "") or ""
        if "cwd" in data:
            cwd = data.get("cwd", cwd)
    
    if not command:
        # Allow through if we can't identify the command
        sys.exit(0)
    
    is_blocked, reason = check_command(command)
    
    if is_blocked:
        log_block(command, reason, cwd)
        
        # Output a structured message to Claude
        result = {
            "result": "blocked",
            "message": (
                f"⚠️ **Command Blocked**\n\n"
                f"Claude attempted to run a potentially destructive command:\n\n"
                f"```bash\n{command}\n```\n\n"
                f"**Reason:** {reason}\n\n"
                f"**Logged to:** `{LOG_FILE}`\n\n"
                f"To proceed anyway, use the `--allow-destructive` flag or manually review "
                f"and run the command in your terminal."
            )
        }
        print(json.dumps(result))
        sys.exit(0)
    
    # Command is safe — allow
    sys.exit(0)


if __name__ == "__main__":
    main()
