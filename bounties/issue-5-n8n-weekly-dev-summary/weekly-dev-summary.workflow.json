{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 17 * * 5"}]}},"id":"weekly-cron","name":"Weekly Friday 5pm","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[0,0]},
    {"parameters":{"jsCode":"const repo = $env.GITHUB_REPO || 'owner/repo';\nconst language = ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase();\nconst destination = $env.DISCORD_WEBHOOK_URL || '';\nconst since = new Date(Date.now() - 7*24*60*60*1000).toISOString();\nconst until = new Date().toISOString();\nconst [owner, name] = repo.split('/');\nreturn [{ json: { repo, owner, name, language, destination, since, until } }];"},"id":"config","name":"Load configurable variables","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0]},
    {"parameters":{"url":"=https://api.github.com/repos/{{$json.owner}}/{{$json.name}}/commits","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"since","value":"={{$json.since}}"},{"name":"until","value":"={{$json.until}}"},{"name":"per_page","value":"100"}]},"options":{}},"id":"commits","name":"Fetch commits","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[460,-220],"credentials":{"httpHeaderAuth":{"id":"GITHUB_TOKEN_HEADER","name":"GitHub token header"}}},
    {"parameters":{"url":"=https://api.github.com/search/issues?q=repo:{{$node['Load configurable variables'].json.repo}}+is:issue+is:closed+closed:>={{$node['Load configurable variables'].json.since}}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{}},"id":"issues","name":"Fetch closed issues","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[460,0],"credentials":{"httpHeaderAuth":{"id":"GITHUB_TOKEN_HEADER","name":"GitHub token header"}}},
    {"parameters":{"url":"=https://api.github.com/search/issues?q=repo:{{$node['Load configurable variables'].json.repo}}+is:pr+is:merged+merged:>={{$node['Load configurable variables'].json.since}}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{}},"id":"prs","name":"Fetch merged PRs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[460,220],"credentials":{"httpHeaderAuth":{"id":"GITHUB_TOKEN_HEADER","name":"GitHub token header"}}},
    {"parameters":{"jsCode":"const cfg = $('Load configurable variables').first().json;\nconst commits = $('Fetch commits').all().flatMap(i => Array.isArray(i.json) ? i.json : []).slice(0,100).map(c => ({sha:c.sha?.slice(0,7), message:c.commit?.message, author:c.commit?.author?.name}));\nconst issues = ($('Fetch closed issues').first().json.items || []).map(i => ({number:i.number,title:i.title,url:i.html_url}));\nconst prs = ($('Fetch merged PRs').first().json.items || []).map(p => ({number:p.number,title:p.title,url:p.html_url}));\nreturn [{json:{...cfg, commits, issues, prs, prompt:`Write a concise weekly narrative development summary in ${cfg.language}. Include highlights, shipped work, fixes, risks, and next steps. Data:\n${JSON.stringify({commits,issues,prs}, null, 2)}`}}];"},"id":"assemble","name":"Assemble Claude prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,0]},
    {"parameters":{"method":"POST","url":"https://api.anthropic.com/v1/messages","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"anthropic-version","value":"2023-06-01"},{"name":"content-type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":1200,\"messages\":[{\"role\":\"user\",\"content\":{{$json.prompt.toJsonString()}}}]}","options":{}},"id":"claude","name":"Generate narrative with Claude","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,0],"credentials":{"httpHeaderAuth":{"id":"ANTHROPIC_API_KEY_HEADER","name":"Anthropic API key header"}}},
    {"parameters":{"jsCode":"const cfg = $('Assemble Claude prompt').first().json;\nconst text = $json.content?.map(c => c.text).join('\\n') || $json.text || JSON.stringify($json);\nreturn [{json:{content:`**Weekly dev summary — ${cfg.repo}**\\n\\n${text}`, destination:cfg.destination}}];"},"id":"format","name":"Format Discord payload","type":"n8n-nodes-base.code","typeVersion":2,"position":[1180,0]},
    {"parameters":{"method":"POST","url":"={{$json.destination}}","sendBody":true,"specifyBody":"json","jsonBody":"={\"content\": {{$json.content.toJsonString()}}}","options":{}},"id":"discord","name":"Send to Discord webhook","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1400,0]}
  ],
