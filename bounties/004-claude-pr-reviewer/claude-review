#!/usr/bin/env python3
"""
claude-review — Claude Code PR review agent

Usage:
    claude-review --pr https://github.com/owner/repo/pull/123
    claude-review --diff path/to/file.diff
    git diff main...HEAD | claude-review --stdin

Requires:
    pip install anthropic
    export ANTHROPIC_API_KEY=sk-ant-...
    export GITHUB_TOKEN=ghp_...   (optional, increases GitHub API rate limit)
"""

from __future__ import annotations

import argparse
import os
import re
import sys
import urllib.request
import urllib.error
import json
from pathlib import Path

try:
    import anthropic
except ImportError:
    print("Error: anthropic package not installed. Run: pip install anthropic", file=sys.stderr)
    sys.exit(1)

AGENT_PROMPT = (Path(__file__).parent / "agent" / "pr-reviewer.md").read_text()
# Strip YAML frontmatter so only the system instructions remain
AGENT_PROMPT = re.sub(r"^---\n.*?---\n", "", AGENT_PROMPT, flags=re.DOTALL).strip()

MAX_DIFF_CHARS = 40_000  # roughly 10k tokens — keep cost and latency low


def _gh_headers() -> dict[str, str]:
    headers = {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}
    token = os.environ.get("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def fetch_pr_diff(pr_url: str) -> tuple[str, str]:
    """Return (metadata_block, unified_diff) for a GitHub PR URL."""
    m = re.fullmatch(
        r"https://github\.com/(?P<owner>[^/]+)/(?P<repo>[^/]+)/pull/(?P<number>\d+).*",
        pr_url.rstrip("/"),
    )
    if not m:
        raise ValueError(f"Not a valid GitHub PR URL: {pr_url}")
    owner, repo, number = m["owner"], m["repo"], m["number"]

    # Fetch PR metadata
    api_url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{number}"
    req = urllib.request.Request(api_url, headers=_gh_headers())
    with urllib.request.urlopen(req) as resp:
        pr = json.loads(resp.read())

    metadata = (
        f"PR: {pr['title']}\n"
        f"Author: {pr['user']['login']}\n"
        f"Base: {pr['base']['label']} ← Head: {pr['head']['label']}\n"
        f"Files changed: {pr['changed_files']}  +{pr['additions']}/-{pr['deletions']}\n"
        f"Body: {(pr.get('body') or '').strip()[:500]}\n"
    )

    # Fetch unified diff
    diff_req = urllib.request.Request(pr_url + ".diff", headers=_gh_headers())
    diff_req.add_header("Accept", "application/vnd.github.diff")
    with urllib.request.urlopen(diff_req) as resp:
        diff = resp.read().decode("utf-8", errors="replace")

    if len(diff) > MAX_DIFF_CHARS:
        diff = diff[:MAX_DIFF_CHARS] + f"\n\n[diff truncated at {MAX_DIFF_CHARS} characters]"

    return metadata, diff


def review(content: str) -> str:
    """Call Claude with the agent prompt and return the review."""
    client = anthropic.Anthropic()
    message = client.messages.create(
        model="claude-sonnet-4-5",
        max_tokens=1024,
        system=AGENT_PROMPT,
        messages=[{"role": "user", "content": content}],
    )
    return message.content[0].text


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Claude Code PR review agent",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--pr", metavar="URL", help="GitHub PR URL")
    group.add_argument("--diff", metavar="FILE", help="Path to a unified diff file")
    group.add_argument("--stdin", action="store_true", help="Read diff from stdin")
    args = parser.parse_args()

    if not os.environ.get("ANTHROPIC_API_KEY"):
        print("Error: ANTHROPIC_API_KEY environment variable not set.", file=sys.stderr)
        sys.exit(1)

    if args.pr:
        try:
            metadata, diff = fetch_pr_diff(args.pr)
        except (urllib.error.HTTPError, urllib.error.URLError, ValueError) as exc:
            print(f"Error fetching PR: {exc}", file=sys.stderr)
            sys.exit(1)
        content = f"{metadata}\n\n```diff\n{diff}\n```"
    elif args.diff:
        content = Path(args.diff).read_text()
    else:
        content = sys.stdin.read()
        if not content.strip():
            print("Error: no diff received on stdin.", file=sys.stderr)
            sys.exit(1)

    result = review(content)
    print(result)


if __name__ == "__main__":
    main()
