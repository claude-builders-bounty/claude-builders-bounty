{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Trigger (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({ days: 7 }).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, -100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $now.minus({ days: 7 }).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {},
        "combinationMode": "multiplex",
        "options": {}
      },
      "id": "merge-data",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all().filter(item => item.json.sha).map(item => ({\n  sha: item.json.sha?.substring(0, 7),\n  message: item.json.commit?.message?.split('\\n')[0],\n  author: item.json.commit?.author?.name\n}));\n\nconst issues = $input.all().filter(item => item.json.number && !item.json.pull_request).map(item => ({\n  number: item.json.number,\n  title: item.json.title\n}));\n\nconst prs = $input.all().filter(item => item.json.number && item.json.merged_at).map(item => ({\n  number: item.json.number,\n  title: item.json.title,\n  merged_at: item.json.merged_at\n}));\n\nconst lastWeekPrs = prs.filter(pr => {\n  const merged = new Date(pr.merged_at);\n  const weekAgo = new Date();\n  weekAgo.setDate(weekAgo.getDate() - 7);\n  return merged > weekAgo;\n});\n\nreturn [{\n  json: {\n    commits: commits.slice(0, 20),\n    issues: issues.slice(0, 20),\n    prs: lastWeekPrs.slice(0, 20),\n    stats: {\n      totalCommits: commits.length,\n      closedIssues: issues.length,\n      mergedPRs: lastWeekPrs.length\n    }\n  }\n}];"
      },
      "id": "process-data",
      "name": "Process GitHub Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a technical writer creating a weekly development summary for a software team. Write a narrative summary of this week's activity.\\n\\nLanguage: {{ $env.SUMMARY_LANGUAGE || 'EN' }}\\n\\nRepository: {{ $env.GITHUB_REPO }}\\n\\nStats:\\n- Commits: {{ $json.stats.totalCommits }}\\n- Closed Issues: {{ $json.stats.closedIssues }}\\n- Merged PRs: {{ $json.stats.mergedPRs }}\\n\\nRecent Commits:\\n{{ $json.commits.map(c => `- ${c.sha}: ${c.message} (${c.author})`).join('\\\\n') }}\\n\\nClosed Issues:\\n{{ $json.issues.map(i => `- #${i.number}: ${i.title}`).join('\\\\n') }}\\n\\nMerged PRs:\\n{{ $json.prs.map(p => `- #${p.number}: ${p.title}`).join('\\\\n') }}\\n\\nWrite a friendly, professional summary highlighting key achievements and notable changes. Keep it under 300 words. Format with markdown headings.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-summary",
      "name": "Generate Summary (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.content?.[0]?.text || 'Summary generation failed.';\n\nreturn [{\n  json: {\n    summary: content,\n    repo: $env.GITHUB_REPO,\n    generatedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [\n    {\n      \"title\": \"📊 Weekly Dev Summary: {{ $json.repo }}\",\n      \"description\": \"{{ $json.summary.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') }}\",\n      \"color\": 5814783,\n      \"footer\": {\n        \"text\": \"Generated {{ $json.generatedAt }}\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    }
  ],
  "connections": {
