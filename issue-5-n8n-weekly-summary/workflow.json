      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Friday 17:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        340
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-owner",
              "name": "githubOwner",
              "type": "string",
              "value": "={{ $env.GITHUB_OWNER || 'pallets' }}"
            },
            {
              "id": "cfg-repo",
              "name": "githubRepo",
              "type": "string",
              "value": "={{ $env.GITHUB_REPO || 'flask' }}"
            },
            {
              "id": "cfg-lang",
              "name": "language",
              "type": "string",
              "value": "={{ ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase() }}"
            },
            {
              "id": "cfg-model",
              "name": "claudeModel",
              "type": "string",
              "value": "={{ $env.CLAUDE_MODEL || 'claude-sonnet-4-20250514' }}"
            },
            {
              "id": "cfg-endpoint",
              "name": "claudeEndpoint",
              "type": "string",
              "value": "={{ $env.CLAUDE_ENDPOINT || 'https://api.anthropic.com/v1/messages' }}"
            },
            {
              "id": "cfg-webhook",
              "name": "discordWebhookUrl",
              "type": "string",
              "value": "={{ $env.DISCORD_WEBHOOK_URL || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const end = new Date();\nconst start = new Date(end.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst since = start.toISOString();\nconst until = end.toISOString();\nconst owner = $json.githubOwner;\nconst repo = $json.githubRepo;\nif (!['EN','FR'].includes($json.language)) throw new Error('SUMMARY_LANGUAGE must be EN or FR');\nreturn [{json:{...$json,since,until,commitsUrl:`https://api.github.com/repos/${owner}/${repo}/commits?since=${encodeURIComponent(since)}&until=${encodeURIComponent(until)}&per_page=100`,issuesUrl:`https://api.github.com/repos/${owner}/${repo}/issues?state=closed&since=${encodeURIComponent(since)}&per_page=100`,pullsUrl:`https://api.github.com/repos/${owner}/${repo}/pulls?state=closed&sort=updated&direction=desc&per_page=100`}}];"
      },
      "id": "10000000-0000-4000-8000-000000000004",
      "name": "Build 7 Day Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        260
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.commitsUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "avs-opire-n8n-bounty-verification"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "10000000-0000-4000-8000-000000000005",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        260
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Build 7 Day Window').first().json.issuesUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "avs-opire-n8n-bounty-verification"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "10000000-0000-4000-8000-000000000006",
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        260
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Build 7 Day Window').first().json.pullsUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "avs-opire-n8n-bounty-verification"
            }
