      "id": "10000000-0000-4000-8000-000000000007",
      "name": "GitHub Closed Pulls",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const flat = (name) => { const items = $items(name); if (items.length === 1 && Array.isArray(items[0].json)) return items[0].json; return items.map(i => i.json); };\nconst windowData = $('Build 7 Day Window').first().json;\nconst commits = flat('GitHub Commits');\nconst issueRows = flat('GitHub Closed Issues');\nconst pullRows = flat('GitHub Closed Pulls');\nconst issues = issueRows.filter(x => !x.pull_request && x.closed_at && x.closed_at >= windowData.since && x.closed_at <= windowData.until);\nconst pulls = pullRows.filter(x => x.merged_at && x.merged_at >= windowData.since && x.merged_at <= windowData.until);\nconst compactCommit = x => ({sha:(x.sha||'').slice(0,12),title:(x.commit?.message||'').split('\\n')[0],author:x.author?.login||x.commit?.author?.name||null,url:x.html_url||null,date:x.commit?.author?.date||null});\nconst compactIssue = x => ({number:x.number,title:x.title,user:x.user?.login||null,url:x.html_url||null,closedAt:x.closed_at||null});\nconst compactPull = x => ({number:x.number,title:x.title,user:x.user?.login||null,url:x.html_url||null,mergedAt:x.merged_at||null});\nconst activity={repository:`${windowData.githubOwner}/${windowData.githubRepo}`,period:{since:windowData.since,until:windowData.until},commits:commits.map(compactCommit),closedIssues:issues.map(compactIssue),mergedPullRequests:pulls.map(compactPull)};\nconst language=windowData.language==='FR'?'French':'English';\nconst prompt=`Write a concise weekly engineering narrative for ${activity.repository} in ${language}. Use only the supplied activity data. Cover notable commits, closed issues and merged pull requests, mention contributors when available, and do not invent facts. Start with a short heading, then 3-6 bullets and a one-sentence outlook.\\n\\nActivity data:\\n${JSON.stringify(activity,null,2)}`;\nreturn [{json:{requestBody:{model:windowData.claudeModel,max_tokens:1200,messages:[{role:'user',content:prompt}]},counts:{commits:commits.length,closedIssues:issues.length,mergedPullRequests:pulls.length},repository:activity.repository,period:activity.period}}];"
      },
      "id": "10000000-0000-4000-8000-000000000008",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.claudeEndpoint }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "10000000-0000-4000-8000-000000000009",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2060,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const text=Array.isArray($json.content)?$json.content.map(p=>p?.text||'').filter(Boolean).join('\\n').trim():'';\nif(!text) throw new Error('Claude response contained no text');\nconst webhook=$('Configuration').first().json.discordWebhookUrl;\nif(!webhook) throw new Error('DISCORD_WEBHOOK_URL is required');\nconst counts=$('Build Claude Request').first().json.counts;\nconst prefix=`Weekly summary — ${$('Build Claude Request').first().json.repository}\\n`;\nconst combined=prefix+text;\nconst max=1900; const chunks=[];\nfor(let i=0;i<combined.length;i+=max) chunks.push(combined.slice(i,i+max));\nreturn chunks.map((content,index)=>({json:{webhookUrl:webhook,content,part:index+1,total:chunks.length,counts}}));"
      },
      "id": "10000000-0000-4000-8000-000000000010",
      "name": "Format Discord Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhookUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({content:$json.content}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "10000000-0000-4000-8000-000000000011",
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2580,
        260
      ]
    }
