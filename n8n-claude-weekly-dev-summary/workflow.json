      "id": "7934b65a-cb30-449d-83ee-64b31abe195a",
      "name": "Merge All Activity",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        220,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const window = $('Build Weekly Window').first().json;\nconst commits = $json.commits || [];\nconst issues = $json.issues || [];\nconst pullRequests = $json.pullRequests || [];\nconst languageName = window.summaryLanguage === 'FR' ? 'French' : 'English';\nconst activity = {\n  repository: window.githubRepository,\n  period: { since: window.since, until: window.until },\n  commits,\n  closedIssues: issues,\n  mergedPullRequests: pullRequests,\n};\n\nconst prompt = [\n  `Write a concise weekly development narrative in ${languageName} for ${window.githubRepository}.`,\n  'Use only the supplied GitHub data. Do not invent motivations, outcomes, or future plans.',\n  'Open with a one-paragraph overview, then add sections for highlights, resolved work, merged changes, and a short metrics line.',\n  'Mention important contributors and link notable items when URLs are available. If a category is empty, say so briefly.',\n  '',\n  'GitHub activity JSON:',\n  JSON.stringify(activity, null, 2),\n].join('\\n');\n\nreturn [{\n  json: {\n    prompt,\n    repository: window.githubRepository,\n    language: window.summaryLanguage,\n    destinationChannel: window.destinationChannel,\n    since: window.since,\n    until: window.until,\n    metrics: {\n      commits: commits.length,\n      closedIssues: issues.length,\n      mergedPullRequests: pullRequests.length,\n    },\n  },\n}];"
      },
      "id": "a8620bc2-4bb7-44f0-9f02-43df765360e6",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1400, temperature: 0.2, system: 'You turn weekly engineering activity into an accurate, readable narrative for a development team.', messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c4f78843-3e16-43ed-a192-9cc62df4db9d",
      "name": "Generate Narrative with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst source = $('Build Claude Prompt').first().json;\nconst summary = (response.content || [])\n  .filter((block) => block.type === 'text')\n  .map((block) => block.text)\n  .join('\\n\\n')\n  .trim();\n\nif (!summary) {\n  throw new Error('Claude returned no text content. Inspect the API response in the previous node.');\n}\n\nreturn [{\n  json: {\n    ...source,\n    summary,\n    claudeMessageId: response.id,\n  },\n}];"
      },
      "id": "91b85afe-9c0f-4749-93cd-7a125146f6de",
      "name": "Extract Claude Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
