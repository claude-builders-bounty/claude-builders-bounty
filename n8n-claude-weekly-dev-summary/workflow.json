      "id": "9fc6ec3a-e6c2-4e09-97c4-99146c7f267e",
      "name": "Fetch Closed Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().flatMap(({ json }) => Array.isArray(json.body) ? json.body : []);\nconst commits = rows\n  .filter((commit) => commit.sha && commit.commit)\n  .map((commit) => ({\n    sha: commit.sha.slice(0, 7),\n    author: commit.author?.login || commit.commit?.author?.name || 'Unknown',\n    committedAt: commit.commit?.author?.date || commit.commit?.committer?.date,\n    message: (commit.commit?.message || '').split('\\n')[0].slice(0, 300),\n    url: commit.html_url,\n  }));\n\nreturn [{ json: { commits } }];"
      },
      "id": "eef54fe7-4771-4821-80fa-838252141af5",
      "name": "Collect Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const { since, until } = $('Build Weekly Window').first().json;\nconst sinceMs = new Date(since).getTime();\nconst untilMs = new Date(until).getTime();\nconst inWindow = (value) => {\n  const time = new Date(value).getTime();\n  return Number.isFinite(time) && time >= sinceMs && time <= untilMs;\n};\n\nconst rows = $input.all().flatMap(({ json }) => Array.isArray(json.body) ? json.body : []);\nconst issues = rows\n  .filter((issue) => !issue.pull_request && inWindow(issue.closed_at))\n  .map((issue) => ({\n    number: issue.number,\n    title: issue.title,\n    author: issue.user?.login || 'Unknown',\n    closedAt: issue.closed_at,\n    labels: (issue.labels || []).map((label) => label.name),\n    url: issue.html_url,\n  }));\n\nreturn [{ json: { issues } }];"
      },
      "id": "1a1afbbb-ec19-42b4-a622-dbeb1d447115",
      "name": "Collect Closed Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const { since, until } = $('Build Weekly Window').first().json;\nconst sinceMs = new Date(since).getTime();\nconst untilMs = new Date(until).getTime();\nconst inWindow = (value) => {\n  const time = new Date(value).getTime();\n  return Number.isFinite(time) && time >= sinceMs && time <= untilMs;\n};\n\nconst rows = $input.all().flatMap(({ json }) => Array.isArray(json.body) ? json.body : []);\nconst pullRequests = rows\n  .filter((pull) => pull.merged_at && inWindow(pull.merged_at))\n  .map((pull) => ({\n    number: pull.number,\n    title: pull.title,\n    author: pull.user?.login || 'Unknown',\n    mergedAt: pull.merged_at,\n    base: pull.base?.ref,\n    head: pull.head?.ref,\n    url: pull.html_url,\n  }));\n\nreturn [{ json: { pullRequests } }];"
      },
