        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ 'https://api.github.com/repos/' + $json.githubRepository + '/pulls' }}",
        "sendQuery": true,
        "queryParameters": {
