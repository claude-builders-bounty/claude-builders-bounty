        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.destinationChannel, text: '*Weekly development summary — ' + $json.repository + '*\\n_' + $json.since + ' to ' + $json.until + '_\\n\\n' + $json.summary + '\\n\\n*Metrics:* ' + $json.metrics.commits + ' commits · ' + $json.metrics.closedIssues + ' issues closed · ' + $json.metrics.mergedPullRequests + ' PRs merged' }) }}",
        "options": {
          "timeout": 60000
        }
      },
