      "id": "2ad42856-c8e8-49c9-8a88-a3cc61a53b41",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -960,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $input.first().json;\n\nif (!/^[^/\\s]+\\/[^/\\s]+$/.test(config.githubRepository) || config.githubRepository === 'owner/repository') {\n  throw new Error('Set githubRepository to owner/repository in the Configuration node before running the workflow.');\n}\nif (!/^https:\\/\\//.test(config.webhookUrl) || config.webhookUrl.includes('REPLACE/ME')) {\n  throw new Error('Set webhookUrl to a real Slack incoming-webhook URL in the Configuration node.');\n}\n\nconst language = config.summaryLanguage === 'FR' ? 'FR' : 'EN';\nconst until = new Date();\nconst since = new Date(until.getTime() - (7 * 24 * 60 * 60 * 1000));\n\nreturn [{\n  json: {\n    ...config,\n    summaryLanguage: language,\n    since: since.toISOString(),\n    until: until.toISOString(),\n  },\n}];"
      },
