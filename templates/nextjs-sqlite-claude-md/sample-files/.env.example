# Local SQLite (default)
DATABASE_URL=file:./dev.db

# Turso / libsql (uncomment to use; takes precedence over DATABASE_URL)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# NextAuth.js v5
AUTH_SECRET=          # generate via: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Stripe (only if billing is in scope)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Resend, Postmark, etc. — adjust naming as needed)
RESEND_API_KEY=
EMAIL_FROM="App <hello@example.com>"
