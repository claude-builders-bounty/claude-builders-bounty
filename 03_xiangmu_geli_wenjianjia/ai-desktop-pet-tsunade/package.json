{
  "name": "ai-desktop-pet-tsunade",
  "productName": "AI桌宠·纲手",
  "version": "1.0.0",
  "description": "基于 Electron + React + TypeScript 的 AI 桌宠应用，角色形象为《火影忍者》纲手。支持 Live2D 动画、多模型 LLM 接入、系统监控、定时提醒、数据持久化。",
  "author": "Tsunade Pet Team",
  "license": "MIT",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.json && vite build && electron-builder",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "preview": "vite preview",
    "rebuild": "electron-rebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.453.0",
    "openai": "^4.67.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.9.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
