{
  "name": "Weekly GitHub Repo Narrative Summary (Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "cronExpression": "0 17 * * 5"
            }
          ]
        },
        "workflowOutput": [
          {
            "name": "summary",
            "type": "string"
          }
        ],
        "options": {}
      },
      "id": "weekly-cron",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "listCommits",
        "repository": "={{ $json.githubRepo }}",
        "since": "={{ $now.subtract(7, 'days').toISOString() }}",
        "until": "={{ $now.toISOString() }}",
        "perPage": 100
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [540, 300],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "operation": "list",
        "repository": "={{ $json.githubRepo }}",
        "state": "closed",
        "sort": "updated",
        "direction": "desc",
        "since": "={{ $now.subtract(7, 'days').toISOString() }}",
        "perPage": 100
      },
      "id": "fetch-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [540, 440],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "operation": "list",
        "repository": "={{ $json.githubRepo }}",
        "state": "closed",
        "sort": "updated",
        "direction": "desc",
        "since": "={{ $now.subtract(7, 'days').toISOString() }}",
        "perPage": 100
      },
      "id": "fetch-merged-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [540, 580],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "operation": "execute",
        "model": "claude-sonnet-4-20250514",
        "systemMessage": "You are a senior engineering lead writing a weekly narrative summary of a GitHub repository's activity. Inputs: commits, closed issues, merged PRs for the past week. Output: a structured narrative summary in Markdown with (1) an executive summary (2-3 sentences), (2) key commits & features shipped, (3) notable closed issues, (4) merged PRs and their impact, (5) risks or blockers if any. Keep it concise, professional, and audience-aware. Respond in the requested language.",
        "userMessage": "GitHub repo: {{ $json.githubRepo }}\nLanguage: {{ $json.language }}\n\nCommits this week:\n{{ $json.commitsJson }}\n\nClosed issues this week:\n{{ $json.issuesJson }}\n\nMerged PRs this week:\n{{ $json.prsJson }}\n\nPlease write a weekly narrative summary of this repo's activity in {{ $json.language }}.",
        "options": {}
      },
      "id": "claude-summary",
      "name": "Generate Narrative Summary (Claude)",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [840, 440],
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "resource": "discordMessage",
        "channelId": "={{ $json.discordChannelId }}",
        "text": "={{ $json.summary }}"
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1140, 300],
      "credentials": {
        "discordApi": {
          "id": "DISCORD_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "subject": "Weekly repo summary: {{ $json.githubRepo }}",
        "html": "={{ $json.summary }}",
        "to": "={{ $json.emailTo }}"
      },
      "id": "send-email",
      "name": "Send by Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1140, 440],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "slackOperation": "post",
        "channel": "={{ $json.slackChannel }}",
        "text": "={{ $json.summary }}"
      },
      "id": "send-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1140, 580],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID"
        }
      }
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Generate Narrative Summary (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Narrative Summary (Claude)": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send by Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1.0.0",
  "meta": {
    "instanceId": "n8n-weekly-summary",
    "templated": true
  },
  "id": "weekly-github-summary-workflow"
}
