{
  "name": "Weekly GitHub Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repository }}/commits?since={{ $json.since }}&until={{ $json.until }}",
        "options": {}
      },
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repository }}/issues?state=closed&since={{ $json.since }}",
        "options": {}
      },
      "name": "Fetch Issues",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 460]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repository }}/pulls?state=closed&sort=updated&direction=desc&per_page=50",
        "options": {}
      },
      "name": "Fetch PRs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 620]
    },
    {
      "parameters": {
        "text": "=Summarize this week's GitHub activity for {{ $json.repository }}:\n\nCommits: {{ $json.commits }}\nClosed Issues: {{ $json.issues }}\nMerged PRs: {{ $json.prs }}\n\nGenerate a narrative summary highlighting key changes, improvements, and community contributions.",
        "model": "claude-sonnet-4-20250514",
        "options": {}
      },
      "name": "Claude Summary",
      "type": "n8n-nodes-base.claude",
      "position": [700, 300]
    },
    {
      "parameters": {
        "channel": "{{ $json.channel }}",
        "text": "=📊 **Weekly Summary: {{ $json.repository }}**\n\n{{ $json.summary }}",
        "otherOptions": {}
      },
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "position": [920, 300]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          { "node": "Fetch Commits", "type": "main", "index": 0 },
          { "node": "Fetch Issues", "type": "main", "index": 0 },
          { "node": "Fetch PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [{ "node": "Claude Summary", "type": "main", "index": 0 }]
      ]
    },
    "Claude Summary": {
      "main": [
        [{ "node": "Send to Discord", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
