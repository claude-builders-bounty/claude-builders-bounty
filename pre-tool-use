#!/bin/bash
# pre-tool-use hook for Claude Code
TOOL_NAME=$1
ARGS=$(cat)
ARGS_UPPER=$(echo "$ARGS" | tr '[:lower:]' '[:upper:]')

LOG_FILE="$HOME/.claude/hooks/blocked.log"
mkdir -p "$(dirname "$LOG_FILE")"

function block() {
    local reason=$1
    echo "[$(date -Iseconds)] Blocked: $reason | Path: $(pwd) | Command: $ARGS" >> "$LOG_FILE"
    echo "BLOCKED BY SECURITY HOOK: $reason. This action is destructive and forbidden."
    exit 1
}

if echo "$ARGS_UPPER" | grep -q "RM -RF"; then block "rm -rf detected"; fi
if echo "$ARGS_UPPER" | grep -q "DROP TABLE"; then block "DROP TABLE detected"; fi
if echo "$ARGS_UPPER" | grep -q "GIT PUSH --FORCE"; then block "git push --force detected"; fi
if echo "$ARGS_UPPER" | grep -q "TRUNCATE"; then block "TRUNCATE detected"; fi
if echo "$ARGS_UPPER" | grep -q "DELETE FROM"; then
    if ! echo "$ARGS_UPPER" | grep -q "WHERE"; then
        block "DELETE FROM without WHERE detected"
    fi
fi
exit 0
