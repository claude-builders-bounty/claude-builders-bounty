#!/usr/bin/env bash
# pre-tool-use hook for Claude Code
# Blocks destructive bash commands before execution.
# Install: cp pre-tool-use ~/.claude/hooks/ && chmod +x ~/.claude/hooks/pre-tool-use
set -euo pipefail

LOG_FILE="${CLAUDE_HOOKS_LOG:-$HOME/.claude/hooks/blocked.log}"
COMMAND="${CLAUDE_TOOL_INPUT:-}"

# If no command was passed (empty invocation), allow
if [ -z "$COMMAND" ]; then
  exit 0
fi

# Normalize: collapse whitespace, lowercase for matching
NORMALIZED=$(echo "$COMMAND" | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

block() {
  local reason="$1"
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] BLOCKED | project=$(pwd) | cmd=${COMMAND} | reason=${reason}" >> "$LOG_FILE"
  echo ""
  echo "  ⛔ Command BLOCKED by pre-tool-use hook"
  echo "  ─────────────────────────────────────────"
  echo "  Reason: $reason"
  echo ""
  echo "  If you intended to run this command, use your terminal directly"
  echo "  or temporarily disable this hook with: mv ~/.claude/hooks/pre-tool-use ~/.claude/hooks/pre-tool-use.disabled"
  echo ""
  exit 1
}

# Pattern matching (case-insensitive)
LC_ALL=C

# 1. rm -rf / or rm -rf /* (destructive recursive delete)
if echo "$NORMALIZED" | grep -qiE '^rm[[:space:]]+-rf([[:space:]]+/|.*[[:space:]]+/[[:space:]]*$)'; then
  block "Recursive delete of root filesystem is prohibited"
fi

# 2. rm -rf on critical system paths
if echo "$NORMALIZED" | grep -qiE '(^|[[:space:]])rm[[:space:]]+-rf[[:space:]]+(/etc|/var|/usr|/bin|/lib|/boot|/dev)[[:space:]/>]'; then
  block "Recursive delete of system directory is prohibited"
fi

# 3. DROP TABLE / DROP DATABASE
if echo "$NORMALIZED" | grep -qiE '^[[:space:]]*DROP[[:space:]]+(TABLE|DATABASE)'; then
  block "DROP TABLE/DATABASE statements are prohibited via Claude"
fi

# 4. git push --force or git push -f
if echo "$NORMALIZED" | grep -qiE '^[[:space:]]*git[[:space:]]+push[[:space:]]+(--force|-f)\b'; then
  block "Force push is prohibited — use git push --force-with-lease instead"
fi

# 5. TRUNCATE TABLE
if echo "$NORMALIZED" | grep -qiE '^[[:space:]]*TRUNCATE[[:space:]]+TABLE'; then
  block "TRUNCATE TABLE is prohibited via Claude"
fi

# 6. DELETE FROM without WHERE
if echo "$NORMALIZED" | grep -qiE '^[[:space:]]*DELETE[[:space:]]+FROM'; then
  # Check if the command contains WHERE (allowing multi-line)
  if ! echo "$COMMAND" | grep -qi '\bWHERE\b'; then
    block "DELETE FROM without a WHERE clause is prohibited"
  fi
fi

# Allow all other commands
exit 0
