#!/usr/bin/env python3
"""
pre-tool-use hook: Blocks destructive bash commands.
Bounty: $100 - claude-builders-bounty
Install: cp this file to ~/.claude/hooks/pre-tool-use
"""

import os
import re
import time
from pathlib import Path

BLOCKED_PATTERNS = [
    r"rm\s+-rf",
    r"DROP\s+TABLE",
    r"git\s+push\s+--force",
    r"TRUNCATE",
    r"DELETE\s+FROM(?!.*WHERE)",
]

HOOK_LOG = Path.home() / ".claude" / "hooks" / "blocked.log"

def check_command(command: str) -> dict:
    """Check if a command matches any blocked pattern."""
    for pattern in BLOCKED_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return {
                "blocked": True,
                "pattern": pattern,
                "command": command,
                "reason": f"Command matches blocked pattern: {pattern}"
            }
    return {"blocked": False}

def log_blocked(attempt: dict):
    """Log blocked command attempt."""
    HOOK_LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(HOOK_LOG, "a", encoding="utf-8") as f:
        f.write(
            f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] "
            f"BLOCKED: {attempt['command']} "
            f"(pattern: {attempt['pattern']}) "
            f"[project: {os.getcwd()}]
"
        )

def main():
    import sys
    if len(sys.argv) < 2:
        print("Usage: pre-tool-use <command>")
        sys.exit(1)
    
    command = " ".join(sys.argv[1:])
    result = check_command(command)
    
    if result["blocked"]:
        log_blocked(result)
        print(
            f"\n\u26a0\ufe0f BLOCKED: Destructive command detected\n"
            f"Command: {command}\n"
            f"Reason: {result['reason']}\n"
            f"\n"
            f"This command was blocked for safety.\n"
            f"If you need to run it, use a more specific version\n"
            f"or manually execute it outside of Claude Code.\n"
            f"\n"
            f"Logged to: {HOOK_LOG}\n"
        )
        sys.exit(1)
    
    print(f"\u2705 Command allowed: {command}")

if __name__ == "__main__":
    main()
