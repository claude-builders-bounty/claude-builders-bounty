#!/usr/bin/env python3
import sys
import json
import os
from datetime import datetime

DANGEROUS_PATTERNS = [
    "rm -rf",
    "DROP TABLE",
    "git push --force",
    "TRUNCATE",
]

def check_delete_from(command):
    upper = command.upper()
    if "DELETE FROM" in upper:
        if "WHERE" not in upper:
            return True
    return False

def main():
    try:
        data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)

    tool_name = data.get("tool_name", "")
    if tool_name not in ("Bash", "bash"):
        json.dump({}, sys.stdout)
        sys.exit(0)

    command = data.get("input", {}).get("command", "")
    if not command:
        json.dump({}, sys.stdout)
        sys.exit(0)

    command_upper = command.upper()
    blocked = False
    reason = ""

    for pattern in DANGEROUS_PATTERNS:
        if pattern.upper() in command_upper:
            blocked = True
            reason = f"Pattern '{pattern}' detected"
            break

    if not blocked and check_delete_from(command):
        blocked = True
        reason = "DELETE FROM without WHERE clause detected"

    if blocked:
        timestamp = datetime.now().isoformat()
        project_path = data.get("input", {}).get("cwd", os.getcwd())
        log_line = f"{timestamp} | {command} | {project_path}\n"
        log_path = os.path.expanduser("~/.claude/hooks/blocked.log")
        try:
            with open(log_path, "a") as f:
                f.write(log_line)
        except Exception:
            pass

        error_msg = f"Dangerous command blocked: {reason}. Command was: {command}"
        result = {"is_error": True, "error_message": error_msg}
        json.dump(result, sys.stdout)
        sys.exit(0)

    json.dump({}, sys.stdout)

if __name__ == "__main__":
    main()
