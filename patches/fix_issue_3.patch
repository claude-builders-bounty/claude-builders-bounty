```diff
diff --git a/.claude/hooks/pre-tool-use.sh b/.claude/hooks/pre-tool-use.sh
new file mode 100755
index 0000000..e69de29
--- /dev/null
+++ b/.claude/hooks/pre-tool-use.sh
@@ -0,0 +1,62 @@
+#!/bin/bash
+
+BLOCKED_COMMANDS=(
+    "rm -rf"
+    "DROP TABLE"
+    "git push --force"
+    "TRUNCATE"
+    "DELETE FROM"
+)
+
+LOG_FILE="$HOME/.claude/hooks/blocked.log"
+PROJECT_PATH=$(pwd)
+
+attempted_command="$1"
+
+for blocked_command in "${BLOCKED_COMMANDS[@]}"; do
+    if [[ "$attempted_command" == *"$blocked_command"* ]]; then
+        timestamp=$(date +"%Y-%m-%d %H:%M:%S")
+        echo "$timestamp - Attempted command: '$attempted_command' - Project path: '$PROJECT_PATH'" >> "$LOG_FILE"
+        echo "Command blocked: '$attempted_command'"
+        echo "Reason: This command is destructive and may cause irreversible damage."
+        exit 1
+    fi
+done
+
+exit 0
```