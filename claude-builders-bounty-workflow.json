{
  "name": "GitHub Weekly Activity Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "expression": "={\n  owner: $env.GITHUB_OWNER || 'anthropics',\n  repo: $env.GITHUB_REPO || 'claude-code',\n  days: 7,\n  language: $env.LANGUAGE || 'en'\n}"
      },
      "id": "Config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [250, 100]
    },
    {
      "parameters": {
        "rule": "=($now - 7 * 24 * 60 * 60 * 1000)"
      },
      "id": "Cron",
      "name": "Weekly Trigger (Friday 5pm)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [50, 100],
      "cronExpression": "0 17 * * 5"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=`https://api.github.com/repos/${$nodeExecutionData[0].json.owner}/${$nodeExecutionData[0].json.repo}/commits?since=${new Date(Date.now() - 7*24*60*60*1000).toISOString()}&per_page=100`",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "Fetch Commits",
      "name": "Fetch Commits (Last 7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 50]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=`https://api.github.com/repos/${$nodeExecutionData[0].json.owner}/${$nodeExecutionData[0].json.repo}/issues?state=closed&since=${new Date(Date.now() - 7*24*60*60*1000).toISOString()}&per_page=100`",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "Fetch Issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 150]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=`https://api.github.com/repos/${$nodeExecutionData[0].json.owner}/${$nodeExecutionData[0].json.repo}/pulls?state=closed&base=main&since=${new Date(Date.now() - 7*24*60*60*1000).toISOString()}&per_page=100`",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "Fetch PRs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 250]
    },
    {
      "parameters": {
        "jsonOutput": "={\n  commits: $nodeExecutionData[0]?.json || [],\n  issues: $nodeExecutionData[1]?.json || [],\n  prs: $nodeExecutionData[2]?.json || [],\n  owner: $nodeExecutionData[0].json.owner,\n  repo: $nodeExecutionData[0].json.repo,\n  language: $nodeExecutionData[0].json.language\n}"
      },
      "id": "Consolidate Data",
      "name": "Consolidate GitHub Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [700, 150]
    },
    {
      "parameters": {
        "messages": "=[\n  {\n    role: 'user',\n    content: $nodeExecutionData[1].json.language === 'en' ?\n      `Summarize this GitHub activity for the week of ${new Date(Date.now() - 7*24*60*60*1000).toDateString()} for repo ${$nodeExecutionData[1].json.owner}/${$nodeExecutionData[1].json.repo}. Include highlights of merged PRs, closed issues, and recent commits. Keep it narrative and engaging. Limit to 500 words. Use GitHub markdown formatting (##, -, **bold**).\n\nMerged PRs (${$nodeExecutionData[1].json.prs.length}):\n${$nodeExecutionData[1].json.prs.slice(0,20).map(pr => `- #${pr.number}: ${pr.title}`).join('\\n')}\n\nClosed Issues (${$nodeExecutionData[1].json.issues.length}):\n${$nodeExecutionData[1].json.issues.slice(0,20).map(i => `- #${i.number}: ${i.title}`).join('\\n')}\n\nRecent Commits (${$nodeExecutionData[1].json.commits.length}):\n${$nodeExecutionData[1].json.commits.slice(0,20).map(c => `- ${c.commit.message.split('\\n')[0]} by ${c.commit.author.name}`).join('\\n')}`\n      :\n      `Résumez cette activité GitHub pour la semaine du ${new Date(Date.now() - 7*24*60*60*1000).toDateString()} pour le repo ${$nodeExecutionData[1].json.owner}/${$nodeExecutionData[1].json.repo}. Incluez les points forts des PR fusionnées, des issues fermées et des commits récents. Gardez un ton narratif et engageant. Limitez à 500 mots. Utilisez la mise en forme Markdown GitHub (##, -, **gras**).\n\nPR fusionnées (${$nodeExecutionData[1].json.prs.length}):\n${$nodeExecutionData[1].json.prs.slice(0,20).map(pr => `- #${pr.number}: ${pr.title}`).join('\\n')}\n\nIssues fermées (${$nodeExecutionData[1].json.issues.length}):\n${$nodeExecutionData[1].json.issues.slice(0,20).map(i => `- #${i.number}: ${i.title}`).join('\\n')}\n\nCommits récents (${$nodeExecutionData[1].json.commits.length}):\n${$nodeExecutionData[1].json.commits.slice(0,20).map(c => `- ${c.commit.message.split('\\n')[0]} par ${c.commit.author.name}`).join('\\n')}`\n  }\n]",
        "model": "claude-sonnet-4-20250514",
        "options": {}
      },
      "id": "Claude Summary",
      "name": "Generate Claude Summary",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "credentials": {
        "anthropicApi": "AnthropicApi"
      },
      "position": [950, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=`https://discordapp.com/api/webhooks/${$env.DISCORD_WEBHOOK_ID}/${$env.DISCORD_WEBHOOK_TOKEN}`",
        "bodyParametersJson": "={\n  \"content\": `📊 **Weekly GitHub Summary: ${$nodeExecutionData[1].json.owner}/${$nodeExecutionData[1].json.repo}**\\n\\n${$nodeExecutionData[2].json.choices[0].message.content}\\n\\n*Generated by Claude + n8n*`\n}",
        "options": {}
      },
      "id": "Discord Webhook",
      "name": "Send to Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=`https://api.resend.com/emails`",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "resendApi",
        "bodyParametersJson": "={\n  \"from\": \"bot@example.com\",\n  \"to\": $env.EMAIL_RECIPIENT || 'your-email@example.com',\n  \"subject\": `Weekly Summary: ${$nodeExecutionData[1].json.owner}/${$nodeExecutionData[1].json.repo}`,\n  \"html\": `<h2>Weekly GitHub Summary</h2><p>${$nodeExecutionData[2].json.choices[0].message.content.replace(/\\n/g, '<br>')}</p><p><em>Generated by Claude + n8n</em></p>`\n}",
        "options": {}
      },
      "id": "Email via Resend",
      "name": "Send Email (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 250]
    },
    {
      "parameters": {
        "conditions": {
          "nodeVersion": 2,
          "conditions": [
            {
              "id": "1",
              "displayName": "Send to Discord",
              "condition": {
                "left": "=$env.DELIVERY_METHOD",
                "operator": "equals",
                "right": "discord"
              }
            },
            {
              "id": "2",
              "displayName": "Send Email",
              "condition": {
                "left": "=$env.DELIVERY_METHOD",
                "operator": "equals",
                "right": "email"
              }
            }
          ]
        }
      },
      "id": "Delivery Method Switch",
      "name": "Choose Delivery Method",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 250]
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Consolidate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Issues": {
      "main": [
        [
          {
            "node": "Consolidate Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Fetch PRs": {
      "main": [
        [
          {
            "node": "Consolidate Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Consolidate Data": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Delivery Method Switch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivery Method Switch": {
      "main": [
        [
          {
            "node": "Discord Webhook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email via Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "UTC",
    "saveExecutionProgress": true,
    "errorHandler": "minimal"
  },
  "staticData": null,
  "pinData": {}
}
