#!/usr/bin/env python3
"""
Claude Code Pre-Tool-Use Hook — Block Destructive Bash Commands

Intercepts bash commands before execution and blocks dangerous patterns:
  - rm -rf (recursive force deletion)
  - DROP TABLE / DROP DATABASE
  - git push --force / --force-with-lease
  - TRUNCATE TABLE
  - DELETE FROM without WHERE clause
  - :(){ :|:& };: (fork bomb)
  - chmod 777 on system paths
  - mkfs.* (formatting)
  - dd if=... of=/dev/...

Compliant with Claude Code hooks protocol:
https://docs.anthropic.com/claude-code/hooks
"""

import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


# --- Configuration ---
HOOKS_DIR = Path.home() / ".claude" / "hooks"
LOG_FILE = HOOKS_DIR / "blocked.log"

# Patterns to block: (regex, short description)
BLOCKED_PATTERNS = [
    # File system destruction
    (r'\brm\s+.*-rf?\b.*[/~]', "rm -rf on system/home path"),
    (r'\brm\s+.*-rf?\b', "rm -rf (recursive force deletion)"),
    (r'\brm\s+.*--no-preserve-root\b', "rm --no-preserve-root"),

    # SQL destruction
    (r'(?i)\bDROP\s+(TABLE|DATABASE|SCHEMA)\b', "DROP TABLE/DATABASE/SCHEMA"),
    (r'(?i)\bTRUNCATE\s+(TABLE\s+)?', "TRUNCATE TABLE"),
    (r'(?i)\bDELETE\s+FROM\b(?![\s\S]*\bWHERE\b)', "DELETE FROM without WHERE clause"),

    # Force push
    (r'\bgit\s+push\b.*(--force|--force-with-lease|-f)\b', "git push --force"),

    # Fork bomb
    (r':\(\)\s*\{[^}]*:\|:&[^}]*\};:', "fork bomb"),

    # Formatting / disk write
    (r'\bmkfs\.', "filesystem formatting (mkfs)"),
    (r'\bdd\s+if=.*of=/dev/', "dd write to block device"),

    # Dangerous chmod
    (r'\bchmod\s+.*777\b.*(/bin|/etc|/usr|/var|/opt|/sbin)', "chmod 777 on system path"),
    (r'\bchmod\s+-R\s+777\b', "chmod -R 777"),
]


def get_project_path(working_dir: str = "") -> str:
    """Get current project path from working directory or environment."""
    if working_dir:
        return working_dir
    return os.getcwd()


def log_blocked(command: str, pattern: str, project_path: str) -> None:
    """Log a blocked command attempt to blocked.log."""
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)
    entry = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "command": command,
        "pattern": pattern,
        "project_path": project_path,
    }
    with open(LOG_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")


def check_command(command: str) -> tuple[bool, str]:
    """
    Check if a command matches any blocked pattern.
    Returns (is_blocked, reason).
    """
    for pattern, description in BLOCKED_PATTERNS:
        if re.search(pattern, command):
            return True, description
    return False, ""


def main():
    try:
        input_data = json.loads(sys.stdin.read())
    except (json.JSONDecodeError, EOFError):
        # If called without stdin, check args
        if len(sys.argv) > 1:
            command = " ".join(sys.argv[1:])
        else:
            print(json.dumps({"continue": True}))
            return

        blocked, reason = check_command(command)
        if blocked:
            print(json.dumps({
                "continue": False,
                "reason": f"Blocked destructive command: {reason}. Pattern matched in: {command[:80]}"
            }))
        else:
            print(json.dumps({"continue": True}))
        return

    # Claude Code hooks protocol: input has tool_name, tool_input, etc.
    tool_name = input_data.get("tool_name", "")
    tool_input = input_data.get("tool_input", {})

    # Only intercept bash/shell commands
    if tool_name not in ("bash", "shell", "Bash", "Shell", "execute_command"):
        print(json.dumps({"continue": True}))
        return

    # Extract the command string from various possible formats
    command = ""
    if isinstance(tool_input, str):
        command = tool_input
    elif isinstance(tool_input, dict):
        command = tool_input.get("command", "") or tool_input.get("cmd", "") or tool_input.get("script", "")
        if not command:
            command = json.dumps(tool_input)

    if not command or not isinstance(command, str):
        print(json.dumps({"continue": True}))
        return

    project_path = get_project_path(input_data.get("cwd", ""))

    blocked, reason = check_command(command)

    if blocked:
        log_blocked(command, reason, project_path)

        print(json.dumps({
            "continue": False,
            "reason": (
                f"🛡️ BLOCKED: Destructive command detected — {reason}\n"
                f"   Command: {command[:120]}\n"
                f"   This attempt has been logged to {LOG_FILE}\n"
                f"   If you are certain this is safe, please review and modify the command."
            )
        }))
    else:
        print(json.dumps({"continue": True}))


if __name__ == "__main__":
    main()
