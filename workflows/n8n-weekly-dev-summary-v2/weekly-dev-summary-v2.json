    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$vars.GITHUB_OWNER}}/{{$vars.GITHUB_REPO}}/pulls"
      },
      "id": "github-prs-headers",
      "name": "GitHub PRs Headers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200],
      "parameters": {
        "url": "https://api.github.com/repos/{{$vars.GITHUB_OWNER}}/{{$vars.GITHUB_REPO}}/pulls",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "merged",
              "value": "true"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            }
          ]
        },
        "options": {
          "retry": {
            "maxRetries": 3,
            "retryWaitMax": 5000
          }
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter data from GitHub API responses and format for Claude\nconst commits = $input.first()?.json || [];\nconst issues = $('GitHub Issues Headers').first()?.json || [];\nconst pulls = $('GitHub PRs Headers').first()?.json || [];\n\n// Filter commits from the past week\nconst oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst recentCommits = commits.filter(c => new Date(c.commit.author.date) >= oneWeekAgo);\n\n// Filter closed issues from the past week\nconst recentIssues = issues.filter(i => {\n  if (!i.closed_at) return false;\n  return new Date(i.closed_at) >= oneWeekAgo;\n});\n\n// Filter merged PRs from the past week\nconst mergedPRs = pulls.filter(pr => {\n  if (!pr.merged_at) return false;\n  return new Date(pr.merged_at) >= oneWeekAgo;\n});\n\n// Format data for Claude prompt\nconst formattedData = {\n  period: {\n    start: $('Calculate Date Range').first()?.json?.startDate,\n    end: $('Calculate Date Range').first()?.json?.endDate\n  },\n  commits: {\n    count: recentCommits.length,\n    list: recentCommits.slice(0, 10).map(c => ({\n      sha: c.sha?.substring(0, 7),\n      message: c.commit?.message?.split('\\n')[0],\n      author: c.commit?.author?.name\n    }))\n  },\n  issues: {\n    count: recentIssues.length,\n    list: recentIssues.slice(0, 10).map(i => ({\n      number: i.number,\n      title: i.title,\n      closed_by: i.closed_by?.login\n    }))\n  },\n  pullRequests: {\n    count: mergedPRs.length,\n    list: mergedPRs.slice(0, 10).map(pr => ({\n      number: pr.number,\n      title: pr.title,\n      author: pr.user?.login,\n      merged_at: pr.merged_at\n    }))\n  }\n};\n\nreturn [{ json: formattedData }];"
      },
      "id": "format-data-for-claude",
      "name": "Format Data for Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "{{$vars.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 1024
            },
            {
              "name": "system",
              "value": "{{ $vars.LANGUAGE === 'FR' ? 'Tu es un assistant qui génère des résumés de développement hebdomadaire en français. Sois concis et amical.' : 'You are an assistant that generates weekly development summaries in English. Be concise and friendly.' }}"
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"user\", \"content\": $json.commits.count + ' nouveaux commits, ' + $json.issues.count + ' issues fermées et ' + $json.pullRequests.count + ' PRs fusionnées cette semaine. Details: ' + JSON.stringify($json) }]"
            }
          ]
        },
        "options": {
          "retry": {
            "maxRetries": 3,
            "retryWaitMax": 5000
          }
        }
      },
      "id": "call-claude-api",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "webhookUrl": "{{$vars.DISCORD_WEBHOOK_URL}}",
