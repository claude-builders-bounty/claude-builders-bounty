      "id": "3bfc4ba3-477e-45b4-bf8e-9a437d1f13bc",
      "name": "Fetch Closed Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Load Configuration').first().json;\nconst weekStart = new Date(config.weekStart);\nconst weekEnd = new Date(config.weekEnd);\nconst inWindow = (value) => {\n  if (!value) return false;\n  const date = new Date(value);\n  return date >= weekStart && date <= weekEnd;\n};\nconst nodeItems = (name) => $(name).all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]);\n\nconst commits = nodeItems('Fetch Commits').map((commit) => ({\n  sha: (commit.sha || '').slice(0, 7),\n  message: commit.commit?.message?.split('\\n')[0] || '',\n  author: commit.commit?.author?.name || commit.author?.login || 'unknown',\n  date: commit.commit?.author?.date || commit.commit?.committer?.date,\n  url: commit.html_url\n}));\n\nconst closedIssues = nodeItems('Fetch Closed Issues').filter((issue) => !issue.pull_request && inWindow(issue.closed_at)).map((issue) => ({\n  number: issue.number,\n  title: issue.title,\n  closedAt: issue.closed_at,\n  url: issue.html_url\n}));\n\nconst mergedPullRequests = nodeItems('Fetch Closed Pull Requests').filter((pr) => inWindow(pr.merged_at)).map((pr) => ({\n  number: pr.number,\n  title: pr.title,\n  author: pr.user?.login || 'unknown',\n  mergedAt: pr.merged_at,\n  url: pr.html_url\n}));\n\nconst instruction = config.language === 'FR'\n  ? 'Redige un resume narratif hebdomadaire en francais clair. Structure le texte avec un court titre, les themes principaux, les livraisons, les corrections et les prochaines pistes si elles sont evidentes.'\n  : 'Write a clear weekly narrative development summary in English. Structure it with a short title, main themes, shipped work, fixes, and next steps if they are evident.';\n\nconst data = { repository: config.repoFullName, weekStart: config.weekStart, weekEnd: config.weekEnd, commits, closedIssues, mergedPullRequests };\n\nreturn [{\n  json: {\n    config,\n    data,\n    claudeBody: {\n      model: 'claude-sonnet-4-20250514',\n      max_tokens: 1200,\n      temperature: 0.3,\n      system: 'You summarize GitHub development activity for engineering teams. Be accurate and do not invent work that is not present in the input data.',\n      messages: [\n        {\n          role: 'user',\n          content: `${instruction}\\n\\nRepository activity JSON:\\n${JSON.stringify(data, null, 2)}`\n        }\n      ]\n    }\n  }\n}];"
      },
      "id": "64f4aa84-cef2-419a-9e3c-a0e3d5296f40",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.config.anthropicApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claudeBody) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a2dcac42-3215-4415-894c-a8521f7649ce",
      "name": "Generate Summary with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Build Claude Request').first().json.config;\nconst data = $('Build Claude Request').first().json.data;\nconst response = $json;\nconst summary = response.content?.map((part) => part.text || '').join('\\n').trim() || 'Claude returned no summary text.';\n\nreturn [{\n  json: {\n    webhookUrl: config.discordWebhookUrl,\n    body: {\n      username: 'Weekly Dev Summary',\n      content: `**${data.repository} weekly development summary**\\n${summary}`\n    }\n  }\n}];"
      },
      "id": "3d95c515-dd28-4a33-8982-f8b968081a3b",
      "name": "Build Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ]
