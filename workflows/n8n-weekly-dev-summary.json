{
  "name": "Weekly Dev Summary (Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "triggerAtDay": [5], "triggerAtHour": 17 }] }
      },
      "id": "cron",
      "name": "Weekly Cron (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $vars.GITHUB_REPO + '/commits?since=' + $vars.WEEK_START }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $vars.GITHUB_REPO + '/issues?state=closed&since=' + $vars.WEEK_START }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 320]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $vars.GITHUB_REPO + '/pulls?state=closed&sort=updated&direction=desc' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 440]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $vars.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1200, messages: [{ role: 'user', content: 'You are a dev reporter. Write a weekly narrative summary (in ' + $vars.LANGUAGE + ') of this GitHub activity:\\n\\nCOMMITS:\\n' + JSON.stringify($node[\"Fetch Commits\"].json) + '\\n\\nCLOSED ISSUES:\\n' + JSON.stringify($node[\"Fetch Closed Issues\"].json) + '\\n\\nMERGED PRS:\\n' + JSON.stringify($node[\"Fetch Merged PRs\"].json) }] }) }}",
        "options": {}
      },
      "id": "claude",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.DELIVERY_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $node[\"Claude Summary\"].json.content[0].text }) }}",
        "options": {}
      },
      "id": "deliver",
      "name": "Deliver (Webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 320]
    }
  ],
  "connections": {
    "Weekly Cron (Fri 5pm)": {
      "main": [[
        { "node": "Fetch Commits", "type": "main", "index": 0 },
        { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
        { "node": "Fetch Merged PRs", "type": "main", "index": 0 }
      ]]
    },
    "Fetch Commits": { "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]] },
    "Fetch Closed Issues": { "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]] },
    "Fetch Merged PRs": { "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]] },
    "Claude Summary": { "main": [[{ "node": "Deliver (Webhook)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1",
  "meta": { "instanceId": "claude-builders-bounty" },
  "id": "weekly-dev-summary",
  "tags": []
}