{
  "name": "Weekly Dev Summary - Claude Code",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "expression": "1"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "repository",
        "operation": "getCommits",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}",
        "since": "={{ $json.lastWeek }}"
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}",
        "state": "closed",
        "since": "={{ $json.lastWeek }}"
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "getAll",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}",
        "state": "merged",
        "since": "={{ $json.lastWeek }}"
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 400]
    },
    {
      "parameters": {
        "jsCode": "// Calculate date range for last week\nconst now = new Date();\nconst lastWeek = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    lastWeek: lastWeek.toISOString(),\n    now: now.toISOString()\n  }\n}];"
      },
      "id": "date-calc",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 100]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "={{ 'You are a technical writer creating weekly development summaries. Write in ' + $env.LANGUAGE + '. Be concise but informative.' }}"
            },
            {
              "role": "user",
              "content": "={{ 'Generate a weekly dev summary for repo ' + $env.GITHUB_OWNER + '/' + $env.GITHUB_REPO + '\\n\\nCommits: ' + JSON.stringify($input.all()[0].json) + '\\n\\nClosed Issues: ' + JSON.stringify($input.all()[1].json) + '\\n\\nMerged PRs: ' + JSON.stringify($input.all()[2].json) }}"
            }
          ]
        }
      },
      "id": "claude-api",
      "name": "Claude API",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "resource": "=discordWebhook",
        "operation": "sendMessage",
        "webhookUri": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "content": "={{ $json.content[0].text }}"
      },
      "id": "discord-send",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [900, 250]
    },
    {
      "parameters": {
        "resource": "chatMessage",
        "operation": "post",
        "channel": "={{ $env.SLACK_CHANNEL }}",
        "text": "={{ $json.content[0].text }}"
      },
      "id": "slack-send",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [900, 350]
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [
          {
            "node": "Calculate Date Range",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Date Range": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": []
}