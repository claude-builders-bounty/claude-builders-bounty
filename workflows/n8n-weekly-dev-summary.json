{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Weekly Friday 5pm Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -980,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst weekStart = new Date(now);\nweekStart.setDate(weekStart.getDate() - 7);\nconst repo = $env.GITHUB_REPO || 'octocat/Hello-World';\nconst [owner, name] = repo.split('/');\nif (!owner || !name) throw new Error('GITHUB_REPO must use owner/repo format.');\nconst lang = ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase();\nreturn [{ json: { owner, repo: name, repoFullName: `${owner}/${name}`, language: lang === 'FR' ? 'FR' : 'EN', weekStart: weekStart.toISOString(), weekEnd: now.toISOString(), githubToken: $env.GITHUB_TOKEN, anthropicApiKey: $env.ANTHROPIC_API_KEY, webhookUrl: $env.DISCORD_WEBHOOK_URL || $env.SLACK_WEBHOOK_URL || '', deliveryMode: $env.DISCORD_WEBHOOK_URL ? 'discord' : ($env.SLACK_WEBHOOK_URL ? 'slack' : 'none') } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Load Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -760,
        120
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $('Load Configuration').first().json.owner + '/' + $('Load Configuration').first().json.repo + '/commits' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $('Load Configuration').first().json.weekStart }}"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "sort",
              "value": "committer-date"
            },
            {
              "name": "direction",
              "value": "desc"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Load Configuration').first().json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "numberOfRetries": 2,
            "waitBetweenRetries": 1000
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        -80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $('Load Configuration').first().json.owner + '/' + $('Load Configuration').first().json.repo + '/issues' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Load Configuration').first().json.weekStart }}"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Load Configuration').first().json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "numberOfRetries": 2,
            "waitBetweenRetries": 1000
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $('Load Configuration').first().json.owner + '/' + $('Load Configuration').first().json.repo + '/pulls' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Load Configuration').first().json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "numberOfRetries": 2,
            "waitBetweenRetries": 1000
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Fetch Closed Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000010",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -240,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Load Configuration').first().json;\nlet commits = [], issues = [], prs = [];\ntry { const d = $('Fetch Commits').first().json; commits = Array.isArray(d) ? d : []; } catch(e) {}\ntry { const d = $('Fetch Closed Issues').first().json; issues = Array.isArray(d) ? d.filter(i => !i.pull_request) : []; } catch(e) {}\ntry {\n  const d = $('Fetch Closed Pull Requests').first().json;\n  const we = new Date(config.weekEnd);\n  prs = Array.isArray(d) ? d.filter(pr => pr.merged_at && new Date(pr.merged_at) <= we) : [];\n} catch(e) {}\n\nconst byAuthor = {};\ncommits.forEach(c => {\n  const a = c.commit?.author?.name || c.author?.login || 'unknown';\n  byAuthor[a] = (byAuthor[a] || 0) + 1;\n});\n\nconst langInstruction = config.language === 'FR'\n  ? 'Write the summary in French.'\n  : 'Write the summary in English.';\n\nconst prompt = `You are a senior engineering manager writing a concise weekly dev summary for repository ${config.repoFullName}.\n\nWeek: ${config.weekStart.slice(0,10)} to ${config.weekEnd.slice(0,10)}\n\nCommits this week: ${commits.length}\n${Object.entries(byAuthor).map(([a,n]) => `- ${a}: ${n} commits`).join('\\n') || '- No commits found.'}\n\nClosed issues: ${issues.length}\n${issues.slice(0,20).map(i => `- #${i.number}: ${i.title}`).join('\\n') || '- No issues closed.'}\n\nMerged pull requests: ${prs.length}\n${prs.slice(0,20).map(p => `- #${p.number}: ${p.title} (by ${p.user?.login || 'unknown'})`).join('\\n') || '- No PRs merged.'}\n\nWrite a narrative weekly summary with these sections:\n1. **Highlights** - Key achievements and milestones\n2. **Commits** - Overview of commit activity and top contributors\n3. **Issues Resolved** - What was fixed/closed\n4. **Pull Requests Merged** - Notable PRs and their impact\n5. **Summary** - One-paragraph TL;DR\n\n${langInstruction}\nBe professional but concise. Use bullet points where appropriate. Do not fabricate details not in the data above.`;\n\nreturn [{ json: {\n  config,\n  summaryData: { commitCount: commits.length, issueCount: issues.length, prCount: prs.length, contributors: Object.keys(byAuthor) },\n  claudeBody: {\n    model: 'claude-sonnet-4-20250514',\n    max_tokens: 2048,\n    messages: [{ role: 'user', content: prompt }]\n  }\n}}];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Build Claude Request').first().json.config.anthropicApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Build Claude Request').first().json.claudeBody) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Generate Summary with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const reqData = $('Build Claude Request').first().json;\nconst config = reqData.config;\nconst stats = reqData.summaryData;\nconst claudeResp = $json;\nconst summary = claudeResp.content?.map(p => p.text || '').join('\\n').trim() || 'No summary generated.';\n\nconst header = `# Weekly Dev Summary: ${config.repoFullName}\\n*${config.weekStart.slice(0,10)} to ${config.weekEnd.slice(0,10)}*\\n\\n`;\nconst statsLine = `> ${stats.commitCount} commits | ${stats.issueCount} issues closed | ${stats.prCount} PRs merged | ${stats.contributors.length} contributors\\n\\n`;\nconst fullMarkdown = header + statsLine + summary;\n\nconst discordContent = `**Weekly Dev Summary: ${config.repoFullName}**\\n*${config.weekStart.slice(0,10)} to ${config.weekEnd.slice(0,10)}*\\n${stats.commitCount} commits | ${stats.issueCount} issues | ${stats.prCount} PRs | ${stats.contributors.length} contributors\\n\\n${summary.slice(0,1900)}`;\n\nconst slackBlocks = {\n  blocks: [\n    { type: \"header\", text: { type: \"plain_text\", text: `Weekly Dev Summary: ${config.repoFullName}` }},\n    { type: \"section\", text: { type: \"mrkdwn\", text: `*${config.weekStart.slice(0,10)} to ${config.weekEnd.slice(0,10)}*\\n${stats.commitCount} commits | ${stats.issueCount} issues closed | ${stats.prCount} PRs merged` }},\n    { type: \"section\", text: { type: \"mrkdwn\", text: summary.slice(0,2900) }},\n    { type: \"context\", elements: [{ type: \"mrkdwn\", text: \"Generated by n8n + Claude AI\" }]}\n  ]\n};\n\nreturn [{ json: {\n  config,\n  fullMarkdown,\n  discord: { content: discordContent },\n  slack: slackBlocks,\n  stats\n}}];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Build Output Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
