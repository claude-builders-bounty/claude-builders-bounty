{
  "name": "Weekly Dev Summary - Claude + n8n",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "value": 1,
              "triggerAtDay": 5,
              "triggerAtHour": 17
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300],
      "id": "cron-trigger",
      "name": "Weekly Friday 5PM"
    },
    {
      "parameters": {
        "resource": "repository",
        "operation": "getCommits",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}"
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "github-commits",
      "name": "Get Commits"
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}",
        "state": "closed",
        "returnAll": true
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 500],
      "id": "github-issues",
      "name": "Get Closed Issues"
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "getAll",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}",
        "state": "merged",
        "returnAll": true
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 700],
      "id": "github-prs",
      "name": "Get Merged PRs"
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "You are a technical writer. Generate a weekly development summary in {{ $env.LANGUAGE || 'EN' }} based on the provided GitHub activity data."
            },
            {
              "role": "user",
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1,
      "position": [750, 400],
      "id": "claude-api",
      "name": "Claude API"
    },
    {
      "parameters": {
        "sendTo": "={{ $env.DESTINATION_TYPE }}",
        "destination": "={{ $env.WEBHOOK_URL || $env.EMAIL_TO }}"
      },
      "type": "n8n-nodes-base.sendMessage",
      "typeVersion": 1,
      "position": [1050, 400],
      "id": "send-summary",
      "name": "Send Summary"
    }
  ],
  "connections": {
    "Weekly Friday 5PM": {
      "main": [[{"node": "Get Commits", "type": "main", "index": 0}]]
    },
    "Get Commits": {
      "main": [[{"node": "Get Closed Issues", "type": "main", "index": 0}]]
    },
    "Get Closed Issues": {
      "main": [[{"node": "Get Merged PRs", "type": "main", "index": "0"}]]
    },
    "Get Merged PRs": {
      "main": [[{"node": "Claude API", "type": "main", "index": 0}]]
    },
    "Claude API": {
      "main": [[{"node": "Send Summary", "type": "main", "index": 0}]]
    }
  }
}