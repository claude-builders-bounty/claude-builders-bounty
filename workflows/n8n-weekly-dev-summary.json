        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "e361c223-bbf2-40c2-8e2b-eb2a2a98850e",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
