{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "0f7a4f57-3c83-47d0-89a1-a5fe9c7fa7db",
      "name": "Weekly Friday 5pm Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -980,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst weekEnd = new Date(now);\nconst weekStart = new Date(now);\nweekStart.setDate(weekStart.getDate() - 7);\n\nconst repo = $env.GITHUB_REPO || 'octocat/Hello-World';\nconst [owner, name] = repo.split('/');\n\nif (!owner || !name) {\n  throw new Error('GITHUB_REPO must use owner/repo format.');\n}\n\nreturn [{\n  json: {\n    owner,\n    repo: name,\n    repoFullName: `${owner}/${name}`,\n    language: ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase() === 'FR' ? 'FR' : 'EN',\n    weekStart: weekStart.toISOString(),\n    weekEnd: weekEnd.toISOString(),\n    githubToken: $env.GITHUB_TOKEN,\n    anthropicApiKey: $env.ANTHROPIC_API_KEY,\n    discordWebhookUrl: $env.DISCORD_WEBHOOK_URL\n  }\n}];"
      },
      "id": "cd96497c-7797-4a9d-96c7-982cd5227611",
      "name": "Load Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -760,
        120
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $('Load Configuration').first().json.owner + '/' + $('Load Configuration').first().json.repo + '/commits' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $('Load Configuration').first().json.weekStart }}"
            },
            {
              "name": "until",
              "value": "={{ $('Load Configuration').first().json.weekEnd }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Load Configuration').first().json.githubToken }}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
