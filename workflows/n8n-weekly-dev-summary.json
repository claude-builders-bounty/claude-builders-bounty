{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [5],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "weekly-cron",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "repo", "name": "repo", "type": "string", "value": "={{ $env.GITHUB_REPO || 'owner/repo' }}" },
            { "id": "language", "name": "language", "type": "string", "value": "={{ $env.SUMMARY_LANGUAGE || 'EN' }}" },
            { "id": "destination", "name": "destinationWebhook", "type": "string", "value": "={{ $env.DISCORD_WEBHOOK_URL }}" },
            { "id": "since", "name": "since", "type": "string", "value": "={{ $now.minus({ days: 7 }).toISO() }}" }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "since", "value": "={{ $json.since }}" },
            { "name": "per_page", "value": "50" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.GITHUB_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "github-commits",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, -180]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{ $json.repo }}+is:issue+is:closed+closed:>={{ $json.since }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.GITHUB_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "github-closed-issues",
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{ $json.repo }}+is:pr+is:merged+merged:>={{ $json.since }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.GITHUB_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "github-merged-prs",
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-commits-issues",
      "name": "Merge Commits and Issues",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [700, -80]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-all-activity",
      "name": "Merge All Activity",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [700, 120]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = $input.all();\nconst commits = all.find(i => Array.isArray(i.json))?.json || [];\nconst searches = all.filter(i => i.json && Array.isArray(i.json.items)).map(i => i.json.items);\nconst closedIssues = searches[0] || [];\nconst mergedPrs = searches[1] || [];\nconst repo = $('Config').first().json.repo;\nconst language = $('Config').first().json.language;\nconst prompt = `Write a concise weekly narrative development summary in ${language} for ${repo}.\\n\\nCommits:\\n${commits.slice(0, 20).map(c => `- ${c.commit?.message || c.sha}`).join('\\n')}\\n\\nClosed issues:\\n${closedIssues.slice(0, 20).map(i => `- #${i.number} ${i.title}`).join('\\n')}\\n\\nMerged PRs:\\n${mergedPrs.slice(0, 20).map(p => `- #${p.number} ${p.title}`).join('\\n')}\\n\\nInclude: headline, shipped work, fixes, notable risks, and next-week follow-up.`;\nreturn [{ json: { repo, language, prompt, counts: { commits: commits.length, closedIssues: closedIssues.length, mergedPrs: mergedPrs.length } } }];"
      },
      "id": "build-claude-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":1200,\"messages\":[{\"role\":\"user\",\"content\":$json.prompt}]}",
        "options": {}
      },
      "id": "claude-summary",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const content = $json.content?.[0]?.text || 'No summary returned from Claude.';\nreturn { json: { content: `**Weekly Dev Summary**\\n\\n${content}` } };"
      },
      "id": "format-message",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.destinationWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": $json.content}",
        "options": {}
      },
      "id": "send-discord",
      "name": "Send Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 0]
    }
  ],
  "connections": {
    "Weekly Friday 5pm": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [
        [
          { "node": "GitHub Commits", "type": "main", "index": 0 },
          { "node": "GitHub Closed Issues", "type": "main", "index": 0 },
          { "node": "GitHub Merged PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "GitHub Commits": {
      "main": [[{ "node": "Merge Commits and Issues", "type": "main", "index": 0 }]]
    },
    "GitHub Closed Issues": {
      "main": [[{ "node": "Merge Commits and Issues", "type": "main", "index": 1 }]]
    },
    "GitHub Merged PRs": {
      "main": [[{ "node": "Merge All Activity", "type": "main", "index": 1 }]]
    },
    "Merge Commits and Issues": {
      "main": [[{ "node": "Merge All Activity", "type": "main", "index": 0 }]]
    },
    "Merge All Activity": {
      "main": [[{ "node": "Build Claude Prompt", "type": "main", "index": 0 }]]
    },
    "Build Claude Prompt": {
      "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]]
    },
    "Claude Summary": {
      "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]]
    },
    "Format Message": {
      "main": [[{ "node": "Send Discord Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "weekly-dev-summary-claude",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
