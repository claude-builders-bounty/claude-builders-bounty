 {
   "name": "Weekly Dev Summary (Claude + GitHub)",
   "nodes": [
     {
       "parameters": {
         "rule": {
           "interval": [
             {
               "field": "weeks",
               "triggerAtDay": 5,
               "triggerAtHour": 17
             }
           ]
         }
       },
       "id": "cron-trigger",
       "name": "Weekly Cron (Fri 5pm)",
       "type": "n8n-nodes-base.scheduleTrigger",
       "typeVersion": 1.2,
       "position": [240, 300]
     },
     {
       "parameters": {
         "resource": "commit",
         "operation": "getAll",
         "owner": "={{ $json.githubOwner }}",
         "repository": "={{ $json.githubRepo }}",
         "returnAll": true,
         "options": {
           "since": "={{ new Date(Date.now() - 7*24*60*60*1000).toISOString() }}"
         }
       },
       "id": "get-commits",
       "name": "Get Commits (7d)",
       "type": "n8n-nodes-base.github",
       "typeVersion": 1,
       "position": [480, 200],
       "credentials": {
         "githubApi": {
           "id": "REPLACE_WITH_GITHUB_CRED_ID",
           "name": "GitHub API"
         }
       }
     },
     {
       "parameters": {
         "resource": "issue",
         "operation": "getAll",
         "owner": "={{ $json.githubOwner }}",
         "repository": "={{ $json.githubRepo }}",
         "returnAll": true,
         "options": {
           "state": "closed",
           "since": "={{ new Date(Date.now() - 7*24*60*60*1000).toISOString() }}"
         }
       },
       "id": "get-issues",
       "name": "Get Closed Issues (7d)",
       "type": "n8n-nodes-base.github",
       "typeVersion": 1,
       "position": [480, 400],
       "credentials": {
         "githubApi": {
           "id": "REPLACE_WITH_GITHUB_CRED_ID",
           "name": "GitHub API"
         }
       }
     },
     {
       "parameters": {
         "resource": "pullRequest",
         "operation": "getAll",
         "owner": "={{ $json.githubOwner }}",
         "repository": "={{ $json.githubRepo }}",
         "returnAll": true,
         "options": {
           "state": "merged",
           "since": "={{ new Date(Date.now() - 7*24*60*60*1000).toISOString() }}"
         }
       },
       "id": "get-prs",
       "name": "Get Merged PRs (7d)",
       "type": "n8n-nodes-base.github",
       "typeVersion": 1,
       "position": [480, 600],
       "credentials": {
         "githubApi": {
           "id": "REPLACE_WITH_GITHUB_CRED_ID",
           "name": "GitHub API"
         }
       }
     },
     {
       "parameters": {
         "mode": "append",
         "options": {}
       },
       "id": "merge-data",
       "name": "Merge Activity Data",
       "type": "n8n-nodes-base.merge",
       "typeVersion": 3,
       "position": [720, 400]
     },
     {
       "parameters": {
         "model": "claude-sonnet-4-20250514",
         "messages": {
           "values": [
             {
               "content": "You are a senior engineering manager writing a weekly dev summary. Summarize the following GitHub activity for {{ $json.githubOwner }}/{{ $json.githubRepo }} in {{ $json.language || 'EN' }}. Be concise, narrative-driven, and highlight key themes, risks, and achievements.\n\nActivity JSON:\n{{ JSON.stringify($json) }}",
               "role": "user"
             }
           ]
         }
       },
       "id": "claude-summarize",
       "name": "Claude Summary",
       "type": "@n8n/n8n-nodes-langchain.chatAnthropic",
       "typeVersion": 1.2,
       "position": [960, 400],
       "credentials": {
         "anthropicApi": {
           "id": "REPLACE_WITH_ANTHROPIC_CRED_ID",
           "name": "Anthropic API"
         }
       }
     },
     {
       "parameters": {
         "url": "={{ $json.webhookUrl }}",
         "method": "POST",
         "body": {
           "content": "## 📊 Weekly Dev Summary — {{ $json.githubOwner }}/{{ $json.githubRepo }}\n\n{{ $json.claudeResponse }}"
         },
         "options": {}
       },
       "id": "send-webhook",
       "name": "Send to Discord/Slack",
       "type": "n8n-nodes-base.httpRequest",
       "typeVersion": 4.2,
       "position": [1200, 400]
     }
   ],
   "connections": {
     "Weekly Cron (Fri 5pm)": {
       "main": [
         [{ "node": "Get Commits (7d)", "type": "main", "index": 0 }],
         [{ "node": "Get Closed Issues (7d)", "type": "main", "index": 0 }],
         [{ "node": "Get Merged PRs (7d)", "type": "main", "index": 0 }]
       ]
     },
     "Get Commits (7d)": {
       "main": [[{ "node": "Merge Activity Data", "type": "main", "index": 0 }]]
     },
     "Get Closed Issues (7d)": {
       "main": [[{ "node": "Merge Activity Data", "type": "main", "index": 1 }]]
     },
     "Get Merged PRs (7d)": {
       "main": [[{ "node": "Merge Activity Data", "type": "main", "index": 2 }]]
     },
     "Merge Activity Data": {
       "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]]
     },
     "Claude Summary": {
       "main": [[{ "node": "Send to Discord/Slack", "type": "main", "index": 0 }]]
     }
   },
   "settings": {
     "executionOrder": "v1"
   }
 }
