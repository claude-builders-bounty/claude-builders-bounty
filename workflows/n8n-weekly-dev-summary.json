              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.config.deliveryMode === 'discord' ? JSON.stringify($json.discord) : JSON.stringify($json.slack) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000009",
      "name": "Send to Webhook",
      "type": "n8n-nodes-base.httpRequest",
