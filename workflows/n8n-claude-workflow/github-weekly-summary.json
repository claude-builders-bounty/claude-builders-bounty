{
  "name": "GitHub Weekly Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 17,
              "triggerAtMinute": 0,
              "weekday": "Friday"
            }
          ]
        }
      },
      "id": "node-cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "resource": "commit",
        "operation": "getAll",
        "repository": "={{$vars.GITHUB_REPO}}",
        "author": "",
        "options": {
          "maxResults": 50,
          "fields": "sha,message,author.name,author.date"
        }
      },
      "id": "node-github-commits",
      "name": "GitHub: Get Commits (7 days)",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [300, 200]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "repository": "={{$vars.GITHUB_REPO}}",
        "state": "closed",
        "options": {
          "maxResults": 50
        }
      },
      "id": "node-github-issues",
      "name": "GitHub: Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [300, 350]
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "getAll",
        "repository": "={{$vars.GITHUB_REPO}}",
        "state": "closed",
        "options": {
          "maxResults": 50,
          "fields": "number,title,user.login,merged"
        }
      },
      "id": "node-github-prs",
      "name": "GitHub: Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [300, 500]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a dev ops assistant that writes concise, informative weekly summaries of GitHub repository activity. Write in {{$vars.LANGUAGE === 'FR' ? 'French' : 'English'}}. Be engaging and highlight key achievements."
            },
            {
              "role": "user",
              "content": "={{\"📊 Weekly Dev Summary — \" + $vars.GITHUB_REPO + \"\\n📅 This week\\n\\n🤖 Commits: \" + $json.length + \"\\n📌 Closed Issues: \" + $('node-github-issues').itemCount + \"\\n🔀 Merged PRs: \" + $('node-github-prs').itemCount}}\n\nProvide a concise narrative summary highlighting key developments, notable contributors, and anything noteworthy."
            }
          ]
        },
        "options": {
          "maxTokens": 500
        }
      },
      "id": "node-claude-api",
      "name": "Claude API: Generate Summary",
      "type": "anthropic-api.anthropic",
      "typeVersion": 1,
      "position": [600, 350]
    },
    {
      "parameters": {
        "url": "={{$vars.DISCORD_WEBHOOK_URL}}",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json.content}}"
            },
            {
              "name": "username",
              "value": "🤖 Dev Summary Bot"
            }
          ]
        }
      },
      "id": "node-discord-webhook",
      "name": "Discord: Send Summary",
      "type": "n8n-nodes-base.discordWebhook",
      "typeVersion": 1,
      "position": [850, 350]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [
        [
          {
            "node": "GitHub: Get Commits (7 days)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub: Get Commits (7 days)": {
      "main": [
        [
          {
            "node": "Claude API: Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub: Get Closed Issues": {
      "main": [
        [
          {
            "node": "Claude API: Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub: Get Merged PRs": {
      "main": [
        [
          {
            "node": "Claude API: Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API: Generate Summary": {
      "main": [
        [
          {
            "node": "Discord: Send Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
