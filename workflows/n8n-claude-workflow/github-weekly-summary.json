{
  "name": "GitHub Weekly Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 17,
              "triggerAtMinute": 0,
              "weekday": "Friday"
            }
          ]
        }
      },
      "id": "node-cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "resource": "commit",
        "operation": "getAll",
        "repository": "={{$vars.GITHUB_REPO}}",
        "author": "",
        "options": {
          "maxResults": 50,
          "fields": "sha,message,author.name,author.date",
          "dateRange": "7 days"
        }
      },
      "id": "node-github-commits",
      "name": "GitHub: Get Commits (7 days)",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.2,
      "position": [300, 200]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "repository": "={{$vars.GITHUB_REPO}}",
        "state": "closed",
        "options": {
          "maxResults": 50,
          "fields": "number,title,user.login,closed_at,labels"
        }
      },
      "id": "node-github-issues",
      "name": "GitHub: Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.2,
      "position": [300, 350]
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "getAll",
        "repository": "={{$vars.GITHUB_REPO}}",
        "state": "closed",
        "options": {
          "maxResults": 50,
          "fields": "number,title,user.login,merged,merged_at"
        }
      },
      "id": "node-github-prs",
      "name": "GitHub: Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.2,
      "position": [300, 500]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a dev ops assistant that writes concise, informative weekly summaries of GitHub repository activity. Write in {{$vars.LANGUAGE === 'FR' ? 'French' : 'English'}}. Format with emojis. Be engaging and highlight key achievements. Include a section for 'Notable Contributors' and 'Looking Ahead'."
            },
            {
              "role": "user",
              "content": "={{\"📊 Weekly Dev Summary — \" + $vars.GITHUB_REPO + \"\\n📅 Week ending \" + $now.toLocaleDateString() + \"\\n\\n🤖 Commits: \" + $('GitHub: Get Commits (7 days)').data.length + \"\\n📌 Closed Issues: \" + $('GitHub: Get Closed Issues').data.length + \"\\n🔀 Merged PRs: \" + $('GitHub: Get Merged PRs').data.length + \"\\n\\n---\\n\\n\" + $json.content}}"
            }
          ]
        },
        "options": {
          "maxTokens": 600
        }
      },
      "id": "node-claude-api",
      "name": "Claude API: Generate Summary",
      "type": "anthropic-api.anthropic",
      "typeVersion": 1.2,
      "position": [600, 350]
    },
    {
      "parameters": {
        "url": "={{$vars.DISCORD_WEBHOOK_URL}}",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json.content}}"
            },
            {
              "name": "username",
              "value": "🤖 Dev Summary Bot"
            },
            {
              "name": "avatar_url",
              "value": "https://i.imgur.com/4M34kIm.png"
            }
          ]
        }
      },
      "id": "node-discord-webhook",
      "name": "Discord: Send Summary",
      "type": "n8n-nodes-base.discordWebhook",
      "typeVersion": 1.2,
      "position": [850, 350]
    },
    {
      "parameters": {
        "to": "={{$vars.EMAIL_TO}}",
        "subject": "={{'📊 Weekly Dev Summary — ' + $vars.GITHUB_REPO}}",
        "body": "={{$json.content}}",
        "options": {
          "fromEmail": "={{$vars.EMAIL_FROM}}"
        }
      },
      "id": "node-email-fallback",
      "name": "Email: Fallback Delivery",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.2,
      "position": [850, 550]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [
        [
          {
            "node": "GitHub: Get Commits (7 days)",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub: Get Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub: Get Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API: Generate Summary": {
      "main": [
        [
          {
            "node": "Discord: Send Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["github", "claude", "weekly-summary", "automation"],
  "meta": {
    "templateCredsSetupCompleted": true,
    "templateIdCreated": "n8n-claude-weekly-summary"
  }
}
