          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/search/issues?q=repo:' + $('Configuration Variables').item.json.githubRepo + '+is:pr+is:merged+closed:>=' + new Date(new Date().setDate(new Date().getDate() - 7)).toISOString().split('T')[0] }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
