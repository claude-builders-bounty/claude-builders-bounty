            },
            {
              "name": "max_tokens",
              "value": "1024"
            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"user\", \"content\": \"Write a weekly narrative summary for the GitHub repository '\" + $('Configuration Variables').item.json.githubRepo + \"' in \" + $('Configuration Variables').item.json.language + \". Here is the raw data.\\n\\nCommits: \" + JSON.stringify($json.data1.slice(0, 20)) + \"\\n\\nMerged PRs: \" + JSON.stringify($json.data2.items.slice(0, 10)) + \"\\n\\nMake it sound like an engaging newsletter update.\" }] }}"
            }
          ]
        },
        "options": {
          "headers": {
            "parameter": [
              {
                "name": "anthropic-version",
                "value": "2023-06-01"
