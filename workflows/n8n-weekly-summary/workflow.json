{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": 7
        },
        "triggerTimes": {
          "item": [{"hour": 17, "minute": 0, "weekday": 5}]
        }
      },
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.repo_url }}/commits?per_page=20",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "token {{ $env.GITHUB_TOKEN }}"},
            {"name": "Accept", "value": "application/vnd.github.v3+json"}
          ]
        }
      },
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.closed_issues_url }}?state=closed&per_page=10&sort=updated",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "token {{ $env.GITHUB_TOKEN }}"}
          ]
        }
      },
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 450]
    },
    {
      "parameters": {
        "url": "={{ $json.merges_url }}?per_page=10&sort=updated",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "token {{ $env.GITHUB_TOKEN }}"}
          ]
        }
      },
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 600]
    },
    {
      "parameters": {
        "model": "claude-3-haiku-20240307",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a technical assistant that generates concise weekly development summaries."
            },
            {
              "role": "user",
              "content": "=Generate a weekly dev summary from this data:\n\nCommits:\n{{ $json.commits }}\n\nClosed Issues:\n{{ $json.issues }}\n\nMerged PRs:\n{{ $json.prs }}\n\nFormat: narrative style, bullet points under categories: New Features, Bug Fixes, Improvements, Stats"
            }
          ]
        },
        "options": {}
      },
      "name": "Claude API",
      "type": "n8n-nodes-base.openAi",
      "position": [650, 400]
    },
    {
      "parameters": {
        "text": "={{ $json.message.content[0].text }}",
        "subject": "=Weekly Dev Summary: {{ $json.repo_name }}",
        "toEmail": "={{ $env.SUMMARY_EMAIL }}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [850, 400]
    }
  ],
  "connections": {
    "Weekly Cron": {"main": [[{"node": "GitHub Commits", "type": "main"}]], "GitHub Commits": {"main": [[{"node": "GitHub Closed Issues", "type": "main"}, {"node": "GitHub Merged PRs", "type": "main"}]]}},
    "GitHub Closed Issues": {"main": [[{"node": "Claude API", "type": "main"}]]},
    "GitHub Merged PRs": {"main": [[{"node": "Claude API", "type": "main"}]]},
    "Claude API": {"main": [[{"node": "Send Email", "type": "main"}]]}
  }
}
