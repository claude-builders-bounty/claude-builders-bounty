{
  "name": "Weekly Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/OWNER/REPO/commits?per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        470,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/OWNER/REPO/issues?state=closed&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Get Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        470,
        350
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/OWNER/REPO/pulls?state=closed&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Get PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        470,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Get Commits').all();\nconst issues = $('Get Issues').all();\nconst prs = $('Get PRs').all();\nconst week = new Date(); week.setDate(week.getDate() - 7);\nconst rc = commits.filter(c => new Date(c.json.commit?.author?.date) > week);\nconst ri = issues.filter(i => new Date(i.json.closed_at) > week);\nconst rp = prs.filter(p => p.json.merged_at && new Date(p.json.merged_at) > week);\nreturn [{json:{commits:rc.map(c=>c.json.commit?.message?.split('\\n')[0]),issues:ri.map(i=>i.json.title),prs:rp.map(p=>p.json.title),stats:{commits:rc.length,issues:ri.length,prs:rp.length}}}];"
      },
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        350
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":1024,\"messages\":[{\"role\":\"user\",\"content\":\"Write a concise weekly dev summary. Stats: \" + JSON.stringify($json.stats) + \". Commits: \" + JSON.stringify($json.commits) + \". Issues: \" + JSON.stringify($json.issues) + \". PRs: \" + JSON.stringify($json.prs)}]}"
      },
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.all()[0].json;\nconst text = r.content?.[0]?.text || 'No summary generated.';\nreturn [{json:{summary:text}}];"
      },
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        350
      ]
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Extract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}