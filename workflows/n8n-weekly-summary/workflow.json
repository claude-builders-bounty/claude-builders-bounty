      "id": "df15aefa-4b14-43d2-9674-8fa1e56ba812",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));\nconst sinceIso = sevenDaysAgo.toISOString();\nconst untilIso = now.toISOString();\n\nreturn {\n  ...$input.first().json,\n  since_iso: sinceIso,\n  until_iso: untilIso,\n  start_date_str: sevenDaysAgo.toISOString().slice(0, 10),\n  end_date_str: now.toISOString().slice(0, 10)\n};\n"
      },
      "id": "46f1122b-1981-4da3-b783-90359691a040",
      "name": "Compute 7-Day Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since_iso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-claude-weekly-summary"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.GITHUB_TOKEN ? 'Bearer ' + $env.GITHUB_TOKEN : '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "cf5b619f-474a-4d29-a469-788fcf70ab9f",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        180
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Compute 7-Day Window').first().json.repo_owner }}/{{ $('Compute 7-Day Window').first().json.repo_name }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Compute 7-Day Window').first().json.since_iso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-claude-weekly-summary"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.GITHUB_TOKEN ? 'Bearer ' + $env.GITHUB_TOKEN : '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7a97c7d4-ae6b-40fd-bb36-bacb49858002",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Compute 7-Day Window').first().json.repo_owner }}/{{ $('Compute 7-Day Window').first().json.repo_name }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-claude-weekly-summary"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.GITHUB_TOKEN ? 'Bearer ' + $env.GITHUB_TOKEN : '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "6c0fa16f-1586-4469-9682-cd5523fbf195",
      "name": "Fetch Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst config = $('Compute 7-Day Window').first().json;\nconst sinceDate = new Date(config.since_iso);\n\n// Process commits\nconst commitsRaw = $('Fetch Commits').all().map(i => i.json);\nconst commits = (Array.isArray(commitsRaw) ? commitsRaw : []).map(c => ({\n  sha: (c.sha || '').slice(0, 7),\n  author: c.commit?.author?.name || c.author?.login || 'Unknown',\n  message: (c.commit?.message || '').split('\\n')[0],\n  date: c.commit?.author?.date || ''\n})).slice(0, 40);\n\n// Process closed issues (filter out PRs returned by issues endpoint)\nconst issuesRaw = $('Fetch Closed Issues').all().map(i => i.json);\nconst closedIssues = (Array.isArray(issuesRaw) ? issuesRaw : [])\n  .filter(iss => !iss.pull_request)\n  .map(iss => ({\n    number: iss.number,\n    title: iss.title,\n    author: iss.user?.login || 'Unknown',\n    closed_at: iss.closed_at\n  })).slice(0, 30);\n\n// Process merged PRs in the last 7 days\nconst pullsRaw = $('Fetch Pull Requests').all().map(i => i.json);\nconst mergedPulls = (Array.isArray(pullsRaw) ? pullsRaw : [])\n  .filter(pr => pr.merged_at && new Date(pr.merged_at) >= sinceDate)\n  .map(pr => ({\n    number: pr.number,\n    title: pr.title,\n    author: pr.user?.login || 'Unknown',\n    merged_at: pr.merged_at\n  })).slice(0, 30);\n\nconst language = (config.summary_language || 'EN').toUpperCase();\nconst langInstruction = language === 'FR' \n  ? 'R\u00e9dige le r\u00e9sum\u00e9 hebdomadaire enti\u00e8rement en FRAN\u00c7AIS, avec un ton professionnel et engageant.' \n  : 'Write the weekly developer summary entirely in ENGLISH, with a professional and engaging tone.';\n\nconst prompt = `You are Claude Code, an expert technical lead and developer relations engineer.\nGenerate an engaging, narrative weekly developer activity summary for the repository: ${config.repo_owner}/${config.repo_name}.\nPeriod: ${config.start_date_str} to ${config.end_date_str}.\n\n${langInstruction}\n\nHere is the raw activity data from the past 7 days:\n\nMerged Pull Requests (${mergedPulls.length}):\n${mergedPulls.map(p => `- #${p.number}: ${p.title} (by @${p.author})`).join('\\n') || 'None this week.'}\n\nClosed Issues Resolved (${closedIssues.length}):\n${closedIssues.map(i => `- #${i.number}: ${i.title}`).join('\\n') || 'None this week.'}\n\nRecent Commits (${commits.length}):\n${commits.slice(0, 25).map(c => `- [${c.sha}] ${c.message} (${c.author})`).join('\\n') || 'None recorded.'}\n\nStructure the summary cleanly using Markdown:\n1. **Executive Narrative**: A 2-3 paragraph overview capturing the high-level progress, architectural focus, and engineering momentum.\n2. **Key Shipped Features & Enhancements**: Detailed bullet points highlighting merged PRs and core improvements.\n3. **Resolved Issues & Quality Fixes**: Breakdown of closed issues and bug remediations.\n4. **Contributor Spotlight**: Shout-out to contributors who landed PRs and fixes this week.\n\nKeep it concise, technically accurate, and readable for both technical contributors and leadership.`;\n\nreturn {\n  ...config,\n  commits_count: commits.length,\n  closed_issues_count: closedIssues.length,\n  merged_prs_count: mergedPulls.length,\n  prompt: prompt\n};\n"
      },
      "id": "5dec4ad5-d115-494f-9d72-8bb774aa372a",
      "name": "Aggregate & Format Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\\n  \"model\": \"claude-3-5-sonnet-20241022\",\\n  \"max_tokens\": 2048,\\n  \"messages\": [\\n    {\\n      \"role\": \"user\",\\n      \"content\": {{ JSON.stringify($json.prompt) }}\\n    }\\n  ]\\n}",
        "options": {}
      },
      "id": "7eca2a42-0fe2-4b1d-a32f-7677b8991891",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nconst contentList = response.content || [];\nconst summaryText = contentList.filter(c => c.type === 'text').map(c => c.text).join('\\n\\n');\n\nconst agg = $('Aggregate & Format Prompt').first().json;\n\nreturn {\n  repo_owner: agg.repo_owner,\n  repo_name: agg.repo_name,\n  start_date_str: agg.start_date_str,\n  end_date_str: agg.end_date_str,\n  delivery_channel: (agg.delivery_channel || 'slack').toLowerCase(),\n  slack_webhook_url: agg.slack_webhook_url,\n  discord_webhook_url: agg.discord_webhook_url,\n  summary: summaryText,\n  commits_count: agg.commits_count,\n  closed_issues_count: agg.closed_issues_count,\n  merged_prs_count: agg.merged_prs_count\n};\n"
      },
      "id": "2ac1cabd-b0f0-4b0f-8ecb-f2b34cc84217",
      "name": "Parse Claude Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
