            {
              "id": "d8b1a3e7-02e8-4deb-9d55-ac5be2cb881a",
              "name": "slack_webhook_url",
              "value": "={{ $env.SLACK_WEBHOOK_URL || '' }}",
              "type": "string"
            },
            {
              "id": "21ead2fe-058a-49a5-adc2-af789307187d",
              "name": "discord_webhook_url",
              "value": "={{ $env.DISCORD_WEBHOOK_URL || '' }}",
