{
  "name": "Claude Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Every Friday at 5PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300],
      "typeVersion": 1.1
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo_owner",
              "value": "owner-name"
            },
            {
              "name": "repo_name",
              "value": "repo-name"
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "discord_webhook_url",
              "value": "https://discord.com/api/webhooks/..."
            }
          ]
        },
        "options": {}
      },
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "position": [460, 300],
      "typeVersion": 2
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json[\"repo_owner\"]}}/{{$json[\"repo_name\"]}}/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-workflow"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch GitHub Events",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 300],
      "typeVersion": 4.1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$credentials.apiKey}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-7-sonnet-20250219"
            },
            {
              "name": "max_tokens",
              "value": "1024"
            }
          ]
        },
        "options": {
          "bodyContentType": "raw",
          "bodyContent": "={\"model\":\"claude-3-7-sonnet-20250219\",\"max_tokens\":1024,\"messages\":[{\"role\":\"user\",\"content\":\"Summarize the following GitHub activity for the week in {{$node[\\\"Config Variables\\\"].json[\\\"language\\\"]}}. Focus on commits and PRs.\\n\\n{{JSON.stringify($json)}}\"}]}"
        }
      },
      "name": "Claude Sonnet Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropic_api",
          "name": "Anthropic API Key"
        }
      },
      "position": [900, 300],
      "typeVersion": 4.1
    },
    {
      "parameters": {
        "webhookUri": "={{$node[\"Config Variables\"].json[\"discord_webhook_url\"]}}",
        "text": "={{$json[\"content\"][0][\"text\"]}}",
        "options": {}
      },
      "name": "Post to Discord",
      "type": "n8n-nodes-base.discord",
      "position": [1120, 300],
      "typeVersion": 2
    }
  ],
  "connections": {
    "Every Friday at 5PM": {
      "main": [
        [
          {
            "node": "Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config Variables": {
      "main": [
        [
          {
            "node": "Fetch GitHub Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch GitHub Events": {
      "main": [
        [
          {
            "node": "Claude Sonnet Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Sonnet Analysis": {
      "main": [
        [
          {
            "node": "Post to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
