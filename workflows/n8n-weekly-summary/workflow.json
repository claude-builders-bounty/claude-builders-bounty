        "jsonBody": "={\\n  \"content\": \"**Weekly Dev Summary: \" + $json.repo_owner + \"/\" + $json.repo_name + \"**\\n\\n\" + $json.summary.slice(0, 1900)\\n}",
        "options": {}
      },
      "id": "cbb85b1a-3a62-4c13-a9b3-abbfef4d980b",
