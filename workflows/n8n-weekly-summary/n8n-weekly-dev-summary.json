{
  "name": "Claude Code — Automated Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "node-trigger-cron",
      "name": "Weekly Trigger (Friday 5 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "GITHUB_OWNER",
              "value": "claude-builders-bounty"
            },
            {
              "name": "GITHUB_REPO",
              "value": "claude-builders-bounty"
            },
            {
              "name": "SUMMARY_LANGUAGE",
              "value": "EN"
            },
            {
              "name": "DISCORD_WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK"
            },
            {
              "name": "CLAUDE_MODEL",
              "value": "claude-sonnet-4-20250514"
            }
          ]
        },
        "options": {}
      },
      "id": "node-config",
      "name": "Configuration Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_OWNER }}/{{ $json.GITHUB_REPO }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "node-get-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        180
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Configuration Variables').item.json.GITHUB_OWNER }}/{{ $('Configuration Variables').item.json.GITHUB_REPO }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "node-get-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Configuration Variables').item.json.GITHUB_OWNER }}/{{ $('Configuration Variables').item.json.GITHUB_REPO }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "node-get-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nconst commits = $('Fetch Commits').all().map(i => i.json).map(c => ({\n  author: c.commit?.author?.name || 'Contributor',\n  message: c.commit?.message?.split('\\n')[0] || ''\n})).filter(c => c.message);\n\nconst prs = $('Fetch Merged PRs').all().map(i => i.json)\n  .filter(pr => pr.merged_at && new Date(pr.merged_at) >= oneWeekAgo)\n  .map(pr => ({\n    title: pr.title,\n    number: pr.number,\n    author: pr.user?.login\n  }));\n\nconst issues = $('Fetch Closed Issues').all().map(i => i.json)\n  .filter(issue => !issue.pull_request)\n  .map(issue => ({\n    title: issue.title,\n    number: issue.number\n  }));\n\nconst config = $('Configuration Variables').first().json;\n\nreturn [{\n  json: {\n    config,\n    summaryData: {\n      totalCommits: commits.length,\n      commits: commits.slice(0, 20),\n      mergedPRs: prs,\n      closedIssues: issues\n    }\n  }\n}];"
      },
      "id": "node-aggregate",
      "name": "Aggregate Weekly Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.config.CLAUDE_MODEL }}\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate an engaging, executive weekly developer summary narrative in \" + ($json.config.SUMMARY_LANGUAGE === 'FR' ? 'French' : 'English') + \" for repository \" + $json.config.GITHUB_OWNER + \"/\" + $json.config.GITHUB_REPO + \". Include: 1) Highlights & accomplishments, 2) Merged pull requests and features, 3) Closed issues and bugfixes, 4) Outlook for next week. Activity data: \" + JSON.stringify($json.summaryData)\n    }\n  ]\n}",
        "options": {}
      },
      "id": "node-claude-api",
      "name": "Claude Weekly Narrative",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration Variables').first().json.DISCORD_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"username\": \"Claude Dev Summary\",\n  \"avatar_url\": \"https://github.com/anthropics.png\",\n  \"content\": \"📊 **Weekly Engineering Summary — \" + $('Configuration Variables').first().json.GITHUB_REPO + \"**\\n\\n\" + $json.content[0].text.substring(0, 1900)\n}",
        "options": {}
      },
      "id": "node-post-webhook",
      "name": "Post to Webhook (Discord/Slack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Trigger (Friday 5 PM)": {
      "main": [
        [
          {
            "node": "Configuration Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration Variables": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Aggregate Weekly Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Aggregate Weekly Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Aggregate Weekly Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Weekly Data": {
      "main": [
        [
          {
            "node": "Claude Weekly Narrative",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Weekly Narrative": {
      "main": [
        [
          {
            "node": "Post to Webhook (Discord/Slack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
