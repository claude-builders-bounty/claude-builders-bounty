{
  "name": "Weekly GitHub Dev Summary (Claude API)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "Weekly Cron Trigger (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "GITHUB_REPO",
              "value": "={{ $env.GITHUB_REPO || 'airdropia-collection/bounty-hunter' }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "LANGUAGE",
              "value": "={{ $env.LANGUAGE || 'EN' }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "WEEK_LOOKBACK_DAYS",
              "value": 7,
              "type": "number"
            },
            {
              "id": "4",
              "name": "CLAUDE_MODEL",
              "value": "claude-sonnet-4-20250514",
              "type": "string"
            },
            {
              "id": "5",
              "name": "DISCORD_WEBHOOK_URL",
              "value": "={{ $env.DISCORD_WEBHOOK_URL }}",
              "type": "string"
            },
            {
              "id": "6",
              "name": "EMAIL_ENABLED",
              "value": "={{ ($env.EMAIL_ENABLED || 'false').toLowerCase() === 'true' }}",
              "type": "boolean"
            },
            {
              "id": "7",
              "name": "SMTP_HOST",
              "value": "={{ $env.SMTP_HOST || '' }}",
              "type": "string"
            },
            {
              "id": "8",
              "name": "SMTP_USER",
              "value": "={{ $env.SMTP_USER || '' }}",
              "type": "string"
            },
            {
              "id": "9",
              "name": "SMTP_PASS",
              "value": "={{ $env.SMTP_PASS || '' }}",
              "type": "string"
            },
            {
              "id": "10",
              "name": "EMAIL_TO",
              "value": "={{ $env.EMAIL_TO || '' }}",
              "type": "string"
            },
            {
              "id": "11",
              "name": "EMAIL_FROM",
              "value": "={{ $env.EMAIL_FROM || 'dev-summary@n8n.local' }}",
              "type": "string"
            },
            {
              "id": "12",
              "name": "GITHUB_TOKEN",
              "value": "={{ $env.GITHUB_TOKEN }}",
              "type": "string"
            },
            {
              "id": "13",
              "name": "ANTHROPIC_API_KEY",
              "value": "={{ $env.ANTHROPIC_API_KEY }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000002",
      "name": "Load Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_REPO }}/commits",
        "sendQuery": true,
        "queryParameters": [
          {
            "name": "since",
            "value": "={{ $now.minus({days: $json.WEEK_LOOKBACK_DAYS}).toISO() }}"
          },
          {
            "name": "per_page",
            "value": "100"
          }
        ],
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000003",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        180
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Load Config').item.json.GITHUB_REPO }}/issues",
        "sendQuery": true,
        "queryParameters": [
          {
            "name": "state",
            "value": "closed"
          },
          {
            "name": "since",
            "value": "={{ $now.minus({days: $('Load Config').item.json.WEEK_LOOKBACK_DAYS}).toISO() }}"
          },
          {
            "name": "per_page",
            "value": "100"
          }
        ],
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Load Config').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000004",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        360
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Load Config').item.json.GITHUB_REPO }}/pulls",
        "sendQuery": true,
        "queryParameters": [
          {
            "name": "state",
            "value": "closed"
          },
          {
            "name": "sort",
            "value": "updated"
          },
          {
            "name": "direction",
            "value": "desc"
          },
          {
            "name": "per_page",
            "value": "100"
          }
        ],
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Load Config').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000005",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "// Consolidate the 3 GitHub API responses into a single payload.\n// n8n passes items from each upstream node; we read $('Fetch Commits').all() etc.\n\nconst config = $('Load Config').first().json;\nconst repo = config.GITHUB_REPO;\nconst language = (config.LANGUAGE || 'EN').toUpperCase();\nconst lookbackDays = config.WEEK_LOOKBACK_DAYS;\nconst since = new Date(Date.now() - lookbackDays * 86400 * 1000).toISOString();\n\nconst commits = ($('Fetch Commits').all() || []).map(i => i.json).filter(c => c.commit && c.commit.author && c.commit.author.date >= since);\nconst allIssues = ($('Fetch Closed Issues').all() || []).map(i => i.json).filter(i => !i.pull_request); // exclude PRs (GitHub returns them in issues endpoint too)\nconst allPRs = ($('Fetch Merged PRs').all() || []).map(i => i.json);\nconst mergedPRs = allPRs.filter(p => p.merged_at && p.merged_at >= since);\n\n// Build a structured digest for Claude\nconst digest = {\n  repo,\n  week_start: since,\n  week_end: new Date().toISOString(),\n  language,\n  stats: {\n    commits: commits.length,\n    closed_issues: allIssues.length,\n    merged_prs: mergedPRs.length,\n  },\n  commit_authors: [...new Set(commits.map(c => c.commit.author?.name).filter(Boolean))],\n  top_commits: commits.slice(0, 15).map(c => ({\n    sha: c.sha?.slice(0, 7),\n    author: c.commit.author?.name,\n    message: (c.commit.message || '').split('\\n')[0].slice(0, 120),\n    date: c.commit.author?.date,\n  })),\n  closed_issues: allIssues.slice(0, 10).map(i => ({\n    number: i.number,\n    title: i.title,\n    closed_at: i.closed_at,\n  })),\n  merged_prs: mergedPRs.slice(0, 10).map(p => ({\n    number: p.number,\n    title: p.title,\n    author: p.user?.login,\n    merged_at: p.merged_at,\n    additions: p.additions,\n    deletions: p.deletions,\n  })),\n};\n\nreturn [{ json: { config, digest, prompt_payload: JSON.stringify(digest, null, 2) } }];"
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000006",
      "name": "Consolidate Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.config.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.config.CLAUDE_MODEL }}\",\n  \"max_tokens\": 1500,\n  \"system\": \"{{ $json.config.LANGUAGE === 'FR' ? 'Tu es un ingénieur logiciel senior qui rédige des résumés hebdomadaires de développement. Réponds en français. Sois concis, factuel et structuré.' : 'You are a senior software engineer writing weekly development summaries. Be concise, factual, and well-structured.' }}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.config.LANGUAGE === 'FR' ? 'Rédige un résumé narratif hebdomadaire pour ce dépôt GitHub.\\n\\nDonnées JSON:\\n' + $json.prompt_payload + '\\n\\nFormat de sortie (Markdown):\\n- Titre avec le nom du dépôt et la période\\n- Paragraphe d’aperçu (commits, issues, PRs fusionnées)\\n- Section “Points forts” (3-5 puces)\\n- Section “Détails techniques” (changements notables)\\n- Section “Prochaines étapes” (recommandations)\\n\\nLimite: 400 mots.' : 'Write a narrative weekly summary for this GitHub repo.\\n\\nJSON data:\\n' + $json.prompt_payload + '\\n\\nOutput format (Markdown):\\n- Title with repo name and date range\\n- Overview paragraph (commits, issues, merged PRs)\\n- Highlights section (3-5 bullets)\\n- Technical details section (notable changes)\\n- Next steps section (recommendations)\\n\\nLimit: 400 words.' }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000007",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1180,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract Claude's narrative summary from the API response.\n// Claude returns { content: [{ type: 'text', text: '...' }] }\n\nconst response = $input.first().json;\nconst config = $('Load Config').first().json;\n\nlet summary = '';\nif (response && Array.isArray(response.content)) {\n  summary = response.content.filter(b => b.type === 'text').map(b => b.text).join('\\n');\n} else if (typeof response === 'string') {\n  summary = response;\n} else {\n  summary = '⚠️ Could not parse Claude API response. Raw: ' + JSON.stringify(response).slice(0, 500);\n}\n\n// Prepend metadata header\nconst meta = `**${config.LANGUAGE === 'FR' ? 'Résumé Hebdomadaire' : 'Weekly Summary'}** — \\`${config.GITHUB_REPO}\\`\\n_Week of ${new Date(Date.now() - 7 * 86400 * 1000).toISOString().slice(0, 10)} to ${new Date().toISOString().slice(0, 10)}_\\n\\n`;\n\nreturn [{ json: { summary: meta + summary, language: config.LANGUAGE, repo: config.GITHUB_REPO } }];"
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000008",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load Config').first().json.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"{{ $json.summary.length > 1900 ? $json.summary.slice(0, 1900) + '\\n…(truncated)' : $json.summary }}\",\n  \"username\": \"Dev Summary Bot\",\n  \"allowed_mentions\": { \"parse\": [] }\n}",
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000009",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "host": "={{ $('Load Config').first().json.SMTP_HOST }}",
        "port": 587,
        "secure": false,
        "auth": {
          "user": "={{ $('Load Config').first().json.SMTP_USER }}",
          "pass": "={{ $('Load Config').first().json.SMTP_PASS }}"
        },
        "fromEmail": "={{ $('Load Config').first().json.EMAIL_FROM }}",
        "toEmail": "={{ $('Load Config').first().json.EMAIL_TO }}",
        "emailSubject": "=Weekly Dev Summary — {{ $('Format Output').first().json.repo }} ({{ new Date().toISOString().slice(0,10) }})",
        "emailFormat": "markdown",
        "message": "={{ $('Format Output').first().json.summary }}",
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000010",
      "name": "Send Email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1680,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $('Load Config').first().json.EMAIL_ENABLED }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000011",
      "name": "Email Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1.2,
      "position": [
        1440,
        480
      ]
    }
  ],
