{
  "name": "Weekly GitHub Dev Summary with Claude Code (claude-sonnet-4-20250514)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "1a01b2c3-0001-4000-8000-000000000001",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-repo",
              "name": "GITHUB_REPO",
              "value": "={{ $env.GITHUB_REPO || 'claude-builders-bounty/claude-builders-bounty' }}",
              "type": "string"
            },
            {
              "id": "cfg-webhook",
              "name": "DESTINATION_WEBHOOK_URL",
              "value": "={{ $env.DESTINATION_WEBHOOK_URL || 'https://discord.com/api/webhooks/replace-me' }}",
              "type": "string"
            },
            {
              "id": "cfg-lang",
              "name": "SUMMARY_LANGUAGE",
              "value": "={{ $env.SUMMARY_LANGUAGE || 'EN' }}",
              "type": "string"
            },
            {
              "id": "cfg-since",
              "name": "SINCE_ISO",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "1a01b2c3-0002-4000-8000-000000000002",
      "name": "Configure Variables (Repo, Channel, EN/FR)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_REPO }}/commits?since={{ $json.SINCE_ISO }}&per_page=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-claude-weekly-summary"
            }
          ]
        }
      },
      "id": "1a01b2c3-0003-4000-8000-000000000003",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Configure Variables (Repo, Channel, EN/FR)').item.json.GITHUB_REPO }}/issues?state=closed&since={{ $('Configure Variables (Repo, Channel, EN/FR)').item.json.SINCE_ISO }}&per_page=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-claude-weekly-summary"
            }
          ]
        }
      },
      "id": "1a01b2c3-0004-4000-8000-000000000004",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Configure Variables (Repo, Channel, EN/FR)').item.json.GITHUB_REPO }}/pulls?state=closed&sort=updated&direction=desc&per_page=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-claude-weekly-summary"
            }
          ]
        }
      },
      "id": "1a01b2c3-0005-4000-8000-000000000005",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 480]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Configure Variables (Repo, Channel, EN/FR)').first().json;\nconst sinceTs = new Date(cfg.SINCE_ISO).getTime();\nconst commits = $('Fetch Weekly Commits').all().map(i => i.json).filter(c => c && c.sha);\nconst closedIssues = $('Fetch Closed Issues').all().map(i => i.json).filter(x => x && !x.pull_request);\nconst mergedPrs = $('Fetch Merged PRs').all().map(i => i.json).filter(p => p && p.merged_at && new Date(p.merged_at).getTime() >= sinceTs);\n\nconst langInstruction = cfg.SUMMARY_LANGUAGE === 'FR'\n  ? 'Write the weekly engineering narrative summary in French (FR).'\n  : 'Write the weekly engineering narrative summary in English (EN).';\n\nconst prompt = `${langInstruction}\\nRepository: ${cfg.GITHUB_REPO}\\nPeriod Since: ${cfg.SINCE_ISO}\\n\\nCommits (${commits.length}):\\n${commits.slice(0, 20).map(c => '- ' + (c.commit?.message || '').split('\\n')[0]).join('\\n')}\\n\\nClosed Issues (${closedIssues.length}):\\n${closedIssues.slice(0, 20).map(i => '- #' + i.number + ' ' + i.title).join('\\n')}\\n\\nMerged PRs (${mergedPrs.length}):\\n${mergedPrs.slice(0, 20).map(p => '- #' + p.number + ' ' + p.title).join('\\n')}`;\n\nreturn [{ json: { ...cfg, prompt, stats: { commits: commits.length, closedIssues: closedIssues.length, mergedPrs: mergedPrs.length } } }];"
      },
      "id": "1a01b2c3-0006-4000-8000-000000000006",
      "name": "Aggregate Weekly GitHub Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}"
      },
      "id": "1a01b2c3-0007-4000-8000-000000000007",
      "name": "Generate Narrative Summary (claude-sonnet-4-20250514)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Aggregate Weekly GitHub Activity').item.json.DESTINATION_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": {{ JSON.stringify($json.content?.[0]?.text || 'Weekly summary generated.') }},\n  \"text\": {{ JSON.stringify($json.content?.[0]?.text || 'Weekly summary generated.') }}\n}"
      },
      "id": "1a01b2c3-0008-4000-8000-000000000008",
      "name": "Deliver Summary to Discord / Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 320]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [
        [
          {
            "node": "Configure Variables (Repo, Channel, EN/FR)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure Variables (Repo, Channel, EN/FR)": {
      "main": [
        [
          {
            "node": "Fetch Weekly Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Aggregate Weekly GitHub Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Aggregate Weekly GitHub Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Aggregate Weekly GitHub Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Weekly GitHub Activity": {
      "main": [
        [
          {
            "node": "Generate Narrative Summary (claude-sonnet-4-20250514)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Narrative Summary (claude-sonnet-4-20250514)": {
      "main": [
        [
          {
            "node": "Deliver Summary to Discord / Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
