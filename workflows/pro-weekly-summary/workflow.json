{
  "name": "J.A.R.V.I.S. Pro Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "interval": 1,
              "dayOfWeek": [
                5
              ],
              "hour": 17
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "resource": "repository",
        "operation": "get",
        "owner": "={{ $json.GITHUB_OWNER }}",
        "repository": "={{ $json.GITHUB_REPO }}"
      },
      "id": "2",
      "name": "Fetch Repo Info",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "prompt": "Generate a weekly narrative summary of this repo activity. Focus on impact and key changes. Language: {{ $json.LANGUAGE }}. Style: {{ $json.STYLE }}",
        "options": {}
      },
      "id": "3",
      "name": "Claude AI Analysis",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}"
      },
      "id": "4",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Repo Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Repo Info": {
      "main": [
        [
          {
            "node": "Claude AI Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude AI Analysis": {
      "main": [
        [
          {
            "node": "Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
