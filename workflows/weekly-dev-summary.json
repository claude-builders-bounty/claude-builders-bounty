        }
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000006",
      "name": "📥 GitHub — PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        520
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => ({\n  json: { ...item.json, _source: 'commits' }\n}));"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000011",
      "name": "🏷️ Tag — Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => ({\n  json: { ...item.json, _source: 'issues' }\n}));"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000012",
      "name": "🏷️ Tag — Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => ({\n  json: { ...item.json, _source: 'prs' }\n}));"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000013",
      "name": "🏷️ Tag — PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        520
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000014",
      "name": "🔀 Merge Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst firstItem = items.find(i => i.json.repoOwner) || items[0];\nconst repoOwner = firstItem.json.repoOwner || 'your-org';\nconst repoName = firstItem.json.repoName || 'your-repo';\nconst language = firstItem.json.language || 'EN';\nconst weekLabel = (items.find(i => i.json.weekLabel)?.json?.weekLabel) || '';\nconst since = (items.find(i => i.json.since)?.json?.since) || '';\nconst until = (items.find(i => i.json.until)?.json?.until) || '';\nconst commits = items.filter(i => i.json._source === 'commits');\nconst issues = items.filter(i => i.json._source === 'issues');\nconst prs = items.filter(i => i.json._source === 'prs');\nconst closedIssues = issues.filter(i => i.json.closed_at && new Date(i.json.closed_at) >= new Date(since));\nconst mergedPRs = prs.filter(p => p.json.merged_at && new Date(p.json.merged_at) >= new Date(since));\nconst commitList = commits.map(c => {\n  const author = c.json.commit?.author?.name || c.json.commit?.committer?.name || 'Unknown';\n  const msg = (c.json.commit?.message || 'No message').split('\\n')[0];\n  const sha = (c.json.sha || '').slice(0, 7);\n  return `  - \\`${sha}\\` ${author}: ${msg}`;\n}).join('\\n') || '  (none)';\nconst issueList = closedIssues.map(i => `  - #${i.json.number} ${i.json.title}`).join('\\n') || '  (none)';\nconst prList = mergedPRs.map(p => `  - #${p.json.number} ${p.json.title} (by ${p.json.user?.login || 'Unknown'})`).join('\\n') || '  (none)';\nconst promptLang = language === 'FR' ? 'French' : 'English';\nconst summaryPrompt = `Generate a ${promptLang} narrative summary of the past week's development activity for the GitHub repository ${repoOwner}/${repoName} (${weekLabel}).\"\n\"\n## Commits (${commits.length} total):\"\n${commitList}\"\n\"\n## Issues Closed (${closedIssues.length} total):\"\n${issueList}\"\n\"\n## Pull Requests Merged (${mergedPRs.length} total):\"\n${prList}\"\n\"\nWrite an engaging, informative summary in ${promptLang} highlighting key themes, major changes, and notable contributions. Focus on what's most impactful for the team.`;\nreturn [{\n  json: {\n    repoOwner,\n    repoName,\n    language,\n    weekLabel,\n    commitCount: commits.length,\n    issueCount: closedIssues.length,\n    prCount: mergedPRs.length,\n    summaryPrompt\n  }\n}];"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000007",
      "name": "🔀 Combine & Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $json.claudeModel }}"
            },
            {
              "name": "max_tokens",
              "value": "2000"
            },
            {
              "name": "system",
              "value": "You are a technical writing assistant. Generate clear, engaging weekly development summaries."
            },
            {
              "name": "messages[0][role]",
              "value": "user"
            },
            {
              "name": "messages[0][content]",
              "value": "={{ $json.summaryPrompt }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000008",
      "name": "🤖 Claude API — Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Claude API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json;\nlet narrative = '';\ntry {\n  if (output.content && Array.isArray(output.content)) {\n    narrative = output.content.map(c => c.text || '').join('\\n');\n  } else if (typeof output.content === 'string') {\n    narrative = output.content;\n  } else {\n    narrative = JSON.stringify(output);\n  }\n} catch (e) {\n  narrative = 'Failed to parse Claude response.';\n}\nconst summary = `📊 **Weekly Dev Summary** — ${output.weekLabel || 'this week'}\\n\\n📂 \\`${output.repoOwner}/${output.repoName}\\`\\n📝 ${output.commitCount} commits  •  🔒 ${output.issueCount} issues closed  •  🔀 ${output.prCount} PRs merged\\n\\n${narrative}`;\nreturn [{\n  json: {\n    summaryMessage: summary,\n    narrative,\n    weekLabel: output.weekLabel,\n    repoOwner: output.repoOwner,\n    repoName: output.repoName,\n    commitCount: output.commitCount,\n    issueCount: output.issueCount,\n    prCount: output.prCount\n  }\n}];"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000009",
      "name": "📝 Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.summaryMessage }}"
            }
          ]
        },
        "authentication": "none",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000010",
      "name": "📬 Discord Webhook — Deliver",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2480,
        300
      ]
    }
