{
  "name": "Claude Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "repo_owner",
              "value": "={{ $env[\"GITHUB_REPO_OWNER\"] || \"anthropic\" }}"
            },
            {
              "name": "repo_name",
              "value": "={{ $env[\"GITHUB_REPO_NAME\"] || \"claude-code\" }}"
            },
            {
              "name": "language",
              "value": "={{ $env[\"SUMMARY_LANGUAGE\"] || \"EN\" }}"
            },
            {
              "name": "webhook_url",
              "value": "={{ $env[\"DISCORD_WEBHOOK_URL\"] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "repository",
        "operation": "getIssues",
        "owner": "={{ $json.repo_owner }}",
        "repository": "={{ $json.repo_name }}",
        "state": "closed",
        "since": "={{ $now.minus({days: 7}).toISO() }}"
      },
      "name": "GitHub (Get Activity)",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-api-key",
              "value": "={{ $env[\"ANTHROPIC_API_KEY\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20241022"
            },
            {
              "name": "max_tokens",
              "value": "2000"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"Write a weekly narrative dev summary for the repo {{ $('Set Config Variables').item.json.repo_owner }}/{{ $('Set Config Variables').item.json.repo_name }} based on the following recent activity data. Write the summary in {{ $('Set Config Variables').item.json.language }}:\\n\\n{{ JSON.stringify($json) }}\"}]"
            }
          ]
        }
      },
      "name": "Claude API (Generate Summary)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 850, 300 ]
    },
    {
      "parameters": {
        "webhookUri": "={{ $('Set Config Variables').item.json.webhook_url }}",
        "text": "={{ $json.content[0].text }}"
      },
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [ 1050, 300 ]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [ [ { "node": "Set Config Variables", "type": "main", "index": 0 } ] ]
    },
    "Set Config Variables": {
      "main": [ [ { "node": "GitHub (Get Activity)", "type": "main", "index": 0 } ] ]
    },
    "GitHub (Get Activity)": {
      "main": [ [ { "node": "Claude API (Generate Summary)", "type": "main", "index": 0 } ] ]
    },
    "Claude API (Generate Summary)": {
      "main": [ [ { "node": "Discord Webhook", "type": "main", "index": 0 } ] ]
    }
  },
  "active": false,
  "settings": {}
}