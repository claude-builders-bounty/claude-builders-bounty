        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-api-key",
              "value": "={{$('Workflow Config').first().json.anthropicApiKey}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.anthropicBody}}",
        "options": {}
      },
      "id": "72316da9-2a21-462d-8b52-c31bb827a38f",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const request = $('Build Claude Request').first().json;\nconst claude = $input.first().json;\nconst summary = (claude.content || [])\n  .filter((part) => part.type === 'text')\n  .map((part) => part.text)\n  .join('\\n\\n')\n  .trim();\n\nif (!summary) {\n  throw new Error('Claude API returned no text summary.');\n}\n\nreturn [{\n  json: {\n    slackWebhookUrl: request.slackWebhookUrl,\n    summary,\n    slackPayload: {\n      channel: request.slackChannel || undefined,\n      text: `Weekly development summary for ${request.repo}`,\n      blocks: [\n        {\n          type: 'header',\n          text: {\n            type: 'plain_text',\n            text: `Weekly dev summary: ${request.repo}`\n          }\n        },\n        {\n          type: 'context',\n          elements: [\n            {\n              type: 'mrkdwn',\n              text: `${request.sinceIso.slice(0, 10)} to ${request.untilIso.slice(0, 10)} | ${request.commitCount} commits | ${request.pullRequestCount} merged PRs | ${request.issueCount} issues`\n            }\n          ]\n        },\n        {\n          type: 'section',\n          text: {\n            type: 'mrkdwn',\n            text: summary.length > 2900 ? `${summary.slice(0, 2890)}...` : summary\n          }\n        }\n      ]\n    }\n  }\n}];"
      },
      "id": "f65a9baf-3ca4-4dd1-b6b6-3f46efd545f4",
