      "id": "b4681134-d82d-4243-88c9-80ce22dd620f",
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Workflow Config').first().json;\nconst since = new Date(config.sinceIso);\nconst until = new Date(config.untilIso);\nconst repoSlug = `${config.owner}/${config.repo}`;\n\nfor (const [key, value] of Object.entries(config)) {\n  if (['owner', 'repo', 'githubToken', 'anthropicApiKey', 'slackWebhookUrl'].includes(key) && !value) {\n    throw new Error(`Missing required environment variable for ${key}.`);\n  }\n}\n\nfunction flatten(nodeName) {\n  const values = $items(nodeName).map((item) => item.json);\n  return values.length === 1 && Array.isArray(values[0]) ? values[0] : values;\n}\n\nfunction compactCommit(commit) {\n  return {\n    sha: commit.sha?.slice(0, 7),\n    message: commit.commit?.message?.split('\\n')[0],\n    author: commit.commit?.author?.name,\n    date: commit.commit?.author?.date,\n    url: commit.html_url\n  };\n}\n\nfunction compactPullRequest(pr) {\n  return {\n    number: pr.number,\n    title: pr.title,\n    author: pr.user?.login,\n    mergedAt: pr.merged_at,\n    url: pr.html_url\n  };\n}\n\nfunction compactIssue(issue) {\n  return {\n    number: issue.number,\n    title: issue.title,\n    author: issue.user?.login,\n    closedAt: issue.closed_at,\n    url: issue.html_url\n  };\n}\n\nconst commits = flatten('GitHub Commits').map(compactCommit).slice(0, 50);\nconst issues = flatten('GitHub Closed Issues')\n  .filter((issue) => !issue.pull_request)\n  .filter((issue) => issue.closed_at && new Date(issue.closed_at) >= since && new Date(issue.closed_at) <= until)\n  .map(compactIssue)\n  .slice(0, 30);\nconst pullRequests = flatten('GitHub Merged PRs')\n  .filter((pr) => pr.merged_at && new Date(pr.merged_at) >= since && new Date(pr.merged_at) <= until)\n  .map(compactPullRequest)\n  .slice(0, 30);\nconst language = String(config.language || 'EN').toUpperCase() === 'FR' ? 'French' : 'English';\n\nconst prompt = `You are preparing a concise weekly development summary for ${repoSlug}.\n\nWrite in ${language}.\n\nCover:\n- Main product or engineering themes\n- Important merged pull requests\n- Notable commits\n- Closed issues\n- Risks, blockers, or follow-up items if the data suggests any\n\nKeep it useful for a busy engineering team. Use Markdown. Avoid inventing facts not supported by the GitHub data.\n\nTime window: ${config.sinceIso} to ${config.untilIso}\n\nCommits:\n${JSON.stringify(commits, null, 2)}\n\nMerged pull requests:\n${JSON.stringify(pullRequests, null, 2)}\n\nClosed issues:\n${JSON.stringify(issues, null, 2)}`;\n\nreturn [{\n  json: {\n    repo: repoSlug,\n    sinceIso: config.sinceIso,\n    untilIso: config.untilIso,\n    language: config.language || 'EN',\n    model: config.model,\n    slackWebhookUrl: config.slackWebhookUrl,\n    slackChannel: config.slackChannel,\n    commitCount: commits.length,\n    pullRequestCount: pullRequests.length,\n    issueCount: issues.length,\n    anthropicBody: {\n      model: config.model,\n      max_tokens: 1400,\n      temperature: 0.2,\n      messages: [\n        {\n          role: 'user',\n          content: prompt\n        }\n      ]\n    }\n  }\n}];"
      },
      "id": "23668095-cd8a-4206-92f6-51e9ea6eb5ba",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
