{
  "name": "Weekly Dev Summary — Claude Code",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Weekly Friday 5PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repository || $vars.GITHUB_REPO }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({weeks: 1}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repository || $vars.GITHUB_REPO }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $now.minus({weeks: 1}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repository || $vars.GITHUB_REPO }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 600],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Combine all fetched data into a structured payload for Claude\nconst commits = $input.first().json;\nconst issues = $input.all().find(i => i.json.url?.includes('/issues'))?.json || [];\nconst prs = $input.all().find(i => i.json.url?.includes('/pulls'))?.json || [];\n\nconst now = $now;\nconst weekAgo = $now.minus({ weeks: 1 });\n\n// Format commits\nconst commitList = Array.isArray(commits) ? commits : [commits];\nconst formattedCommits = commitList.map(c => ({\n  sha: c.sha?.substring(0, 7),\n  message: c.commit?.message?.split('\\n')[0],\n  author: c.commit?.author?.name,\n  date: c.commit?.author?.date\n}));\n\n// Format issues\nconst issueList = Array.isArray(issues) ? issues : [issues];\nconst formattedIssues = issueList\n  .filter(i => i.pull_request === undefined)\n  .map(i => ({\n    number: i.number,\n    title: i.title,\n    labels: i.labels?.map(l => l.name) || []\n  }));\n\n// Format PRs\nconst prList = Array.isArray(prs) ? prs : [prs];\nconst formattedPRs = prList\n  .filter(p => p.merged_at)\n  .map(p => ({\n    number: p.number,\n    title: p.title,\n    author: p.user?.login,\n    merged: p.merged_at\n  }));\n\nreturn [{\n  json: {\n    repo: $vars.GITHUB_REPO || 'unknown/repo',\n    period: `${weekAgo.toFormat('yyyy-MM-dd')} to ${now.toFormat('yyyy-MM-dd')}`,\n    stats: {\n      commits: formattedCommits.length,\n      issuesClosed: formattedIssues.length,\n      prsMerged: formattedPRs.length\n    },\n    commits: formattedCommits,\n    issues: formattedIssues,\n    prs: formattedPRs,\n    language: $vars.SUMMARY_LANGUAGE || 'EN'\n  }\n}];"
      },
      "id": "merge-data",
      "name": "Merge & Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $vars.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a technical writer generating a weekly development summary.\\n\\nRepository: {{ $json.repo }}\\nPeriod: {{ $json.period }}\\n\\nStats:{{ $json.stats.commits }} commits, {{ $json.stats.issuesClosed }} issues closed, {{ $json.stats.prsMerged }} PRs merged\\n\\nCommits:\\n{{ JSON.stringify($json.commits, null, 2) }}\\n\\nClosed Issues:\\n{{ JSON.stringify($json.issues, null, 2) }}\\n\\nMerged PRs:\\n{{ JSON.stringify($json.prs, null, 2) }}\\n\\nGenerate a clear, professional weekly dev summary in {{ $json.language === 'FR' ? 'French' : 'English' }}. Include:\\n1. Overview of the week\\n2. Key accomplishments\\n3. Notable changes\\n4. Statistics\\n\\nFormat as a well-structured markdown document.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-api",
      "name": "Claude API — Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst summaryText = response.content?.[0]?.text || 'No summary generated.';\n\nreturn [{\n  json: {\n    subject: `Weekly Dev Summary — ${$json.repo || $vars.GITHUB_REPO}`,\n    body: summaryText,\n    repo: $json.repo || $vars.GITHUB_REPO,\n    period: $json.period\n  }\n}];"
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"## {{ $json.subject }}\\n\\n**Period:** {{ $json.period }}\\n\\n{{ $json.body }}\"\n}",
        "options": {}
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 400],
      "disabled": true,
      "notes": "Enable this node and disable 'Send Email' to use Discord delivery"
    },
    {
      "parameters": {
        "fromEmail": "={{ $vars.SENDER_EMAIL || 'bot@example.com' }}",
        "toEmail": "={{ $vars.DEST_EMAIL || 'team@example.com' }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1440, 600],
      "notes": "Enable this node and disable 'Send Discord' to use Email delivery"
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Operation",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1680, 400]
    }
  ],
