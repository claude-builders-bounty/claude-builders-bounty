{
  "name": "Weekly GitHub Dev Summary (n8n + Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Friday 5PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "until",
              "value": "={{ new Date().toISOString() }}"
            },
            {
              "name": "repo",
              "value": "={{ $('Repo').value }}"
            },
            {
              "name": "language",
              "value": "={{ $('Language').value }}"
            },
            {
              "name": "thisFriday",
              "value": "={{ new Date().toISOString().split('T')[0] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-dates",
      "name": "Set Date Range",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Repo').value }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('GitHub Token').value }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "until",
              "value": "={{ $json.until }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "gh-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 200]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Repo').value }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('GitHub Token').value }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            }
          ]
        },
        "options": {}
      },
      "id": "gh-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 350]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Repo').value }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('GitHub Token').value }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "gh-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 500]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate GitHub data and build prompt for Claude\nconst commits = $input.first().json;\nconst issues = $('Fetch Closed Issues').first().json;\nconst prs = $('Fetch Merged PRs').first().json;\nconst since = $('Set Date Range').first().json.since;\nconst until = $('Set Date Range').first().json.until;\nconst repo = $('Set Date Range').first().json.repo;\nconst lang = $('Set Date Range').first().json.language || 'EN';\n\n// Filter merged PRs from this week\nconst mergedPRs = Array.isArray(prs) ? prs\n  .filter(p => p.merged_at && new Date(p.merged_at) >= new Date(since))\n  .map(p => ({\n    title: p.title,\n    number: p.number,\n    author: p.user?.login,\n    merged_at: p.merged_at\n  })) : [];\n\n// Filter closed issues from this week\nconst closedIssues = Array.isArray(issues) ? issues\n  .filter(i => !i.pull_request && new Date(i.closed_at) >= new Date(since))\n  .map(i => ({\n    title: i.title,\n    number: i.number,\n    author: i.user?.login,\n    closed_at: i.closed_at\n  })) : [];\n\n// Recent commits\nconst recentCommits = Array.isArray(commits) ? commits\n  .slice(0, 30)\n  .map(c => ({\n    message: c.commit?.message?.split('\\n')[0],\n    author: c.commit?.author?.name || c.author?.login,\n    sha: c.sha?.substring(0, 7)\n  })) : [];\n\nconst systemPrompt = lang === 'FR'\n  ? \"Tu es un assistant technique. Resume de developpement hebdomadaire concis et precis. Format: Markdown.\"\n  : \"You are a technical assistant. Write a concise weekly development summary. Format: Markdown.\";\n\nconst userPrompt = `Generate a weekly development summary for ${repo}.\n\nPeriod: ${since} to ${until}\n\nCommits (${recentCommits.length}):\n${recentCommits.map(c => `- ${c.sha} ${c.message} (${c.author})`).join('\\n')}\n\nClosed Issues (${closedIssues.length}):\n${closedIssues.map(i => `- #${i.number} ${i.title} (${i.author})`).join('\\n')}\n\nMerged PRs (${mergedPRs.length}):\n${mergedPRs.map(p => `- #${p.number} ${p.title} (${p.author})`).join('\\n')}\n\nFormat:\n# Weekly Dev Summary - ${repo}\n## Highlights\n## What's New\n## Fixes\n## Merged PRs\n| # | Title | Author |\n## Contributors\n## Stats\n\nIn ${lang}. Only the formatted summary, no extra text.`;\n\nreturn { systemPrompt, userPrompt, repo, lang };\n"
      },
      "id": "build-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Anthropic API Key').value }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 4096
            },
            {
              "name": "system",
              "value": "={{ $json.systemPrompt }}"
            },
            {
              "name": "messages[0].role",
              "value": "user"
            },
            {
              "name": "messages[0].content",
              "value": "={{ $json.userPrompt }}"
            }
          ]
        },
        "options": {
          "bodyContentType": "json"
        }
      },
      "id": "claude-api",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst repo = $('Build Claude Prompt').first().json.repo;\nconst thisFriday = $('Set Date Range').first().json.thisFriday;\n\nlet summary = '';\nif (response.content && Array.isArray(response.content)) {\n  summary = response.content\n    .filter(c => c.type === 'text')\n    .map(c => c.text)\n    .join('\\n');\n} else if (response.error) {\n  summary = `CLAUDE ERROR: ${JSON.stringify(response.error)}`;\n} else {\n  summary = 'UNEXPECTED Claude API response format. Check n8n execution log.';\n}\n\nconst subject = `Weekly Dev Summary - ${repo} (${thisFriday})`;\n\nreturn { subject, summary, repo, date: thisFriday };\n"
      },
      "id": "format-summary",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('SMTP From').value }}",
        "toEmail": "={{ $('SMTP To').value }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.summary }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1450, 300]
    }
  ],
  "connections": {
    "Every Friday 5PM": {
      "main": [
        [
          {
            "node": "Set Date Range",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Date Range": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Build Claude Prompt": {
      "main": [
        [
          {
            "node": "Call Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Claude API": {
      "main": [
        [
          {
            "node": "Format Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Summary": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    { "name": "weekly" },
    { "name": "github" },
    { "name": "claude" },
    { "name": "dev-summary" }
  ]
}
