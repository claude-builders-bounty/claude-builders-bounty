{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "days": 7
            }
          ],
          "dateRange": {
            "startDate": "{{now}}",
            "endDate": "{{now}}"
          },
          "timezone": "UTC"
        },
        "options": {}
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "githubPersonalAccessToken",
        "operation": "read",
        "resource": "repo",
        "repository": "={{$githubRepo}}",
        "requestBody": "",
        "path": "/commits?since={{$startDate}}&until={{$endDate}}",
        "options": {}
      },
      "id": "2",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.githubApi",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "githubPersonalAccessToken",
        "operation": "read",
        "resource": "issues",
        "repository": "={{$githubRepo}}",
        "requestBody": "",
        "path": "/?state=closed&since={{$startDate}}&until={{$endDate}}",
        "options": {}
      },
      "id": "3",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.githubApi",
      "typeVersion": 1,
      "position": [
        440,
        380
      ]
    },
    {
      "parameters": {
        "authentication": "githubPersonalAccessToken",
        "operation": "read",
        "resource": "pulls",
        "repository": "={{$githubRepo}}",
        "requestBody": "",
        "path": "/?state=closed&since={{$startDate}}&until={{$endDate}}",
        "options": {}
      },
      "id": "4",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.githubApi",
      "typeVersion": 1,
      "position": [
        440,
        460
      ]
    },
    {
      "parameters": {
        "mode": "merge",
        "options": {}
      },
      "id": "5",
      "name": "Combine Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        640,
        380
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "Generate a weekly development summary in {{$language}} for the GitHub repository {{$githubRepo}}.\n\nHere are the recent commits:\n{{JSON.stringify($json.commits)}}\n\nHere are the closed issues:\n{{JSON.stringify($json.issues)}}\n\nHere are the merged pull requests:\n{{JSON.stringify($json.prs)}}\n\nProvide a narrative summary of development activity for the week, highlighting key features, bug fixes, and notable contributions. Format as a well-structured markdown document with clear sections.",
        "temperature": 0.7,
        "maxTokens": 2000
      },
      "id": "6",
      "name": "Generate Summary with Claude",
      "type": "n8n-nodes-base.claude",
      "typeVersion": 1,
      "position": [
        840,
        380
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "url": "={{$webhookUrl}}",
        "sendHeaders": true,
        "headerParameters": {},
        "sendBody": true,
        "bodyParameters": {
          "text": "Weekly Dev Summary for {{$githubRepo}}\n\n{{{$json.summary}}}"
        },
        "options": {}
      },
      "id": "7",
      "name": "Send Slack Notification",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        1040,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format date for GitHub API\nconst date = new Date();\nconst endDate = date.toISOString();\nconst startDate = new Date(date.getTime() - 7 * 24 * 60 * 60 * 1000).toISOString();\n\nreturn {
  startDate,
  endDate,
  githubRepo: $githubRepo || 'claude-builders-bounty/claude-builders-bounty',
  webhookUrl: $webhookUrl || '',
  language: $language || 'EN'
};"
      },
      "id": "8",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        240
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Combine Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Combine Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Combine Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine Data": {
      "main": [
        [
          {
            "node": "Prepare Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Data": {
      "main": [
        [
          {
            "node": "Generate Summary with Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary with Claude": {
      "main": [
        [
          {
            "node": "Send Slack Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2024-01-01T00:00:00.000Z",
  "versionId": "1"
}