{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.cron",
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{$json.repo_url}}/commits?since={{$json.week_start}}&until={{$json.week_end}}",
        "options": {
          "headers": {
            "Authorization": "Bearer {{$json.github_token}}",
            "Accept": "application/vnd.github.v3+json"
          }
        }
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 200]
    },
    {
      "parameters": {
        "url": "={{$json.repo_url}}/issues?state=closed&since={{$json.week_start}}",
        "options": {
          "headers": {
            "Authorization": "Bearer {{$json.github_token}}",
            "Accept": "application/vnd.github.v3+json"
          }
        }
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 400]
    },
    {
      "parameters": {
        "url": "={{$json.repo_url}}/pulls?state=closed&sort=updated&direction=desc",
        "options": {
          "headers": {
            "Authorization": "Bearer {{$json.github_token}}",
            "Accept": "application/vnd.github.v3+json"
          }
        }
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 600]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst commits = items[0]?.json || [];\nconst issues = items[1]?.json || [];\nconst prs = items[2]?.json || [];\n\n// Filter merged PRs only\nconst mergedPRs = prs.filter(pr => pr.merged_at !== null);\n\n// Build summary data\nreturn [{\n  json: {\n    repo: $('Set Variables').first().json.repo_name,\n    week_start: $('Set Variables').first().json.week_start,\n    week_end: $('Set Variables').first().json.week_end,\n    commit_count: commits.length,\n    commits: commits.map(c => ({ message: c.commit.message, author: c.commit.author.name, date: c.commit.author.date })),\n    closed_issues: issues.length,\n    issues_list: issues.map(i => ({ title: i.title, number: i.number })),\n    merged_prs: mergedPRs.length,\n    prs_list: mergedPRs.map(pr => ({ title: pr.title, number: pr.number, author: pr.user.login }))\n  }\n}];"
      },
      "id": "aggregate-data",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "position": [600, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "headers": {
            "x-api-key": "={{$json.claude_api_key}}",
            "Content-Type": "application/json",
            "anthropic-version": "2023-06-01"
          }
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 2048,
          "messages": [
            {
              "role": "user",
              "content": "Generate a weekly development summary for the repository {{$json.repo}} for the period {{$json.week_start}} to {{$json.week_end}}.\n\nStats:\n- Commits: {{$json.commit_count}}\n- Closed Issues: {{$json.closed_issues}}\n- Merged PRs: {{$json.merged_prs}}\n\nCommits:\n{{$json.commits}}\n\nClosed Issues:\n{{$json.issues_list}}\n\nMerged PRs:\n{{$json.prs_list}}\n\nWrite a concise, professional narrative summary (3-5 paragraphs) highlighting key changes, improvements, and milestones. Use {{$json.language || 'English'}}."
            }
          ]
        }
      },
      "id": "claude-api",
      "name": "Generate Summary (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [800, 400]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.content?.[0]?.text || 'No summary generated';\nreturn [{ json: { summary: content } }];"
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "position": [1000, 400]
    },
    {
      "parameters": {
        "fromEmail": "={{$json.sender_email}}",
        "toEmail": "={{$json.recipient_email}}",
        "subject": "📊 Weekly Dev Summary — {{$json.repo}} ({{$json.week_start}} to {{$json.week_end}})",
        "text": "={{$json.summary}}\n\n---\nGenerated by n8n + Claude Code"
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [[{ "node": "Set Variables", "type": "main", "index": 0 }]]
    },
    "Set Variables": {
      "main": [
        [{ "node": "Fetch Commits", "type": "main", "index": 0 }],
        [{ "node": "Fetch Closed Issues", "type": "main", "index": 0 }],
        [{ "node": "Fetch Merged PRs", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Commits": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 0 }]]
    },
    "Fetch Closed Issues": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 1 }]]
    },
    "Fetch Merged PRs": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 2 }]]
    },
    "Aggregate Data": {
      "main": [[{ "node": "Generate Summary (Claude)", "type": "main", "index": 0 }]]
    },
    "Generate Summary (Claude)": {
      "main": [[{ "node": "Extract Summary", "type": "main", "index": 0 }]]
    },
    "Extract Summary": {
      "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": {
    "repo_url": "https://api.github.com/repos/OWNER/REPO",
    "repo_name": "owner/repo",
    "github_token": "ghp_YOUR_GITHUB_TOKEN",
    "claude_api_key": "sk-ant-YOUR_CLAUDE_KEY",
    "sender_email": "n8n@yourdomain.com",
    "recipient_email": "team@yourdomain.com",
    "language": "en"
  }
}
