{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.github_repo }}/commits?since={{ $json.since }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits (GitHub API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 250]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.github_repo }}/issues?state=closed&since={{ $json.since }}&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        }
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues (GitHub API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 350]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.github_repo }}/pulls?state=closed&sort=updated&direction=desc&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        }
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs (GitHub API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 450]
    },
    {
      "parameters": {
        "jsCode": "// Compute weekly date range\nconst now = new Date();\nconst oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\n// Extract GitHub repo from config\nconst repo = $input.first().json.github_repo || 'owner/repo';\nconst apiBase = `https://api.github.com/repos/${repo}`;\n\nreturn {\n  github_repo: apiBase,\n  since: oneWeekAgo.toISOString(),\n  repo_name: repo,\n  week_start: oneWeekAgo.toISOString().split('T')[0],\n  week_end: now.toISOString().split('T')[0]\n};"
      },
      "id": "compute-dates",
      "name": "Compute Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all().filter(n => n.name === 'Fetch Commits')[0]?.json || [];\nconst issues = $input.all().filter(n => n.name === 'Fetch Closed Issues')[0]?.json || [];\nconst prs = $input.all().filter(n => n.name === 'Fetch Merged PRs')[0]?.json || [];\nconst meta = $('Compute Date Range').item.json;\n\nconst summary = `Weekly Dev Summary for ${meta.repo_name} (${meta.week_start} → ${meta.week_end})\\n\\nCommits: ${commits.length}\\nClosed Issues: ${issues.length}\\nMerged PRs: ${prs.length}\\n\\n---\\n\\n## Commits\\n${commits.slice(0, 10).map(c => `- ${c.commit?.message?.split('\\\\n')[0] || 'N/A'} (${c.sha?.slice(0,7)})`).join('\\\\n')}\\n\\n## Closed Issues\\n${issues.slice(0, 10).map(i => `- ${i.title} (#${i.number})`).join('\\\\n')}\\n\\n## Merged PRs\\n${prs.slice(0, 10).map(p => `- ${p.title} (#${p.number})`).join('\\\\n')}\\n\\n---\\n*Generated by n8n + Claude API workflow*`;\n\nreturn { summary, repo_name: meta.repo_name, week_start: meta.week_start, week_end: meta.week_end };\n"
      },
      "id": "aggregate-data",
      "name": "Aggregate GitHub Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.CLAUDE_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": 1024 },
            { "name": "system", "value": "You are a technical writer. Transform the raw weekly dev data into a concise, narrative summary. Highlight the most important changes, group related work, and use a professional but friendly tone. Respond in {{ $json.language || 'EN' }}." },
            { "name": "messages[0].role", "value": "user" },
            { "name": "messages[0].content", "value": "={{ $json.summary }}" }
          ]
        }
      },
      "id": "claude-summarize",
      "name": "Claude API — Narrative Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhook_url }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "content", "value": "={{ $('Claude API — Narrative Summary').item.json.content[0].text }}" }
          ]
        }
      },
      "id": "deliver-webhook",
      "name": "Deliver via Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 350]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [[ { "node": "Compute Date Range", "type": "main", "index": 0 } ]]
    },
    "Compute Date Range": {
      "main": [
        [
          { "node": "Fetch Commits (GitHub API)", "type": "main", "index": 0 },
          { "node": "Fetch Closed Issues (GitHub API)", "type": "main", "index": 0 },
          { "node": "Fetch Merged PRs (GitHub API)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Commits (GitHub API)": {
      "main": [[ { "node": "Aggregate GitHub Data", "type": "main", "index": 0 } ]]
    },
    "Fetch Closed Issues (GitHub API)": {
      "main": [[ { "node": "Aggregate GitHub Data", "type": "main", "index": 0 } ]]
    },
    "Fetch Merged PRs (GitHub API)": {
      "main": [[ { "node": "Aggregate GitHub Data", "type": "main", "index": 0 } ]]
    },
    "Aggregate GitHub Data": {
      "main": [[ { "node": "Claude API — Narrative Summary", "type": "main", "index": 0 } ]]
    },
    "Claude API — Narrative Summary": {
      "main": [[ { "node": "Deliver via Discord/Slack", "type": "main", "index": 0 } ]]
    }
  },
  "settings": {
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": {
    "github_repo": "owner/repo",
    "webhook_url": "https://discord.com/api/webhooks/your-webhook",
    "language": "EN"
  },
  "versionId": "1.0.0"
}
