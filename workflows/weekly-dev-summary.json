{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weekday",
              "weekday": "friday"
            }
          ],
          "timeOfField": {
            "field": "time",
            "hour": 17,
            "minute": 0
          }
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "schedule",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "search",
        "query": "repo:{GITHUB_REPO} is:pr is:merged merged:>={WEEK_AGO}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "id": "github_prs",
      "name": "GitHub PRs"
    },
    {
      "parameters": {
        "operation": "search",
        "query": "repo:{GITHUB_REPO} is:issue is:closed closed:>={WEEK_AGO}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "id": "github_issues",
      "name": "GitHub Issues"
    },
    {
      "parameters": {
        "operation": "search",
        "query": "repo:{GITHUB_REPO} commits since:{WEEK_AGO}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.github",
      "typeVersion": 2,
      "position": [
        200,
        400
      ],
      "id": "github_commits",
      "name": "GitHub Commits"
    },
    {
      "parameters": {
        "prompt": "Generate a weekly narrative summary of GitHub repo activity. Include: merged PRs, closed issues, key commits. Language: {{\\.language}}",
        "options": {
          "model": "claude-sonnet-4-20250514",
          "maxTokens": 2000
        }
      },
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "id": "claude",
      "name": "Claude Summary"
    },
    {
      "parameters": {
        "mode": "send",
        "to": "{{\\.webhook_url}}",
        "message": "=Weekly Dev Summary\\n\\n{{\\.summary}}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [
        600,
        200
      ],
      "id": "discord",
      "name": "Discord Notification"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "GitHub PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub PRs": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Issues": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Commits": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Discord Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}