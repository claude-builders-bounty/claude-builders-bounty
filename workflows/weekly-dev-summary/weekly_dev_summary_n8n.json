{
  "name": "Weekly Dev Summary with Claude API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [5],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo_owner",
              "value": "claude-builders-bounty"
            },
            {
              "name": "repo_name",
              "value": "claude-builders-bounty"
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "webhook_url",
              "value": "https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Workflow Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [380, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "3",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 200]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Workflow Configuration').item.json.repo_owner }}/{{ $('Workflow Configuration').item.json.repo_name }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 400]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Workflow Configuration').item.json;\nconst commits = $('Fetch Commits').all().map(i => i.json.commit?.message?.split('\\n')[0] || '').filter(Boolean);\nconst issues = $('Fetch Closed Issues').all().map(i => i.json.title || '').filter(Boolean);\n\nconst prompt = `Generate a high-quality weekly executive developer summary for ${config.repo_owner}/${config.repo_name}.\nLanguage: ${config.language}\nRecent Commits (${commits.length}):\\n${commits.slice(0, 15).join('\\n')}\\n\\nResolved Issues (${issues.length}):\\n${issues.slice(0, 10).join('\\n')}\\n\\nFormat with:\\n- 🚀 Highlight of the Week\\n- 🛠️ Shipped Features & Bugfixes\\n- 📈 Momentum & Focus for Next Sprint`;\n\nreturn [{\n  json: {\n    prompt,\n    webhook_url: config.webhook_url,\n    repo: `${config.repo_owner}/${config.repo_name}`\n  }\n}];"
      },
      "id": "5",
      "name": "Aggregate Activity & Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "6",
      "name": "Generate Summary with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Aggregate Activity & Build Prompt').item.json.webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"📢 **Weekly Dev Summary: \" + $('Aggregate Activity & Build Prompt').item.json.repo + \"**\\n\\n\" + $json.content[0].text\n}",
        "options": {}
      },
      "id": "7",
      "name": "Deliver via Webhook (Discord/Slack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Workflow Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workflow Configuration": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Aggregate Activity & Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Aggregate Activity & Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Activity & Build Prompt": {
      "main": [
        [
          {
            "node": "Generate Summary with Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary with Claude": {
      "main": [
        [
          {
            "node": "Deliver via Webhook (Discord/Slack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
