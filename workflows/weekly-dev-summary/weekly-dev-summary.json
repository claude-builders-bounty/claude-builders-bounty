    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node[\"Set Configurations\"].json[\"github_owner\"]}}/{{$node[\"Set Configurations\"].json[\"github_repo\"]}}/pulls",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
