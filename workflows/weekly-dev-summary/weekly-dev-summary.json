{
  "name": "Weekly GitHub Dev Summary (Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-friday-5pm",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "github_owner",
              "name": "github_owner",
              "value": "={{ $env.GITHUB_OWNER || 'claude-builders-bounty' }}",
              "type": "string"
            },
            {
              "id": "github_repo",
              "name": "github_repo",
              "value": "={{ $env.GITHUB_REPO || 'claude-builders-bounty' }}",
              "type": "string"
            },
            {
              "id": "language",
              "name": "language",
              "value": "={{ $env.SUMMARY_LANGUAGE || 'EN' }}",
              "type": "string"
            },
            {
              "id": "since_iso",
              "name": "since_iso",
              "value": "={{ $now.minus({ days: 7 }).toISO() }}",
              "type": "string"
            },
            {
              "id": "webhook_url",
              "name": "webhook_url",
              "value": "={{ $env.DELIVERY_WEBHOOK_URL }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config-vars",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.github_owner }}/{{ $json.github_repo }}/commits",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since_iso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 180]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.github_owner }}/{{ $('Config Variables').item.json.github_repo }}/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Config Variables').item.json.since_iso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.github_owner }}/{{ $('Config Variables').item.json.github_repo }}/pulls",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-closed-prs",
      "name": "Fetch Closed PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config Variables').first().json;\nconst since = new Date(cfg.since_iso);\n\nconst commits = $('Fetch Commits').all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]);\nconst issues = $('Fetch Closed Issues').all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]);\nconst pulls = $('Fetch Closed PRs').all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]);\n\nconst mergedPrs = pulls.filter(pr => pr.merged_at && new Date(pr.merged_at) >= since);\nconst closedIssues = issues.filter(issue => !issue.pull_request && issue.closed_at && new Date(issue.closed_at) >= since);\n\nconst payload = {\n  repo: `${cfg.github_owner}/${cfg.github_repo}`,\n  window_start: cfg.since_iso,\n  language: cfg.language,\n  stats: {\n    commits: commits.length,\n    closed_issues: closedIssues.length,\n    merged_prs: mergedPrs.length\n  },\n  commits: commits.slice(0, 30).map(c => ({\n    sha: c.sha?.slice(0, 7),\n    message: (c.commit?.message || '').split('\\n')[0],\n    author: c.commit?.author?.name,\n    date: c.commit?.author?.date\n  })),\n  closed_issues: closedIssues.slice(0, 20).map(i => ({\n    number: i.number,\n    title: i.title,\n    closed_at: i.closed_at\n  })),\n  merged_prs: mergedPrs.slice(0, 20).map(p => ({\n    number: p.number,\n    title: p.title,\n    merged_at: p.merged_at,\n    user: p.user?.login\n  }))\n};\n\nreturn [{ json: payload }];"
      },
      "id": "aggregate-activity",
      "name": "Aggregate Weekly Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1200,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a weekly developer narrative summary for the GitHub repository activity below. Language: \" + $('Config Variables').first().json.language + \" (EN=English, FR=French). Use 3-5 short paragraphs, bullet highlights, and a one-line TL;DR.\\n\\n\" + JSON.stringify($json, null, 2)\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-summary",
      "name": "Claude Narrative Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1220, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config Variables').first().json;\nconst activity = $('Aggregate Weekly Activity').first().json;\nconst claude = $input.first().json;\nconst text = claude.content?.[0]?.text || claude.error?.message || 'Summary unavailable';\n\nreturn [{\n  json: {\n    repo: activity.repo,\n    language: cfg.language,\n    stats: activity.stats,\n    summary: text,\n    webhook_url: cfg.webhook_url\n  }\n}];"
      },
      "id": "format-delivery",
      "name": "Format Delivery Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"## Weekly Dev Summary — \" + $json.repo + \"\\n\\n**TL;DR stats:** \" + $json.stats.commits + \" commits, \" + $json.stats.merged_prs + \" merged PRs, \" + $json.stats.closed_issues + \" closed issues\\n\\n\" + $json.summary\n}",
        "options": {}
      },
      "id": "deliver-webhook",
      "name": "Deliver via Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 300]
    }
  ],
  "connections": {
    "Weekly Friday 5pm": {
      "main": [[{ "node": "Config Variables", "type": "main", "index": 0 }]]
    },
    "Config Variables": {
      "main": [
        [
          { "node": "Fetch Commits", "type": "main", "index": 0 },
          { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
          { "node": "Fetch Closed PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [[{ "node": "Aggregate Weekly Activity", "type": "main", "index": 0 }]]
    },
    "Fetch Closed Issues": {
      "main": [[{ "node": "Aggregate Weekly Activity", "type": "main", "index": 0 }]]
    },
    "Fetch Closed PRs": {
      "main": [[{ "node": "Aggregate Weekly Activity", "type": "main", "index": 0 }]]
    },
    "Aggregate Weekly Activity": {
      "main": [[{ "node": "Claude Narrative Summary", "type": "main", "index": 0 }]]
    },
    "Claude Narrative Summary": {
      "main": [[{ "node": "Format Delivery Payload", "type": "main", "index": 0 }]]
    },
    "Format Delivery Payload": {
      "main": [[{ "node": "Deliver via Webhook", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "swarm-bounty-5-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
