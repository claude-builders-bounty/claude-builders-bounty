{
  "name": "Weekly Dev Summary (Claude + GitHub)",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "config-vars",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repoOwner",
              "value": "={{ $json.repoOwner || $env.REPO_OWNER || 'your-org' }}"
            },
            {
              "name": "repoName",
              "value": "={{ $json.repoName || $env.REPO_NAME || 'your-repo' }}"
            },
            {
              "name": "language",
              "value": "={{ $json.language || $env.SUMMARY_LANGUAGE || 'EN' }}"
            },
            {
              "name": "deliveryType",
              "value": "={{ $json.deliveryType || $env.DELIVERY_TYPE || 'webhook' }}"
            },
            {
              "name": "webhookUrl",
              "value": "={{ $json.webhookUrl || $env.WEBHOOK_URL || '' }}"
            },
            {
              "name": "sinceDate",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "get-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $items(0).json.repoOwner + '/' + $items(0).json.repoName + '/commits?since=' + $items(0).json.sinceDate + '&per_page=50' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "get-issues",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 400],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $items(0).json.repoOwner + '/' + $items(0).json.repoName + '/issues?state=closed&since=' + $items(0).json.sinceDate + '&per_page=50&sort=updated' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "get-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 600],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $items(0).json.repoOwner + '/' + $items(0).json.repoName + '/pulls?state=closed&sort=updated&direction=desc&per_page=50' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "merge-data",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300],
      "parameters": {
        "language": "javascript",
        "code": "// Collect data from all three GitHub API calls\nconst commits = $input.all()[0]?.json?.items || [];\nconst issues = $input.all()[1]?.json?.items || [];\nconst prs = $input.all()[2]?.json?.items || [];\n\n// Config from first node\nconst config = $('Config Variables').first();\nconst repoOwner = config.json.repoOwner;\nconst repoName = config.json.repoName;\nconst language = config.json.language;\n\n// Format commits\nconst commitLines = commits.slice(0, 30).map(c => {\n  return `- ${c.commit.message.split('\\n')[0]} (${c.commit.author.name})`;\n}).join('\\n');\n\n// Format issues (filter out PRs — GitHub API returns both)\nconst issueLines = issues\n  .filter(i => !i.pull_request)\n  .slice(0, 20)\n  .map(i => `- #${i.number}: ${i.title}`)\n  .join('\\n');\n\n// Format merged PRs (filter for merged ones)\nconst prLines = prs\n  .filter(p => p.merged_at)\n  .slice(0, 20)\n  .map(p => `- #${p.number}: ${p.title} (by @${p.user.login})`)\n  .join('\\n');\n\nconst weekStart = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\nconst weekEnd = new Date().toISOString().split('T')[0];\n\n// Build the prompt for Claude\nconst summaryLang = language === 'FR'\n  ? `Veuillez rédiger le résumé en français.`\n  : `Please write the summary in English.`;\n\nconst prompt = `You are generating a weekly development summary for the open-source project **${repoOwner}/${repoName}**.\n\nPeriod: ${weekStart} to ${weekEnd}\n\n${summaryLang}\n\n## Commits (${commits.length} total)\n${commitLines || 'No commits this week.'}\n\n## Closed Issues (${issues.filter(i => !i.pull_request).length} total)\n${issueLines || 'No issues closed this week.'}\n\n## Merged Pull Requests (${prs.filter(p => p.merged_at).length} total)\n${prLines || 'No PRs merged this week.'}\n\nPlease write a narrative summary covering:\n1. **Highlights** — the most important changes this week (2-3 bullet points)\n2. **Bug Fixes** — notable bug fixes\n3. **New Features** — any new capabilities added\n4. **Contributors** — shout-out to active contributors\n5. **Looking Ahead** — what's coming next (if discernible from the data)\n\nKeep it friendly and informative. Write in a newsletter style.`;\n\nreturn [{ json: { prompt, repoOwner, repoName, language, deliveryType: config.json.deliveryType, webhookUrl: config.json.webhookUrl } }];"
      }
    },
    {
      "id": "call-claude",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 2000
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "jsonBody": "{\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 2000,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}"
      }
    },
    {
      "id": "parse-response",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300],
      "parameters": {
        "language": "javascript",
        "code": "const response = $input.first().json;\nconst content = response.content?.[0]?.text || JSON.stringify(response);\nconst repoOwner = $json.repoOwner || 'your-org';\nconst repoName = $json.repoName || 'your-repo';\nconst weekEnd = new Date().toISOString().split('T')[0];\n\nconst summary = `# 📊 Weekly Dev Summary: ${repoOwner}/${repoName}\n\n> Week ending ${weekEnd}\n\n${content}\n\n---\n*Generated by n8n + Claude*`;\n\nreturn [{ json: { summary, repoOwner, repoName } }];"
      }
    },
    {
      "id": "deliver-webhook",
      "name": "Send Discord/Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1450, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhookUrl || $env.WEBHOOK_URL || 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL' }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "application/json",
        "jsonBody": "{\n  \"text\": {{ JSON.stringify($json.summary) }}\n}\n",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "deliver-email",
      "name": "Send Email (alternative)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.1,
      "position": [1450, 500],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM || 'noreply@example.com' }}",
        "toEmail": "={{ $env.EMAIL_TO || 'team@example.com' }}",
        "subject": "={{ 'Weekly Dev Summary: ' + $json.repoOwner + '/' + $json.repoName }}",
        "emailType": "text",
        "message": "={{ $json.summary }}",
        "options": {}
      }
    },
    {
      "id": "noop-end",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1650, 300],
      "parameters": {}
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [
          {
            "node": "Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config Variables": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Closed Issues": {
      "main": [
        [
          {
            "node": "Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Merged PRs": {
      "main": [
        [
          {
            "node": "Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Prompt": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Parse Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Response": {
      "main": [
        [
          {
            "node": "Send Discord/Slack Webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email (alternative)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Discord/Slack Webhook": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email (alternative)": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "versionId": "weekly-dev-summary-v1",
  "active": true,
  "settings": {
    "timezone": "UTC"
  },
  "tags": [
    {
      "name": "weekly-report",
      "id": "weekly-report"
    }
  ]
}
