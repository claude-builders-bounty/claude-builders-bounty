{
  "name": "Weekly Dev Summary (GitHub + Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "sched-1",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "githubOwner",
              "value": "={{$env.GITHUB_OWNER || 'cli'}}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "githubRepo",
              "value": "={{$env.GITHUB_REPO || 'cli'}}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "language",
              "value": "={{$env.SUMMARY_LANG || 'EN'}}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "discordWebhookUrl",
              "value": "={{$env.DISCORD_WEBHOOK_URL}}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "anthropicApiKey",
              "value": "={{$env.ANTHROPIC_API_KEY}}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "githubToken",
              "value": "={{$env.GITHUB_TOKEN}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cfg-1",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst weekAgo = new Date(now.getTime() - 7*24*60*60*1000);\nconst since = weekAgo.toISOString();\nconst until = now.toISOString();\nreturn [{ json: { ...items[0].json, since, until } }];"
      },
      "id": "code-dates",
      "name": "Compute Week Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$json.githubOwner}}/{{$json.githubRepo}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.since}}"
            },
            {
              "name": "until",
              "value": "={{$json.until}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.githubToken}}"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-commits",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        120
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{$('Compute Week Window').item.json.githubOwner}}/{{$('Compute Week Window').item.json.githubRepo}} is:issue is:closed closed:>={{$('Compute Week Window').item.json.since.substring(0,10)}}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$('Compute Week Window').item.json.githubToken}}"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-issues",
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{$('Compute Week Window').item.json.githubOwner}}/{{$('Compute Week Window').item.json.githubRepo}} is:pr is:merged merged:>={{$('Compute Week Window').item.json.since.substring(0,10)}}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$('Compute Week Window').item.json.githubToken}}"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-prs",
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        480
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge-1",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Compute Week Window').first().json;\nconst commitsRaw = $('GitHub Commits').all().map(i => i.json).flat();\nconst commits = Array.isArray(commitsRaw[0]) ? commitsRaw[0] : commitsRaw.filter(c => c && c.sha);\nconst issuesData = $('GitHub Closed Issues').first().json;\nconst prsData = $('GitHub Merged PRs').first().json;\nconst issues = (issuesData.items || []).map(i => ({number:i.number, title:i.title, url:i.html_url}));\nconst prs = (prsData.items || []).map(i => ({number:i.number, title:i.title, url:i.html_url}));\nconst commitLines = commits.slice(0,80).map(c => `- ${(c.commit&&c.commit.message||'').split('\\n')[0]} (${(c.author&&c.author.login)||'unknown'})`);\nconst lang = (cfg.language||'EN').toUpperCase() === 'FR' ? 'French' : 'English';\nconst prompt = `You are a tech lead writing a weekly engineering narrative for ${cfg.githubOwner}/${cfg.githubRepo}.\nPeriod: ${cfg.since} to ${cfg.until}.\nWrite the entire summary in ${lang}.\n\nCommits (${commits.length}):\n${commitLines.join('\\n') || '(none)'}\n\nClosed issues (${issues.length}):\n${issues.map(i=>`- #${i.number} ${i.title}`).join('\\n') || '(none)'}\n\nMerged PRs (${prs.length}):\n${prs.map(i=>`- #${i.number} ${i.title}`).join('\\n') || '(none)'}\n\nReturn a concise narrative (3-6 short paragraphs) covering themes, notable ship, and risks/follow-ups. No markdown tables.`;\nreturn [{ json: { ...cfg, prompt, stats: { commits: commits.length, issues: issues.length, prs: prs.length } } }];"
      },
      "id": "code-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$json.anthropicApiKey}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1200,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{JSON.stringify($json.prompt)}} }\n  ]\n}",
        "options": {}
      },
      "id": "http-claude",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Build Claude Prompt').first().json;\nconst resp = items[0].json;\nconst text = (resp.content && resp.content[0] && resp.content[0].text) || JSON.stringify(resp);\nconst title = `Weekly summary \u2014 ${cfg.githubOwner}/${cfg.githubRepo}`;\nconst content = `**${title}**\\n_${cfg.since.slice(0,10)} \u2192 ${cfg.until.slice(0,10)}_ \u00b7 commits ${cfg.stats.commits} \u00b7 closed issues ${cfg.stats.issues} \u00b7 merged PRs ${cfg.stats.prs}\\n\\n${text}`;\nreturn [{ json: { discordWebhookUrl: cfg.discordWebhookUrl, content: content.slice(0,1900) } }];"
      },
      "id": "code-format",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.discordWebhookUrl}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": {{JSON.stringify($json.content)}}\n}",
        "options": {}
      },
      "id": "http-discord",
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        300
      ]
    }
  ],
