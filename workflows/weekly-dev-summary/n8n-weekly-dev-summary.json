{
  "name": "Weekly GitHub dev summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$env.GITHUB_REPO}}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$now.minus({days:7}).toISO()}}"
            }
          ]
        }
      },
      "name": "GitHub commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:1200,messages:[{role:'user',content:'Write a weekly narrative summary in '+($env.SUMMARY_LANG||'EN')+' for repo '+$env.GITHUB_REPO+'. Commits JSON: '+JSON.stringify($json)}]})}"
      },
      "name": "Narrative summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { content: ($json.content && $json.content[0] && $json.content[0].text) || 'No summary' } }}"
      },
      "name": "Discord/Slack webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ]
    }
  ],
  "connections": {
    "Weekly Friday 5pm": {
      "main": [
        [
          {
            "node": "GitHub commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub commits": {
      "main": [
        [
          {
            "node": "Narrative summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Narrative summary": {
      "main": [
        [
          {
            "node": "Discord/Slack webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "notes": "Set env: GITHUB_REPO, ANTHROPIC_API_KEY, WEBHOOK_URL, SUMMARY_LANG=EN|FR"
  }
}
