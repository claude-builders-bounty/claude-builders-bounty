{
  "name": "Weekly GitHub Activity Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "interval": 1
            }
          ]
        }
      },
      "id": "1d6c8e3b-9a2c-4f1d-b8a7-e2d2c1b0a9f8",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "resource": "commit",
        "operation": "getAll",
        "owner": "={{$node[\"Config\"].json[\"owner\"]}}",
        "repository": "={{$node[\"Config\"].json[\"repo\"]}}",
        "filters": {
          "since": "={{$today.minus({ days: 7 }).toISO()}}"
        }
      },
      "id": "2d6c8e3b-9a2c-4f1d-b8a7-e2d2c1b0a9f9",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "credentials": {
        "githubApi": {
          "id": "your-github-credential-id"
        }
      }
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{$node[\"Config\"].json[\"owner\"]}}",
        "repository": "={{$node[\"Config\"].json[\"repo\"]}}",
        "filters": {
          "state": "closed",
          "since": "={{$today.minus({ days: 7 }).toISO()}}"
        }
      },
      "id": "3d6c8e3b-9a2c-4f1d-b8a7-e2d2c1b0a9f0",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        400,
        400
      ],
      "credentials": {
        "githubApi": {
          "id": "your-github-credential-id"
        }
      }
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "=Generate a narrative weekly summary of the following GitHub activity for the repo {{$node[\"Config\"].json[\"repo\"]}} in {{$node[\"Config\"].json[\"language\"]}}:\n\nCommits: {{$node[\"Get Commits\"].json.map(c => c.commit.message).join(', ')}}\nClosed Issues: {{$node[\"Get Closed Issues\"].json.map(i => i.title).join(', ')}}\n\nMake it engaging and professional.",
        "options": {}
      },
      "id": "4d6c8e3b-9a2c-4f1d-b8a7-e2d2c1b0a9f1",
      "name": "Claude AI Summary",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [
        700,
        300
      ],
      "credentials": {
        "anthropicApi": {
          "id": "your-anthropic-credential-id"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$node[\"Config\"].json[\"destination_webhook\"]}}",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json[\"text\"]}}"
            }
          ]
        }
      },
      "id": "5d6c8e3b-9a2c-4f1d-b8a7-e2d2c1b0a9f2",
      "name": "Send Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        950,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "owner",
              "value": "owner-name"
            },
            {
              "name": "repo",
              "value": "repo-name"
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "destination_webhook",
              "value": "https://discord.com/api/webhooks/..."
            }
          ]
        },
        "options": {}
      },
      "id": "6d6c8e3b-9a2c-4f1d-b8a7-e2d2c1b0a9f3",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Claude AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Closed Issues": {
      "main": [
        [
          {
            "node": "Claude AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude AI Summary": {
      "main": [
        [
          {
            "node": "Send Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Weekly Trigger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
