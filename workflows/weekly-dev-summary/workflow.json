{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "github1",
      "name": "Get Recent Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 200],
      "credentials": {
        "githubApi": "github"
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "github2",
      "name": "Get Recent PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 400],
      "credentials": {
        "githubApi": "github"
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "github3",
      "name": "Get Recent Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 600],
      "credentials": {
        "githubApi": "github"
      }
    },
    {
      "parameters": {
        "text": "=== Weekly Development Summary ===\n\nRepo: {{ $node[\"Get Recent Commits\"].json?.repository?.nameWithOwner || \"N/A\" }}\n\n## Commits\n{{ $node[\"Get Recent Commits\"].json }}\n\n## Pull Requests\n{{ $node[\"Get Recent PRs\"].json }}\n\n## Issues\n{{ $node[\"Get Recent Issues\"].json }}"
      },
      "id": "compose",
      "name": "Compose Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a technical writer. Summarize the following weekly GitHub activity into a clear narrative."
            },
            {
              "role": "user",
              "content": "={{ $json[\"text\"] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ai",
      "name": "Generate Narrative",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [850, 400],
      "credentials": {
        "openAiApi": "openai"
      }
    },
    {
      "parameters": {
        "text": "={{ $json[\"choices\"][0][\"message\"][\"content\"] }}"
      },
      "id": "extract",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "notify",
      "name": "Send Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1250, 400],
      "credentials": {
        "slackApi": "slack"
      }
    }
  ],
  "connections": {
    "Weekly Schedule": {
      "main": [[{ "node": "Get Recent Commits", "type": "main" }, { "node": "Get Recent PRs", "type": "main" }, { "node": "Get Recent Issues", "type": "main" }]]
    },
    "Get Recent Commits": { "main": [[{ "node": "Compose Summary", "type": "main" }]] },
    "Get Recent PRs": { "main": [[{ "node": "Compose Summary", "type": "main" }]] },
    "Get Recent Issues": { "main": [[{ "node": "Compose Summary", "type": "main" }]] },
    "Compose Summary": { "main": [[{ "node": "Generate Narrative", "type": "main" }]] },
    "Generate Narrative": { "main": [[{ "node": "Extract Summary", "type": "main" }]] },
    "Extract Summary": { "main": [[{ "node": "Send Notification", "type": "main" }]] }
  }
}
