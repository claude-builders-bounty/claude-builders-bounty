{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "weekly-cron",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -980,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "github-owner",
              "name": "githubOwner",
              "type": "string",
              "value": "={{$env.GITHUB_OWNER || 'octocat'}}"
            },
            {
              "id": "github-repo",
              "name": "githubRepo",
              "type": "string",
              "value": "={{$env.GITHUB_REPO || 'Hello-World'}}"
            },
            {
              "id": "language",
              "name": "language",
              "type": "string",
              "value": "={{$env.SUMMARY_LANGUAGE || 'EN'}}"
            },
            {
              "id": "destination",
              "name": "destinationWebhookUrl",
              "type": "string",
              "value": "={{$env.DESTINATION_WEBHOOK_URL}}"
            },
            {
              "id": "since",
              "name": "since",
              "type": "string",
              "value": "={{$now.minus({ days: 7 }).toISO()}}"
            },
            {
              "id": "until",
              "name": "until",
              "type": "string",
              "value": "={{$now.toISO()}}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -760,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.githubOwner}}/{{$json.githubRepo}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.since}}"
            },
            {
              "name": "until",
              "value": "={{$json.until}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        -220
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node['Set Config'].json.githubOwner}}/{{$node['Set Config'].json.githubRepo}}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{$node['Set Config'].json.since}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node['Set Config'].json.githubOwner}}/{{$node['Set Config'].json.githubRepo}}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-merged-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Set Config').first().json;\nconst commits = $('Fetch Commits').all().map(item => item.json).flat();\nconst closedIssues = $('Fetch Closed Issues').all().map(item => item.json).flat()\n  .filter(issue => !issue.pull_request)\n  .filter(issue => issue.closed_at && new Date(issue.closed_at) >= new Date(config.since));\nconst mergedPrs = $('Fetch Merged PRs').all().map(item => item.json).flat()\n  .filter(pr => pr.merged_at)\n  .filter(pr => new Date(pr.merged_at) >= new Date(config.since));\n\nconst compactCommits = commits.slice(0, 50).map(commit => ({\n  sha: commit.sha?.slice(0, 7),\n  message: commit.commit?.message?.split('\\n')[0],\n  author: commit.commit?.author?.name,\n  date: commit.commit?.author?.date,\n  url: commit.html_url\n}));\n\nconst compactIssues = closedIssues.slice(0, 50).map(issue => ({\n  number: issue.number,\n  title: issue.title,\n  closedAt: issue.closed_at,\n  url: issue.html_url,\n  labels: (issue.labels || []).map(label => label.name)\n}));\n\nconst compactPrs = mergedPrs.slice(0, 50).map(pr => ({\n  number: pr.number,\n  title: pr.title,\n  author: pr.user?.login,\n  mergedAt: pr.merged_at,\n  url: pr.html_url\n}));\n\nreturn [{\n  json: {\n    repo: `${config.githubOwner}/${config.githubRepo}`,\n    language: config.language,\n    destinationWebhookUrl: config.destinationWebhookUrl,\n    since: config.since,\n    until: config.until,\n    activity: {\n      commitCount: commits.length,\n      closedIssueCount: closedIssues.length,\n      mergedPrCount: mergedPrs.length,\n      commits: compactCommits,\n      closedIssues: compactIssues,\n      mergedPrs: compactPrs\n    }\n  }\n}];"
      },
      "id": "prepare-activity",
      "name": "Prepare Activity Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1200,\n  \"temperature\": 0.2,\n  \"system\": \"You write concise weekly engineering updates for product teams. Be specific, narrative, and useful. Do not invent activity that is not in the input.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a weekly development summary in {{$json.language === 'FR' ? 'French' : 'English'}} for repository {{$json.repo}} covering {{$json.since}} through {{$json.until}}. Include: headline, shipped work, resolved issues, notable contributors, operational risk, and next-week focus. Use the following JSON activity data:\\n\\n\" + JSON.stringify($json.activity, null, 2)\n    }\n  ]\n}",
        "options": {}
      },
      "id": "call-claude",
      "name": "Generate Summary With Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const digest = $('Prepare Activity Digest').first().json;\nconst claude = $input.first().json;\nconst summary = claude.content?.map(part => part.text).filter(Boolean).join('\\n\\n') || 'No summary returned by Claude.';\n\nreturn [{\n  json: {\n    destinationWebhookUrl: digest.destinationWebhookUrl,\n    repo: digest.repo,\n    since: digest.since,\n    until: digest.until,\n    summary,\n    payload: {\n      text: `Weekly dev summary for ${digest.repo}\\n\\n${summary}`,\n      repo: digest.repo,\n      since: digest.since,\n      until: digest.until,\n      summary\n    }\n  }\n}];"
      },
      "id": "format-webhook-payload",
      "name": "Format Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.destinationWebhookUrl}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.payload}}",
        "options": {}
      },
      "id": "send-webhook",
      "name": "Send Slack or Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        0
      ]
    }
  ],
  "pinData": {},
