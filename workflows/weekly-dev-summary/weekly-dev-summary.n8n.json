      "id": "a9917bf2-211b-4c4f-bc34-d0a1837f0710",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $input.first().json;\nconst repo = String(config.githubRepo || '').trim();\nconst [githubOwner, githubRepoName] = repo.split('/');\n\nif (!githubOwner || !githubRepoName) {\n  throw new Error('Set Config.githubRepo must use owner/repo format, for example n8n-io/n8n.');\n}\n\nconst now = new Date();\nconst weekStart = new Date(now);\nweekStart.setUTCDate(now.getUTCDate() - 7);\n\nconst normalizedLanguage = String(config.language || 'EN').trim().toUpperCase();\nconst languageName = normalizedLanguage === 'FR' ? 'French' : 'English';\n\nreturn [\n  {\n    json: {\n      ...config,\n      githubOwner,\n      githubRepoName,\n      language: normalizedLanguage,\n      languageName,\n      weekStartIso: weekStart.toISOString(),\n      weekEndIso: now.toISOString()\n    }\n  }\n];"
      },
      "id": "74124b3a-4b4f-4fce-9a92-4ca056ce8eef",
      "name": "Prepare Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.githubOwner }}/{{ $json.githubRepoName }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.weekStartIso }}"
            },
            {
              "name": "until",
              "value": "={{ $json.weekEndIso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "responseFormat": "json"
          }
        }
      },
      "id": "678eb26a-24a0-47c9-91bf-261914ebdd70",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        0
