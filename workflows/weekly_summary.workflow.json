{
  "name": "Weekly GitHub Dev Summary \u2014 Claude AI",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst since = new Date(now - 7 * 24 * 60 * 60 * 1000);\nreturn [{ json: {\n  repo: $env.GITHUB_REPO || 'owner/repo',\n  since: since.toISOString(),\n  until: now.toISOString()\n}}];"
      },
      "id": "set-dates",
      "name": "Set Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "until",
              "value": "={{ $json.until }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-commits",
      "name": "GitHub: Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Set Date Range').item.json.repo }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Set Date Range').item.json.since }}"
            },
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "options": {}
      },
      "id": "get-issues",
      "name": "GitHub: Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        340
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Set Date Range').item.json.repo }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "options": {}
      },
      "id": "get-prs",
      "name": "GitHub: Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        480
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const commits = $('GitHub: Get Commits').all().map(i => i.json);\nconst issues = $('GitHub: Get Closed Issues').all().map(i => i.json);\nconst prs = $('GitHub: Get Merged PRs').all().map(i => i.json).filter(p => p.merged_at);\n\nconst commitSummary = commits.slice(0, 20).map(c => `- ${c.commit?.message?.split('\\n')[0]} (@${c.author?.login || 'unknown'})`).join('\\n');\nconst issueSummary = issues.slice(0, 10).map(i => `- #${i.number}: ${i.title}`).join('\\n');\nconst prSummary = prs.slice(0, 10).map(p => `- #${p.number}: ${p.title} (by @${p.user?.login})`).join('\\n');\n\nreturn [{ json: {\n  commits_count: commits.length,\n  issues_closed: issues.length,\n  prs_merged: prs.length,\n  commit_summary: commitSummary || 'No commits this week',\n  issue_summary: issueSummary || 'No issues closed',\n  pr_summary: prSummary || 'No PRs merged',\n  repo: $('Set Date Range').item.json.repo,\n  week_end: new Date().toISOString().split('T')[0]\n}}];"
      },
      "id": "aggregate",
      "name": "Aggregate Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        340
      ]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "values": [
            {
              "name": "model",
              "value": "claude-haiku-4-5-20251001"
            },
            {
              "name": "max_tokens",
              "value": "1024"
            },
            {
              "name": "messages",
              "value": "=[{\"role\":\"user\",\"content\":\"Write a concise, engaging weekly development summary for the GitHub repo **{{ $json.repo }}** for the week ending {{ $json.week_end }}.\\n\\nActivity this week:\\n- Commits: {{ $json.commits_count }}\\n- Issues closed: {{ $json.issues_closed }}\\n- PRs merged: {{ $json.prs_merged }}\\n\\n## Recent Commits\\n{{ $json.commit_summary }}\\n\\n## Closed Issues\\n{{ $json.issue_summary }}\\n\\n## Merged PRs\\n{{ $json.pr_summary }}\\n\\nWrite 3-4 short paragraphs in a friendly, professional tone. Highlight the most impactful work. End with a one-sentence teaser for what might come next.\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "claude-summary",
      "name": "Claude: Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        340
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropic-key",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $json.content?.[0]?.text || 'Summary unavailable';\nconst data = $('Aggregate Activity').item.json;\nreturn [{ json: {\n  subject: `Weekly Dev Summary \u2014 ${data.repo} (${data.week_end})`,\n  body: `# Weekly Development Summary\\n\\n**Repo:** ${data.repo}  \\n**Week ending:** ${data.week_end}  \\n**Commits:** ${data.commits_count} | **Issues closed:** ${data.issues_closed} | **PRs merged:** ${data.prs_merged}\\n\\n---\\n\\n${response}`\n}}];"
      },
      "id": "format-email",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        340
      ]
    }
  ],
  "connections": {
