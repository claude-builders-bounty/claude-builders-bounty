{
  "name": "Weekly Report \u2014 Claude API",
  "nodes": [
    {
      "type": "n8n-nodes-base.scheduleTrigger",
      "name": "Every Monday 9am",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "type": "n8n-nodes-base.httpRequest",
      "name": "Fetch Data",
      "parameters": {
        "url": "={{$env.DATA_SOURCE_URL}}",
        "method": "GET"
      }
    },
    {
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "name": "Claude Summary",
      "parameters": {
        "model": "claude-opus-4-5",
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "Summarize this weekly data into a concise report:\n\n{{$json.data}}"
            }
          ]
        }
      }
    },
    {
      "type": "n8n-nodes-base.emailSend",
      "name": "Send Report",
      "parameters": {
        "toEmail": "={{$env.REPORT_EMAIL}}",
        "subject": "Weekly Report \u2014 {{$now.format('YYYY-MM-DD')}}",
        "text": "={{$json.text}}"
      }
    }
  ],
  "connections": {}
}