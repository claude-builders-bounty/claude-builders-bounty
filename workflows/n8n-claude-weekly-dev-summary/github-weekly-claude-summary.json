          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged Pull Requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Aggregate Repo Telemetry & Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Aggregate Repo Telemetry & Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged Pull Requests": {
      "main": [
        [
          {
            "node": "Aggregate Repo Telemetry & Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Repo Telemetry & Prompt": {
      "main": [
        [
          {
            "node": "Call Claude API for Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Claude API for Summary": {
      "main": [
        [
          {
            "node": "Format Webhook Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Webhook Payload": {
      "main": [
        [
          {
            "node": "Deliver via Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
