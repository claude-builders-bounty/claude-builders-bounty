{
  "name": "Weekly GitHub Dev Summary with Claude (Sanitized Draft)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "weekly-friday-trigger",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst since = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{ json: {\n  owner: $env.GITHUB_OWNER,\n  repo: $env.GITHUB_REPO,\n  destinationMode: $env.DESTINATION_MODE || 'email',\n  destinationUrl: $env.DESTINATION_URL,\n  summaryLanguage: ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase(),\n  since: since.toISOString(),\n  until: now.toISOString()\n}}];"
      },
      "id": "build-config",
      "name": "Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits?since={{$json.since}}&until={{$json.until}}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        -180
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{$json.owner}}/{{$json.repo}}+is:issue+closed:{{$json.since}}..{{$json.until}}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{$json.owner}}/{{$json.repo}}+is:pr+is:merged+merged:{{$json.since}}..{{$json.until}}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-merged-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        180
      ]
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "merge-github-data",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\nconst commits = Array.isArray(items[0]) ? items[0] : items[0]?.data || items[0]?.items || items[0] || [];\nconst closedIssues = items[1]?.items || [];\nconst mergedPrs = items[2]?.items || [];\nconst config = $('Build Config').first().json;\nconst payload = {\n  repo: `${config.owner}/${config.repo}`,\n  period: { since: config.since, until: config.until },\n  language: config.summaryLanguage,\n  commits: commits.slice(0, 50).map(commit => ({ sha: commit.sha, message: commit.commit?.message, author: commit.commit?.author?.name, url: commit.html_url })),\n  closedIssues: closedIssues.slice(0, 50).map(issue => ({ number: issue.number, title: issue.title, url: issue.html_url })),\n  mergedPrs: mergedPrs.slice(0, 50).map(pr => ({ number: pr.number, title: pr.title, url: pr.html_url }))\n};\nreturn [{ json: { ...config, githubPayload: payload } }];"
      },
      "id": "normalize-summary-input",
      "name": "Normalize Summary Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1200,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a concise weekly developer summary in {{$json.summaryLanguage}}. Include: shipped work, fixed issues, merged PRs, notable contributors if visible, and next-week risks. Use only this JSON evidence: \" + JSON.stringify($json.githubPayload)\n    }\n  ]\n}",
        "options": {}
      },
      "id": "call-claude-summary",
      "name": "Call Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst config = $('Normalize Summary Input').first().json;\nconst text = response.content?.map(part => part.text).filter(Boolean).join('\\n\\n') || response.summary || JSON.stringify(response);\nreturn [{ json: {\n  destinationMode: config.destinationMode,\n  destinationUrl: config.destinationUrl,\n  subject: `Weekly dev summary: ${config.owner}/${config.repo}`,\n  summary: text,\n  payload: {\n    text,\n    repo: `${config.owner}/${config.repo}`,\n    since: config.since,\n    until: config.until,\n    language: config.summaryLanguage\n  }\n}}];"
      },
      "id": "prepare-delivery",
      "name": "Prepare Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "webhook-mode",
              "leftValue": "={{$json.destinationMode}}",
              "rightValue": "webhook",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "delivery-mode",
      "name": "Delivery Mode",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.destinationUrl}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": $json.summary}",
        "options": {}
      },
      "id": "send-webhook",
      "name": "Send Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -100
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SUMMARY_FROM_EMAIL}}",
        "toEmail": "={{$json.destinationUrl}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.summary}}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        100
      ]
    }
  ],
