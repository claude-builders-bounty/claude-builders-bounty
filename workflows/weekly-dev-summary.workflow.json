{
  "name": "Claude Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Weekly Cron (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/commits",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({days: 7}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $now.minus({days: 7}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/pulls",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 480]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [640, 340]
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Fetch Commits').all().map(i => i.json);\nconst issues = $('Fetch Closed Issues').all().map(i => i.json);\nconst allPRs = $('Fetch Merged PRs').all().map(i => i.json);\n\n// Filter merged PRs in the last 7 days\nconst since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst mergedPRs = allPRs.filter(pr => pr.merged_at && new Date(pr.merged_at) >= since);\n\n// Build a concise summary for Claude\nconst repo = $vars.GITHUB_REPO;\nconst lang = $vars.SUMMARY_LANGUAGE || 'EN';\n\nconst commitLines = commits.slice(0, 30).map(c =>\n  `- ${c.commit?.message?.split('\\n')[0] || 'No message'} (${c.sha?.slice(0,7)})`\n).join('\\n');\n\nconst issueLines = issues.slice(0, 20).map(i =>\n  `- #${i.number}: ${i.title}`\n).join('\\n');\n\nconst prLines = mergedPRs.slice(0, 20).map(p =>\n  `- #${p.number}: ${p.title} (merged by @${p.merged_by?.login || 'unknown'})`\n).join('\\n');\n\nconst prompt = `You are a technical writer generating a professional weekly development summary for the repository ${repo}.\nRespond in ${lang === 'FR' ? 'French' : 'English'}.\n\nHere is the week's activity:\n\n## Commits (last 7 days)\n${commitLines || 'None'}\n\n## Closed Issues\n${issueLines || 'None'}\n\n## Merged Pull Requests\n${prLines || 'None'}\n\nWrite a concise, well-structured narrative summary (3-5 paragraphs) highlighting key achievements, important fixes, and notable contributions. Use Markdown formatting.`;\n\nreturn [{ json: { prompt, commitCount: commits.length, issueCount: issues.length, prCount: mergedPRs.length, repo } }];"
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $vars.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 1024
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"{{ $json.prompt }}\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 340]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst summary = response.content?.[0]?.text || 'No summary generated.';\nconst repo = $('Build Claude Prompt').first().json.repo;\nconst stats = `📊 Stats: ${$('Build Claude Prompt').first().json.commitCount} commits, ${$('Build Claude Prompt').first().json.issueCount} issues closed, ${$('Build Claude Prompt').first().json.prCount} PRs merged`;\n\nreturn [{ json: { summary, stats, repo, text: `**Weekly Dev Summary — ${repo}**\\n\\n${stats}\\n\\n${summary}` } }];"
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.text.slice(0, 1900) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 340]
    }
  ],
