{
  "name": "Automated Weekly Dev Summary via Claude API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "Weekly Trigger (Fri 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "GITHUB_OWNER",
              "value": "claude-builders-bounty"
            },
            {
              "name": "GITHUB_REPO",
              "value": "claude-builders-bounty"
            },
            {
              "name": "DELIVERY_WEBHOOK_URL",
              "value": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
            },
            {
              "name": "SUMMARY_LANGUAGE",
              "value": "EN"
            },
            {
              "name": "CLAUDE_MODEL",
              "value": "claude-sonnet-4-20250514"
            }
          ]
        }
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Set Workflow Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_OWNER }}/{{ $json.GITHUB_REPO }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        180
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $node[\"Set Workflow Config\"].json.GITHUB_OWNER }}/{{ $node[\"Set Workflow Config\"].json.GITHUB_REPO }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $node[\"Set Workflow Config\"].json.GITHUB_OWNER }}/{{ $node[\"Set Workflow Config\"].json.GITHUB_REPO }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $node[\"Set Workflow Config\"].json;\nconst commitsData = $items(\"Fetch Weekly Commits\").map(i => i.json);\nconst prsData = $items(\"Fetch Merged PRs\").map(i => i.json).filter(pr => pr.merged_at != null);\nconst issuesData = $items(\"Fetch Closed Issues\").map(i => i.json);\n\nconst language = config.SUMMARY_LANGUAGE || \"EN\";\nconst repoName = `${config.GITHUB_OWNER}/${config.GITHUB_REPO}`;\n\nconst commitsList = commitsData.map(c => `- ${c.commit?.message?.split('\\n')[0]} (by ${c.commit?.author?.name})`).join('\\n') || \"No commits this week.\";\nconst prsList = prsData.map(p => `- #${p.number}: ${p.title} (by ${p.user?.login})`).join('\\n') || \"No merged PRs this week.\";\nconst issuesList = issuesData.map(i => `- #${i.number}: ${i.title}`).join('\\n') || \"No closed issues this week.\";\n\nconst promptText = `You are an executive AI assistant summarizing weekly development activity for the repository ${repoName}.\nTarget Language: ${language === 'FR' ? 'French' : 'English'}\n\nHere is the raw activity data for the past 7 days:\n\n### COMMITS:\n${commitsList}\n\n### MERGED PULL REQUESTS:\n${prsList}\n\n### CLOSED ISSUES:\n${issuesList}\n\nInstructions:\n- Write a concise, engaging narrative summary suitable for a team chat channel.\n- Highlight major features, critical bug fixes, and key contributors.\n- Output strictly in ${language === 'FR' ? 'French' : 'English'}.\n- Format with clear Markdown headings and bullet points.`;\n\nreturn [{\n  json: {\n    prompt: promptText,\n    webhook_url: config.DELIVERY_WEBHOOK_URL,\n    model: config.CLAUDE_MODEL || \"claude-sonnet-4-20250514\"\n  }\n}];"
      },
      "id": "1a2b3c4d-0006-4000-8000-000000000006",
      "name": "Format Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.model }}\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "1a2b3c4d-0007-4000-8000-000000000007",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1130,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Format Claude Prompt\"].json.webhook_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.content[0].text.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') }}\"\n}",
        "options": {}
      },
      "id": "1a2b3c4d-0008-4000-8000-000000000008",
      "name": "Deliver via Webhook (Slack/Discord)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1350,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Trigger (Fri 5PM)": {
      "main": [
        [
          {
            "node": "Set Workflow Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Workflow Config": {
      "main": [
        [
          {
            "node": "Fetch Weekly Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Format Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Format Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Format Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Claude Prompt": {
      "main": [
        [
          {
            "node": "Call Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Claude API": {
      "main": [
        [
          {
            "node": "Deliver via Webhook (Slack/Discord)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "1"
}
