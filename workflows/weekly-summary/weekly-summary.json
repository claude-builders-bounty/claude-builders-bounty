{
  "name": "Claude Code Weekly Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.githubRepo}}/compare/{{$json.lastWeek}}...{{$json.thisWeek}}",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        }
      },
      "id": "github",
      "name": "Get GitHub Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "prompt": "Generate a weekly summary of this GitHub repository activity:\n\nCommits: {{$json.commits}}\nPRs: {{$json.pulls}}\nIssues: {{$json.issues}}\n\nWrite in {{$json.language}} language, 2-3 paragraphs, friendly tone.",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.7,
        "maxTokens": 1000
      },
      "id": "claude",
      "name": "Claude Summary",
      "type": "anthropic.messages",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "url": "={{$json.webhookUrl}}",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json.summary}}"
            }
          ]
        }
      },
      "id": "discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          {
            "node": "Get GitHub Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get GitHub Data": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-04-01T00:00:00.000Z",
  "versionId": "1"
}