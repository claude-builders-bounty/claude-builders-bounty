{
  "name": "Claude Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Start",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "resource": "commit",
        "owner": "={{ $parameter[\"github_repo_owner\"] }}",
        "repository": "={{ $parameter[\"github_repo_name\"] }}",
        "filters": {
          "since": "={{ $parameter[\"start_date\"] }}",
          "until": "={{ $parameter[\"end_date\"] }}"
        }
      },
      "id": "2",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "resource": "issue",
        "state": "closed",
        "owner": "={{ $parameter[\"github_repo_owner\"] }}",
        "repository": "={{ $parameter[\"github_repo_name\"] }}",
        "filters": {
          "since": "={{ $parameter[\"start_date\"] }}",
          "until": "={{ $parameter[\"end_date\"] }}"
        }
      },
      "id": "3",
      "name": "Get Closed Issues",
      "type": "n8n-n0des-base.github",
      "typeVersion": 1,
      "position": [
        500,
        450
      ]
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "state": "closed",
        "owner": "={{ $parameter[\"github_repo_owner\"] }}",
        "repository": "={{ $parameter[\"github_repo_name\"] }}",
        "filters": {
          "since": "={{ $parameter[\"start_date\"] }}",
          "until": "={{ $parameter[\"end_date\"] }}"
        }
      },
      "id": "4",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        500,
        600
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "={{ $parameter[\"claude_prompt\"] }}",
        "max_tokens": 1024
      },
      "id": "5",
      "name": "Claude API",
      "type": "n8n-nodes-base.claude",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    }
  ]
}