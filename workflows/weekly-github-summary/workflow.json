            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": 1,
  "meta": {
    "instanceId": "weekly-github-summary-template"
  },
  "id": "weekly-github-summary-template",
  "tags": [
    {
      "name": "weekly",
      "id": "tag-weekly"
    },
    {
      "name": "github",
      "id": "tag-github"
    }
  ]
