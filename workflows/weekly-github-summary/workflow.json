            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code: flatten + tag": {
      "main": [
        [
          {
            "node": "Claude: write summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude: write summary": {
      "main": [
        [
          {
            "node": "Extract assistant text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract assistant text": {
      "main": [
        [
          {
