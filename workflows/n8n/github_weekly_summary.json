{
  "name": "Automated Weekly GitHub Dev Summary via Claude API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": 5,
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "1",
      "name": "Weekly Schedule (Friday 5 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$vars.GITHUB_REPO || 'owner/repo'}}/commits?since={{$now.minus({days: 7}).toISO()}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "2",
      "name": "Fetch Recent Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$vars.GITHUB_REPO || 'owner/repo'}}/pulls?state=closed&sort=updated&direction=desc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "3",
      "name": "Fetch Closed PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 480]
    },
    {
      "parameters": {
        "modelId": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "content": "=You are a senior technical writer. Generate an executive narrative summary of the following weekly GitHub activity for repo {{$vars.GITHUB_REPO}} in {{$vars.SUMMARY_LANG || 'EN'}}:\n\nCommits: {{JSON.stringify($('Fetch Recent Commits').all())}}\nPull Requests: {{JSON.stringify($('Fetch Closed PRs').all())}}\n\nProvide 3 sections: 🚀 Highlights, 🐛 Bugfixes & Stability, and 🔮 Next Steps.",
              "role": "user"
            }
          ]
        }
      },
      "id": "4",
      "name": "Claude API Generator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [720, 380]
    },
    {
      "parameters": {
        "url": "={{$vars.WEBHOOK_URL || 'https://discord.com/api/webhooks/your-channel'}}",
        "method": "POST",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "content",
              "value": "={{$json.output}}"
            }
          ]
        }
      },
      "id": "5",
      "name": "Deliver via Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 380]
    }
  ],
  "connections": {
    "Weekly Schedule (Friday 5 PM)": {
      "main": [
        [
          { "node": "Fetch Recent Commits", "type": "main", "index": 0 },
          { "node": "Fetch Closed PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Recent Commits": {
      "main": [
        [
          { "node": "Claude API Generator", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Closed PRs": {
      "main": [
        [
          { "node": "Claude API Generator", "type": "main", "index": 0 }
        ]
      ]
    },
    "Claude API Generator": {
      "main": [
        [
          { "node": "Deliver via Webhook", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
