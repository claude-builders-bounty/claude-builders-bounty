{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Weekly Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{$json.repo}}/commits?since={{ $json.since }}&until={{ $json.until }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{$json.github_token}}"},
            {"name": "Accept", "value": "application/vnd.github+json"}
          ]
        }
      },
      "name": "Fetch GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 250]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{$json.repo}}/issues?state=closed&since={{ $json.since }}&until={{ $json.until }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{$json.github_token}}"},
            {"name": "Accept", "value": "application/vnd.github+json"}
          ]
        }
      },
      "name": "Fetch GitHub Issues",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 450]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{$json.repo}}/pulls?state=closed&sort=updated&direction=desc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{$json.github_token}}"},
            {"name": "Accept", "value": "application/vnd.github+json"}
          ]
        }
      },
      "name": "Fetch GitHub PRs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 650]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "{{$json.anthropic_api_key}}"},
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "claude-sonnet-4-20250514"},
            {"name": "max_tokens", "value": 1024},
            {"name": "messages", "value": "[{\"role\":\"user\",\"content\":\"Generate a weekly dev summary in {{$json.language}} for the repo {{$json.repo}}.\\n\\nCommits this week: {{$json.commits}}\\nClosed issues: {{$json.issues}}\\nMerged PRs: {{$json.prs}}\\n\\nFormat:\\n# Weekly Dev Summary\\n## Commits\\n- List key commits\\n## Issues Closed\\n- List closed issues\\n## PRs Merged\\n- List merged PRs\\n## Highlights\\n- 2-3 sentence narrative summary\"}]"
          ]
        }
      },
      "name": "Claude API - Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$json.webhook_url}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "content", "value": "{{$json.summary}}"}
          ]
        }
      },
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 400]
    }
  ],
  "connections": {
    "Weekly Cron Trigger": {
      "main": [[{"node": "Fetch GitHub Commits", "type": "main"}]]
    },
    "Fetch GitHub Commits": {
      "main": [[{"node": "Claude API - Generate Summary", "type": "main"}]]
    },
    "Fetch GitHub Issues": {
      "main": [[{"node": "Claude API - Generate Summary", "type": "main"}]]
    },
    "Fetch GitHub PRs": {
      "main": [[{"node": "Claude API - Generate Summary", "type": "main"}]]
    },
    "Claude API - Generate Summary": {
      "main": [[{"node": "Send to Discord/Slack", "type": "main"}]]
    }
  }
}
