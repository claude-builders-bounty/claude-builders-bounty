{
  "name": "Weekly Dev Summary — GitHub + Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [5],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-001",
              "name": "GITHUB_OWNER",
              "value": "your-org",
              "type": "string"
            },
            {
              "id": "cfg-002",
              "name": "GITHUB_REPO",
              "value": "your-repo",
              "type": "string"
            },
            {
              "id": "cfg-003",
              "name": "LANGUAGE",
              "value": "English",
              "type": "string"
            },
            {
              "id": "cfg-004",
              "name": "DELIVERY_WEBHOOK",
              "value": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Set Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst since = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst weekLabel = `${since.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} – ${now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;\n\nreturn [{\n  json: {\n    ...items[0].json,\n    since_iso: since.toISOString(),\n    now_iso: now.toISOString(),\n    week_label: weekLabel\n  }\n}];"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Compute Date Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_OWNER }}/{{ $json.GITHUB_REPO }}/commits",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since_iso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 160],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const commits = items.map(i => i.json);\n\nif (!commits || commits.length === 0) {\n  return [{ json: { commits_text: 'No commits this week.', commit_count: 0 } }];\n}\n\nconst lines = commits.map(c => {\n  const sha    = (c.sha || '').slice(0, 7);\n  const msg    = ((c.commit && c.commit.message) ? c.commit.message.split('\\n')[0] : 'No message').slice(0, 120);\n  const author = (c.commit && c.commit.author) ? c.commit.author.name : 'unknown';\n  const date   = (c.commit && c.commit.author && c.commit.author.date) ? c.commit.author.date.slice(0, 10) : '';\n  return `- [${sha}] ${msg} (${author}, ${date})`;\n});\n\nreturn [{ json: { commits_text: lines.join('\\n'), commit_count: commits.length } }];"
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Format Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config Variables').item.json.GITHUB_OWNER }}/{{ $('Set Config Variables').item.json.GITHUB_REPO }}/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Compute Date Window').item.json.since_iso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 320],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items_raw = items.map(i => i.json);\n\nconst issues = items_raw.filter(i => !i.pull_request);\n\nif (issues.length === 0) {\n  return [{ json: { issues_text: 'No issues closed this week.', issue_count: 0 } }];\n}\n\nconst lines = issues.map(i => {\n  const closer = (i.closed_by && i.closed_by.login) ? `@${i.closed_by.login}` : 'unknown';\n  return `- #${i.number}: ${i.title} (closed by ${closer})`;\n});\n\nreturn [{ json: { issues_text: lines.join('\\n'), issue_count: issues.length } }];"
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Format Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config Variables').item.json.GITHUB_OWNER }}/{{ $('Set Config Variables').item.json.GITHUB_REPO }}/pulls",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 480],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const since = new Date($('Compute Date Window').item.json.since_iso);\nconst prs_raw = items.map(i => i.json);\n\nconst prs = prs_raw.filter(pr => {\n  if (!pr.merged_at) return false;\n  return new Date(pr.merged_at) >= since;\n});\n\nif (prs.length === 0) {\n  return [{ json: { prs_text: 'No pull requests merged this week.', pr_count: 0 } }];\n}\n\nconst lines = prs.map(p => {\n  const merger = (p.merged_by && p.merged_by.login) ? `@${p.merged_by.login}` : 'unknown';\n  const mergedDate = p.merged_at ? p.merged_at.slice(0, 10) : 'unknown date';\n  return `- #${p.number}: ${p.title} (merged by ${merger} on ${mergedDate})`;\n});\n\nreturn [{ json: { prs_text: lines.join('\\n'), pr_count: prs.length } }];"
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Format Merged PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 480]
    },
    {
      "parameters": {
        "jsCode": "const config        = $('Set Config Variables').item.json;\nconst window        = $('Compute Date Window').item.json;\nconst commits_text  = $('Format Commits').item.json.commits_text;\nconst issues_text   = $('Format Issues').item.json.issues_text;\nconst prs_text      = $('Format Merged PRs').item.json.prs_text;\n\nconst isQuietWeek = (\n  commits_text.includes('No commits') &&\n  issues_text.includes('No issues') &&\n  prs_text.includes('No pull requests')\n);\n\nconst quietNote = isQuietWeek ? '\\nNote: It was a quiet week with no recorded activity.' : '';\n\nconst langInstruction = config.LANGUAGE === 'French'\n  ? 'Repondez entierement en francais.'\n  : 'Respond entirely in English.';\n\nconst prompt = `Here is this week's GitHub activity for ${config.GITHUB_OWNER}/${config.GITHUB_REPO} (${window.week_label}):\\n\\n## Commits\\n${commits_text}\\n\\n## Closed Issues\\n${issues_text}\\n\\n## Merged Pull Requests\\n${prs_text}${quietNote}\\n\\nWrite a concise narrative summary (3-5 paragraphs) suitable for a weekly team update. Highlight key accomplishments, any notable issues resolved, and overall development momentum. ${langInstruction}`;\n\nreturn [{\n  json: {\n    prompt,\n    is_quiet_week: isQuietWeek,\n    repo_label: `${config.GITHUB_OWNER}/${config.GITHUB_REPO}`,\n    week_label: window.week_label,\n    language: config.LANGUAGE,\n    delivery_webhook: config.DELIVERY_WEBHOOK\n  }\n}];"
      },
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Merge Activity Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are a senior technical writer creating internal team updates. Be concise, professional, and highlight what matters most to developers.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0011-0011-0011-000000000011",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 320],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = items[0].json;\n\nconst rawSummary = (response.content && response.content[0] && response.content[0].text)\n  ? response.content[0].text\n  : 'Error: No summary generated.';\n\nconst MAX_CHARS = 1800;\nconst summary = rawSummary.length > MAX_CHARS\n  ? rawSummary.slice(0, MAX_CHARS) + '...'\n  : rawSummary;\n\nreturn [{\n  json: {\n    summary,\n    repo_label:       $('Merge Activity Data').item.json.repo_label,\n    week_label:       $('Merge Activity Data').item.json.week_label,\n    delivery_webhook: $('Merge Activity Data').item.json.delivery_webhook\n  }\n}];"
      },
      "id": "a1b2c3d4-0012-0012-0012-000000000012",
      "name": "Extract Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.delivery_webhook }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"username\": \"Dev Summary Bot\",\n  \"content\": \"📊 **Weekly Dev Summary — {{ $json.repo_label }}**\\n🗓️ {{ $json.week_label }}\\n\\n{{ $json.summary }}\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0013-0013-0013-000000000013",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 320]
    }
  ],
  "connections": {
