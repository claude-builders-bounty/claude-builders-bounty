            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_discord",
              "leftValue": "={{ $json.discordWebhookUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000014",
      "name": "Has Discord Webhook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": {{ JSON.stringify($json.summary.substring(0, 2000)) }},\n  \"username\": \"Weekly Dev Summary Bot\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000015",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 200]
    },
    {
      "parameters": {
        "jsCode": "// Log summary for n8n execution history\nconst data = $input.first().json;\nconsole.log('===== WEEKLY DEV SUMMARY =====');\nconsole.log(data.summary);\nconsole.log('===== END SUMMARY =====');\nreturn [{ json: { status: 'completed', repo: data.repo, weekStart: data.weekStart, weekEnd: data.weekEnd } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000016",
      "name": "Log Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, -100]
    }
