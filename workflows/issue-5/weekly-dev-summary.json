              "fullResponse": false
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_GITHUB_CREDENTIAL_ID",
          "name": "GitHub API Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').item.json.githubOwner }}/{{ $('Config').item.json.githubRepo }}/pulls?state=closed&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 150],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_GITHUB_CREDENTIAL_ID",
          "name": "GitHub API Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [880, 0]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate GitHub data into a structured format for Claude\nconst commits = $('Fetch Commits').all();\nconst issues = $('Fetch Closed Issues').all();\nconst prs = $('Fetch Merged PRs').all();\nconst config = $('Config').first();\nconst dates = $('Compute Date Range').first();\n\n// Process commits\nconst commitList = commits.map(c => ({\n  sha: c.json.sha?.substring(0, 7),\n  message: c.json.commit?.message?.split('\\n')[0],\n  author: c.json.commit?.author?.name,\n  date: c.json.commit?.author?.date,\n  url: c.json.html_url\n}));\n\n// Process closed issues (filter out PRs which GitHub returns as issues)\nconst closedIssues = issues\n  .filter(i => !i.json.pull_request)\n  .map(i => ({\n    number: i.json.number,\n    title: i.json.title,\n    labels: i.json.labels?.map(l => l.name),\n    closedAt: i.json.closed_at,\n    url: i.json.html_url\n  }));\n\n// Process merged PRs\nconst mergedPRs = prs\n  .filter(p => p.json.merged_at)\n  .map(p => ({\n    number: p.json.number,\n    title: p.json.title,\n    author: p.json.user?.login,\n    mergedAt: p.json.merged_at,\n    url: p.json.html_url,\n    additions: p.json.additions,\n    deletions: p.json.deletions\n  }));\n\n// Compute contributor stats\nconst contributorCounts = {};\ncommitList.forEach(c => {\n  if (c.author) {\n    contributorCounts[c.author] = (contributorCounts[c.author] || 0) + 1;\n  }\n});\nconst topContributors = Object.entries(contributorCounts)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 10)\n  .map(([name, count]) => ({ name, commits: count }));\n\nconst result = {\n  repo: `${config.json.githubOwner}/${config.json.githubRepo}`,\n  weekStart: dates.json.weekStart,\n  weekEnd: dates.json.weekEnd,\n  language: config.json.language,\n  stats: {\n    totalCommits: commitList.length,\n    totalClosedIssues: closedIssues.length,\n    totalMergedPRs: mergedPRs.length\n  },\n  topContributors,\n  commits: commitList,\n  closedIssues,\n  mergedPRs\n};\n\nreturn [{ json: result }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(`Generate a weekly development summary for the repository \\\"${$json.repo}\\\" covering ${$json.weekStart} to ${$json.weekEnd}.\n\nLanguage: ${$json.language === 'FR' ? 'French' : 'English'}\n\n## Raw Data\n\n### Stats\n- Total Commits: ${$json.stats.totalCommits}\n- Closed Issues: ${$json.stats.totalClosedIssues}\n- Merged PRs: ${$json.stats.totalMergedPRs}\n\n### Top Contributors\n${$json.topContributors.map(c => `- ${c.name}: ${c.commits} commits`).join('\\n')}\n\n### Commits\n${$json.commits.map(c => `- [${c.sha}] ${c.message} (${c.author})`).join('\\n')}\n\n### Closed Issues\n${$json.closedIssues.map(i => `- #${i.number} ${i.title} ${i.labels?.length ? '[' + i.labels.join(', ') + ']' : ''}`).join('\\n')}\n\n### Merged PRs\n${$json.mergedPRs.map(p => `- #${p.number} ${p.title} by ${p.author} (+${p.additions}/-${p.deletions})`).join('\\n')}\n\n## Instructions\nWrite a well-structured Markdown summary with these sections:\n1. **Overview** — 2-3 sentence narrative of the week's activity\n2. **By the Numbers** — key metrics in bullet form\n3. **Top Contributors** — acknowledge contributors with commit counts\n4. **Key Changes** — highlight the most significant commits/PRs with brief explanations\n5. **Closed Issues** — list resolved issues with context\n6. **Looking Ahead** — a brief forward-looking statement\n\nKeep the tone professional but engaging. Use emojis sparingly. Do NOT fabricate data not present in the raw data above.`) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000009",
      "name": "Generate Summary (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CLAUDE_CREDENTIAL_ID",
          "name": "Claude API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract the summary text from Claude's response\nconst claudeResponse = $input.first().json;\n\nlet summary = '';\nif (claudeResponse.content && Array.isArray(claudeResponse.content)) {\n  summary = claudeResponse.content\n    .filter(block => block.type === 'text')\n    .map(block => block.text)\n    .join('\\n');\n}\n\nconst config = $('Config').first();\nconst dates = $('Compute Date Range').first();\nconst aggregated = $('Aggregate Data').first();\n\n// Add header\nconst fullSummary = `# Weekly Dev Summary — ${aggregated.json.repo}\\n_${dates.json.weekStart} → ${dates.json.weekEnd}_\\n\\n${summary}`;\n\nreturn [{\n  json: {\n    summary: fullSummary,\n    repo: aggregated.json.repo,\n    weekStart: dates.json.weekStart,\n    weekEnd: dates.json.weekEnd,\n    slackWebhookUrl: config.json.slackWebhookUrl,\n    discordWebhookUrl: config.json.discordWebhookUrl,\n    outputDir: config.json.outputDir\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000010",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "command": "=mkdir -p \"{{ $json.outputDir }}\" && cat > \"{{ $json.outputDir }}/weekly-summary-{{ $json.weekStart }}-to-{{ $json.weekEnd }}.md\" << 'N8NSUMMARYEOF'\n{{ $json.summary }}\nN8NSUMMARYEOF\necho \"Markdown saved to {{ $json.outputDir }}/weekly-summary-{{ $json.weekStart }}-to-{{ $json.weekEnd }}.md\""
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000011",
      "name": "Save Markdown File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1760, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
