{
  "name": "GitHub Weekly Narrative Summary with Claude API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger (Fridays 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "repository",
        "operation": "get",
        "owner": "={{ $node[\"Set Variables\"].json[\"repo_owner\"] }}",
        "repository": "={{ $node[\"Set Variables\"].json[\"repo_name\"] }}"
      },
      "id": "2",
      "name": "GitHub Repo Stats",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo_owner",
              "value": "anthropics"
            },
            {
              "name": "repo_name",
              "value": "anthropic-sdk-python"
            },
            {
              "name": "destination_webhook",
              "value": "https://discord.com/api/webhooks/..."
            },
            {
              "name": "language",
              "value": "EN"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a weekly developer digest summary for GitHub repository {{ $node['Set Variables'].json['repo_owner'] }}/{{ $node['Set Variables'].json['repo_name'] }} in {{ $node['Set Variables'].json['language'] }}. Highlight top commits, closed issues, and milestones.\"\n    }\n  ]\n}"
      },
      "id": "4",
      "name": "Claude API Narrative Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Set Variables\"].json[\"destination_webhook\"] }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"\ud83d\udce2 **Weekly Dev Summary for {{ $node['Set Variables'].json['repo_name'] }}**\\n\\n\" + $json[\"content\"][0][\"text\"]\n}"
      },
      "id": "5",
      "name": "Send Discord/Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        300
      ]
    }
  ],
  "connections": {
    "Set Variables": {
      "main": [
        [
          {
            "node": "Schedule Trigger (Fridays 5pm)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger (Fridays 5pm)": {
      "main": [
        [
          {
            "node": "GitHub Repo Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Repo Stats": {
      "main": [
        [
          {
            "node": "Claude API Narrative Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API Narrative Summary": {
      "main": [
        [
          {
            "node": "Send Discord/Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}