{
  "name": "Weekly GitHub Dev Summary via Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "e9e8b1b2-132a-4f51-b8f9-b8d2b9df6355",
      "name": "Schedule Trigger (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        280
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{ $json.repoOwner }}",
        "repository": "={{ $json.repoName }}",
        "state": "closed",
        "since": "={{ new Date(new Date().setDate(new Date().getDate() - 7)).toISOString() }}"
      },
      "id": "42fb0c68-e4b2-4cd8-b0a5-f4edb72b83eb",
      "name": "Get Closed Issues & PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        640,
        180
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "commit",
        "operation": "getAll",
        "owner": "={{ $json.repoOwner }}",
        "repository": "={{ $json.repoName }}",
        "since": "={{ new Date(new Date().setDate(new Date().getDate() - 7)).toISOString() }}"
      },
      "id": "97e6822e-bf73-4ea2-ab26-9fcfb29e083c",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        640,
        380
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repoOwner",
              "value": "owner-placeholder"
            },
            {
              "name": "repoName",
              "value": "repo-placeholder"
            },
            {
              "name": "destinationEmail",
              "value": "team@example.com"
            },
            {
              "name": "language",
              "value": "English"
            }
          ]
        },
        "options": {}
      },
      "id": "18cfc7a4-3997-4c47-a8a2-f8eb08f237eb",
      "name": "Set Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        420,
        280
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "multiplex",
        "options": {}
      },
      "id": "d0e145c2-f174-4b5c-a5b6-6eab8f1b29a2",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        860,
        280
      ]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20240620",
        "prompt": "={{ 'You are an engineering manager. Generate a narrative weekly summary of development activity for the repository based on this data. Language: ' + $('Set Config Variables').item.json.language + '\\n\\nIssues & PRs:\\n' + JSON.stringify($json.issueData) + '\\n\\nCommits:\\n' + JSON.stringify($json.commitData) }}"
      },
      "id": "89b5c3d2-a7e8-422c-b5f7-f0b2f8c05763",
      "name": "Claude API",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1080,
        280
      ]
    },
    {
      "parameters": {
        "fromEmail": "bot@example.com",
        "toEmail": "={{ $('Set Config Variables').item.json.destinationEmail }}",
        "subject": "={{ 'Weekly Dev Summary: ' + $('Set Config Variables').item.json.repoName }}",
        "text": "={{ $json.text }}"
      },
      "id": "a1bcdef2-1234-5678-abcd-1234567890ab",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1300,
        280
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Set Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Config Variables": {
      "main": [
        [
          {
            "node": "Get Closed Issues & PRs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Closed Issues & PRs": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
