{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "weekly-cron",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "repo",
              "name": "repo",
              "type": "string",
              "value": "={{ $env.GITHUB_REPO || 'owner/repo' }}"
            },
            {
              "id": "language",
              "name": "language",
              "type": "string",
              "value": "={{ $env.SUMMARY_LANGUAGE || 'EN' }}"
            },
            {
              "id": "destination",
              "name": "destination",
              "type": "string",
              "value": "={{ $env.DISCORD_WEBHOOK_URL || '' }}"
            },
            {
              "id": "since",
              "name": "since",
              "type": "string",
              "value": "={{ $now.minus({ days: 7 }).toISO() }}"
            },
            {
              "id": "until",
              "name": "until",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "until",
              "value": "={{ $json.until }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-commits",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        -220
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-closed-issues",
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-merged-prs",
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        220
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "merge-github-data-a",
      "name": "Merge Commits + Issues",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -160,
        -80
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "merge-github-data-b",
      "name": "Merge With PRs",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst commits = $('GitHub Commits').all().map(i => i.json).flat();\nconst issues = $('GitHub Closed Issues').all().map(i => i.json).flat().filter(i => !i.pull_request);\nconst pulls = $('GitHub Merged PRs').all().map(i => i.json).flat().filter(pr => pr.merged_at && new Date(pr.merged_at) >= new Date(config.since));\nconst compact = {\n  repo: config.repo,\n  language: config.language,\n  period: { since: config.since, until: config.until },\n  commits: commits.slice(0, 40).map(c => ({ sha: c.sha?.slice(0, 7), message: c.commit?.message?.split('\\n')[0], author: c.commit?.author?.name, url: c.html_url })),\n  closedIssues: issues.slice(0, 30).map(i => ({ number: i.number, title: i.title, url: i.html_url, closedAt: i.closed_at })),\n  mergedPRs: pulls.slice(0, 30).map(pr => ({ number: pr.number, title: pr.title, url: pr.html_url, mergedAt: pr.merged_at, author: pr.user?.login }))\n};\nreturn [{ json: { ...config, compact, prompt: `Write a weekly narrative developer summary in ${config.language === 'FR' ? 'French' : 'English'} for ${config.repo}. Use sections: Headline, What shipped, Bugs closed, Engineering momentum, Risks / follow-ups, Links. Be concise but specific. Data: ${JSON.stringify(compact)}` } }];"
      },
      "id": "build-claude-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'claude-sonnet-4-20250514', max_tokens: 1200, messages: [{ role: 'user', content: $json.prompt }] } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "claude-summary",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst response = $('Claude Summary').first().json;\nconst text = response.content?.map(part => part.text).join('\\n') || 'No Claude summary returned.';\nreturn [{ json: { destination: config.destination, content: `**Weekly dev summary: ${config.repo}**\\n\\n${text}` } }];"
      },
      "id": "format-discord-message",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.destination }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { content: $json.content } }}",
        "options": {}
      },
      "id": "send-discord-webhook",
      "name": "Send Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ]
    }
  ],
