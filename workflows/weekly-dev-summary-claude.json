{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "weekly-cron",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const repo = $env.GITHUB_REPO || 'owner/repo';\nconst destination = $env.DESTINATION_WEBHOOK_URL || '';\nconst language = $env.SUMMARY_LANGUAGE || 'EN';\nconst [owner, name] = repo.split('/');\nconst since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\nreturn [{ json: { repo, owner, name, since, destination, language } }];"
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.name}}/commits?since={{$json.since}}&per_page=50",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        -220
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{$json.owner}}/{{$json.name}}+is:issue+is:closed+closed:>={{$json.since}}&per_page=50",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{$json.owner}}/{{$json.name}}+is:pr+is:merged+merged:>={{$json.since}}&per_page=50",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst commits = $('Fetch Commits').all().map(i => i.json).flat();\nconst issues = ($('Fetch Closed Issues').first().json.items || []);\nconst prs = ($('Fetch Merged PRs').first().json.items || []);\nconst compactCommits = commits.slice(0, 25).map(c => ({ sha: (c.sha || '').slice(0,7), message: c.commit?.message?.split('\\n')[0], author: c.commit?.author?.name }));\nconst compactIssues = issues.slice(0, 25).map(i => ({ number: i.number, title: i.title, url: i.html_url }));\nconst compactPrs = prs.slice(0, 25).map(p => ({ number: p.number, title: p.title, url: p.html_url }));\nconst prompt = `Write a concise weekly narrative development summary in ${cfg.language}. Include: shipped work, closed issues, merged PRs, notable risks, and next-week suggested focus. Repo: ${cfg.repo}. Since: ${cfg.since}. Data: ${JSON.stringify({commits: compactCommits, closedIssues: compactIssues, mergedPRs: compactPrs})}`;\nreturn [{ json: { ...cfg, prompt, commits: compactCommits, closedIssues: compactIssues, mergedPRs: compactPrs } }];"
      },
      "id": "build-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1200, messages: [{ role: 'user', content: $json.prompt }] })}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "claude-summary",
      "name": "Generate Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Build Claude Prompt').first().json;\nconst response = $json;\nconst text = response.content?.map(part => part.text || '').join('\\n') || 'No summary returned.';\nreturn [{ json: { repo: cfg.repo, language: cfg.language, destination: cfg.destination, text, payload: { text: `*Weekly dev summary for ${cfg.repo}*\\n\\n${text}` } } }];"
      },
      "id": "format-summary",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.destination}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.payload)}}",
        "options": {}
      },
      "id": "deliver-webhook",
      "name": "Deliver to Slack or Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        0
      ]
    }
  ],
  "connections": {
