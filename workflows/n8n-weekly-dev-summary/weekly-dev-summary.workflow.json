      "id": "d40f7f86-76d7-4e80-b08c-62178788f95e",
      "name": "Get Merged Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function payloadFromNode(nodeName) {\n  const nodeItems = $items(nodeName).map((item) => item.json);\n  if (nodeItems.length === 1 && Array.isArray(nodeItems[0])) return nodeItems[0];\n  return nodeItems;\n}\n\nconst config = $items('Config')[0].json;\nconst range = $items('Compute Week Range')[0].json;\nconst commits = payloadFromNode('Get Commits').slice(0, 40).map((commit) => ({\n  sha: (commit.sha || '').slice(0, 7),\n  message: commit.commit?.message?.split('\\n')[0] || commit.message || '',\n  author: commit.commit?.author?.name || commit.author?.login || 'unknown',\n  date: commit.commit?.author?.date || commit.date || null\n}));\nconst closedIssuesResponse = $items('Get Closed Issues')[0].json;\nconst mergedPrsResponse = $items('Get Merged Pull Requests')[0].json;\nconst closedIssues = (closedIssuesResponse.items || []).slice(0, 30).map((issue) => ({\n  number: issue.number,\n  title: issue.title,\n  author: issue.user?.login,\n  closedAt: issue.closed_at\n}));\nconst mergedPrs = (mergedPrsResponse.items || []).slice(0, 30).map((pr) => ({\n  number: pr.number,\n  title: pr.title,\n  author: pr.user?.login,\n  mergedAt: pr.pull_request?.merged_at\n}));\n\nconst activity = {\n  repo: `${config.repoOwner}/${config.repoName}`,\n  window: `${range.sinceDay} to ${range.untilDay}`,\n  language: config.language,\n  commits,\n  closedIssues,\n  mergedPrs\n};\n\nconst prompt = `Write a weekly development summary in ${config.language === 'FR' ? 'French' : 'English'} for ${activity.repo} covering ${activity.window}.\n\nUse a narrative tone for maintainers and stakeholders. Include:\n- one short executive paragraph\n- highlights grouped by theme\n- merged pull requests worth calling out\n- closed issues and user impact\n- risks, follow-ups, or quiet areas\n- a concise next-week outlook\n\nBase the summary only on this JSON activity data. If a section has no data, say that clearly without inventing details.\n\nActivity JSON:\n${JSON.stringify(activity, null, 2)}`;\n\nreturn [{\n  json: {\n    ...activity,\n    prompt\n  }\n}];"
      },
      "id": "21d81a84-0a7d-4786-91f5-42a11f425cf6",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1800,\n  \"system\": \"You create accurate weekly engineering summaries from GitHub activity data. Do not invent work that is not present in the input JSON.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": $json.prompt\n    }\n  ]\n}",
        "options": {}
      },
      "id": "5f7d1597-b49c-4ee6-8d55-9172fae4ba7b",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const summary = ($json.content || [])\n  .map((part) => part.text || '')\n  .join('\\n')\n  .trim();\nconst config = $items('Config')[0].json;\nconst range = $items('Compute Week Range')[0].json;\nconst repo = `${config.repoOwner}/${config.repoName}`;\nconst description = summary.length > 3900 ? `${summary.slice(0, 3890)}...` : summary;\n\nreturn [{\n  json: {\n    repo,\n    sinceDay: range.sinceDay,\n    untilDay: range.untilDay,\n    summary,\n    discordPayload: {\n      embeds: [\n        {\n          title: `Weekly dev summary: ${repo}`,\n          description,\n          color: 5793266,\n          footer: {\n            text: `${range.sinceDay} to ${range.untilDay}`\n          }\n        }\n      ]\n    }\n  }\n}];"
      },
      "id": "671021af-82e8-498c-bbff-2776cfc3e707",
      "name": "Build Discord Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node[\"Config\"].json[\"destinationWebhookUrl\"]}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.discordPayload)}}",
        "options": {}
      },
      "id": "cb5910ee-1841-4103-a224-47f26e7a384e",
      "name": "Send Discord Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ]
    }
