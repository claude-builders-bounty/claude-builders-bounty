          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{$node[\"Config\"].json[\"repoOwner\"]}}/{{$node[\"Config\"].json[\"repoName\"]}} is:issue is:closed closed:>={{$node[\"Compute Week Range\"].json[\"sinceDay\"]}} closed:<={{$node[\"Compute Week Range\"].json[\"untilDay\"]}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN || ''}}"
            }
          ]
        },
        "options": {}
      },
      "id": "d9e99bea-6b7c-4fb8-b7d0-61df347d0f7e",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{$node[\"Config\"].json[\"repoOwner\"]}}/{{$node[\"Config\"].json[\"repoName\"]}} is:pr is:merged merged:>={{$node[\"Compute Week Range\"].json[\"sinceDay\"]}} merged:<={{$node[\"Compute Week Range\"].json[\"untilDay\"]}}"
            },
