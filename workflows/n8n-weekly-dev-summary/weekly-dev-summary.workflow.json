    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst until = now.toISOString();\nconst sinceDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst since = sinceDate.toISOString();\nconst sinceDay = since.slice(0, 10);\nconst untilDay = until.slice(0, 10);\n\nreturn [{\n  json: {\n    ...$json,\n    since,\n    until,\n    sinceDay,\n    untilDay\n  }\n}];"
      },
      "id": "10c423ef-47d5-4487-a759-f7c81dfd2c8d",
      "name": "Compute Week Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node[\"Config\"].json[\"repoOwner\"]}}/{{$node[\"Config\"].json[\"repoName\"]}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$node[\"Compute Week Range\"].json[\"since\"]}}"
            },
            {
              "name": "until",
              "value": "={{$node[\"Compute Week Range\"].json[\"until\"]}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN || ''}}"
            }
          ]
        },
        "options": {}
      },
      "id": "78c2ef7e-1ffd-4928-b19b-5b8e15ba8d36",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
