{
  "id": "weekly-github-dev-summary-claude",
  "name": "Weekly GitHub Dev Summary with Claude",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -980,
        160
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "weekly-schedule",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -980,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "// Edit these workflow variables before switching dryRun to false.\nconst config = {\n  repo: \"claude-builders-bounty/claude-builders-bounty\",\n  language: \"EN\",\n  destinationChannel: \"discord-dev-summary\",\n  discordWebhookUrl: \"\",\n  githubToken: \"\",\n  anthropicApiKey: \"\",\n  dryRun: true\n};\n\nconst now = new Date();\nconst until = now.toISOString();\nconst since = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000).toISOString();\n\nconst repo = config.repo.trim();\nconst [repoOwner, repoName] = repo.split(\"/\");\n\nif (!repoOwner || !repoName) {\n  throw new Error(\"repo must use owner/repo format.\");\n}\n\nconst language = (config.language.toUpperCase() === \"FR\") ? \"FR\" : \"EN\";\n\nreturn [{\n  json: {\n    repo,\n    repoOwner,\n    repoName,\n    since,\n    until,\n    language,\n    dryRun: Boolean(config.dryRun),\n    destinationChannel: config.destinationChannel,\n    discordWebhookUrl: config.discordWebhookUrl,\n    githubToken: config.githubToken,\n    anthropicApiKey: config.anthropicApiKey\n  }\n}];"
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        80
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repoOwner }}/{{ $json.repoName }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "until",
              "value": "={{ $json.until }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28', ...($('Set Config').first().json.githubToken ? { Authorization: 'Bearer ' + $('Set Config').first().json.githubToken } : {}) }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ Array.isArray($response.body) && $response.body.length < 100 }}",
              "limitPagesFetched": true,
              "maxRequests": 10,
              "requestInterval": 250
            }
          }
        }
      },
      "id": "github-commits",
      "name": "GitHub - Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "executeOnce": true,
      "position": [
        -440,
        80
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Set Config').first().json.repoOwner }}/{{ $('Set Config').first().json.repoName }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Set Config').first().json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28', ...($('Set Config').first().json.githubToken ? { Authorization: 'Bearer ' + $('Set Config').first().json.githubToken } : {}) }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ Array.isArray($response.body) && $response.body.length < 100 }}",
              "limitPagesFetched": true,
              "maxRequests": 10,
              "requestInterval": 250
            }
          }
        }
      },
      "id": "github-closed-issues",
      "name": "GitHub - Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "executeOnce": true,
      "position": [
        -160,
        80
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Set Config').first().json.repoOwner }}/{{ $('Set Config').first().json.repoName }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28', ...($('Set Config').first().json.githubToken ? { Authorization: 'Bearer ' + $('Set Config').first().json.githubToken } : {}) }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ Array.isArray($response.body) && $response.body.length < 100 }}",
              "limitPagesFetched": true,
              "maxRequests": 10,
              "requestInterval": 250
            }
          }
        }
      },
      "id": "github-merged-prs",
      "name": "GitHub - Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "executeOnce": true,
      "position": [
        120,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $(\"Set Config\").first().json;\n\nfunction responseBody(nodeName) {\n  return $items(nodeName).flatMap((item) => {\n    const json = item.json;\n    if (Array.isArray(json.body)) return json.body;\n    if (Array.isArray(json.data)) return json.data;\n    if (Array.isArray(json)) return json;\n    return [];\n  });\n}\n\nfunction inWindow(value) {\n  if (!value) return false;\n  const time = new Date(value).getTime();\n  return time >= new Date(config.since).getTime() && time <= new Date(config.until).getTime();\n}\n\nconst commits = responseBody(\"GitHub - Commits\").map((commit) => ({\n  sha: commit.sha,\n  message: commit.commit?.message?.split(\"\\n\")[0] || \"\",\n  author: commit.commit?.author?.name || commit.author?.login || \"unknown\",\n  date: commit.commit?.author?.date || commit.commit?.committer?.date,\n  url: commit.html_url\n}));\n\nconst closedIssues = responseBody(\"GitHub - Closed Issues\")\n  .filter((issue) => !issue.pull_request && inWindow(issue.closed_at))\n  .map((issue) => ({\n    number: issue.number,\n    title: issue.title,\n    closedAt: issue.closed_at,\n    author: issue.user?.login || \"unknown\",\n    url: issue.html_url\n  }));\n\nconst mergedPullRequests = responseBody(\"GitHub - Merged PRs\")\n  .filter((pr) => pr.merged_at && inWindow(pr.merged_at))\n  .map((pr) => ({\n    number: pr.number,\n    title: pr.title,\n    mergedAt: pr.merged_at,\n    author: pr.user?.login || \"unknown\",\n    url: pr.html_url\n  }));\n\nconst activity = {\n  commits,\n  closedIssues,\n  mergedPullRequests,\n  metrics: {\n    commitCount: commits.length,\n    closedIssueCount: closedIssues.length,\n    mergedPullRequestCount: mergedPullRequests.length\n  }\n};\n\nreturn [{\n  json: {\n    ...config,\n    activity\n  }\n}];"
      },
      "id": "aggregate-activity",
      "name": "Aggregate Weekly Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst languageName = data.language === \"FR\" ? \"French\" : \"English\";\n\nconst prompt = [\n  \"Repository: \" + data.repo,\n  \"Window: \" + data.since + \" to \" + data.until,\n  \"Language: \" + languageName,\n  \"\",\n  \"Activity JSON:\",\n  JSON.stringify(data.activity, null, 2),\n  \"\",\n  \"Write a weekly narrative development summary for humans.\",\n  \"Mention the week's main themes, notable shipped work, operational risks, and next-week follow-ups.\",\n  \"Keep it concise, useful, and non-hypey.\"\n].join(\"\\n\");\n\nreturn [{\n  json: {\n    ...data,\n    claudeRequest: {\n      model: \"claude-sonnet-4-20250514\",\n      max_tokens: 1200,\n      system: \"You write concise weekly engineering summaries from GitHub activity. Return Markdown only.\",\n      messages: [\n        {\n          role: \"user\",\n          content: prompt\n        }\n      ]\n    }\n  }\n}];"
      },
      "id": "build-claude-request",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.dryRun ? 'https://postman-echo.com/post' : 'https://api.anthropic.com/v1/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "x-api-key",
              "value": "={{ $json.anthropicApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.dryRun ? { dryRun: true, model: $json.claudeRequest.model, promptPreview: $json.claudeRequest.messages[0].content.slice(0, 500) } : $json.claudeRequest) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "timeout": 60000
        }
      },
      "id": "call-claude-api",
      "name": "Claude API - Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $(\"Build Claude Request\").first().json;\nconst response = $input.first().json;\nconst body = response.body || response;\n\nlet summary;\nif (data.dryRun) {\n  summary = [\n    \"## Weekly dev summary (dry run)\",\n    \"\",\n    \"**Repository:** \" + data.repo,\n    \"**Window:** \" + data.since.slice(0, 10) + \" to \" + data.until.slice(0, 10),\n    \"\",\n    \"- Commits: \" + data.activity.metrics.commitCount,\n    \"- Closed issues: \" + data.activity.metrics.closedIssueCount,\n    \"- Merged PRs: \" + data.activity.metrics.mergedPullRequestCount,\n    \"\",\n    \"Production mode sends the same activity payload to Claude using claude-sonnet-4-20250514.\"\n  ].join(\"\\n\");\n} else {\n  summary = body.content?.find((part) => part.type === \"text\")?.text || body.content?.[0]?.text;\n  if (!summary) {\n    throw new Error(\"Claude API response did not contain a text summary.\");\n  }\n}\n\nconst content = [\n  \"**Weekly dev summary for \" + data.repo + \"**\",\n  \"\",\n  summary\n].join(\"\\n\").slice(0, 1900);\n\nreturn [{\n  json: {\n    ...data,\n    summary,\n    discordPayload: {\n      content,\n      allowed_mentions: {\n        parse: []\n      }\n    }\n  }\n}];"
      },
      "id": "format-discord-payload",
      "name": "Format Discord Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.dryRun ? 'https://postman-echo.com/post' : $json.discordWebhookUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.discordPayload) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "timeout": 30000
        }
      },
      "id": "send-discord-webhook",
      "name": "Discord Webhook - Deliver Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $(\"Format Discord Payload\").first().json;\nconst response = $input.first().json;\n\nreturn [{\n  json: {\n    ok: true,\n    dryRun: data.dryRun,\n    repo: data.repo,\n    language: data.language,\n    destinationChannel: data.destinationChannel,\n    delivery: data.dryRun ? \"Postman Echo dry run\" : \"Discord webhook\",\n    deliveryStatusCode: response.statusCode || 200,\n    metrics: data.activity.metrics,\n    summaryPreview: data.summary.slice(0, 500)\n  }\n}];"
      },
      "id": "execution-summary",
      "name": "Execution Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        80
      ]
    }
  ],
