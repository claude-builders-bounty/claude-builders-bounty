        [
          {
            "node": "Aggregate & Format Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Aggregate & Format Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Aggregate & Format Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate & Format Prompt": {
      "main": [
        [
          {
            "node": "Claude API (Sonnet 4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API (Sonnet 4)": {
      "main": [
        [
          {
            "node": "Deliver via Webhook (Discord/Slack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
