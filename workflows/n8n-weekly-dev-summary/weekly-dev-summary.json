{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "c1a0b2d3-e4f5-6a7b-8c9d-0e1f2a3b4c5d",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $vars.GITHUB_API_URL }}/repos/{{ $vars.GITHUB_REPO }}/commits?since={{ $now.minus({weeks:1}).toISO() }}&per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "d2e3f4a5-b6c7-8d9e-0f1a-2b3c4d5e6f7a",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $vars.GITHUB_API_URL }}/repos/{{ $vars.GITHUB_REPO }}/issues?state=closed&since={{ $now.minus({weeks:1}).toISO() }}&per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "e3f4a5b6-c7d8-9e0f-1a2b-3c4d5e6f7a8b",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $vars.GITHUB_API_URL }}/repos/{{ $vars.GITHUB_REPO }}/pulls?state=closed&per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "f4a5b6c7-d8e9-0f1a-2b3c-4d5e6f7a8b9c",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        600
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all()[0]?.json || [];\nconst issues = $input.all()[1]?.json || [];\nconst prs = $input.all()[2]?.json || [];\n\nconst oneWeekAgo = new Date();\noneWeekAgo.setDate(oneWeekAgo.getDate() - 7);\n\nconst recentCommits = commits.filter(c => new Date(c.commit?.author?.date) >= oneWeekAgo);\nconst recentIssues = issues.filter(i => new Date(i.closed_at) >= oneWeekAgo);\nconst mergedPRs = prs.filter(p => p.merged_at && new Date(p.merged_at) >= oneWeekAgo);\n\nconst commitList = recentCommits.map(c => `- ${c.commit?.message?.split('\\n')[0]} (${c.sha?.substring(0,7)}) by ${c.commit?.author?.name}`).join('\\n');\nconst issueList = recentIssues.filter(i => !i.pull_request).map(i => `- #${i.number} ${i.title}`).join('\\n');\nconst prList = mergedPRs.map(p => `- #${p.number} ${p.title} (by ${p.user?.login})`).join('\\n');\n\nconst summary = `## GitHub Activity for the Week\n\n### Commits (${recentCommits.length})\n${commitList || 'No commits this week.'}\n\n### Closed Issues (${recentIssues.filter(i => !i.pull_request).length})\n${issueList || 'No closed issues this week.'}\n\n### Merged PRs (${mergedPRs.length})\n${prList || 'No merged PRs this week.'}`;\n\nreturn [{ json: { summary, commitCount: recentCommits.length, closedIssueCount: recentIssues.filter(i => !i.pull_request).length, mergedPRCount: mergedPRs.length } }];"
      },
      "id": "a5b6c7d8-e9f0-1a2b-3c4d-5e6f7a8b9c0d",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "options": {
          "temperature": 0.5
        },
        "prompt": "={{ $vars.LANGUAGE === 'FR' ? 'Tu es un rédacteur technique. Rédige un résumé narratif en français pour la semaine de développement suivante. Sois concis mais informatif, mets en avant les accomplissements clés et les tendances.\\n\\n' : 'You are a technical writer. Write a concise, engaging narrative summary in English of this week\\'s development activity. Highlight key accomplishments and trends.\\n\\n' }}{{ $json.summary }}\n\n{{ $vars.LANGUAGE === 'FR' ? 'Résumé narratif :' : 'Narrative summary:' }}"
      },
      "id": "b6c7d8e9-f0a1-2b3c-4d5e-6f7a8b9c0d1e",
      "name": "Claude Narrative",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [
        940,
        400
      ],
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const narrative = $input.first()?.json?.content?.[0]?.text || $input.first()?.json?.text || $input.first()?.json?.completion || '';\nconst header = `📋 **Weekly Dev Summary — {{ $vars.GITHUB_REPO }}**\\n\\n`;\nreturn [{ json: { message: header + narrative } }];"
      },
      "id": "c7d8e9f0-a1b2-3c4d-5e6f-7a8b9c0d1e2f",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{ $vars.DELIVERY_METHOD }}",
              "rightValue": "discord",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "d8e9f0a1-b2c3-4d5e-6f7a-8b9c0d1e2f3a",
      "name": "Delivery Method?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1420,
        400
      ]
    },
    {
      "parameters": {
        "content": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "e9f0a1b2-c3d4-5e6f-7a8b-9c0d1e2f3a4b",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1680,
        260
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "DISCORD_CREDENTIAL_ID",
          "name": "Discord Webhook"
        }
      },
      "webhookId": "discord"
    },
    {
      "parameters": {
        "fromEmail": "={{ $vars.EMAIL_FROM }}",
        "toEmail": "={{ $vars.EMAIL_TO }}",
        "subject": "=📋 Weekly Dev Summary — {{ $vars.GITHUB_REPO }}",
        "text": "={{ $json.message }}",
        "options": {}
      },
      "id": "f0a1b2c3-d4e5-6f7a-8b9c-0d1e2f3a4b5c",
      "name": "Send via Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1680,
        540
      ],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "SMTP Account"
        }
      }
    }
  ],
