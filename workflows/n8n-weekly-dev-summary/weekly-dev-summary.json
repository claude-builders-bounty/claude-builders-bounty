{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "d2b5f8b2-02a0-4ad4-8ac8-3052556f4971",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -860,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "repo-owner",
              "name": "repoOwner",
              "value": "claude-builders-bounty",
              "type": "string"
            },
            {
              "id": "repo-name",
              "name": "repoName",
              "value": "claude-builders-bounty",
              "type": "string"
            },
            {
              "id": "language",
              "name": "language",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "discord-webhook",
              "name": "discordWebhookUrl",
              "value": "https://discord.com/api/webhooks/replace-me",
              "type": "string"
            },
            {
              "id": "since-date",
              "name": "sinceDate",
              "value": "={{$now.minus({ days: 7 }).toFormat('yyyy-MM-dd')}}",
              "type": "string"
            },
            {
              "id": "since-iso",
              "name": "sinceIso",
              "value": "={{$now.minus({ days: 7 }).toISO()}}",
              "type": "string"
            },
            {
              "id": "until-date",
              "name": "untilDate",
              "value": "={{$now.toFormat('yyyy-MM-dd')}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0d1208f3-4b17-4d7a-8808-5f6356a542a5",
      "name": "Configure Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -640,
        120
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.repoOwner}}/{{$json.repoName}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.sinceIso}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "5bcfb54f-e8fe-4777-8024-3c3e4bf4af87",
      "name": "Get Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        120
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{$node[\"Configure Report\"].json.repoOwner}}/{{$node[\"Configure Report\"].json.repoName}} is:pr is:merged merged:>={{$node[\"Configure Report\"].json.sinceDate}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "45a8c887-7cbb-406b-9bf9-7c56d15755d2",
      "name": "Search Merged Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        120
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{$node[\"Configure Report\"].json.repoOwner}}/{{$node[\"Configure Report\"].json.repoName}} is:issue closed:>={{$node[\"Configure Report\"].json.sinceDate}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "5111e428-f3b9-4337-b70c-4b9ce502e939",
      "name": "Search Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $items('Configure Report')[0].json;\nconst commits = $items('Get Weekly Commits').map((item) => item.json);\nconst mergedPrs = $items('Search Merged Pull Requests')[0].json.items ?? [];\nconst closedIssues = $items('Search Closed Issues')[0].json.items ?? [];\n\nconst commitLines = commits.slice(0, 25).map((commit) => {\n  const sha = String(commit.sha ?? '').slice(0, 7);\n  const message = commit.commit?.message?.split('\\n')[0] ?? 'Untitled commit';\n  const author = commit.commit?.author?.name ?? commit.author?.login ?? 'unknown';\n  return `- ${sha} ${message} (${author})`;\n});\n\nconst prLines = mergedPrs.slice(0, 25).map((pr) => `- #${pr.number} ${pr.title} by ${pr.user?.login ?? 'unknown'}`);\nconst issueLines = closedIssues.slice(0, 25).map((issue) => `- #${issue.number} ${issue.title}`);\nconst outputLanguage = String(config.language).toUpperCase() === 'FR' ? 'French' : 'English';\n\nconst prompt = `Write a weekly engineering update in ${outputLanguage} for ${config.repoOwner}/${config.repoName}.\n\nPeriod: ${config.sinceDate} through ${config.untilDate}\n\nCommits (${commits.length}):\n${commitLines.join('\\n') || '- No commits found'}\n\nMerged pull requests (${mergedPrs.length}):\n${prLines.join('\\n') || '- No merged pull requests found'}\n\nClosed issues (${closedIssues.length}):\n${issueLines.join('\\n') || '- No closed issues found'}\n\nReturn:\n1. A two-sentence executive summary\n2. Three to six bullet highlights\n3. Risks or follow-ups, if any\n4. A short thank-you note to contributors\n\nKeep it human, concrete, and under 450 words.`;\n\nreturn [\n  {\n    json: {\n      ...config,\n      commitCount: commits.length,\n      mergedPrCount: mergedPrs.length,\n      closedIssueCount: closedIssues.length,\n      prompt,\n    },\n  },\n];"
      },
      "id": "f5038206-0832-43e7-b840-3758bf7cc5eb",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1200,\n  \"temperature\": 0.3,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": $json.prompt\n    }\n  ]\n}",
        "options": {}
      },
      "id": "61e3444a-0bb4-446d-9966-03f676cfd87f",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const report = $items('Build Claude Prompt')[0].json;\nconst textBlocks = Array.isArray($json.content) ? $json.content : [];\nconst summary = textBlocks\n  .map((block) => block.text)\n  .filter(Boolean)\n  .join('\\n\\n') || 'Claude returned no text content.';\n\nreturn [\n  {\n    json: {\n      ...report,\n      summary,\n      discordPayload: {\n        content: `**Weekly Dev Summary: ${report.repoOwner}/${report.repoName}**\\n${summary}`,\n      },\n    },\n  },\n];"
      },
      "id": "b46a40bb-b008-4d4c-b7e8-a542b516c619",
      "name": "Format Discord Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.discordWebhookUrl}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.discordPayload}}",
        "options": {}
      },
      "id": "844dcb2f-9065-4929-8c8c-249c1d95305d",
      "name": "Send Discord Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        120
      ]
    }
  ],
  "connections": {
