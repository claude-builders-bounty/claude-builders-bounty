{
  "name": "Weekly Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo_owner",
              "value": "={{ $env.GITHUB_REPO_OWNER || 'tscircuit' }}"
            },
            {
              "name": "repo_name",
              "value": "={{ $env.GITHUB_REPO_NAME || 'dsn-converter' }}"
            },
            {
              "name": "language",
              "value": "={{ $env.SUMMARY_LANGUAGE || 'EN' }}"
            },
            {
              "name": "discord_webhook_url",
              "value": "={{ $env.DISCORD_WEBHOOK_URL || '' }}"
            },
            {
              "name": "email_to",
              "value": "={{ $env.SUMMARY_EMAIL_TO || '' }}"
            },
            {
              "name": "github_token",
              "value": "={{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "anthropic_api_key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "config-vars",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus(7, 'days').toISO() }}"
            },
            {
              "name": "until",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.github_token }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.repo_owner }}/{{ $('Config Variables').item.json.repo_name }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $now.minus(7, 'days').toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Variables').item.json.github_token }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 380],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.repo_owner }}/{{ $('Config Variables').item.json.repo_name }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Variables').item.json.github_token }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-summary"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 560],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Fetch Commits').first().json || [];\nconst issues = $('Fetch Closed Issues').first().json || [];\nconst prs = $('Fetch Merged PRs').first().json || [];\nconst config = $('Config Variables').first().json;\n\n// Filter PRs to only merged ones from this week\nconst weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst mergedPRs = (Array.isArray(prs) ? prs : []).filter(pr => \n  pr.merged_at && new Date(pr.merged_at) >= weekAgo\n);\n\n// Filter issues closed this week\nconst closedIssues = (Array.isArray(issues) ? issues : []).filter(issue => \n  !issue.pull_request && issue.closed_at && new Date(issue.closed_at) >= weekAgo\n);\n\n// Summarize commits\nconst commitList = (Array.isArray(commits) ? commits : []).slice(0, 50).map(c => ({\n  sha: c.sha?.substring(0, 7),\n  message: c.commit?.message?.split('\\n')[0],\n  author: c.commit?.author?.name,\n  date: c.commit?.author?.date\n}));\n\n// Summarize PRs\nconst prList = mergedPRs.map(pr => ({\n  number: pr.number,\n  title: pr.title,\n  author: pr.user?.login,\n  merged_at: pr.merged_at,\n  additions: pr.additions,\n  deletions: pr.deletions,\n  changed_files: pr.changed_files\n}));\n\n// Summarize issues\nconst issueList = closedIssues.map(issue => ({\n  number: issue.number,\n  title: issue.title,\n  closed_by: issue.closed_by?.login,\n  closed_at: issue.closed_at,\n  labels: issue.labels?.map(l => l.name).join(', ')\n}));\n\n// Unique commit authors\nconst authors = [...new Set(commitList.map(c => c.author))];\n\nconst data = {\n  repo: `${config.repo_owner}/${config.repo_name}`,\n  week_range: `${weekAgo.toISOString().split('T')[0]} to ${new Date().toISOString().split('T')[0]}`,\n  language: config.language,\n  stats: {\n    total_commits: commitList.length,\n    total_prs_merged: prList.length,\n    total_issues_closed: issueList.length,\n    unique_authors: authors.length,\n    authors: authors\n  },\n  commits: commitList,\n  merged_prs: prList,\n  closed_issues: issueList\n};\n\nreturn [{ json: data }];"
      },
      "id": "aggregate-data",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config Variables').item.json.anthropic_api_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a technical writer creating a weekly development summary for a GitHub repository. Write a clear, engaging narrative summary in {{ $json.language === 'FR' ? 'French' : 'English' }}.\\n\\nRepository: {{ $json.repo }}\\nWeek: {{ $json.week_range }}\\n\\nStatistics:\\n- Commits: {{ $json.stats.total_commits }}\\n- PRs merged: {{ $json.stats.total_prs_merged }}\\n- Issues closed: {{ $json.stats.total_issues_closed }}\\n- Unique contributors: {{ $json.stats.unique_authors }} ({{ $json.stats.authors.join(', ') }})\\n\\nMerged PRs:\\n{{ $json.merged_prs.map(pr => `- #${pr.number}: ${pr.title} (+${pr.additions}/-${pr.deletions}) by ${pr.author}`).join('\\n') }}\\n\\nClosed Issues:\\n{{ $json.closed_issues.map(issue => `- #${issue.number}: ${issue.title} [${issue.labels}]`).join('\\n') }}\\n\\nRecent Commits:\\n{{ $json.commits.map(c => `- ${c.sha}: ${c.message} (${c.author})`).join('\\n') }}\\n\\nWrite a narrative summary with these sections:\\n1. **Overview** — 2-3 sentences on the week's overall theme\\n2. **Highlights** — Key PRs and changes, with context on why they matter\\n3. **Issues Resolved** — Summary of closed issues\\n4. **Contributors** — Acknowledge who contributed\\n5. **Looking Ahead** — Brief note on what seems to be in progress based on commit patterns\\n\\nKeep it concise but informative. Use Markdown formatting.\"\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "claude-api",
      "name": "Claude API Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 380],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $('Claude API Summary').first().json;\nconst data = $('Aggregate Data').first().json;\nconst config = $('Config Variables').first().json;\n\n// Extract the summary text from Claude's response\nlet summary = '';\nif (claudeResponse.content && Array.isArray(claudeResponse.content)) {\n  summary = claudeResponse.content.map(block => block.text || '').join('');\n} else if (typeof claudeResponse === 'string') {\n  summary = claudeResponse;\n} else {\n  summary = JSON.stringify(claudeResponse);\n}\n\nconst output = {\n  repo: data.repo,\n  week: data.week_range,\n  summary: summary,\n  stats: data.stats,\n  delivery: {\n    discord_webhook: config.discord_webhook_url || null,\n    email_to: config.email_to || null\n  }\n};\n\nreturn [{ json: output }];"
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-discord",
              "leftValue": "={{ $json.delivery.discord_webhook }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-discord",
      "name": "Has Discord Webhook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1580, 280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.delivery.discord_webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [{\n    \"title\": \"📋 Weekly Dev Summary: {{ $json.repo }}\",\n    \"description\": \"{{ $json.summary.substring(0, 4000) }}\",\n    \"color\": 5814783,\n    \"footer\": {\n      \"text\": \"Week of {{ $json.week }} | Generated by n8n + Claude\"\n    },\n    \"timestamp\": \"{{ $now.toISO() }}\"\n  }]\n}",
        "options": {}
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1820, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-email",
              "leftValue": "={{ $json.delivery.email_to }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-email",
      "name": "Has Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1580, 480]
    },
    {
      "parameters": {
        "fromEmail": "dev-summary@n8n.local",
        "toEmail": "={{ $json.delivery.email_to }}",
        "subject": "=Weekly Dev Summary: {{ $json.repo }} ({{ $json.week }})",
        "emailFormat": "html",
        "html": "=<!DOCTYPE html><html><body style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;\"><h1 style=\"color: #333;\">📋 Weekly Dev Summary</h1><p style=\"color: #666;\"><strong>Repository:</strong> {{ $json.repo }}<br><strong>Week:</strong> {{ $json.week }}</p><div style=\"background: #f6f8fa; border-radius: 8px; padding: 20px; margin-top: 20px;\">{{ $json.summary.replace(/\\n/g, '<br>') }}</div><hr style=\"margin-top: 30px; border: none; border-top: 1px solid #eee;\"><p style=\"color: #999; font-size: 12px;\">Generated by n8n + Claude API</p></body></html>",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1820, 480]
    }
  ],
