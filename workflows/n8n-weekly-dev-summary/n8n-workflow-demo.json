    {
      "parameters": {
        "jsCode": "const items=$input.all().map(i=>i.json);const commits=items.filter(i=>i.kind==='commit').map(i=>i.text);const issues=items.filter(i=>i.kind==='issue').map(i=>i.text);const prs=items.filter(i=>i.kind==='pr').map(i=>i.text);const cfg=$('Config').first().json;return[{json:{repo:cfg.githubRepo,language:cfg.language,commitCount:commits.length,commits,issuesClosed:issues,prsMerged:prs}}];"
      },
      "name": "Aggregate Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$json;const text='## Introduction\\nThis week '+d.repo+' saw '+d.commitCount+' commits, '+d.issuesClosed.length+' issues closed and '+d.prsMerged.length+' PRs merged.\\n\\n## Highlights\\n- '+d.commits.join('\\n- ')+'\\n\\n## Technical Details\\nIssues: '+d.issuesClosed.join(', ')+'\\nPRs: '+d.prsMerged.join(', ')+'\\n\\n## Next Steps\\nKeep iterating and monitor activity.';return[{json:{summary:text}}];"
      },
