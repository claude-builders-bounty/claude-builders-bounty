{
  "id": "7f8a9b0c-1d2e-3f4a-5b6c-7d8e9f0a1b2c",
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "id": "aa1bb2cc-3dd4-5ee6-7ff8-900aabbccdd01",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "bb2cc3dd-4ee5-6ff7-8aa9-0bbccddee102",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-owner-0001",
              "name": "GITHUB_OWNER",
              "value": "your-org",
              "type": "string"
            },
            {
              "id": "cfg-repo-0002",
              "name": "GITHUB_REPO",
              "value": "your-repo",
              "type": "string"
            },
            {
              "id": "cfg-token-0003",
              "name": "GITHUB_TOKEN",
              "value": "ghp_your_github_token_here",
              "type": "string"
            },
            {
              "id": "cfg-claude-0004",
              "name": "CLAUDE_API_KEY",
              "value": "sk-ant-your_claude_api_key_here",
              "type": "string"
            },
            {
              "id": "cfg-slack-0005",
              "name": "SLACK_WEBHOOK_URL",
              "value": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
              "type": "string"
            },
            {
              "id": "cfg-lang-0006",
              "name": "LANGUAGE",
              "value": "EN",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cc3dd4ee-5ff6-7aa8-9bb0-1ccddee00f03",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now = new Date();\nconst since = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst fmt = (d) => d.toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    since: since.toISOString(),\n    until: now.toISOString(),\n    sinceDate: fmt(since),\n    untilDate: fmt(now),\n    weekLabel: `${fmt(since)} → ${fmt(now)}`\n  }\n}];"
      }
    },
    {
      "id": "dd4ee5ff-6aa7-8bb9-0cc1-2ddee00ff104",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config').first().json.GITHUB_OWNER }}/{{ $('Set Config').first().json.GITHUB_REPO }}/commits",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Config').first().json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $('Calculate Date Range').first().json.since }}"
            },
            {
              "name": "until",
              "value": "={{ $('Calculate Date Range').first().json.until }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "ee5ff6aa-7bb8-9cc0-1dd2-3eeff00aa205",
      "name": "Aggregate Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const commits = $input.all().map(item => ({\n  sha: (item.json.sha || '').substring(0, 7),\n  message: (item.json.commit?.message || 'No message').split('\\n')[0],\n  author: item.json.commit?.author?.name || item.json.author?.login || 'Unknown',\n  date: item.json.commit?.author?.date || ''\n}));\n\nreturn [{ json: { commits, commitCount: commits.length } }];"
      }
    },
    {
      "id": "ff6aa7bb-8cc9-0dd1-2ee3-4ffaa00bb306",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config').first().json.GITHUB_OWNER }}/{{ $('Set Config').first().json.GITHUB_REPO }}/issues",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Config').first().json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Calculate Date Range').first().json.since }}"
            },
            {
              "name": "filter",
              "value": "all"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "aa7bb8cc-9dd0-1ee2-3ff4-5aabb00cc407",
      "name": "Aggregate Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GitHub issues API also returns PRs — filter them out\nconst issues = $input.all()\n  .filter(item => !item.json.pull_request)\n  .map(item => ({\n    number: item.json.number,\n    title: item.json.title,\n    closedAt: item.json.closed_at,\n    labels: (item.json.labels || []).map(l => l.name).join(', ')\n  }));\n\nreturn [{ json: { issues, issueCount: issues.length } }];"
      }
    },
    {
      "id": "bb8cc9dd-0ee1-2ff3-4aa5-6bbcc00dd508",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config').first().json.GITHUB_OWNER }}/{{ $('Set Config').first().json.GITHUB_REPO }}/pulls",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Config').first().json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "cc9dd0ee-1ff2-3aa4-5bb6-7ccdd00ee609",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config = $('Set Config').first().json;\nconst dateRange = $('Calculate Date Range').first().json;\nconst { commits, commitCount } = $('Aggregate Commits').first().json;\nconst { issues, issueCount } = $('Aggregate Issues').first().json;\n\n// Filter only truly merged PRs from this week\nconst sinceDate = new Date(dateRange.since);\nconst mergedPRs = $input.all()\n  .filter(item => item.json.merged_at && new Date(item.json.merged_at) >= sinceDate)\n  .map(item => ({\n    number: item.json.number,\n    title: item.json.title,\n    author: item.json.user?.login || 'unknown',\n    mergedAt: item.json.merged_at\n  }));\n\nconst lang = config.LANGUAGE === 'FR' ? 'French' : 'English';\nconst repo = `${config.GITHUB_OWNER}/${config.GITHUB_REPO}`;\n\nconst systemPrompt = `You are a technical writer creating concise weekly development summaries for engineering teams. Write in ${lang}. Be informative and highlight the most impactful work. Format output for Slack using mrkdwn (bold with *asterisks*, bullet points with •).`;\n\nconst commitLines = commits.slice(0, 15).map(c => `- [${c.sha}] ${c.message} (${c.author})`).join('\\n') || 'No commits this week.';\nconst issueLines = issues.map(i => `- #${i.number}: ${i.title}${i.labels ? ` [${i.labels}]` : ''}`).join('\\n') || 'No issues closed this week.';\nconst prLines = mergedPRs.map(pr => `- #${pr.number}: ${pr.title} by @${pr.author}`).join('\\n') || 'No PRs merged this week.';\n\nconst userPrompt = `Write a weekly development summary for *${repo}* covering ${dateRange.weekLabel}.\n\n## Commits (${commitCount} total)\\n${commitLines}\\n\\n## Closed Issues (${issueCount} total)\\n${issueLines}\\n\\n## Merged Pull Requests (${mergedPRs.length} total)\\n${prLines}\\n\\nWrite 2–3 concise paragraphs that:\\n1. Summarise the key achievements and shipped work\\n2. Highlight notable contributors\\n3. Give a sense of overall project velocity\\n\\nUse Slack mrkdwn formatting with emoji. Keep it under 400 words.`;\n\nconst claudeRequestBody = JSON.stringify({\n  model: 'claude-sonnet-4-20250514',\n  max_tokens: 1024,\n  system: systemPrompt,\n  messages: [{ role: 'user', content: userPrompt }]\n});\n\nreturn [{\n  json: {\n    claudeRequestBody,\n    claudeApiKey: config.CLAUDE_API_KEY,\n    slackWebhookUrl: config.SLACK_WEBHOOK_URL,\n    repo,\n    weekLabel: dateRange.weekLabel,\n    commitCount,\n    issueCount,\n    prCount: mergedPRs.length\n  }\n}];"
      }
    },
    {
      "id": "dd0ee1ff-2aa3-4bb5-6cc7-8ddee00ff710",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.claudeApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.claudeRequestBody }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "ee1ff2aa-3bb4-5cc6-7dd8-9eeff00aa811",
      "name": "Format Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claudeText = $json.content?.[0]?.text || 'No summary generated.';\nconst bp = $('Build Prompt').first().json;\n\nconst statsLine = `:memo: *${bp.commitCount}* commits  |  :white_check_mark: *${bp.issueCount}* issues closed  |  :twisted_rightwards_arrows: *${bp.prCount}* PRs merged`;\n\nconst slackPayload = JSON.stringify({\n  text: `Weekly Dev Summary: ${bp.repo} — ${bp.weekLabel}`,\n  blocks: [\n    {\n      type: 'header',\n      text: {\n        type: 'plain_text',\n        text: `:bar_chart: Weekly Dev Summary — ${bp.repo}`,\n        emoji: true\n      }\n    },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: `*${bp.weekLabel}*\\n${statsLine}`\n      }\n    },\n    { type: 'divider' },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: claudeText\n      }\n    },\n    {\n      type: 'context',\n      elements: [\n        {\n          type: 'mrkdwn',\n          text: '_Generated by claude-sonnet-4-20250514 via n8n_'\n        }\n      ]\n    }\n  ]\n});\n\nreturn [{ json: { slackPayload, webhookUrl: bp.slackWebhookUrl } }];"
      }
    },
    {
      "id": "ff2aa3bb-4cc5-6dd7-8ee9-0ffaa00bb912",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhookUrl }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.slackPayload }}",
        "options": {}
      }
    }
  ],
