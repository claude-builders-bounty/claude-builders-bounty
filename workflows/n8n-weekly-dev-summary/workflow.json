{
  "name": "GitHub Weekly Dev Summary with Claude API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "e4b10b0a-73d8-4f23-95b8-d2a8497d025b",
      "name": "Weekly Schedule (Friday 5 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "GITHUB_OWNER",
              "value": "claude-builders-bounty"
            },
            {
              "name": "GITHUB_REPO",
              "value": "claude-builders-bounty"
            },
            {
              "name": "SUMMARY_LANGUAGE",
              "value": "EN"
            },
            {
              "name": "DELIVERY_CHANNEL",
              "value": "slack"
            },
            {
              "name": "SLACK_WEBHOOK_URL",
              "value": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"
            },
            {
              "name": "DISCORD_WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK"
            }
          ],
          "number": [
            {
              "name": "LOOKBACK_DAYS",
              "value": 7
            }
          ]
        },
        "options": {}
      },
      "id": "7ac1516e-44fa-4d1e-8a03-7cb2cfbe19f1",
      "name": "Workflow Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const lookbackDays = $json.LOOKBACK_DAYS || 7;\nconst now = new Date();\nconst sinceDate = new Date(now.getTime() - (lookbackDays * 24 * 60 * 60 * 1000));\n\nreturn {\n  owner: $json.GITHUB_OWNER,\n  repo: $json.GITHUB_REPO,\n  language: $json.SUMMARY_LANGUAGE || 'EN',\n  channel: ($json.DELIVERY_CHANNEL || 'slack').toLowerCase(),\n  slackWebhook: $json.SLACK_WEBHOOK_URL,\n  discordWebhook: $json.DISCORD_WEBHOOK_URL,\n  sinceIso: sinceDate.toISOString(),\n  startDate: sinceDate.toISOString().split('T')[0],\n  endDate: now.toISOString().split('T')[0]\n};"
      },
      "id": "e44654ec-15b5-4b07-94d1-0f7f32997b69",
      "name": "Calculate Date Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.sinceIso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "904b8923-aef3-4014-9988-fa08191ec485",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        180
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Calculate Date Window').item.json.owner }}/{{ $('Calculate Date Window').item.json.repo }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Calculate Date Window').item.json.sinceIso }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "673f8e65-3c1d-4eb4-b901-b952a2336340",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        340
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Calculate Date Window').item.json.owner }}/{{ $('Calculate Date Window').item.json.repo }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "76e3100e-61c0-4279-913a-7ef6d62886c5",
      "name": "Fetch Closed & Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Calculate Date Window').item.json;\nconst sinceMs = new Date(meta.sinceIso).getTime();\n\n// 1. Process Commits\nlet rawCommits = [];\ntry {\n  rawCommits = $('Fetch Weekly Commits').all().map(i => i.json);\n} catch (e) {}\n\nconst commits = rawCommits.map(c => ({\n  sha: c.sha ? c.sha.substring(0, 7) : '',\n  author: c.commit?.author?.name || c.author?.login || 'Unknown',\n  message: (c.commit?.message || '').split('\\n')[0]\n})).slice(0, 40);\n\n// 2. Process Issues (filter out PRs)\nlet rawIssues = [];\ntry {\n  rawIssues = $('Fetch Closed Issues').all().map(i => i.json);\n} catch (e) {}\n\nconst closedIssues = rawIssues\n  .filter(iss => !iss.pull_request) // GitHub issues endpoint includes PRs unless filtered\n  .filter(iss => new Date(iss.closed_at).getTime() >= sinceMs)\n  .map(iss => ({\n    number: iss.number,\n    title: iss.title,\n    author: iss.user?.login,\n    labels: (iss.labels || []).map(l => l.name)\n  }));\n\n// 3. Process Merged PRs\nlet rawPulls = [];\ntry {\n  rawPulls = $('Fetch Closed & Merged PRs').all().map(i => i.json);\n} catch (e) {}\n\nconst mergedPRs = rawPulls\n  .filter(pr => pr.merged_at && new Date(pr.merged_at).getTime() >= sinceMs)\n  .map(pr => ({\n    number: pr.number,\n    title: pr.title,\n    author: pr.user?.login,\n    merged_at: pr.merged_at\n  }));\n\nreturn {\n  owner: meta.owner,\n  repo: meta.repo,\n  language: meta.language,\n  channel: meta.channel,\n  slackWebhook: meta.slackWebhook,\n  discordWebhook: meta.discordWebhook,\n  startDate: meta.startDate,\n  endDate: meta.endDate,\n  stats: {\n    totalCommits: commits.length,\n    totalMergedPRs: mergedPRs.length,\n    totalClosedIssues: closedIssues.length\n  },\n  commits,\n  mergedPRs,\n  closedIssues\n};"
      },
      "id": "e963bc1e-28db-410a-b1ee-3286395b0021",
      "name": "Aggregate & Format Activity Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 2000,\n  \"system\": \"You are an elite Staff Engineering Manager and Technical Communicator. Transform raw GitHub commits, closed issues, and merged PRs into an engaging, cohesive weekly narrative summary for the dev team and leadership. Write strictly in {{ $json.language === 'FR' ? 'French' : 'English' }}. Highlight key architectural improvements, impactful bugfixes, and dev momentum. Use markdown with concise emojis, bold highlights, and clean bullet points.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Here is this week's activity data for repository {{ $json.owner }}/{{ $json.repo }} ({{ $json.startDate }} to {{ $json.endDate }}):\\n\\nStats: {{ JSON.stringify($json.stats) }}\\n\\nMerged Pull Requests ({{ $json.mergedPRs.length }}):\\n{{ JSON.stringify($json.mergedPRs, null, 2) }}\\n\\nClosed Issues ({{ $json.closedIssues.length }}):\\n{{ JSON.stringify($json.closedIssues, null, 2) }}\\n\\nKey Commits sample ({{ $json.commits.length }}):\\n{{ JSON.stringify($json.commits, null, 2) }}\\n\\nPlease write a structured weekly narrative summary with:\\n1. 📊 Executive Summary & Velocity Highlights\\n2. 🚀 Key Features & Merged PRs\\n3. 🛡️ Critical Bugfixes & Resolved Issues\\n4. 💡 Engineering Impact & Focus for Next Week\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "e43b1716-17b4-47cf-898f-0a0669176378",
      "name": "Generate Summary with Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $json;\nconst textContent = claudeResponse.content?.[0]?.text || 'No summary generated.';\nconst meta = $('Aggregate & Format Activity Data').item.json;\n\nreturn {\n  summary: textContent,\n  channel: meta.channel,\n  owner: meta.owner,\n  repo: meta.repo,\n  startDate: meta.startDate,\n  endDate: meta.endDate,\n  stats: meta.stats,\n  slackWebhook: meta.slackWebhook,\n  discordWebhook: meta.discordWebhook\n};"
      },
      "id": "5fa2dc10-381a-4645-a7be-769a6fa99e56",
      "name": "Parse Claude Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        340
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "discord",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "416bb7ef-5722-4467-b50a-e5a95ba3d3d8",
      "name": "Route by Destination Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1800,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slackWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"*📢 Weekly Engineering Summary: {{ $json.owner }}/{{ $json.repo }} ({{ $json.startDate }} to {{ $json.endDate }})*\\n\\n{{ $json.summary.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') }}\"\n}",
        "options": {}
      },
      "id": "67b9319e-e37a-428e-8dbf-9b161e1b8273",
      "name": "Post to Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2040,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"**📢 Weekly Engineering Summary: {{ $json.owner }}/{{ $json.repo }} ({{ $json.startDate }} to {{ $json.endDate }})**\",\n  \"embeds\": [\n    {\n      \"title\": \"Weekly Dev Digest\",\n      \"description\": \"{{ $json.summary.substring(0, 4000).replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') }}\",\n      \"color\": 3447003,\n      \"footer\": {\n        \"text\": \"Generated autonomously by Claude Code & n8n\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "df2eb121-6927-4c4f-a496-c1eb14378107",
      "name": "Post to Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2040,
        420
      ]
    }
  ],
