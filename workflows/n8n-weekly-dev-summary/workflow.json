{
  "name": "Weekly Dev Summary — GitHub + Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/commits",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Get Commits (7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 320]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/pulls",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 440]
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Get Commits (7 days)').all();\nconst issues = $('Get Closed Issues)').all();\nconst prs = $('Get Merged PRs').all();\n\nconst oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nconst commitList = commits\n  .filter(c => new Date(c.json.commit?.author?.date) > oneWeekAgo)\n  .map(c => `- ${c.json.commit?.message?.split('\\n')[0]} (@${c.json.author?.login || 'unknown'})`)\n  .slice(0, 30)\n  .join('\\n');\n\nconst issueList = issues\n  .filter(i => !i.json.pull_request && new Date(i.json.closed_at) > oneWeekAgo)\n  .map(i => `- #${i.json.number}: ${i.json.title}`)\n  .slice(0, 20)\n  .join('\\n');\n\nconst prList = prs\n  .filter(p => p.json.merged_at && new Date(p.json.merged_at) > oneWeekAgo)\n  .map(p => `- #${p.json.number}: ${p.json.title} (@${p.json.user?.login})`)\n  .slice(0, 20)\n  .join('\\n');\n\nconst repo = $vars.GITHUB_REPO;\nconst weekStart = oneWeekAgo.toISOString().split('T')[0];\nconst weekEnd = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    repo,\n    weekStart,\n    weekEnd,\n    commitCount: commits.filter(c => new Date(c.json.commit?.author?.date) > oneWeekAgo).length,\n    issueCount: issues.filter(i => !i.json.pull_request && new Date(i.json.closed_at) > oneWeekAgo).length,\n    prCount: prs.filter(p => p.json.merged_at && new Date(p.json.merged_at) > oneWeekAgo).length,\n    commitList: commitList || '(none)',\n    issueList: issueList || '(none)',\n    prList: prList || '(none)',\n  }\n}];"
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $vars.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-6"
            },
            {
              "name": "max_tokens",
              "value": "1024"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"Write a concise weekly development summary for the {{ $json.repo }} repository covering {{ $json.weekStart }} to {{ $json.weekEnd }}.\\n\\nStats:\\n- Commits: {{ $json.commitCount }}\\n- Issues closed: {{ $json.issueCount }}\\n- PRs merged: {{ $json.prCount }}\\n\\nRecent commits:\\n{{ $json.commitList }}\\n\\nClosed issues:\\n{{ $json.issueList }}\\n\\nMerged PRs:\\n{{ $json.prList }}\\n\\nWrite a 3-4 paragraph narrative summary in {{ $vars.LANGUAGE || 'English' }}. Highlight the most significant work, group related changes, and end with a note on team velocity. Keep it under 300 words. No bullet points — prose only.\"}]"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Claude — Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 320]
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $json.content?.[0]?.text || 'Error generating summary';\nconst stats = $('Aggregate Data').first().json;\n\nconst subject = `📊 Weekly Dev Summary: ${stats.repo} (${stats.weekStart} → ${stats.weekEnd})`;\n\nconst body = `**${stats.repo} — Week of ${stats.weekStart}**\\n\\n` +\n  `📝 ${stats.commitCount} commits · 🔀 ${stats.prCount} PRs merged · ✅ ${stats.issueCount} issues closed\\n\\n` +\n  claudeResponse;\n\nreturn [{ json: { subject, body, stats } }];"
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 320]
    },
    {
      "parameters": {
        "url": "={{ $vars.WEBHOOK_URL }}",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.subject + '\\n\\n' + $json.body }}"
            },
            {
              "name": "username",
              "value": "Dev Summary Bot"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Send to Slack / Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 320]
    }
  ],
  "connections": {
    "Every Friday 5pm": {
      "main": [
        [
          { "node": "Get Commits (7 days)", "type": "main", "index": 0 },
          { "node": "Get Closed Issues", "type": "main", "index": 0 },
          { "node": "Get Merged PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Commits (7 days)": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 0 }]]
    },
    "Get Closed Issues": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 0 }]]
    },
    "Get Merged PRs": {
      "main": [[{ "node": "Aggregate Data", "type": "main", "index": 0 }]]
    },
    "Aggregate Data": {
      "main": [[{ "node": "Claude — Generate Summary", "type": "main", "index": 0 }]]
    },
    "Claude — Generate Summary": {
      "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]]
    },
    "Format Message": {
      "main": [[{ "node": "Send to Slack / Discord", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": ["github", "claude", "weekly-summary", "automation"],
  "triggerCount": 0,
  "updatedAt": "2026-06-15T00:00:00.000Z",
  "versionId": "1"
}
