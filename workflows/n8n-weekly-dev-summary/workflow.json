{
  "name": "Claude Code Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-friday-5pm",
      "name": "Weekly Cron (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "repo",
              "name": "GITHUB_REPO",
              "value": "claude-builders-bounty/claude-builders-bounty",
              "type": "string"
            },
            {
              "id": "lang",
              "name": "SUMMARY_LANGUAGE",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "webhook",
              "name": "DESTINATION_WEBHOOK_URL",
              "value": "={{ $env.SLACK_OR_DISCORD_WEBHOOK_URL }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "config-vars",
      "name": "Configurable Variables (Repo, Channel, EN/FR)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.GITHUB_REPO }}/commits?per_page=30",
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        140
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $node[\"Configurable Variables (Repo, Channel, EN/FR)\"].json.GITHUB_REPO }}/issues?state=closed&per_page=30",
        "options": {}
      },
      "id": "fetch-closed-issues",
      "name": "Fetch Closed Issues & Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate an executive weekly developer narrative summary in language (\" + $node[\"Configurable Variables (Repo, Channel, EN/FR)\"].json.SUMMARY_LANGUAGE + \") for repo \" + $node[\"Configurable Variables (Repo, Channel, EN/FR)\"].json.GITHUB_REPO + \" covering this week's commits, closed issues, and merged PRs.\"\n    }\n  ]\n}"
      },
      "id": "claude-sonnet-summary",
      "name": "Claude API (claude-sonnet-4-20250514)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Configurable Variables (Repo, Channel, EN/FR)\"].json.DESTINATION_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"📊 **Weekly Dev Summary**:\\n\\n\" + $json.content[0].text\n}"
      },
      "id": "deliver-webhook",
      "name": "Deliver to Discord / Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Configurable Variables (Repo, Channel, EN/FR)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configurable Variables (Repo, Channel, EN/FR)": {
      "main": [
        [
          {
            "node": "Fetch Weekly Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues & Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Claude API (claude-sonnet-4-20250514)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues & Merged PRs": {
      "main": [
        [
          {
            "node": "Claude API (claude-sonnet-4-20250514)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API (claude-sonnet-4-20250514)": {
      "main": [
        [
          {
            "node": "Deliver to Discord / Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}