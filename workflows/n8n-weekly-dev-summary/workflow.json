        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [{ "node": "Merge GitHub Data", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [{ "node": "Merge GitHub Data", "type": "main", "index": 1 }]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [{ "node": "Merge GitHub Data", "type": "main", "index": 2 }]
      ]
    },
    "Merge GitHub Data": {
      "main": [
        [{ "node": "Build Claude Prompt", "type": "main", "index": 0 }]
      ]
    },
    "Build Claude Prompt": {
      "main": [
