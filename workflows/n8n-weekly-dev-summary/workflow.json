{
  "name": "Weekly GitHub Activity Summary With Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "weekly-friday-trigger",
      "name": "Friday 5pm Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const repo = $env.GITHUB_REPO || 'n8n-io/n8n';\nconst language = ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase();\nconst destination = $env.DISCORD_WEBHOOK_URL || 'https://discord.example.invalid/webhook';\nconst [owner, name] = repo.split('/');\nif (!owner || !name) throw new Error('GITHUB_REPO must be owner/repo');\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    repo,\n    owner,\n    name,\n    language: language === 'FR' ? 'FR' : 'EN',\n    destination,\n    since: weekAgo.toISOString(),\n    until: now.toISOString()\n  }\n}];"
      },
      "id": "prepare-config",
      "name": "Prepare Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.name}}/commits?since={{$json.since}}&until={{$json.until}}&per_page=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, -220],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.name}}/issues?state=closed&since={{$json.since}}&per_page=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.name}}/pulls?state=closed&sort=updated&direction=desc&per_page=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "User-Agent",
              "value": "n8n-weekly-dev-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-merged-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 220],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const config = $('Prepare Config').first().json;\nconst commits = $('Fetch Commits').all().flatMap(item => Array.isArray(item.json) ? item.json : []);\nconst closedIssues = $('Fetch Closed Issues').all().flatMap(item => Array.isArray(item.json) ? item.json : []).filter(issue => !issue.pull_request);\nconst mergedPrs = $('Fetch Merged PRs').all().flatMap(item => Array.isArray(item.json) ? item.json : []).filter(pr => pr.merged_at && new Date(pr.merged_at) >= new Date(config.since));\nconst prompt = `Write a concise weekly narrative development summary in ${config.language}. Repository: ${config.repo}. Window: ${config.since} to ${config.until}. Commits: ${commits.slice(0, 20).map(c => `- ${c.commit?.message || c.sha}`).join('\\n') || 'No commits found.'} Closed issues: ${closedIssues.slice(0, 20).map(i => `- #${i.number} ${i.title}`).join('\\n') || 'No closed issues found.'} Merged PRs: ${mergedPrs.slice(0, 20).map(p => `- #${p.number} ${p.title}`).join('\\n') || 'No merged PRs found.'} Include sections: Highlights, Product impact, Engineering notes, Next week.`;\nreturn [{ json: { ...config, commitsCount: commits.length, closedIssuesCount: closedIssues.length, mergedPrsCount: mergedPrs.length, prompt } }];"
      },
      "id": "build-claude-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":900,\"messages\":[{\"role\":\"user\",\"content\":$json.prompt}]}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "generate-summary-with-claude",
      "name": "Generate Summary With Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Build Claude Prompt').first().json;\nconst response = $input.first().json;\nconst summary = response.content?.map(part => part.text).filter(Boolean).join('\\n\\n') || 'Claude returned no text content.';\nreturn [{ json: { content: `# Weekly summary for ${config.repo}\\n\\n${summary}\\n\\n_Stats: ${config.commitsCount} commits, ${config.closedIssuesCount} closed issues, ${config.mergedPrsCount} merged PRs._`, destination: config.destination } }];"
      },
      "id": "format-discord-message",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.destination}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\":$json.content}",
        "options": {}
      },
      "id": "deliver-to-discord",
      "name": "Deliver To Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 0]
    }
  ],
  "connections": {
    "Friday 5pm Trigger": {
      "main": [
        [
          {
            "node": "Prepare Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Config": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Claude Prompt": {
      "main": [
        [
          {
            "node": "Generate Summary With Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary With Claude": {
      "main": [
        [
          {
            "node": "Format Discord Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Discord Message": {
      "main": [
        [
          {
            "node": "Deliver To Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
