              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "weekly-friday-schedule",
      "name": "Weekly Friday Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{'https://api.github.com/repos/' + ($env.GITHUB_OWNER || 'OWNER') + '/' + ($env.GITHUB_REPO || 'REPO') + '/commits'}}",
