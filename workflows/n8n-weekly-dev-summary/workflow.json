{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "id": "node-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "node-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "GITHUB_OWNER",
              "value": "your-github-org",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "GITHUB_REPO",
              "value": "your-repo-name",
              "type": "string"
            },
            {
              "id": "cfg-3",
              "name": "GITHUB_TOKEN",
              "value": "={{ $env.GITHUB_TOKEN }}",
              "type": "string"
            },
            {
              "id": "cfg-4",
              "name": "ANTHROPIC_API_KEY",
              "value": "={{ $env.ANTHROPIC_API_KEY }}",
              "type": "string"
            },
            {
              "id": "cfg-5",
              "name": "DISCORD_WEBHOOK_URL",
              "value": "={{ $env.DISCORD_WEBHOOK_URL }}",
              "type": "string"
            },
            {
              "id": "cfg-6",
              "name": "SUMMARY_LANGUAGE",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "cfg-7",
              "name": "SLACK_WEBHOOK_URL",
              "value": "={{ $env.SLACK_WEBHOOK_URL }}",
              "type": "string"
            },
            {
              "id": "cfg-8",
              "name": "NOTIFICATION_EMAIL",
              "value": "={{ $env.NOTIFICATION_EMAIL }}",
              "type": "string"
            },
            {
              "id": "cfg-9",
              "name": "DELIVERY_CHANNEL",
              "value": "discord",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-dates",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "const now = new Date();\nconst since = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    since: since.toISOString(),\n    until: now.toISOString(),\n    weekLabel: since.toISOString().slice(0, 10) + ' to ' + now.toISOString().slice(0, 10)\n  }\n}];"
      }
    },
    {
      "id": "node-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -220],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config').item.json.GITHUB_OWNER }}/{{ $('Set Config').item.json.GITHUB_REPO }}/commits",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Config').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $('Calculate Date Range').item.json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config').item.json.GITHUB_OWNER }}/{{ $('Set Config').item.json.GITHUB_REPO }}/issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Config').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Calculate Date Range').item.json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 220],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Config').item.json.GITHUB_OWNER }}/{{ $('Set Config').item.json.GITHUB_REPO }}/pulls",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Config').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-merge",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [880, 0],
      "parameters": {
        "mode": "mergeByIndex",
        "options": {}
      }
    },
    {
      "id": "node-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0],
      "parameters": {
        "jsCode": "const cfg = $('Set Config').item.json;\nconst dates = $('Calculate Date Range').item.json;\n\nconst commits = $('Fetch Commits').all().map(i => i.json);\nconst rawIssues = $('Fetch Closed Issues').all().map(i => i.json);\nconst rawPRs = $('Fetch Merged PRs').all().map(i => i.json);\n\nconst issues = rawIssues.filter(i => !i.pull_request);\nconst prs = rawPRs.filter(p => p.merged_at !== null);\n\nconst lang = cfg.SUMMARY_LANGUAGE === 'FR' ? 'French' : 'English';\nconst repo = `${cfg.GITHUB_OWNER}/${cfg.GITHUB_REPO}`;\n\nconst commitList = commits.slice(0, 20)\n  .map(c => `- ${(c.commit?.message || '').split('\\n')[0]} (${c.author?.login || 'unknown'})`)\n  .join('\\n') || '(none)';\n\nconst issueList = issues.slice(0, 10)\n  .map(i => `- #${i.number}: ${i.title}`)\n  .join('\\n') || '(none)';\n\nconst prList = prs.slice(0, 10)\n  .map(p => `- #${p.number}: ${p.title} (by ${p.user?.login || 'unknown'})`)\n  .join('\\n') || '(none)';\n\nconst prompt = `You are a developer-facing technical writer. Write a concise weekly activity summary for the GitHub repository \"${repo}\" in ${lang}.\n\nWeek: ${dates.weekLabel}\n\n## Commits (${commits.length} total, showing up to 20)\n${commitList}\n\n## Closed Issues (${issues.length} total)\n${issueList}\n\n## Merged Pull Requests (${prs.length} total)\n${prList}\n\nWrite a 3-5 paragraph narrative summary covering: overview of the week, key accomplishments, notable commits or themes, and what to watch next week (if inferable). Tone: concise, technical, positive. Flowing prose only — no bullet lists.`;\n\nreturn [{\n  json: {\n    prompt,\n    repo,\n    weekLabel: dates.weekLabel,\n    stats: { commits: commits.length, issues: issues.length, prs: prs.length },\n    apiKey: cfg.ANTHROPIC_API_KEY,\n    discordUrl: cfg.DISCORD_WEBHOOK_URL,\n    slackUrl: cfg.SLACK_WEBHOOK_URL,\n    notifEmail: cfg.NOTIFICATION_EMAIL,\n    channel: cfg.DELIVERY_CHANNEL\n  }\n}];"
      }
    },
    {
      "id": "node-claude",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1024, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {}
      }
    },
    {
      "id": "node-format",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0],
      "parameters": {
        "jsCode": "const claudeResp = $input.item.json;\nconst prev = $('Build Claude Prompt').item.json;\n\nconst text = claudeResp.content?.[0]?.text || '(no summary generated)';\n\nreturn [{\n  json: {\n    summary: text,\n    weekLabel: prev.weekLabel,\n    discordUrl: prev.discordUrl,\n    slackUrl: prev.slackUrl,\n    notifEmail: prev.notifEmail,\n    channel: prev.channel,\n    embed: {\n      title: `\\uD83D\\uDCCA Weekly Dev Summary: ${prev.repo}`,\n      description: text.slice(0, 4000),\n      color: 5814783,\n      fields: [\n        { name: 'Week', value: prev.weekLabel, inline: true },\n        { name: 'Commits', value: String(prev.stats.commits), inline: true },\n        { name: 'Issues Closed', value: String(prev.stats.issues), inline: true },\n        { name: 'PRs Merged', value: String(prev.stats.prs), inline: true }\n      ],\n      footer: { text: 'Generated by Claude claude-sonnet-4-20250514 via n8n' }\n    }\n  }\n}];"
      }
    },
    {
      "id": "node-route",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1760, 0],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "discord",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "discord"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "slack",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "slack"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "email",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, -220],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ username: 'Dev Summary Bot', embeds: [$json.embed] }) }}",
        "options": {}
      }
    },
    {
      "id": "node-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ text: '*\\uD83D\\uDCCA Weekly Dev Summary*\\n' + $json.summary.slice(0, 3000) }) }}",
        "options": {}
      }
    },
    {
      "id": "node-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1980, 220],
      "parameters": {
        "fromEmail": "devbot@example.com",
        "toEmail": "={{ $json.notifEmail }}",
        "subject": "=📊 Weekly Dev Summary: {{ $json.weekLabel }}",
        "emailType": "text",
        "text": "={{ $json.summary }}",
        "options": {}
      }
    }
  ],
  "connections": {
