{
  "name": "Claude Code - Automated Weekly GitHub Activity Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [5],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "1",
      "name": "Weekly Schedule (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "GITHUB_REPO",
              "value": "claude-builders-bounty/claude-builders-bounty"
            },
            {
              "name": "DELIVERY_WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/EXAMPLE/YOUR_WEBHOOK_URL"
            },
            {
              "name": "SUMMARY_LANGUAGE",
              "value": "EN"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    repo: $json.GITHUB_REPO,\n    webhookUrl: $json.DELIVERY_WEBHOOK_URL,\n    language: $json.SUMMARY_LANGUAGE,\n    sinceIso: oneWeekAgo.toISOString(),\n    nowIso: now.toISOString()\n  }\n}];"
      },
      "id": "3",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/commits?since={{ $json.sinceIso }}&per_page=100",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-Claude-Weekly-Summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 160]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Calculate Date Range').item.json.repo }}/issues?state=closed&since={{ $('Calculate Date Range').item.json.sinceIso }}&per_page=100",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-Claude-Weekly-Summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "Fetch Closed Issues & PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 440]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Calculate Date Range').first().json;\n\n// Normalize commits\nconst rawCommits = $('Fetch Weekly Commits').all().map(i => i.json);\nconst commits = (Array.isArray(rawCommits[0]) ? rawCommits[0] : rawCommits).filter(c => c && c.commit);\nconst commitSummaries = commits.slice(0, 30).map(c => `- ${c.commit.message.split('\\n')[0]} (${c.commit.author ? c.commit.author.name : 'Unknown'})`);\n\n// Normalize issues vs PRs\nconst rawItems = $('Fetch Closed Issues & PRs').all().map(i => i.json);\nconst items = (Array.isArray(rawItems[0]) ? rawItems[0] : rawItems).filter(i => i && i.title);\nconst closedPRs = items.filter(i => i.pull_request).slice(0, 20).map(p => `- #${p.number}: ${p.title}`);\nconst closedIssues = items.filter(i => !i.pull_request).slice(0, 20).map(i => `- #${i.number}: ${i.title}`);\n\nreturn [{\n  json: {\n    repo: cfg.repo,\n    webhookUrl: cfg.webhookUrl,\n    language: cfg.language,\n    sinceIso: cfg.sinceIso,\n    totalCommits: commits.length,\n    totalClosedPRs: closedPRs.length,\n    totalClosedIssues: closedIssues.length,\n    commitList: commitSummaries.join('\\n'),\n    closedPRList: closedPRs.join('\\n'),\n    closedIssueList: closedIssues.join('\\n')\n  }\n}];"
      },
      "id": "6",
      "name": "Aggregate Activity Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are an elite technical writer. Generate a concise, engaging weekly engineering narrative dev summary for GitHub repository '{{ $json.repo }}'.\\n\\nLanguage: {{ $json.language }}\\nActivity Statistics:\\n- Total Commits: {{ $json.totalCommits }}\\n- Total Merged/Closed PRs: {{ $json.totalClosedPRs }}\\n- Total Closed Issues: {{ $json.totalClosedIssues }}\\n\\nKey Commits:\\n{{ $json.commitList }}\\n\\nMerged PRs:\\n{{ $json.closedPRList }}\\n\\nClosed Issues:\\n{{ $json.closedIssueList }}\\n\\nFormat the output with:\\n🚀 **Weekly Overview** (2 sentences)\\n✨ **Key Highlights & Merges** (bullet points)\\n🛠️ **Bug Fixes & Maintenance**\\n🔮 **Looking Ahead**\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "7",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Aggregate Activity Data').item.json.webhookUrl }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"📊 **Weekly Engineering Dev Summary — {{ $('Aggregate Activity Data').item.json.repo }}**\\n\\n\" + {{ JSON.stringify($json.content[0].text) }}\n}",
        "options": {}
      },
      "id": "8",
      "name": "Dispatch to Discord/Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300]
    }
  ],
  "connections": {
    "Weekly Schedule (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config Variables": {
      "main": [
        [
          {
            "node": "Calculate Date Range",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Date Range": {
      "main": [
        [
          {
            "node": "Fetch Weekly Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues & PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Aggregate Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues & PRs": {
      "main": [
        [
          {
            "node": "Aggregate Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Activity Data": {
      "main": [
        [
          {
            "node": "Call Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Claude API": {
      "main": [
        [
          {
            "node": "Dispatch to Discord/Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
