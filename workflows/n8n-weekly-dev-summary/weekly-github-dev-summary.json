      "id": "set-config",
      "name": "Config (repo/lang/dest)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst end = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\nconst start = new Date(end.getTime() - 7*24*3600*1000);\nreturn [{ json: { ...items[0].json, sinceISO: start.toISOString(), untilISO: end.toISOString(), sinceDate: start.toISOString().slice(0,10) } }];"
      },
      "id": "window",
      "name": "Compute 7-day window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
