      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {}
      },
      "id": "711b8c88-e301-5ff6-bd5d-209535cf3a01",
      "name": "Claude narrative",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst text = (r.content || []).filter(b => b.type === 'text').map(b => b.text).join('\\n').trim();\nif (!text || !['end_turn','stop_sequence'].includes(r.stop_reason)) throw new Error('Claude returned an empty or incomplete narrative.');\nconst w = $('Window').first().json;\nreturn [{json:{text,from:w.from,to:w.to,subject:(w.language==='FR'?'Activité hebdomadaire':'Weekly activity')+' · '+w.repo+' · '+w.end.slice(0,10)}}];"
      },
      "id": "923a9895-54a1-55d0-95ed-44a384397c78",
      "name": "Validate response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
