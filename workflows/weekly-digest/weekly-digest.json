    },
    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nif (!/^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$/.test(c.repo) || !['EN','FR'].includes(c.language)) {\n  throw new Error('Enter an owner/repository and choose EN or FR.');\n}\nconst end = new Date();\nconst start = new Date(end.getTime() - 7 * 24 * 3600 * 1000);\nreturn [{json: {...c, start: start.toISOString(), end: end.toISOString()}}];"
      },
      "id": "294849d6-829a-5762-9abb-69b9cb1eee23",
      "name": "Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $('Window').first().json.repo + '/commits' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "since",
              "value": "={{ $('Window').first().json.start }}"
            },
            {
              "name": "until",
              "value": "={{ $('Window').first().json.end }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "weekly-repository-digest"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.headers.link?.includes('rel=\"next\"') }}"
            }
          }
        }
      },
      "id": "2f389ad7-efa0-5fa0-9bad-fdcd6bf2fd03",
      "name": "GitHub commits",
