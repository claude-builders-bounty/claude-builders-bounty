    {"parameters":{"jsCode":"const repo=$('Config').first().json.repo; const language=$('Config').first().json.language; const since=$('Config').first().json.since; const until=$('Config').first().json.until;\nconst commits=$('Fetch commits').all().map(i=>i.json).flat().slice(0,100).map(c=>({sha:(c.sha||'').slice(0,7), message:c.commit?.message, author:c.commit?.author?.name, url:c.html_url}));\nconst issues=$('Fetch closed issues').all().map(i=>i.json).flat().filter(x=>!x.pull_request).map(x=>({number:x.number,title:x.title,closed_at:x.closed_at,url:x.html_url}));\nconst prs=$('Fetch closed PRs').all().map(i=>i.json).flat().filter(p=>p.merged_at && new Date(p.merged_at)>=new Date(since)).map(p=>({number:p.number,title:p.title,merged_at:p.merged_at,user:p.user?.login,url:p.html_url}));\nreturn [{json:{repo,language,since,until,commits,issues,prs,prompt:`Write a concise weekly narrative GitHub activity summary in ${language}. Repo: ${repo}. Window: ${since} to ${until}. Include: highlights, shipped changes, fixed issues, contributors, risks/next steps. Use a friendly engineering-lead tone. Data:\nCOMMITS=${JSON.stringify(commits)}\nCLOSED_ISSUES=${JSON.stringify(issues)}\nMERGED_PRS=${JSON.stringify(prs)}`}}];"} ,"id":"prepare","name":"Prepare Claude prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[1160,20]},
    {"parameters":{"method":"POST","url":"https://api.anthropic.com/v1/messages","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-api-key","value":"={{$env.ANTHROPIC_API_KEY}}"},{"name":"anthropic-version","value":"2023-06-01"},{"name":"content-type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { model: 'claude-sonnet-4-20250514', max_tokens: 1200, messages: [{ role: 'user', content: $json.prompt }] } }}","options":{}} ,"id":"claude","name":"Claude narrative summary","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1380,20]},
    {"parameters":{"method":"POST","url":"={{$env.DISCORD_WEBHOOK_URL || $env.SLACK_WEBHOOK_URL}}","sendBody":true,"specifyBody":"json","jsonBody":"={{ { content: ($json.content?.[0]?.text || $json.text || JSON.stringify($json)).slice(0, 1900) } }}","options":{}} ,"id":"deliver","name":"Deliver to Discord or Slack webhook","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1600,20]}
  ],
