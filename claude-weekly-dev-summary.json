{
  "name": "Claude Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": 1,
          "unit": "weeks",
          "cronExpression": "0 17 * * 5"
        }
      },
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "path": "claude-weekly-summary",
        "method": "GET",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "bodyContentType": "json",
          "responseFormat": "json"
        }
      },
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseFormat": "json"
        }
      },
      "name": "GitHub",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseFormat": "json"
        }
      },
      "name": "GitHub1",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseFormat": "json"
        }
      },
      "name": "GitHub2",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1450,
        300
      ]
      },
      {
        "parameters": {
          "options": {
            "responseFormat": "json"
          }
        },
        "name": "Claude",
        "type": "n8n-nodes-base.claude",
        "typeVersion": 1,
        "position": [
          1650,
          300
        ]
      },
      {
        "parameters": {
          "options": {
            "responseFormat": "json"
          }
        },
        "name": "Email",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 1,
        "position": [
          1850,
          300
        ]
      }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set": {
      "main": [
        [
          {
            "node": "GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub": {
      "main": [
        [
          {
            "node": "GitHub1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub1": {
      "main": [
        [
          {
            "node": "GitHub2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub2": {
      "main": [
        [
          {
            "node": "Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude": {
      "main": [
        [
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/New_York",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": false,
    "timeout": -1,
    "maxExecutionTimeout": 3600
  },
  "versionId": "claude_weekly_dev_summary"
}