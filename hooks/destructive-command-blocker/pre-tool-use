#!/bin/bash
# Claude Code pre-tool-use hook: Destructive Command Blocker
# Blocks dangerous bash commands and logs them.

LOG_FILE="${HOME}/.claude/hooks/blocked.log"
MAX_LOG_SIZE=1048576

DANGEROUS_PATTERNS=(
  "rm[[:space:]]+-rf[[:space:]]+.*--no-preserve-root"
  "rm[[:space:]]+-rf[[:space:]]+\/"
  "rm[[:space:]]+-rf[[:space:]]+/[[:space:]]*$"
  "rm[[:space:]]+-rf[[:space:]]+\\~"
  "rm[[:space:]]+-rf[[:space:]]+\$HOME"
  "mkfs\\."
  "dd[[:space:]]+if=.*of="
  "shutdown[[:space:]]+-h[[:space:]]+now"
  "git[[:space:]]+push[[:space:]]+.*--force"
  "git[[:space:]]+reset[[:space:]]+--hard[[:space:]]+HEAD~"
  "git[[:space:]]+branch[[:space:]]+-D[[:space:]]"
  "DROP[[:space:]]+TABLE"
  "TRUNCATE[[:space:]]+TABLE"
  "DELETE[[:space:]]+FROM[[:space:]]+(?!.*WHERE)"
  "DROP[[:space:]]+DATABASE"
  "ALTER[[:space:]]+TABLE.*DROP"
)

log_blocked() {
  local cmd="$1"
  local reason="$2"
  local timestamp
  timestamp="$(date "+%Y-%m-%d %H:%M:%S")"
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  echo "[${timestamp}] BLOCKED | reason: ${reason} | command: ${cmd}" >> "$LOG_FILE"
}

if [ ! -t 0 ]; then
  INPUT="$(cat)"
else
  exit 0
fi

TOOL="$(echo "$INPUT" | python3 -c 'import sys, json; d=json.load(sys.stdin); print(d.get("tool", d.get("name", ""))) if isinstance(d,dict) else print("")' 2>/dev/null || echo "")"

CMD="$(echo "$INPUT" | python3 -c 'import sys, json; d=json.load(sys.stdin); args=d.get("arguments", d.get("args", {})); print(args.get("command", args.get("cmd", args.get("code", "")))) if isinstance(args,dict) else print(str(args))' 2>/dev/null || echo "")"

if [ -z "$TOOL" ] && [ -z "$CMD" ]; then
  exit 0
fi

case "$TOOL" in
  Bash|bash|shell|execute_command|exec_command|run|terminal)
    ;;
  *)
    exit 0
    ;;
esac

for pattern in "${DANGEROUS_PATTERNS[@]}"; do
  if echo "$CMD" | grep -qiE "$pattern" 2>/dev/null; then
    log_blocked "$CMD" "Matched: $pattern"
    echo ""
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    echo "!!                    COMMAND BLOCKED BY SAFETY HOOK                        !!"
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    echo ""
    echo "Pattern triggered: $pattern"
    echo "Command: $CMD"
    echo ""
    echo "Logged to: $LOG_FILE"
    echo "Temporary bypass: mv $LOG_FILE.pre-tool-use \$HOME/.claude/hooks/pre-tool-use.disabled 2>/dev/null; true"
    echo ""
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    exit 1
  fi
done

exit 0
