#!/bin/bash
#
# This script handles the pre-tool-use hook for blocking destructive commands
#

set -e

# Create hooks directory if it doesn't exist
mkdir -p ~/.claude/hooks/

# Default values
HOOKS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/.claude/hooks"
mkdir -p "$HOOKS_DIR"

# Log file for blocked commands
LOG_FILE="$HOOKS_DIR/blocked.log"

# Function to block destructive commands
block_destructive_commands() {
    local command="$1"
    # Log the blocked command
    echo "$(date): Blocking command: $command" >> "$LOG_FILE"
    
    # Check for destructive patterns and block them
    if [[ $command == *"rm -rf"* ]]; then
        echo "Blocked: rm -rf command detected"
        return 1
    fi
    
    if [[ $command == *"--force"* ]] || [[ $command == *"-rf"* ]]; then
        echo "Blocked: dangerous command with --force or -rf flag"
        return 1
    fi
    
    # Log the block
    echo "Blocked command: $command"
    return 0
}
 
This script blocks destructive commands like `rm -rf`, `DROP TABLE`, etc.
#
set +x

block_destructive_commands
