{
  "_comment": "Copy to ~/.claude/hooks/block_destructive_bash.config.json. All fields optional.",
  "allowlist": [
    "^rm -rf /tmp/[\\w./-]+$",
    "^rm -rf node_modules$",
    "^rm -rf \\.next$"
  ],
  "extra_rules": [
    ["\\bcurl\\s+.*\\|\\s*sh\\b", "piping curl into sh is dangerous"]
  ],
  "disabled_rules": []
}
