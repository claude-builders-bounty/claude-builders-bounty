{
  "$schema": "./hook_config_schema.json",
  "rules": [
    {
      "id": "rm-rf",
      "description": "Recursive force delete",
      "pattern": "\\brm\\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*\\b|\\-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*\\b|(?:-[a-zA-Z]+\\s+)*-r\\s+(?:-[a-zA-Z]*\\s+)*-f\\b|(?:-[a-zA-Z]+\\s+)*-f\\s+(?:-[a-zA-Z]*\\s+)*-r\\b)",
      "severity": "critical",
      "enabled": true
    },
    {
      "id": "drop-table",
      "description": "SQL DROP TABLE",
      "pattern": "\\bDROP\\s+TABLE\\b",
      "severity": "critical",
      "enabled": true,
      "flags": "IGNORECASE"
    },
    {
      "id": "git-push-force",
      "description": "Forced git push",
      "pattern": "\\bgit\\s+push\\s+.*--force\\b|\\bgit\\s+push\\s+-f\\b",
      "severity": "high",
      "enabled": true
    },
    {
      "id": "truncate",
      "description": "SQL TRUNCATE",
      "pattern": "\\bTRUNCATE\\b",
      "severity": "critical",
      "enabled": true,
      "flags": "IGNORECASE"
    },
    {
      "id": "delete-no-where",
      "description": "SQL DELETE FROM without WHERE clause",
      "pattern": "\\bDELETE\\s+FROM\\s+\\S+\\s*;",
      "severity": "critical",
      "enabled": true,
      "flags": "IGNORECASE"
    },
    {
      "id": "delete-no-where-eol",
      "description": "SQL DELETE FROM without WHERE (end-of-line)",
      "pattern": "\\bDELETE\\s+FROM\\s+\\S+\\s*$",
      "severity": "critical",
      "enabled": true,
      "flags": "IGNORECASE|MULTILINE"
    },
    {
      "id": "chmod-777",
      "description": "World-writable permissions",
      "pattern": "\\bchmod\\s+777\\b",
      "severity": "high",
      "enabled": true
    },
    {
      "id": "mkfs",
      "description": "Format filesystem",
      "pattern": "\\bmkfs\\b",
      "severity": "critical",
      "enabled": true
    },
    {
      "id": "dd-of-dev",
      "description": "Raw disk write with dd",
      "pattern": "\\bdd\\b.*\\bof=/dev/",
      "severity": "critical",
      "enabled": true
    }
  ],
  "whitelist": {
    "paths": [],
    "commands": []
  },
  "logging": {
    "enabled": true,
    "log_file": "~/.claude/hooks/blocked.log",
    "max_size_mb": 10
  },
  "dry_run": false,
  "show_colors": true
}
