#!/usr/bin/env bash
# PreToolUse hook - blocks destructive bash commands
set -euo pipefail

BLOCKED_PATTERNS=(
  'rm -rf /'
  'rm -rf ~'
  'DROP TABLE'
  'DROP DATABASE'
  'git push --force'
  'chmod -R 777'
  'dd if='
  'mkfs'
  '> /dev/sd'
  ':(){ :|& };:'
  'wget -O - | bash'
  'curl -sSL | bash'
)

INPUT="$*"
for pattern in "${BLOCKED_PATTERNS[@]}"; do
  if echo "$INPUT" | grep -qi "$pattern"; then
    echo "BLOCKED: Command matches destructive pattern '$pattern'"
    exit 1
  fi
done
exit 0
