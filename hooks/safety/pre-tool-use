#!/usr/bin/env python3
import sys
import json
import datetime
import os

def log_blocked(command):
    log_dir = os.path.expanduser("~/.claude/hooks")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, "blocked.log")
    timestamp = datetime.datetime.now().isoformat()
    pwd = os.getcwd()
    try:
        with open(log_path, "a") as f:
            f.write(f"[{timestamp}] [BLOCKED] {command} | Path: {pwd}\n")
    except Exception:
        pass

def main():
    try:
        input_data = sys.stdin.read()
        if not input_data.strip():
            return 0
        payload = json.loads(input_data)
        
        tool_name = payload.get("toolName", "").lower()
        if tool_name not in ["bash", "runcommand", "run_command", "execute"]:
            return 0
            
        args = payload.get("input", {})
        command = args.get("command", "")
        if not command:
            return 0
            
        cmd_upper = command.upper()
        
        # Block patterns
        if "RM -RF" in cmd_upper:
            log_blocked(command)
            print("BLOCKED: The 'rm -rf' command is destructive and has been intercepted by your safety hook.")
            return 1
            
        if "DROP TABLE" in cmd_upper:
            log_blocked(command)
            print("BLOCKED: The 'DROP TABLE' command is destructive and has been intercepted by your safety hook.")
            return 1
            
        if "GIT PUSH --FORCE" in cmd_upper or "GIT PUSH -F " in cmd_upper:
            log_blocked(command)
            print("BLOCKED: Force pushing ('git push --force') is destructive and has been intercepted by your safety hook.")
            return 1
            
        if "TRUNCATE" in cmd_upper:
            log_blocked(command)
            print("BLOCKED: The 'TRUNCATE' command is destructive and has been intercepted by your safety hook.")
            return 1
            
        if "DELETE FROM" in cmd_upper and "WHERE" not in cmd_upper:
            log_blocked(command)
            print("BLOCKED: 'DELETE FROM' without a 'WHERE' clause is destructive and has been intercepted by your safety hook.")
            return 1
            
        return 0
    except Exception:
        return 0

if __name__ == "__main__":
    sys.exit(main())
