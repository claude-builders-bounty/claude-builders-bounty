#!/bin/bash

# Claude Code pre-tool-use hook
# Blocks destructive commands and logs them.

COMMAND="$1"
LOG_FILE="$HOME/.claude/hooks/blocked.log"

# Patterns to block
PATTERNS=(
    "rm -rf"
    "DROP TABLE"
    "git push --force"
    "TRUNCATE"
    "DELETE FROM (?!.*WHERE)"
)

for pattern in "${PATTERNS[@]}"; do
    if echo "$COMMAND" | grep -qiE "$pattern"; then
        TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
        echo "[$TIMESTAMP] BLOCKED: $COMMAND | PATH: $PWD" >> "$LOG_FILE"
        echo "Error: Command blocked by security hook. Destructive operation detected: $COMMAND"
        exit 1
    fi
done

exit 0