#!/usr/bin/env bash
# ==============================================================================
# pre-tool-use — Claude Code safety hook
# Blocks destructive bash commands before execution.
# Part of: Claude Builders Bounty #3 — $100
# ==============================================================================
# Claude Code Hooks spec:
#   https://docs.anthropic.com/claude-code/hooks
#
# Environment variables set by Claude Code when invoking hooks:
#   CLAUDE_PROJECT_ROOT  — absolute path of the project
#   CLAUDE_TOOL_NAME     — tool being used (e.g., "Bash", "FileWrite")
#   CLAUDE_INPUT         — the full tool input as a JSON string
# ==============================================================================

set -uo pipefail

readonly HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LOG_FILE="${HOOK_DIR}/blocked.log"
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# ── Patterns that are always blocked ────────────────────────────────────────
# Each entry: pattern_name|pattern_regex|reason
PATTERNS=(
  "rm-rf-recursive|rm\s+(-rf|-/rf/|/-rf/|/-r/|/-f/)\s+/|Recursive force-delete targets the root filesystem. Use specific paths with --one-file-system."
  "rm-rf-system|rm\s+(-rf|-/rf/)\s+/etc|Modifying /etc with -rf can destroy system configuration."
  "rm-rf-var|rm\s+(-rf|-/rf/)\s+/var|Modifying /var with -rf can destroy system data."
  "drop-table|DROP\s+TABLE|Destructive DDL. Write a migration instead."
  "truncate|TRUNCATE\s+|Destructive DDL. Write a migration instead."
  "git-force-push|git\s+push\s+.*(-f|--force)\s*$|Force push rewrites remote history. Use --force-with-lease at minimum."
  "git-force-with-lease|git\s+push\s+.*--force\s+|Use --force-with-lease instead of --force."
  "delete-no-where|DELETE\s+FROM\s+\w+\s*$|DELETE without WHERE clause. Add a WHERE clause or use TRUNCATE intentionally."
  "update-no-where|UPDATE\s+\w+\s+SET\s+.*\s*$|UPDATE without WHERE clause. Add a WHERE clause."
  "shutdown|shutdown\s+-h\s+now|Shutdown command. Intentional? Use with caution."
  "reboot|reboot\s+|Reboot command. Intentional? Use with caution."
  "chmod-recursive-root|chmod\s+-R\s+777\s+/|Recursive chmod 777 on root. Specify a target directory."
  "dd-wipe|dd\s+if=.*\s+of=/dev|Direct disk write — potentially destructive."
  "mkfs|mkfs\.\w+|Filesystem creation — destructive."
  "sudo-rm-rf|sudo\s+rm\s+-rf|sudo + rm -rf = double danger."
)

# ── Check if Claude Code is invoking us ─────────────────────────────────────
if [ "${CLAUDE_TOOL_NAME:-}" != "Bash" ]; then
  # Not a bash tool call; let it pass
  exit 0
fi

# ── Extract the command being executed ──────────────────────────────────────
# The command is in CLAUDE_INPUT (JSON), under the "command" field.
INPUT_RAW="${CLAUDE_INPUT:-$*}"

# Try to parse command from JSON input
COMMAND=""
if echo "$INPUT_RAW" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
  COMMAND=$(echo "$INPUT_RAW" | python3 -c "
import json,sys
try:
    d = json.load(sys.stdin)
    print(d.get('command', d.get('raw_command', '')))
except:
    print('')
" 2>/dev/null)
fi

# Fallback: use the raw input
if [ -z "$COMMAND" ]; then
  COMMAND="$INPUT_RAW"
fi

# Normalize: collapse whitespace, uppercase SQL keywords for matching
COMMAND_NORMALIZED=$(echo "$COMMAND" | tr -s ' ' | sed 's/^ *//;s/ *$//')
COMMAND_UPPER=$(echo "$COMMAND_NORMALIZED" | tr '[:lower:]' '[:upper:]')

# ── Check against each dangerous pattern ────────────────────────────────────
for entry in "${PATTERNS[@]}"; do
  IFS='|' read -r name regex reason <<< "$entry"

  # Test both original (case-sensitive for CLI tools) and uppercased (for SQL)
  if echo "$COMMAND_NORMALIZED" | grep -qE "$regex" 2>/dev/null || \
     echo "$COMMAND_UPPER" | grep -qE "$regex" 2>/dev/null; then

    # Log the blocked attempt
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] BLOCKED | pattern=${name} | command=${COMMAND_NORMALIZED} | project=${CLAUDE_PROJECT_ROOT:-unknown}" >> "$LOG_FILE"

    # Print block message (Claude Code captures stdout and reports it)
    echo ""
    echo -e "${RED}⛔ BLOCKED${NC} — ${YELLOW}${name}${NC}"
    echo ""
    echo "  ${reason}"
    echo ""
    echo "  Attempted command: ${COMMAND_NORMALIZED}"
    echo "  Blocked pattern:   ${regex}"
    echo "  Project path:      ${CLAUDE_PROJECT_ROOT:-unknown}"
    echo ""
    echo -e "${YELLOW}💡 Suggestion:${NC} Use a safer alternative or explicitly"
    echo "   acknowledge the risk by bypassing with a targeted path."
    echo ""
    echo "  Logged to: ${LOG_FILE}"

    exit 1
  fi
done

# ── Command passed all checks ───────────────────────────────────────────────
exit 0
