#!/usr/bin/env python3
"""pre-tool-use hook - Blocks destructive bash commands in Claude Code.

Install: cp this file to ~/.claude/hooks/pre-tool-use
         chmod +x ~/.claude/hooks/pre-tool-use

This hook intercepts bash commands and blocks dangerous patterns.
"""

import sys
import json
import os
import datetime

BLOCKED_PATTERNS = [
    "rm -rf",
    "rm -fr",
    "rm -rf /",
    "rm -fr /",
    "DROP TABLE",
    "drop table",
    "TRUNCATE",
    "truncate",
    "git push --force",
    "git push -f",
    "DELETE FROM",
    "delete from",
    "> /dev/sda",
    "dd if=",
    ":(){ :|:& };:",  # Fork bomb
    "wget -O - | sh",
    "curl -sSL | bash",
    "curl | bash",
    "chmod -R 777 /",
    "mv /* /dev/null",
]

BLOCKED_LOG = os.path.expanduser("~/.claude/hooks/blocked.log")

def main():
    # Read the tool use payload from stdin
    try:
        payload = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        print(json.dumps({"approve": True}))
        return

    # Only intercept bash commands
    if isinstance(payload, dict) and payload.get("tool") == "Bash":
        command = payload.get("input", {}).get("command", "")

        for pattern in BLOCKED_PATTERNS:
            if pattern in command:
                # Log the blocked attempt
                os.makedirs(os.path.dirname(BLOCKED_LOG), exist_ok=True)
                with open(BLOCKED_LOG, "a") as log:
                    log.write(
                        f"[{datetime.datetime.now().isoformat()}] "
                        f"BLOCKED: {pattern!r} in command: {command[:200]}"
                        f" | cwd: {os.getcwd()}\n"
                    )

                # Reject with clear message
                result = {
                    "approve": False,
                    "message": (
                        f"BLOCKED by pre-tool-use hook. "
                        f"Command contains dangerous pattern: {pattern!r}. "
                        f"Execution rejected to prevent data loss. "
                        f"If you need to run this command, "
                        f"temporarily rename ~/.claude/hooks/pre-tool-use."
                    )
                }
                print(json.dumps(result))
                return

    # Approve safe commands
    print(json.dumps({"approve": True}))


if __name__ == "__main__":
    main()
