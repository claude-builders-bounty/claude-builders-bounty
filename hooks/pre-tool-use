#!/usr/bin/env python3
"""Claude Code pre-tool-use hook: blocks destructive bash commands."""
import json, sys, re, os, datetime

DANGEROUS_PATTERNS = [
    (r"\brm\s+.*-.*f", "rm with force flag deletes files without confirmation"),
    (r"\bDROP\s+TABLE\b", "DROP TABLE destroys database tables permanently"),
    (r"\bgit\s+push\s+.*--force\b", "git push --force rewrites shared history"),
    (r"\bTRUNCATE\s+TABLE\b", "TRUNCATE TABLE irreversibly empties tables"),
]

def main():
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)

    tool_use = payload.get("tool_use", {})
    if tool_use.get("type") != "bash" and tool_use.get("tool") != "bash":
        sys.exit(0)

    command = tool_use.get("command", "")
    if not command:
        sys.exit(0)

    # Check DELETE FROM without WHERE
    if re.search(r"\bDELETE\s+FROM\s+\w+", command, re.IGNORECASE):
        if not re.search(r"\bWHERE\b", command, re.IGNORECASE):
            block(command, "DELETE FROM without WHERE clause deletes all rows")
            return

    # Check other patterns
    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            block(command, reason)
            return

    sys.exit(0)

def block(command, reason):
    log_dir = os.path.expanduser("~/.claude/hooks")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, "blocked.log")

    timestamp = datetime.datetime.now().isoformat()
    project = os.getcwd()

    with open(log_path, "a", encoding="utf-8") as f:
        f.write(f"{timestamp} | {project} | BLOCKED: {command}\n")

    msg = (
        f"\n🛡️  BLOCKED: This command was intercepted by the pre-tool-use hook.\n"
        f"   Reason: {reason}\n"
        f"   Command: {command}\n"
        f"   If you really need this, run it manually outside Claude Code.\n"
    )
    print(msg, file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
