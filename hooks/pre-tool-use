#!/usr/bin/env python3
"""
pre-tool-use hook for Claude Code.
Blocks destructive bash commands before execution.

Install: copy to ~/.claude/hooks/pre-tool-use and chmod +x
Logs blocked attempts to ~/.claude/hooks/blocked.log
"""
import json
import re
import sys
from datetime import datetime, timezone

LOG_FILE = "blocked.log"
BLOCKED_PATTERNS = [
    # rm -rf variations — recursive force delete
    (r'\brm\s+.*-rf?\b', "Recursive force delete (rm -rf)"),
    # git push --force variations
    (r'git\s+push\s+.*--force', "Force push to remote"),
    (r'git\s+push\s+.*-f\b', "Force push to remote (short flag)"),
    # SQL destructive patterns
    (r'\bDROP\s+TABLE\b', "SQL DROP TABLE", True),
    (r'\bTRUNCATE\s+(TABLE\s+)?', "SQL TRUNCATE", True),
    # DELETE FROM without WHERE clause
    (r'\bDELETE\s+FROM\s+\S+(?!.*\bWHERE\b)', "SQL DELETE FROM without WHERE clause", True),
    # Other dangerous patterns
    (r'>\s*/dev/sda', "Write to raw block device"),
    (r'\bchmod\s+.*777\b', "World-writable permissions (chmod 777)"),
    (r':\(\)\s*\{', "Fork bomb pattern"),
    (r'\bdd\s+if=', "Raw disk copy (dd) — includes block device risk"),
]


def is_blocked(command: str):
    """Check command against blocked patterns. Returns (blocked, reason)."""
    for pattern, reason, *flags in BLOCKED_PATTERNS:
        case_insensitive = flags and flags[0]
        flags_re = re.IGNORECASE if case_insensitive else 0
        if re.search(pattern, command, flags_re):
            return True, reason
    return False, None


def log_blocked(command: str, reason: str):
    """Log blocked attempt with timestamp."""
    ts = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    entry = f"{ts} | BLOCKED | {reason} | command: {command[:200]}\n"
    with open(LOG_FILE, 'a') as f:
        f.write(entry)
    return entry.strip()


def main():
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(0)  # Non-JSON input, pass through

    tool_name = data.get('tool_name', '')
    tool_input = data.get('tool_input', {})

    # Only intercept Bash/terminal commands
    if tool_name not in ('Bash', 'terminal', 'bash'):
        print(json.dumps(data))
        return

    command = tool_input.get('command', '')
    if not command:
        print(json.dumps(data))
        return

    blocked, reason = is_blocked(command)
    if blocked:
        log_entry = log_blocked(command, reason)
        sys.stderr.write(f"[pre-tool-use] {log_entry}\n")
        sys.exit(2)  # Non-zero exit = block the tool call

    # Pass through unmodified
    print(json.dumps(data))


if __name__ == '__main__':
    main()
