#!/usr/bin/env python3
"""
pre-tool-use hook for Claude Code.

Blocks dangerous bash commands before they execute.
Install: cp hooks/pre-tool-use ~/.claude/hooks/ && chmod +x ~/.claude/hooks/pre-tool-use
"""

import json
import os
import re
import sys
from pathlib import Path

# ── blocklist ──────────────────────────────────────────────────────────────
# Each entry: (regex_pattern, reason_message)
BLOCKED_PATTERNS = [
    (re.compile(r'\brm\s+[-][-]?[rRfF]+\b', re.IGNORECASE),       # rm -rf / rm -r -f
     "rm -rf blocked: recursive forced delete is too destructive."),
    (re.compile(r'\bdrop\s+table\b', re.IGNORECASE),               # DROP TABLE
     "DROP TABLE blocked: would destroy a database table."),
    (re.compile(r'\bgit\s+push\s+--force\b', re.IGNORECASE),       # git push --force
     "git push --force blocked: force push can destroy remote history."),
    (re.compile(r'\btruncate\b', re.IGNORECASE),                     # TRUNCATE
     "TRUNCATE blocked: would clear a database table."),
    (re.compile(r'\bdelete\s+from\b(?!.*\bwhere\b)', re.IGNORECASE | re.DOTALL),
     # 'DELETE FROM' without 'WHERE' is a full table delete
     "DELETE FROM without WHERE blocked: would delete all rows in a table."),
]

LOG_FILE = Path.home() / ".claude" / "hooks" / "blocked.log"


def log_blocked(cmd: str, reason: str) -> None:
    """Append a blocked-attempt entry to the log file."""
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    ts = __import__("datetime").datetime.now().isoformat()
    cwd = os.getcwd()
    with LOG_FILE.open("a") as f:
        f.write(f"[{ts}] {reason}\n  command: {cmd}\n  project: {cwd}\n\n")


def check_command(cmd: str) -> tuple[bool, str]:
    """
    Return (is_blocked, reason).
    is_blocked = True means the command should not be allowed.
    """
    for pattern, reason in BLOCKED_PATTERNS:
        if pattern.search(cmd):
            return True, reason
    return False, ""


def main():
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw)
    except (json.JSONDecodeError, Exception) as e:
        # If we can't parse the payload, let it through (noise, not a risk)
        sys.exit(0)

    # Extract the command from various possible payload shapes
    cmd = ""

    # Tool-use payload from Claude Code (Bash:Execute tool)
    if isinstance(payload, dict):
        if "command" in payload and isinstance(payload["command"], str):
            cmd = payload["command"]
        elif "args" in payload and isinstance(payload["args"], dict):
            cmd = payload["args"].get("command", "")
            cmd = payload["args"].get("cmd", cmd)
            cmd = payload["args"].get("content", cmd)
        # Fallback: stringify the whole payload for pattern matching
        if not cmd:
            cmd = json.dumps(payload)

    if not cmd:
        sys.exit(0)

    blocked, reason = check_command(cmd)
    if blocked:
        log_blocked(cmd, reason)
        print(f"⛔ {reason}", flush=True)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()