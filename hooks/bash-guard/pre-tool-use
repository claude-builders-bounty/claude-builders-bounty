#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook — intercepts dangerous bash commands.
Install: copy to ~/.claude/hooks/pre-tool-use and chmod +x
"""
import sys, os, json, re
from datetime import datetime

LOG_FILE = os.path.expanduser("~/.claude/hooks/blocked.log")

DANGEROUS_PATTERNS = [
    # rm -rf variations
    (r'\brm\s+(-[a-zA-Z]*r[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*r)\b', 'rm -rf (recursive force delete)'),
    (r'\brm\s+.*-[a-zA-Z]*r.*-f\b', 'rm with recursive + force flags'),
    # SQL destructive
    (r'\bDROP\s+TABLE\b', 'DROP TABLE'),
    (r'\bDELETE\s+FROM\b(?!.*\bWHERE\b)', 'DELETE FROM without WHERE clause'),
    (r'\bTRUNCATE\b', 'TRUNCATE'),
    # Git force push
    (r'git\s+push\s+.*--force', 'git push --force'),
    (r'git\s+push\s+.*-f\b', 'git push -f'),
    # Additional safety
    (r'\bchmod\s+777\b', 'chmod 777 (world-writable)'),
    (r'>\s*/dev/sd[a-z]', 'direct write to block device'),
]

def get_project_path(input_data):
    try:
        return input_data.get('cwd', 'unknown')
    except:
        return 'unknown'

def log_block(command, reason, project):
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    with open(LOG_FILE, 'a') as f:
        f.write(f"[{datetime.now().isoformat()}] blocked: {reason}\n")
        f.write(f"  command: {command}\n")
        f.write(f"  project: {project}\n\n")

def main():
    try:
        input_data = json.load(sys.stdin)
    except:
        print(json.dumps({"decision": "allow"}))
        return

    tool_name = input_data.get('tool_name', '')
    if tool_name != 'bash' and tool_name != 'Bash':
        # Only intercept bash commands
        print(json.dumps({"decision": "allow"}))
        return

    tool_input = input_data.get('tool_input', {})
    command = tool_input.get('command', '')

    project = get_project_path(input_data)

    for pattern, reason in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            log_block(command, reason, project)
            msg = (
                f"🚫 BLOCKED: {reason}\n\n"
                f"The command was blocked for safety:\n"
                f"  {command}\n\n"
                f"Blocked attempt logged to: {LOG_FILE}\n"
                f"If this is intentional, use a safer alternative or explicitly confirm."
            )
            print(json.dumps({
                "decision": "block",
                "reason": msg
            }))
            return

    print(json.dumps({"decision": "allow"}))

if __name__ == '__main__':
    main()
