#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook to block destructive bash commands.
"""

import sys
import os
import re
from datetime import datetime

def log_blocked_command(command, project_path):
    """Log blocked command attempts to blocked.log"""
    log_file = os.path.expanduser("~/.claude/hooks/blocked.log")
    os.makedirs(os.path.dirname(log_file), exist_ok=True)
    
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(log_file, "a") as f:
        f.write(f"[{timestamp}] Blocked command: {command} | Project: {project_path}\n")

def main():
    # Read the command from stdin
    command = sys.stdin.read().strip()
    project_path = os.environ.get("PROJECT_PATH", "Unknown")
    
    # Destructive patterns to block
    destructive_patterns = [
        r'rm\s+-rf',
        r'rm\s+-fr',
    r'DROP\s+TABLE',
    r'git\s+push\s+--force',
    r'TRUNCATE\s+(?!TABLE\s+\w+\s*;)',
    r'DELETE\s+FROM\s+\w+\s*;',
    ]
    
    # Check if command matches any destructive pattern
    for pattern in destructive_patterns:
        if re.search(pattern, command, re.IGNORECASE):
            log_blocked_command(command, project_path)
            print(f"❌ Blocked potentially destructive command: {command}", file=sys.stderr)
            print("This command was blocked because it contains potentially destructive patterns.", file=sys.stderr)
            print("Blocked patterns: rm -rf, DROP TABLE, git push --force, TRUNCATE, DELETE FROM (without WHERE)", file=sys.stderr)
            sys.exit(1)
    
    # If we get here, command is allowed
    sys.exit(0)

if __name__ == "__main__":
    main()