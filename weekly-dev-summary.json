{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 17 * * 5" }
          ]
        }
      },
      "name": "Weekly Cron (Fri 5pm)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$env.GITHUB_REPO}}/commits?since={{$now.minus({days:7}).toISODate()}}",
        "options": { "headers": { "Authorization": "=token {{$env.GITHUB_TOKEN}}", "Accept": "application/vnd.github+json" } }
      },
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [240, 200]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$env.GITHUB_REPO}}/pulls?state=closed&since={{$now.minus({days:7}).toISODate()}}",
        "options": { "headers": { "Authorization": "=token {{$env.GITHUB_TOKEN}}", "Accept": "application/vnd.github+json" } }
      },
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [240, 400]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$env.GITHUB_REPO}}/issues?state=closed&since={{$now.minus({days:7}).toISODate()}}",
        "options": { "headers": { "Authorization": "=token {{$env.GITHUB_TOKEN}}", "Accept": "application/vnd.github+json" } }
      },
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [240, 600]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "messages": [
          {
            "role": "user",
            "content": "Write a {{$env.LANGUAGE}} narrative weekly dev summary from this data. Commits: {{$json.commits}}. PRs: {{$json.prs}}. Issues: {{$json.issues}}."
          }
        ]
      },
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [520, 400]
    },
    {
      "parameters": {
        "webhookUri": "={{$env.DELIVERY_WEBHOOK}}",
        "text": "={{$json.summary}}"
      },
      "name": "Deliver (Slack/Discord)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [780, 400]
    }
  ],
  "connections": {
    "Weekly Cron (Fri 5pm)": { "main": [[ { "node": "GitHub Commits", "type": "main", "index": 0 }, { "node": "GitHub Merged PRs", "type": "main", "index": 0 }, { "node": "GitHub Closed Issues", "type": "main", "index": 0 } ]] },
    "GitHub Commits": { "main": [[ { "node": "Claude Summary", "type": "main", "index": 0 } ]] },
    "GitHub Merged PRs": { "main": [[ { "node": "Claude Summary", "type": "main", "index": 0 } ]] },
    "GitHub Closed Issues": { "main": [[ { "node": "Claude Summary", "type": "main", "index": 0 } ]] },
    "Claude Summary": { "main": [[ { "node": "Deliver (Slack/Discord)", "type": "main", "index": 0 } ]] }
  },
  "settings": { "executionOrder": "v1" },
  "variables": {
    "GITHUB_REPO": { "value": "owner/repo" },
    "GITHUB_TOKEN": { "value": "" },
    "DELIVERY_WEBHOOK": { "value": "https://hooks.slack.com/services/xxx" },
    "LANGUAGE": { "value": "EN" }
  }
}
