{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Weekly Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "github-commits",
      "name": "Get Weekly Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 200],
      "parameters": {
        "operation": "listCommits",
        "repository": "={{ $json.owner }}/{{ $json.repo }}",
        "filters": {
          "since": "={{ $now.startOf('week').toISO() }}"
        }
      },
      "credentials": {
        "githubApi": "{{ $credentials.github }}"
      }
    },
    {
      "id": "github-closed-issues",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 400],
      "parameters": {
        "operation": "listIssues",
        "repository": "={{ $json.owner }}/{{ $json.repo }}",
        "filters": {
          "state": "closed",
          "since": "={{ $now.startOf('week').toISO() }}"
        }
      },
      "credentials": {
        "githubApi": "{{ $credentials.github }}"
      }
    },
    {
      "id": "github-merged-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 600],
      "parameters": {
        "operation": "listPullRequests",
        "repository": "={{ $json.owner }}/{{ $json.repo }}",
        "filters": {
          "state": "closed",
          "since": "={{ $now.startOf('week').toISO() }}"
        }
      },
      "credentials": {
        "githubApi": "{{ $credentials.github }}"
      }
    },
    {
      "id": "merge-data",
      "name": "Merge Activity Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Merge all GitHub data into a single payload\nconst { DateTime } = require('luxon');\n\nconst allItems = $input.all();\nconst commits = [];\nconst issues = [];\nconst prs = [];\n\nfor (const item of allItems) {\n  const data = item.json;\n  if (data.sha) {\n    commits.push({\n      message: data.commit?.message?.split('\\n')[0] || '',\n      author: data.commit?.author?.name || '',\n      date: data.commit?.author?.date || '',\n      url: data.html_url || ''\n    });\n  } else if (data.pull_request) {\n    prs.push({\n      title: data.title || '',\n      number: data.number || 0,\n      author: data.user?.login || '',\n      state: data.state || '',\n      merged: data.pull_request?.merged_at ? true : false,\n      url: data.html_url || ''\n    });\n  } else {\n    issues.push({\n      title: data.title || '',\n      number: data.number || 0,\n      author: data.user?.login || '',\n      url: data.html_url || ''\n    });\n  }\n}\n\nconst mergedPRs = prs.filter(p => p.merged);\n\nreturn [{\n  json: {\n    repo: $json.owner + '/' + $json.repo,\n    weekStart: DateTime.now().startOf('week').toISODate(),\n    weekEnd: DateTime.now().endOf('week').toISODate(),\n    totalCommits: commits.length,\n    totalIssuesClosed: issues.length,\n    totalPRsMerged: mergedPRs.length,\n    commits: commits.slice(0, 20),\n    issues: issues.slice(0, 10),\n    mergedPRs: mergedPRs.slice(0, 10),\n    language: $json.language || 'EN'\n  }\n}];"
      }
    },
    {
      "id": "claude-api",
      "name": "Claude API - Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 1500
            },
            {
              "name": "system",
              "value": "You are a technical writing assistant. Generate a concise, narrative weekly dev summary. Use markdown. Be factual and highlight key changes, fixes, and contributions."
            },
            {
              "name": "messages",
              "value": "=[\n  {\n    \"role\": \"user\",\n    \"content\": `Generate a weekly development summary in {{ $json.language }} for repository **{{ $json.repo }}**.\n\n## Week: {{ $json.weekStart }} to {{ $json.weekEnd }}\n\n### Commits ({{ $json.totalCommits }})\n{{ $json.commits.map(c => `- ${c.message} (${c.author})`).join('\\n') }}\n\n### Issues Closed ({{ $json.totalIssuesClosed }})\n{{ $json.issues.map(i => `- #${i.number} ${i.title}`).join('\\n') }}\n\n### Merged PRs ({{ $json.totalPRsMerged }})\n{{ $json.mergedPRs.map(p => `- #${p.number} ${p.title} by @${p.author}`).join('\\n') }}\n\nFormat the response as markdown with these sections:\n1. **Week in Review** — narrative overview\n2. **Key Changes** — notable commits/features\n3. **Bug Fixes** — important issues closed\n4. **Contributors** — shoutouts\n5. **Looking Ahead** — what's coming next`\n              },\n              {\n                \"role\": \"assistant\",\n                \"content\": \"\"\n              }\n            ]"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "{{ $credentials.claudeApi }}",
          "name": "Claude API Key"
        }
      }
    },
    {
      "id": "discord-webhook",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [1050, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordWebhook }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.content }}"
            }
          ]
        }
      }
    },
    {
      "id": "slack-webhook",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1050, 500],
      "parameters": {
        "operation": "postMessage",
        "channel": "={{ $json.slackChannel }}",
        "text": "={{ $json.content }}"
      },
      "credentials": {
        "slackApi": "{{ $credentials.slack }}"
      }
    },
    {
      "id": "router",
      "name": "Route: Choose Destination",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [950, 500],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.deliveryMethod }}",
              "operation": "equal",
              "value2": "discord"
            }
          ]
        }
      }
    },
    {
      "id": "config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 50],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "owner",
              "value": "claude-builders-bounty"
            },
            {
              "name": "repo",
              "value": "claude-builders-bounty"
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "deliveryMethod",
              "value": "discord"
            },
            {
              "name": "discordWebhook",
              "value": "https://discord.com/api/webhooks/your-webhook-url"
            },
            {
              "name": "slackChannel",
              "value": "#dev-updates"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Weekly Cron Trigger": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "Get Weekly Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Weekly Commits": {
      "main": [
        [
          {
            "node": "Merge Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Closed Issues": {
      "main": [
        [
          {
            "node": "Merge Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Merged PRs": {
      "main": [
        [
          {
            "node": "Merge Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Activity Data": {
      "main": [
        [
          {
            "node": "Claude API - Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API - Generate Summary": {
      "main": [
        [
          {
            "node": "Route: Choose Destination",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route: Choose Destination": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "versionId": "1.0.0",
  "active": true,
  "settings": {}
}
