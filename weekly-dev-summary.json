{
  "name": "Weekly Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "a1b2c3d4",
      "name": "Every Friday 5PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({weeks: 1}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_GITHUB_TOKEN",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $now.minus({weeks: 1}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_GITHUB_TOKEN",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "d4e5f6g7",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_GITHUB_TOKEN",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "e5f6g7h8",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 2000,\n  \"system\": \"You are a technical writer. Generate a weekly narrative summary of a GitHub repo's activity in {{ $env.SUMMARY_LANGUAGE || 'EN' }}. Be concise but informative. Structure with headers: Overview, Key Changes, Closed Issues, Merged PRs, Notable Contributors.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a weekly dev summary for {{ $env.GITHUB_REPO }}.\\n\\n## Commits ({{ $json.commits.length || 0 }} this week)\\n{{ ($json.commits || []).map(c => '- ' + c.commit.message.split('\\n')[0] + ' (' + c.commit.author.name + ')').join('\\n') }}\\n\\n## Closed Issues ({{ ($json.closedIssues || []).filter(i => !i.pull_request).length }})\\n{{ ($json.closedIssues || []).filter(i => !i.pull_request).map(i => '- #' + i.number + ': ' + i.title).join('\\n') }}\\n\\n## Merged PRs ({{ ($json.mergedPRs || []).filter(p => p.merged_at).length }})\\n{{ ($json.mergedPRs || []).filter(p => p.merged_at).map(p => '- #' + p.number + ': ' + p.title + ' (by ' + p.user.login + ')').join('\\n') }}\\n\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "f6g7h8i9",
      "name": "Claude API Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ANTHROPIC_KEY",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.content?.[0]?.text || 'No summary generated';\nreturn [{ json: { summary: content } }];"
      },
      "id": "g7h8i9j0",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $env.DELIVERY_METHOD }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "h8i9j0k1",
      "name": "Delivery Method",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $env.EMAIL_TO }}",
        "subject": "=📋 Weekly Dev Summary — {{ $env.GITHUB_REPO }}",
        "text": "={{ $json.summary }}",
        "options": {}
      },
      "id": "i9j0k1l2",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1440, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.WEBHOOK_URL }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": \"## 📋 Weekly Dev Summary — {{ $env.GITHUB_REPO }}\\n\\n\" + $json.summary}",
        "options": {}
      },
      "id": "j0k1l2m3",
      "name": "Send Webhook (Discord/Slack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 400]
    }
  ],
  "connections": {
    "Every Friday 5PM": {
      "main": [
        [
          { "node": "Get Commits", "type": "main", "index": 0 },
          { "node": "Get Closed Issues", "type": "main", "index": 0 },
          { "node": "Get Merged PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Commits": {
      "main": [[{ "node": "Merge Data", "type": "main", "index": 0 }]]
    },
    "Get Closed Issues": {
      "main": [[{ "node": "Merge Data", "type": "main", "index": 1 }]]
    },
    "Get Merged PRs": {
      "main": [[{ "node": "Merge Data", "type": "main", "index": 2 }]]
    },
    "Merge Data": {
      "main": [[{ "node": "Claude API Summary", "type": "main", "index": 0 }]]
    },
    "Claude API Summary": {
      "main": [[{ "node": "Extract Summary", "type": "main", "index": 0 }]]
    },
    "Extract Summary": {
      "main": [[{ "node": "Delivery Method", "type": "main", "index": 0 }]]
    },
    "Delivery Method": {
      "main": [
        [{ "node": "Send Email", "type": "main", "index": 0 }],
        [{ "node": "Send Webhook (Discord/Slack)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
