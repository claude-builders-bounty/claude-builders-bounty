{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 17 * * 5" }]
        }
      }
    },
    {
      "id": "github-commits",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.repoUrl || 'https://api.github.com/repos/owner/repo' }}/commits?since={{ $now.minus(7, 'days').toISO() }}&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "github-issues",
      "name": "GitHub Issues & PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 400],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.repoUrl || 'https://api.github.com/repos/owner/repo' }}/issues?state=closed&since={{ $now.minus(7, 'days').toISO() }}&per_page=50&sort=updated",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "merge-data",
      "name": "Merge Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300],
      "parameters": {
        "language": "python",
        "code": "import json\n\ncommits = items[0].json\nissues = items[1].json\n\n# Collect commit messages\ncommit_msgs = []\nfor c in (commits if isinstance(commits, list) else [commits]):\n    msg = c.get('commit', {}).get('message', '').split('\\n')[0]\n    author = c.get('commit', {}).get('author', {}).get('name', 'unknown')\n    commit_msgs.append(f\"- {msg} ({author})\")\n\n# Collect closed issues/PRs\nissue_lines = []\npr_lines = []\nfor i in (issues if isinstance(issues, list) else [issues]):\n    title = i.get('title', '')\n    number = i.get('number', '')\n    if i.get('pull_request'):\n        pr_lines.append(f\"- #{number} {title}\")\n    else:\n        issue_lines.append(f\"- #{number} {title}\")\n\nreturn [{\n    \"commits\": '\\n'.join(commit_msgs) if commit_msgs else 'No commits this week',\n    \"issues\": '\\n'.join(issue_lines) if issue_lines else 'No issues closed this week',\n    \"prs\": '\\n'.join(pr_lines) if pr_lines else 'No PRs merged this week',\n    \"repo\": $json.repoUrl or 'https://github.com/owner/repo'\n}]"
      }
    },
    {
      "id": "claude-summary",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": 1024 },
            {
              "name": "messages",
              "value": "=[{{\"role\":\"user\",\"content\":\"Generate a weekly dev summary for {{ $json.repo }}.\\n\\n## Commits\\n{{ $json.commits }}\\n\\n## Closed Issues\\n{{ $json.issues }}\\n\\n## Merged PRs\\n{{ $json.prs }}\\n\\nWrite a concise narrative summary (3-5 paragraphs) highlighting key developments, patterns, and any notable changes.\"}}]"
            }
          ]
        },
        "options": {
          "headers": {
            "anthropic-version": "2023-06-01",
            "content-type": "application/json"
          }
        }
      }
    },
    {
      "id": "slack-output",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1050, 300],
      "parameters": {
        "channel": "={{ $json.channel || '#dev-updates' }}",
        "text": "={{ $json.content?.blocks ? $json.content.blocks[0].text.text : 'Weekly summary generated.' }}",
        "otherOptions": {
          "attachments": "={{ [{\"color\": \"#36a64f\", \"title\": \"Weekly Dev Summary\", \"text\": ($json.content?.blocks ? $json.content.blocks[0].text.text : ''), \"footer\": \"Generated by n8n\", \"ts\": Math.floor(Date.now() / 1000)}] }}"
        }
      }
    }
  ],
  "connections": {
    "Weekly Schedule": { "main": [[ { "node": "GitHub Commits", "type": "main", "index": 0 } ]] },
    "GitHub Commits": { "main": [[ { "node": "Merge Activity", "type": "main", "index": 0 } ]] },
    "GitHub Issues & PRs": { "main": [[ { "node": "Merge Activity", "type": "main", "index": 1 } ]] },
    "Merge Activity": { "main": [[ { "node": "Claude Summary", "type": "main", "index": 0 } ]] },
    "Claude Summary": { "main": [[ { "node": "Send to Slack", "type": "main", "index": 0 } ]] }
  },
  "pinData": {},
  "versionId": "1",
  "active": true,
  "settings": {}
}
