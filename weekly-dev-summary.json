{
  "name": "Weekly GitHub Dev Summary — Claude AI",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{
            "field": "cronExpression",
            "expression": "0 17 * * 5"
          }]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.repo_url}}/commits?since={{$json.since}}&until={{$json.until}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        },
        "options": {}
      },
      "id": "github-commits",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.repo_url}}/issues?state=closed&since={{$json.since}}&until={{$json.until}}&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        }
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.repo_url}}/pulls?state=closed&sort=updated&direction=desc&per_page=30",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        }
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 600]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate GitHub data into a summary context\nconst commits = $input.all()[0]?.json || [];\nconst issues = $input.all()[1]?.json || [];\nconst prs = $input.all()[2]?.json || [];\n\nconst weekStart = new Date();\nweekStart.setDate(weekStart.getDate() - 7);\n\nconst summary = {\n  period: `${weekStart.toISOString().split('T')[0]} to ${new Date().toISOString().split('T')[0]}`,\n  commits: commits.slice(0, 20).map(c => ({\n    message: c.commit?.message?.split('\\n')[0] || '',\n    author: c.commit?.author?.name || 'unknown',\n    date: c.commit?.author?.date?.split('T')[0] || ''\n  })),\n  closedIssues: issues.slice(0, 15).map(i => ({\n    title: i.title,\n    number: i.number,\n    labels: (i.labels || []).map(l => l.name)\n  })),\n  mergedPRs: prs.slice(0, 10).filter(p => p.merged_at).map(p => ({\n    title: p.title,\n    number: p.number,\n    author: p.user?.login || 'unknown'\n  }))\n};\n\nreturn { json: summary };"
      },
      "id": "data-aggregator",
      "name": "Aggregate GitHub Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{$env.ANTHROPIC_API_KEY}}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 2000
            },
            {
              "name": "system",
              "value": "You are a technical writer. Generate a concise, engaging weekly development summary from the provided GitHub activity data. Focus on: key changes, notable merged PRs, closed issues, and overall progress. Use bullet points for clarity. Keep it under 500 words."
            },
            {
              "name": "messages[0].role",
              "value": "user"
            },
            {
              "name": "messages[0].content",
              "value": "={{JSON.stringify($json)}}"
            }
          ]
        }
      },
      "id": "claude-api",
      "name": "Generate Summary (Claude API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [950, 400]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.all()[0]?.json;\nconst content = response?.content?.[0]?.text || 'No summary generated.';\nconst timestamp = new Date().toISOString().split('T')[0];\n\nreturn {\n  json: {\n    generatedAt: timestamp,\n    summary: content\n  }\n};"
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Cron (Friday 5pm)": {
      "main": [[
        { "node": "Fetch Weekly Commits", "type": "main", "index": 0 },
        { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
        { "node": "Fetch Merged PRs", "type": "main", "index": 0 }
      ]]
    },
    "Fetch Weekly Commits": {
      "main": [[{ "node": "Aggregate GitHub Data", "type": "main", "index": 0 }]]
    },
    "Fetch Closed Issues": {
      "main": [[{ "node": "Aggregate GitHub Data", "type": "main", "index": 1 }]]
    },
    "Fetch Merged PRs": {
      "main": [[{ "node": "Aggregate GitHub Data", "type": "main", "index": 2 }]]
    },
    "Aggregate GitHub Data": {
      "main": [[{ "node": "Generate Summary (Claude API)", "type": "main", "index": 0 }]]
    },
    "Generate Summary (Claude API)": {
      "main": [[{ "node": "Format Output", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "callerPolicy": "workflowsFromSameOwner",
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "1.0.0",
  "active": false,
  "id": "weekly-github-summary-claude"
}
