{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {},
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{$node[\"Schedule\"].json[\"cronExpression\"] === \"0 17 * * 5\" ? \"https://api.github.com/search/issues?q=repo:OWNER/REPO+updated:>=\" + $node[\"Schedule\"].json[\"lastRun\"] : \"\"}}",
        "options": {},
        "headers": {
          "Accept": "application/vnd.github.v3+json",
          "Authorization": "=Bearer {{$env.GITHUB_TOKEN}}"
        }
      },
      "name": "GitHub API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a technical writer. Generate a weekly dev summary from the provided GitHub activity data. Include: key changes, notable fixes, and a highlight of the week."
            },
            {
              "role": "user",
              "content": "={{$json[\"body\"]}}"
            }
          ]
        }
      },
      "name": "Claude API",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "dev-summary@example.com",
        "toEmail": "team@example.com",
        "subject": "={{$node[\"Schedule\"].json[\"lastRun\"] ? \"Weekly Dev Summary - \" + $node[\"Schedule\"].json[\"lastRun\"] : \"Weekly Dev Summary\"}}",
        "text": "={{$json[\"choices\"][0][\"message\"][\"content\"]}}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "GitHub API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub API": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}