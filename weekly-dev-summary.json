{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "value": 168 }] } },
      "id": "schedule", "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [240, 300]
    },
    {
      "parameters": {
        "owner": "={{ $json.owner }}",
        "repo": "={{ $json.repo }}",
        "timePeriod": "7"
      },
      "id": "github", "name": "GitHub Events",
      "type": "n8n-nodes-base.github", "typeVersion": 1, "position": [460, 300]
    },
    {
      "parameters": {
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "You are a dev summary generator. Summarize GitHub activity into a concise weekly report with: Key commits, PRs merged, Issues opened, Contributors."
            },
            {
              "role": "user",
              "content": "=Summarize this week'\''s GitHub activity:\n{{ $json.description }}\n{{ $json.title }}"
            }
          ]
        }
      },
      "id": "claude", "name": "Claude Summary",
      "type": "n8n-nodes-base.agent", "typeVersion": 1, "position": [680, 300]
    },
    {
      "parameters": {
        "channel": "#dev-summary",
        "text": "=Weekly Dev Report:\n{{ $json.output }}"
      },
      "id": "slack", "name": "Post to Slack",
      "type": "n8n-nodes-base.slack", "typeVersion": 1, "position": [900, 300]
    }
  ],
  "connections": {
    "Weekly Trigger": { "main": [[{ "node": "GitHub Events", "type": "main", "index": 0 }]] },
    "GitHub Events": { "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]] },
    "Claude Summary": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]] }
  }
}
