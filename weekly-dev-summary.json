{
  "name": "Weekly Dev Summary (Claude + GitHub)",
  "nodes": [
    {
      "id": "trigger-schedule",
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "github-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        450,
        200
      ],
      "parameters": {
        "resource": "repository",
        "operation": "listCommits",
        "repository": "={{ $json.owner }}/{{ $json.repo }}",
        "since": "={{ $now.startOf('week').toISO() }}",
        "options": {}
      }
    },
    {
      "id": "github-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        450,
        400
      ],
      "parameters": {
        "resource": "pullRequest",
        "operation": "list",
        "repository": "={{ $json.owner }}/{{ $json.repo }}",
        "filters": {
          "state": "closed"
        },
        "options": {
          "sort": "updated",
          "direction": "desc"
        }
      }
    },
    {
      "id": "github-issues",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        450,
        600
      ],
      "parameters": {
        "resource": "issue",
        "operation": "list",
        "repository": "={{ $json.owner }}/{{ $json.repo }}",
        "filters": {
          "state": "closed"
        },
        "options": {
          "sort": "updated",
          "direction": "desc"
        }
      }
    },
    {
      "id": "merge-data",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        650,
        400
      ],
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      }
    },
    {
      "id": "build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        850,
        400
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "prompt",
              "value": "You are a technical writer. Generate a weekly dev summary.\n\nCOMMITS:\n{{ $json.commits.data | map('c') => c.commit.message | join('\n') }}\n\nMERGED PRs:\n{{ $json.prs.data | filter(p) => p.merged_at | map('p') => '#' + p.number + ': ' + p.title | join('\n') }}\n\nCLOSED ISSUES:\n{{ $json.issues.data | map('i') => '#' + i.number + ': ' + i.title | join('\n') }}\n\nWrite a narrative summary of key changes and notable fixes."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "claude-call",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1050,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredential",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 4096
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"user\", \"content\": \"={{ $json.prompt }}\"}]"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "output-format",
      "name": "Format Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1250,
        400
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "report",
              "value": "=# Weekly Dev Summary\n\n{{ $json.content[0].text }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Merged PRs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Merged PRs": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Get Closed Issues": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          {
            "node": "Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Prompt": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Format Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "tags": []
}