{
  "name": "Weekly Dev Summary (Claude + GitHub)",
  "nodes": [
    {
      "parameters": {},
      "id": "schedule-trigger",
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.repository_url }}/pulls?state=closed&sort=updated&direction=desc&per_page=20",
        "options": {}
      },
      "id": "github-pulls",
      "name": "GitHub - Get Closed PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.repository_url }}/issues?state=closed&sort=updated&direction=desc&per_page=20"
      },
      "id": "github-issues",
      "name": "GitHub - Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        450
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.repository_url }}/commits?per_page=30"
      },
      "id": "github-commits",
      "name": "GitHub - Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        600
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "nodeCredentialType": "claudeApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 4096
            },
            {
              "name": "messages[0][role]",
              "value": "user"
            },
            {
              "name": "messages[0][content]",
              "value": "=Generate a weekly dev summary from this data:\n\nPRs: {{ $json[\"prs\"] }}\nIssues: {{ $json[\"issues\"] }}\nCommits: {{ $json[\"commits\"] }}\n\nFormat: ## Weekly Summary (date range)\n### Merged PRs\n### Closed Issues\n### Key Commits\n### Notes"
            }
          ]
        }
      },
      "id": "claude-api",
      "name": "Claude API - Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [
          {
            "node": "GitHub - Get Closed PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub - Get Closed PRs": {
      "main": [
        [
          {
            "node": "Claude API - Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}