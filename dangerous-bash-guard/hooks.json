{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dangerous_bash_guard.py"
          },
          {
            "type": "command",
            "if": "Bash(DROP *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dangerous_bash_guard.py"
          },
          {
            "type": "command",
            "if": "Bash(git push --force *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dangerous_bash_guard.py"
          },
          {
            "type": "command",
            "if": "Bash(TRUNCATE *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dangerous_bash_guard.py"
          },
          {
            "type": "command",
            "if": "Bash(DELETE FROM *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dangerous_bash_guard.py"
          }
        ]
      }
    ]
  }
}
