#!/usr/bin/env python3
"""
Claude Code PR Review Agent
Analyzes GitHub pull requests and provides structured code review feedback
"""
import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# Check if anthropic package is available
try:
    import anthropic
    HAS_ANTHROPIC = True
except ImportError:
    HAS_ANTHROPIC = False


def get_pr_details(pr_url):
    """Extract PR details using GitHub CLI"""
    # Parse PR URL
    match = re.match(r'https://github\.com/([^/]+)/([^/]+)/pull/(\d+)', pr_url)
    if not match:
        print(f"❌ Invalid PR URL: {pr_url}")
        sys.exit(1)

    owner, repo, pr_number = match.groups()
    repo_full = f"{owner}/{repo}"

    print(f"📥 Fetching PR #{pr_number} from {repo_full}...")

    # Get PR details via gh CLI
    try:
        result = subprocess.run(
            ['gh', 'pr', 'view', pr_number, '--repo', repo_full, '--json',
             'title,body,additions,deletions,changedFiles,files,headRefName,baseRefName'],
            capture_output=True,
            text=True,
            check=True
        )
        pr_data = json.loads(result.stdout)
    except subprocess.CalledProcessError as e:
        print(f"❌ Failed to fetch PR: {e.stderr}")
        sys.exit(1)

    # Get diff
    try:
        diff_result = subprocess.run(
            ['gh', 'pr', 'diff', pr_number, '--repo', repo_full],
            capture_output=True,
            text=True,
            check=True
        )
        pr_data['diff'] = diff_result.stdout
    except subprocess.CalledProcessError as e:
        print(f"❌ Failed to fetch diff: {e.stderr}")
        sys.exit(1)

    return pr_data, repo_full, pr_number


def analyze_pr_with_claude(pr_data):
    """Analyze PR using Claude API (supports both Anthropic API and AWS Bedrock)"""
    if not HAS_ANTHROPIC:
        print("⚠️  anthropic package not installed. Using fallback analysis...")
        return analyze_pr_fallback(pr_data)

    # Try AWS Bedrock first (uses AWS credentials from environment)
    aws_region = os.environ.get('AWS_REGION', 'us-east-1')

    try:
        client = anthropic.AnthropicBedrock(
            aws_region=aws_region
        )
        print("🔗 Using AWS Bedrock...")
    except Exception:
        # Fall back to standard Anthropic API
        api_key = os.environ.get('ANTHROPIC_API_KEY')
        if not api_key:
            print("⚠️  No AWS credentials or ANTHROPIC_API_KEY found. Using fallback analysis...")
            return analyze_pr_fallback(pr_data)
        client = anthropic.Anthropic(api_key=api_key)
        print("🔗 Using Anthropic API...")

    # Build analysis prompt
    prompt = f"""Analyze this GitHub pull request and provide a structured code review.

**PR Title:** {pr_data['title']}

**PR Description:**
{pr_data.get('body', 'No description provided')}

**Statistics:**
- Files changed: {pr_data['changedFiles']}
- Lines added: {pr_data['additions']}
- Lines deleted: {pr_data['deletions']}

**Diff:**
```
{pr_data['diff'][:8000]}
```

Provide your review in the following structured format:

## Summary
[2-3 sentences describing what this PR does]

## Identified Risks
- [List specific risks, security concerns, or potential bugs]
- [Each risk should be concrete and actionable]

## Improvement Suggestions
- [List specific improvements to code quality, readability, or architecture]
- [Each suggestion should be actionable]

## Confidence Score
[Low / Medium / High] - briefly explain why

Focus on:
1. Code quality and maintainability
2. Potential bugs or edge cases
3. Security vulnerabilities
4. Performance implications
5. Architecture and design patterns
"""

    try:
        print("🤖 Analyzing with Claude...")
        # Use Bedrock inference profile ID if on Bedrock, otherwise standard model ID
        model_id = "us.anthropic.claude-3-sonnet-20240229-v1:0" if isinstance(client, anthropic.AnthropicBedrock) else "claude-sonnet-4-20250514"

        message = client.messages.create(
            model=model_id,
            max_tokens=2000,
            messages=[{"role": "user", "content": prompt}]
        )

        review_text = message.content[0].text
        return review_text

    except Exception as e:
        print(f"⚠️  Claude API error: {e}")
        print("Using fallback analysis...")
        return analyze_pr_fallback(pr_data)


def analyze_pr_fallback(pr_data):
    """Fallback analysis when Claude API is not available"""
    # Simple heuristic-based analysis
    files_changed = pr_data['changedFiles']
    additions = pr_data['additions']
    deletions = pr_data['deletions']
    diff = pr_data['diff']

    # Detect patterns
    has_tests = any('test' in f['path'].lower() for f in pr_data.get('files', []))
    has_security_keywords = any(keyword in diff.lower()
                                 for keyword in ['password', 'token', 'secret', 'api_key', 'auth'])
    large_changes = additions + deletions > 500
    many_files = files_changed > 10

    # Build review
    review = f"""## Summary

This PR modifies {files_changed} file(s) with {additions} additions and {deletions} deletions."""

    if large_changes:
        review += " This is a substantial change that warrants careful review."

    review += f"\n\n## Identified Risks\n\n"

    if not has_tests:
        review += "- ⚠️  No test files modified - consider adding tests for new functionality\n"

    if has_security_keywords:
        review += "- 🔒 Contains security-sensitive keywords (passwords, tokens, secrets) - verify proper handling\n"

    if large_changes:
        review += "- 📊 Large diff size may indicate the PR is doing too many things - consider splitting\n"

    if many_files:
        review += "- 📁 Many files changed - increases complexity and review burden\n"

    review += "\n## Improvement Suggestions\n\n"
    review += "- Review edge cases and error handling\n"
    review += "- Ensure code follows project conventions and style guide\n"
    review += "- Add inline comments for complex logic\n"

    if not has_tests:
        review += "- Add unit tests to cover new functionality\n"

    review += "\n## Confidence Score\n\n"
    review += "**Medium** - This is an automated heuristic review. "
    review += "For comprehensive analysis, set ANTHROPIC_API_KEY and use Claude API.\n"

    return review


def format_review_output(pr_data, review_text, repo_full, pr_number):
    """Format the final review output"""
    output = f"""# Code Review: {pr_data['title']}

**Repository:** {repo_full}
**PR:** #{pr_number}
**Branch:** `{pr_data['headRefName']}` → `{pr_data['baseRefName']}`
**Generated:** {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

---

{review_text}

---

*Generated by claude-review agent*
"""
    return output


def main():
    parser = argparse.ArgumentParser(
        description='Analyze GitHub pull requests with Claude AI'
    )
    parser.add_argument(
        '--pr',
        required=True,
        help='GitHub PR URL (e.g., https://github.com/owner/repo/pull/123)'
    )
    parser.add_argument(
        '--output',
        help='Output file (default: stdout)'
    )

    args = parser.parse_args()

    # Fetch PR details
    pr_data, repo_full, pr_number = get_pr_details(args.pr)

    # Analyze with Claude
    review_text = analyze_pr_with_claude(pr_data)

    # Format output
    output = format_review_output(pr_data, review_text, repo_full, pr_number)

    # Write output
    if args.output:
        Path(args.output).write_text(output)
        print(f"✅ Review saved to: {args.output}")
    else:
        print("\n" + "=" * 80)
        print(output)
        print("=" * 80)


if __name__ == '__main__':
    main()
