{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "interval": 1,
              "weekday": "friday",
              "hour": 17
            }
          ]
        }
      },
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "resource": "commit",
        "operation": "list",
        "owner": "={{$node[\"Config\"].json[\"owner\"]}}",
        "repository": "={{$node[\"Config\"].json[\"repo\"]}}",
        "filters": {
          "since": "={{$today.minus({days: 7}).toISO()}}"
        }
      },
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [650, 150],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "headerAuth",
        "sendBody": true,
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20240620"
            },
            {
              "name": "max_tokens",
              "value": "1024"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"Generate a narrative weekly summary of this repo activity: \" + $node[\"Merge Data\"].json[\"summary\"]}]"
            }
          ]
        },
        "headerParametersUi": {
          "parameter": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1100, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$node[\"Config\"].json[\"discord_webhook\"]}}",
        "content": "={{$node[\"Call Claude API\"].json[\"content\"][0][\"text\"]}}"
      },
      "name": "Discord Post",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Claude API": {
      "main": [
        [
          {
            "node": "Discord Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
