{
  "name": "Weekly GitHub Dev Summary via Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "eecfaec0-c447-495d-ab90-fc5c94291c95",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        360
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "REPO_OWNER",
              "value": "claude-builders-bounty"
            },
            {
              "name": "REPO_NAME",
              "value": "claude-builders-bounty"
            },
            {
              "name": "LANGUAGE",
              "value": "EN"
            },
            {
              "name": "DISCORD_WEBHOOK_URL",
              "value": "YOUR_DISCORD_WEBHOOK_URL"
            }
          ]
        },
        "options": {}
      },
      "id": "31278ff9-8c6f-4277-bcbf-00d9cfd93967",
      "name": "Set Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const oneWeekAgo = new Date();\noneWeekAgo.setDate(oneWeekAgo.getDate() - 7);\n\nreturn {\n  since: oneWeekAgo.toISOString()\n};"
      },
      "id": "55c464c9-b7b5-4b09-ba44-12ec8a7e0f2d",
      "name": "Calculate Dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        360
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "commit",
        "operation": "getAll",
        "owner": "={{ $('Set Config Variables').item.json.REPO_OWNER }}",
        "repository": "={{ $('Set Config Variables').item.json.REPO_NAME }}",
        "since": "={{ $json.since }}",
        "returnAll": true
      },
      "id": "e00508f7-9c98-4672-8d76-c51ef67e2a44",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        920,
        180
      ],
      "credentials": {
        "githubOAuth2Api": {
          "id": "YOUR_GITHUB_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{ $('Set Config Variables').item.json.REPO_OWNER }}",
        "repository": "={{ $('Set Config Variables').item.json.REPO_NAME }}",
        "state": "closed",
        "since": "={{ $json.since }}",
        "returnAll": true
      },
      "id": "dd1f4df4-82ab-4de0-8e11-e6dc98ceba5e",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        920,
        360
      ],
      "credentials": {
        "githubOAuth2Api": {
          "id": "YOUR_GITHUB_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "pullRequest",
        "operation": "getAll",
        "owner": "={{ $('Set Config Variables').item.json.REPO_OWNER }}",
        "repository": "={{ $('Set Config Variables').item.json.REPO_NAME }}",
        "state": "closed",
        "returnAll": true
      },
      "id": "311d94ea-58b9-4d64-8ab3-77d0139b8ffb",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        920,
        540
      ],
      "credentials": {
        "githubOAuth2Api": {
          "id": "YOUR_GITHUB_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "multiplex",
        "options": {}
      },
      "id": "fa2f8ef2-8cc3-43ed-a477-8495a4980a31",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1160,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Get Commits').all().map(item => item.json);\nconst issues = $('Get Closed Issues').all().map(item => item.json);\nconst prs = $('Get Merged PRs').all().map(item => item.json).filter(pr => pr.merged_at !== null && new Date(pr.merged_at) > new Date($('Calculate Dates').item.json.since));\n\nconst commitsSummary = commits.map(c => `- ${c.commit.message} (${c.commit.author.name})`).join('\\n');\nconst issuesSummary = issues.map(i => `- #${i.number}: ${i.title}`).join('\\n');\nconst prsSummary = prs.map(pr => `- #${pr.number}: ${pr.title}`).join('\\n');\n\nreturn {\n  prompt: `Generate a narrative weekly development summary based on the following activity from the last 7 days.\n  Language to use: ${$('Set Config Variables').item.json.LANGUAGE}\n  \n  Commits:\n  ${commitsSummary}\n  \n  Closed Issues:\n  ${issuesSummary}\n  \n  Merged PRs:\n  ${prsSummary}\n  \n  Make it sound engaging, professional but enthusiastic. Use markdown formatting. Organize by key themes or major achievements rather than just listing everything.`\n};"
      },
      "id": "98144702-863a-4a6c-9a4f-cc8f0a28f2de",
      "name": "Format Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        360
      ]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "messages": {
          "messageValues": [
            {
              "message": "={{ $json.prompt }}"
            }
          ]
        },
        "systemMessage": "You are a senior technical lead summarizing the week's development activity for the rest of the company."
      },
      "id": "3dcda4ed-6302-4632-9df7-ed3c2c510fc7",
      "name": "Anthropic Claude",
      "type": "@n8n/n8n-nodes-langchain.toolAnthropic",
      "typeVersion": 1,
      "position": [
        1600,
        360
      ],
      "credentials": {
        "anthropicApi": {
          "id": "YOUR_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Config Variables').item.json.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.message.content[0].text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "62e153f5-7d52-474c-ba76-daeb03cf8419",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        360
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Set Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Config Variables": {
      "main": [
        [
          {
            "node": "Calculate Dates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Dates": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Closed Issues": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Get Merged PRs": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          {
            "node": "Format Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Prompt": {
      "main": [
        [
          {
            "node": "Anthropic Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic Claude": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
