#!/usr/bin/env bash
set -euo pipefail

INPUT="${1:-}"
PROJECT_PATH="${CLAUDE_PROJECT_PATH:-$(pwd)}"
HOOK_DIR="$HOME/.claude/hooks"
LOG_FILE="$HOOK_DIR/blocked.log"
NOW="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

mkdir -p "$HOOK_DIR"

block() {
  local reason="$1"
  printf '%s | BLOCKED | %s | %s | %s\n' "$NOW" "$reason" "$PROJECT_PATH" "$INPUT" >> "$LOG_FILE"
  echo "Blocked by safety hook: $reason"
  exit 1
}

for pat in "rm -rf" "DROP TABLE" "git push --force" "TRUNCATE"; do
  if [[ "$INPUT" == *"$pat"* ]]; then
    block "disallowed pattern '$pat'"
  fi
done

if echo "$INPUT" | grep -Eq "(?i)DELETE[[:space:]]+FROM[[:space:]]+.+[[:space:]]+WHERE"; then
  :
else
  if echo "$INPUT" | grep -qi "DELETE FROM"; then
    block "DELETE FROM without WHERE"
  fi
fi

exit 0
