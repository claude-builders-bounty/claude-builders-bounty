      "id": "f3f9a46d-b61d-4077-847b-368bd50f4009"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate the three GitHub API branches into one prompt for Claude\nconst commits = ($items(\"Get Commits\")[0]?.json) || [];\nconst issuesRaw = ($items(\"Get Closed Issues\")[0]?.json) || [];\nconst prSearch = ($items(\"Get Merged PRs\")[0]?.json) || {};\nconst prs = prSearch.items || [];\n\nconst issues = issuesRaw.filter(i => !i.pull_request); // issues endpoint also returns PRs\n\nconst lang = ($env.LANG || 'EN').toUpperCase();\nconst L = lang === 'FR'\n  ? 'Rédige le résumé en français.'\n  : 'Write the summary in English.';\n\nconst commitLines = commits.slice(0, 30).map(c => `- ${String(c.commit?.message || '').split('\\n')[0]} (${(c.author?.login) || c.commit?.author?.name || '?'})`).join('\\n');\nconst issueLines = issues.slice(0, 30).map(i => `- #${i.number} ${i.title} (${(i.user?.login) || '?'})`).join('\\n');\nconst prLines = prs.slice(0, 30).map(p => `- #${p.number} ${p.title} (${(p.user?.login) || '?'})`).join('\\n');\n\nconst prompt = `You are an engineering lead writing a concise weekly narrative summary for a GitHub repository.\n${L}\n\nRepository: ${$env.GH_OWNER}/${$env.GH_REPO}\nWindow: the last 7 days.\n\nProduce:\n1. A 2-4 sentence narrative overview of what progressed this week.\n2. Bullet highlights grouped as: Merged PRs, Closed Issues, Notable Commits.\n3. A short \"looking ahead\" sentence if warranted.\n\n=== MERGED PRS (${prs.length}) ===\n${prLines || '(none)'}\n\n=== CLOSED ISSUES (${issues.length}) ===\n${issueLines || '(none)'}\n\n=== COMMITS (${commits.length}) ===\n${commitLines || '(none)'}\n`;\nreturn [{ json: { prompt, counts: { commits: commits.length, issues: issues.length, prs: prs.length } } }];\n"
      },
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        320
      ],
      "id": "6e30053a-1bd4-4296-8054-ad8406ecd0bd"
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { \"model\": \"claude-sonnet-4-20250514\", \"max_tokens\": 1500, \"system\": \"You write crisp, professional weekly engineering summaries. Be factual and avoid fluff.\", \"messages\": [ { \"role\": \"user\", \"content\": $json.prompt } ] } }}",
        "options": {}
