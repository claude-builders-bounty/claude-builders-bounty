#!/usr/bin/env python3
"""claude-review — structured Markdown reviews for GitHub pull requests.

Pipeline (no paid API dependency anywhere):

  1. FETCH      Pull the PR metadata + unified diff from the public GitHub
                API. Unauthenticated for public repos; GITHUB_TOKEN or the
                `gh` CLI token is used when available.
  2. PREPROCESS Deterministic, stdlib-only diff analysis (files changed,
                +/- line counts, per-extension breakdown, binary / rename
                detection). These facts are computed by this script — never
                by the model — and head every review.
  3. REVIEW     The analysis is delegated to the reviewer's own Claude Code
                via the agent definition in `.claude/agents/pr-reviewer.md`
                (`claude -p`). If `claude` is not on PATH, the script writes
                a ready-to-use context pack and prints how to run the review
                interactively (exit code 3).

Usage:
    claude-review --pr https://github.com/owner/repo/pull/123
    claude-review --pr owner/repo#123 --out review.md
    claude-review --pr <url> --dry-run          # fetch + stats + context pack
    claude-review --diff-file pr.diff --pr <url>  # offline diff input

Exit codes: 0 = review written, 2 = usage/fetch error, 3 = context pack
written but `claude` CLI not found (review not executed).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from collections import Counter
from pathlib import Path

API = "https://api.github.com"
USER_AGENT = "claude-review/1.0"

REQUIRED_SECTIONS = ("## Summary", "## Identified risks", "## Improvement suggestions", "## Confidence")

TEST_PATH_HINTS = ("test", "spec", "__tests__", "fixtures")


# --------------------------------------------------------------------------
# Fetching
# --------------------------------------------------------------------------

def github_token() -> str | None:
    """Token from env, else from `gh auth token`; None for anonymous access."""
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token:
        return token
    gh = shutil.which("gh")
    if gh:
        try:
            out = subprocess.run(
                [gh, "auth", "token"], capture_output=True, text=True, timeout=10
            )
            if out.returncode == 0 and out.stdout.strip():
                return out.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    return None


def api_get(url: str, accept: str, token: str | None) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": accept})
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        hint = ""
        if exc.code == 403 and not token:
            hint = " (anonymous rate limit? set GITHUB_TOKEN or log in with `gh auth login`)"
        raise SystemExit(f"error: GET {url} -> HTTP {exc.code} {exc.reason}{hint}")
    except urllib.error.URLError as exc:
        raise SystemExit(f"error: GET {url} failed: {exc.reason}")


def fetch_pr(owner: str, repo: str, number: int, token: str | None) -> tuple[dict, str]:
    base = f"{API}/repos/{owner}/{repo}/pulls/{number}"
    meta = json.loads(api_get(base, "application/vnd.github+json", token))
    diff = api_get(base, "application/vnd.github.v3.diff", token).decode("utf-8", "replace")
    return meta, diff


# --------------------------------------------------------------------------
# Deterministic diff pre-processing
# --------------------------------------------------------------------------

def ext_of(path: str) -> str:
    name = path.rsplit("/", 1)[-1]
    if "." in name and not name.startswith("."):
        return "." + name.rsplit(".", 1)[-1].lower()
    return "(none)"


def preprocess(diff: str) -> dict:
    """Parse a unified diff into exact, model-independent statistics."""
    files: dict[str, dict] = {}
    current: str | None = None
    binary: list[str] = []
    renames: list[tuple[str, str]] = []

    for line in diff.splitlines():
        if line.startswith("diff --git "):
            m = re.match(r"diff --git a/(.*?) b/(.*)$", line)
            current = m.group(2) if m else line
            files.setdefault(current, {"path": current, "additions": 0, "deletions": 0})
        elif current is None:
            continue
        elif line.startswith("Binary files") or line.startswith("GIT binary patch"):
            if current not in binary:
                binary.append(current)
        elif line.startswith("rename from "):
            renames.append((line[len("rename from "):], current))
        elif line.startswith("+") and not line.startswith("+++"):
            files[current]["additions"] += 1
        elif line.startswith("-") and not line.startswith("---"):
            files[current]["deletions"] += 1

    file_list = sorted(files.values(), key=lambda f: (-(f["additions"] + f["deletions"]), f["path"]))
    exts: Counter = Counter()
    for f in file_list:
        exts[ext_of(f["path"])] += f["additions"] + f["deletions"]
    test_files = [
        f["path"] for f in file_list
        if any(hint in f["path"].lower() for hint in TEST_PATH_HINTS)
    ]
    return {
        "files": file_list,
        "files_changed": len(file_list),
        "additions": sum(f["additions"] for f in file_list),
        "deletions": sum(f["deletions"] for f in file_list),
        "extensions": dict(exts.most_common()),
        "binary_files": binary,
        "renames": renames,
        "test_files": test_files,
    }


def stats_markdown(stats: dict) -> str:
    """The factual header block. Byte-for-byte deterministic."""
    lines = [
        "### Diff overview (computed by `claude-review`, not by the model)",
        "",
        f"- Files changed: **{stats['files_changed']}** "
        f"(**+{stats['additions']}** / **-{stats['deletions']}**)",
    ]
    by_ext = ", ".join(
        f"`{ext}` {n} line{'s' if n != 1 else ''}" for ext, n in stats["extensions"].items()
    )
    lines.append(f"- Changed lines by extension: {by_ext or 'n/a'}")
    if stats["test_files"]:
        lines.append(f"- Test files touched: {', '.join(f'`{p}`' for p in stats['test_files'])}")
    else:
        lines.append("- Test files touched: **none**")
    if stats["binary_files"]:
        lines.append(f"- Binary files: {', '.join(f'`{p}`' for p in stats['binary_files'])}")
    for old, new in stats["renames"]:
        lines.append(f"- Renamed: `{old}` -> `{new}`")
    lines.append("")
    lines.append("| File | + | - |")
    lines.append("|---|---:|---:|")
    for f in stats["files"]:
        lines.append(f"| `{f['path']}` | {f['additions']} | {f['deletions']} |")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# Context pack + review assembly
# --------------------------------------------------------------------------

def build_context_pack(meta: dict, stats: dict, diff: str) -> str:
    owner_repo = meta["base"]["repo"]["full_name"]
    return f"""# Review context for {owner_repo}#{meta['number']}

- PR: {meta['html_url']}
- Title: {meta['title']}
- Author: {meta['user']['login']}
- State: {meta['state']}{' (merged)' if meta.get('merged_at') else ''}
- Base: {meta['base']['ref']} <- Head: {meta['head']['ref']}

PR description:

{meta.get('body') or '(no description provided)'}

{stats_markdown(stats)}

## Unified diff

```diff
{diff}
```
"""


def validate_review(review: str) -> list[str]:
    return [s for s in REQUIRED_SECTIONS if s not in review]


def run_agent(context_path: Path, workdir: Path, agent_name: str) -> str:
    claude = shutil.which("claude")
    if not claude:
        return ""
    prompt = (
        f"Review the pull request described in {context_path.name} (in this directory). "
        f"Follow the `{agent_name}` agent definition in .claude/agents/{agent_name}.md exactly: "
        "read the full unified diff in the context pack, apply the rubric, and output ONLY the "
        "structured Markdown review (Summary, Identified risks, Improvement suggestions, "
        "Confidence) with no preamble and no closing remarks."
    )
    try:
        proc = subprocess.run(
            [claude, "-p", prompt, "--agent", agent_name],
            cwd=workdir, capture_output=True, text=True, timeout=1800,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"warning: could not run `claude`: {exc}", file=sys.stderr)
        return ""
    if proc.returncode != 0:
        print(f"warning: `claude` exited {proc.returncode}: {proc.stderr.strip()[:400]}", file=sys.stderr)
        return ""
    return proc.stdout.strip()


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

PR_URL_RE = re.compile(r"(?:https?://github\.com/)?([\w.-]+)/([\w.-]+?)(?:\.git)?(?:/pull/|#)(\d+)")


def parse_pr_ref(ref: str) -> tuple[str, str, int]:
    m = PR_URL_RE.fullmatch(ref.strip())
    if not m:
        raise SystemExit(f"error: cannot parse PR reference: {ref!r} "
                         "(expected https://github.com/owner/repo/pull/123 or owner/repo#123)")
    return m.group(1), m.group(2), int(m.group(3))


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="claude-review", description=__doc__.splitlines()[0])
    ap.add_argument("--pr", required=True, help="PR URL or owner/repo#123")
    ap.add_argument("--diff-file", help="use a local unified diff instead of fetching one")
    ap.add_argument("--out", help="write the review to this file (default: stdout)")
    ap.add_argument("--workdir", help="directory for artifacts (default: ./.claude-review/<owner>-<repo>-<n>)")
    ap.add_argument("--agent", default="pr-reviewer", help="agent definition name (default: pr-reviewer)")
    ap.add_argument("--dry-run", action="store_true",
                    help="fetch + pre-process + write context pack only; do not run the review")
    args = ap.parse_args(argv)

    owner, repo, number = parse_pr_ref(args.pr)
    token = github_token()

    if args.diff_file:
        diff = Path(args.diff_file).read_text(encoding="utf-8", errors="replace")
        base = f"{API}/repos/{owner}/{repo}/pulls/{number}"
        meta = json.loads(api_get(base, "application/vnd.github+json", token))
    else:
        meta, diff = fetch_pr(owner, repo, number, token)

    stats = preprocess(diff)
    workdir = Path(args.workdir) if args.workdir else Path.cwd() / ".claude-review" / f"{owner}-{repo}-{number}"
    workdir.mkdir(parents=True, exist_ok=True)
    diff_path = workdir / "pr.diff"
    diff_path.write_text(diff, encoding="utf-8")
    context_path = workdir / "context.md"
    context_path.write_text(build_context_pack(meta, stats, diff), encoding="utf-8")

    header = (
        f"# PR Review: {owner}/{repo}#{number} - {meta['title']}\n\n"
        f"{meta['html_url']}\n\n{stats_markdown(stats)}\n"
    )

    if args.dry_run:
        print(f"PR:        {meta['html_url']} ({meta['state']})")
        print(f"Diff:      {diff_path} ({stats['files_changed']} files, "
              f"+{stats['additions']}/-{stats['deletions']})")
        print(f"Context:   {context_path}")
        print("Dry run: review not executed.")
        return 0

    review = run_agent(context_path, workdir, args.agent)
    if not review:
        print(
            "The `claude` CLI was not found, so the review step was not executed.\n"
            f"A complete context pack (metadata + diff stats + unified diff) is ready at:\n"
            f"  {context_path}\n"
            "Run the review inside Claude Code from your project root with the agent "
            f"definition installed at .claude/agents/{args.agent}.md, e.g.:\n"
            f'  claude -p "Review the PR in {context_path}" --agent {args.agent}\n'
            "or paste context.md into a Claude Code session and ask for the "
            f"{args.agent} review.",
            file=sys.stderr,
        )
        return 3

    missing = validate_review(review)
    if missing:
        print(f"warning: review is missing required sections: {', '.join(missing)}", file=sys.stderr)

    output = header + "\n" + review + "\n"
    if args.out:
        Path(args.out).write_text(output, encoding="utf-8")
        print(f"Review written to {args.out}")
    else:
        print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
