{
  "name": "claude-pr-reviewer",
  "version": "1.0.0",
  "description": "Claude Code sub-agent that reviews PRs with structured Markdown output",
  "main": "dist/index.js",
  "bin": {
    "claude-review": "./bin/claude-review.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "review": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node dist/index.js --help"
  },
  "keywords": [
    "claude",
    "code-review",
    "pr-review",
    "github",
    "anthropic"
  ],
  "author": "FraktalDeFiDAO",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
