{
  "name": "claude-pr-reviewer",
  "version": "1.0.0",
  "description": "Claude Code PR review sub-agent and CLI for structured Markdown reviews.",
  "type": "module",
  "bin": {
    "claude-review": "./bin/claude-review.js"
  },
  "scripts": {
    "test": "node --test",
    "review:sample:1": "node ./bin/claude-review.js --pr https://github.com/octocat/Hello-World/pull/6 --mode heuristic",
    "review:sample:2": "node ./bin/claude-review.js --pr https://github.com/octocat/Spoon-Knife/pull/31666 --mode heuristic"
  },
  "keywords": [
    "claude-code",
    "github",
    "pull-request",
    "code-review",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {}
}
