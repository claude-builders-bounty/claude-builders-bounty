{
  "name": "claude-pr-reviewer",
  "version": "0.1.0",
  "description": "Claude Code PR review agent and CLI for structured Markdown reviews",
  "type": "module",
  "bin": {
    "claude-review": "./bin/claude-review.js"
  },
  "scripts": {
    "review": "node ./bin/claude-review.js",
    "test": "node --test",
    "check": "node --check ./bin/claude-review.js && node --test"
  },
  "keywords": [
    "claude-code",
    "agent",
    "pull-request",
    "code-review"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
