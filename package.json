{
  "name": "claude-review",
  "version": "1.0.0",
  "description": "Claude Code sub-agent that reviews PRs and posts structured Markdown comments",
  "type": "module",
  "bin": {
    "claude-review": "./dist/cli.js"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "code-review",
    "pr-review",
    "ai-review"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "commander": "^12.0.0",
    "octokit": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.0.0"
  }
}
