exec bash "$(dirname "$0")/changelog.sh" "$@"
#!/bin/bash
#
# generate-changelog
# Automatically generates a structured CHANGELOG.md from git history.
#
# Usage:
#   bash changelog.sh              # Generate CHANGELOG.md
#   bash changelog.sh --dry-run    # Preview without writing
#   bash changelog.sh --since-tag  # Use all commits (no tag filtering)
#

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
OUTPUT_FILE="CHANGELOG.md"
DRY_RUN=false
USE_ALL_COMMITS=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --since-tag)
            USE_ALL_COMMITS=true
            shift
            ;;
        --help|-h)
            echo "Usage: bash changelog.sh [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --dry-run       Preview output without writing to file"
            echo "  --since-tag     Include all commits (ignore tag filtering)"
            echo "  --help, -h      Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not a git repository.${NC}"
    exit 1
fi

# Get the latest tag
LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

if [ -z "$LATEST_TAG" ]; then
    echo -e "${YELLOW}Warning: No tags found. Using all commits.${NC}"
    USE_ALL_COMMITS=true
fi

# Determine commit range
if [ "$USE_ALL_COMMITS" = true ]; then
    COMMIT_RANGE="HEAD"
    echo -e "${BLUE}Generating changelog from all commits...${NC}"
else
    COMMIT_RANGE="${LATEST_TAG}..HEAD"
    echo -e "${BLUE}Generating changelog since tag: ${GREEN}${LATEST_TAG}${NC}"
fi

# Get commits with their messages
# Format: hash|subject|body
COMMITS=$(git log "$COMMIT_RANGE" --pretty=format:"%H|%s|%b---COMMIT_DELIMITER---" 2>/dev/null || true)

if [ -z "$COMMITS" ]; then
    echo -e "${YELLOW}No commits found in the specified range.${NC}"
    exit 0
fi

# Categorization keywords (case-insensitive)
ADDED_PATTERNS="feat|add|introduce|implement|create|new"
FIXED_PATTERNS="fix|bug|repair|resolve|patch|correct"
REMOVED_PATTERNS="remove|delete|drop|eliminate|deprecate|clean"
CHANGED_PATTERNS="update|change|modify|refactor|improve|enhance|optimize|upgrade|rework"

# Initialize category arrays
declare -a ADDED_COMMITS
declare -a FIXED_COMMITS
declare -a CHANGED_COMMITS
declare -a REMOVED_COMMITS
declare -a OTHER_COMMITS

# Process each commit
IFS='---COMMIT_DELIMITER---' read -ra COMMIT_LIST <<< "$COMMITS"

for commit in "${COMMIT_LIST[@]}"; do
    # Trim whitespace
    commit=$(echo "$commit" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$commit" ] && continue
    
    # Extract hash and subject
    HASH=$(echo "$commit" | cut -d'|' -f1)
    SUBJECT=$(echo "$commit" | cut -d'|' -f2)
    BODY=$(echo "$commit" | cut -d'|' -f3-)
    
    # Short hash for display
    SHORT_HASH=$(echo "$HASH" | cut -c1-7)
    
    pir
#!/bin/bash
# Wrapper script for the changelog generator
exec bash "$(dirname "$0")/changelog.sh" "$@"