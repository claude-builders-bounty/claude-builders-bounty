#!/usr/bin/env python3
"""
Claude Code sub-agent: Reviews a GitHub PR and posts a structured Markdown comment.

Works via CLI:
    claude-review --pr https://github.com/owner/repo/pull/123

Requires env var ANTHROPIC_API_KEY (or any compatible OpenAI-format endpoint).
"""

import argparse
import json
import os
import re
import sys
import urllib.request
from dataclasses import dataclass, asdict
from typing import Optional

# ── Config ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
API_URL = "https://api.anthropic.com/v1/messages"
MODEL = "claude-sonnet-4-20250514"


@dataclass
class ReviewResult:
    summary: str
    risks: list
    suggestions: list
    confidence: str  # Low | Medium | High

    def to_markdown(self, pr_url: str) -> str:
        emoji = {"Low": "🟡", "Medium": "🟠", "High": "🟢"}.get(self.confidence, "⚪")
        md = f"""## 🤖 Claude Code PR Review

> 🤖 Generated by Claude Code sub-agent  
> 🔗 [`{pr_url}`]({pr_url})

{emoji} **Confidence:** `{self.confidence}`

---

### 📋 Summary of Changes

{self.summary}

---

### ⚠️ Identified Risks

"""
        if self.risks:
            for i, risk in enumerate(self.risks, 1):
                md += f"{i}. {risk}\n"
        else:
            md += "✅ No obvious risks detected.\n"

        md += "\n---\n\n### 💡 Improvement Suggestions\n\n"
        if self.suggestions:
            for i, sug in enumerate(self.suggestions, 1):
                md += f"{i}. {sug}\n"
        else:
            md += "✨ Code looks good — no suggestions.\n"

        md += "\n---\n\n*Automated review via `claude-review` agent.*"
        return md


def parse_pr_url(url: str) -> tuple[str, str, int]:
    """Extract (owner, repo, pr_number) from a GitHub PR URL."""
    m = re.match(
        r"https?://github\.com/([^/]+)/([^/]+)/pull/(\d+)",
        url.strip()
    )
    if not m:
        raise ValueError(f"Invalid GitHub PR URL: {url!r}")
    owner, repo, num = m.group(1), m.group(2), int(m.group(3))
    return owner, repo, num


def fetch_pr_diff(owner: str, repo: str, pr_number: int) -> str:
    """Fetch the unified diff of a GitHub PR via the GitHub REST API."""
    api = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    req = urllib.request.Request(api, headers={
        "Accept": "application/vnd.github.v3.diff",
        "User-Agent": "claude-review-agent",
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"GitHub API error {e.code}: {e.read().decode()[:300]}") from e


def call_claude(diff_text: str) -> ReviewResult:
    """Send the PR diff to Claude and parse structured review."""
    if not ANTHROPIC_API_KEY:
        return ReviewResult(
            summary="(No API key — set ANTHROPIC_API_KEY to enable real reviews.)",
            risks=["ANTHROPIC_API_KEY not set"],
            suggestions=["Set ANTHROPIC_API_KEY to enable AI review."],
            confidence="Low",
        )

    prompt = f"""You are a senior code reviewer. Given the following GitHub PR diff,
analyze the changes and respond with exactly this JSON structure (no extra text):

{{
  "summary": "2–3 sentences summarizing the changes",
  "risks": ["risk 1", "risk 2"],
  "suggestions": ["suggestion 1", "suggestion 2"],
  "confidence": "Low|Medium|High"
}}

PR Diff:
-----
{diff_text[:30000]}"""

    body = json.dumps({
        "model": MODEL,
        "max_tokens": 1024,
        "messages": [{"role": "user", "content": prompt}],
    }).encode()

    req = urllib.request.Request(API_URL, data=body, headers={
        "x-api-key": ANTHROPIC_API_KEY,
        "content-type": "application/json",
        "anthropic-version": "2023-06-01",
    })
    with urllib.request.urlopen(req, timeout=60) as resp:
        data = json.loads(resp.read())

    text = data["content"][0]["text"] if data.get("content") else "{}"

    # Extract JSON from response (Claude may wrap it in ```json```)
    m = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", text, re.DOTALL)
    if m:
        text = m.group(1)
    try:
        parsed = json.loads(text)
        return ReviewResult(
            summary=parsed.get("summary", ""),
            risks=parsed.get("risks", []),
            suggestions=parsed.get("suggestions", []),
            confidence=parsed.get("confidence", "Low"),
        )
    except (json.JSONDecodeError, TypeError):
        return ReviewResult(
            summary=text[:300],
            risks=["Failed to parse structured review"],
            suggestions=[],
            confidence="Low",
        )


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR review sub-agent")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    parser.add_argument("--json", action="store_true", help="Output raw JSON")
    args = parser.parse_args()

    owner, repo, pr_number = parse_pr_url(args.pr)
    print(f"[*] Fetching diff for {owner}/{repo}#{pr_number} ...", file=sys.stderr)
    diff = fetch_pr_diff(owner, repo, pr_number)
    print(f"[*] Diff size: {len(diff):,} chars\n", file=sys.stderr)

    result = call_claude(diff)

    if args.json:
        print(json.dumps(asdict(result), indent=2))
    else:
        print(result.to_markdown(args.pr))


if __name__ == "__main__":
    main()
