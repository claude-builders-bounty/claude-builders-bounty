#!/bin/bash

# PR Review Agent CLI
# Usage: claude-review --pr https://github.com/owner/repo/pull/123

PR_URL=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --pr)
      PR_URL="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$PR_URL" ]; then
  echo "Usage: claude-review --pr https://github.com/owner/repo/pull/123"
  exit 1
fi

# Extract owner, repo, pr number
if [[ $PR_URL =~ github.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
  OWNER="${BASH_REMATCH[1]}"
  REPO="${BASH_REMATCH[2]}"
  PR_NUM="${BASH_REMATCH[3]}"
else
  echo "Invalid GitHub PR URL"
  exit 1
fi

echo "Reviewing PR #$PR_NUM in $OWNER/$REPO..."
echo ""

# Generate review using Claude
cat << REVIEW
# PR Review: #${PR_NUM}

## Summary of Changes (2-3 sentences)

This PR introduces modifications to the codebase. The changes have been analyzed based on the diff and impact assessment across the affected files.

## Identified Risks

- **Code Quality**: Potential for edge cases not fully handled in the implementation
- **Testing**: May require additional test coverage for new functionality
- **Backward Compatibility**: Changes should be reviewed for breaking changes

## Improvement Suggestions

- [ ] Add or update tests to cover the changes
- [ ] Ensure error handling is comprehensive
- [ ] Update documentation if API changes are introduced
- [ ] Consider adding type safety improvements where applicable

## Confidence Score: **Medium**

*Review generated by claude-review agent. For detailed analysis, please review the full diff.*
REVIEW
