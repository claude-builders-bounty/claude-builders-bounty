def format_markdown_review(review: Dict) -> str:
    """Format the review results into a markdown comment."""
    md = f"""## Code Review

### Summary of Changes
{review['summary']}

### Identified Risks
"""
    for risk in review.get('risks', []):
        md += f"- {risk}\n"
    
    md += "\n### Improvement Suggestions\n"
    for suggestion in review.get('suggestions', []):
        md += f"- {suggestion}\n"
    
    md += f"\n### Confidence\n**{review['confidence']}**\n"
    
    return md

def post_comment(owner: str, repo: str, pr_number: str, comment: str, token: str):
    """Post a comment to the pull request."""
    url = f"https://api.github.com/repos/{owner}/{repo}/issues/{pr_number}/comments"
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/json",
        "User-Agent": "claude-review-agent"
    }
    data = {"body": comment}
    response = requests.post(url, headers=headers, json=data)
    response.raise_for_status()

