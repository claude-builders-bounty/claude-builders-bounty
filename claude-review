#!/usr/bin/env python3
"""
claude-review — PR Reviewer Agent

Analyzes a GitHub PR diff and outputs structured Markdown review.
Works as a standalone CLI tool or as a GitHub Action.

Usage:
  claude-review --pr https://github.com/owner/repo/pull/123
  claude-review --pr 123 --repo owner/repo
  GITHUB_TOKEN=... claude-review --pr 123 --repo owner/repo
"""
import argparse, json, os, re, sys, urllib.request, urllib.error
from datetime import datetime

def fetch(url, token):
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3.diff",
        "User-Agent": "claude-review/1.0"
    }
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req) as resp:
            return resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        print(f"Error fetching {url}: {e.code}", file=sys.stderr)
        sys.exit(1)

def fetch_json(url, token):
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json",
        "User-Agent": "claude-review/1.0"
    }
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())

def analyze_diff(diff, pr_title, pr_body):
    """Analyze a PR diff and produce structured review output."""
    lines = diff.split("\n")
    
    # Stats
    files_changed = set()
    additions = 0
    deletions = 0
    for line in lines:
        if line.startswith("+++ b/"):
            files_changed.add(line[6:])
        elif line.startswith("+" ) and not line.startswith("+++"):
            additions += 1
        elif line.startswith("-") and not line.startswith("---"):
            deletions += 1
    
    # Identify changed file types
    extensions = {}
    for f in files_changed:
        ext = f.split(".")[-1] if "." in f else "(no ext)"
        extensions[ext] = extensions.get(ext, 0) + 1
    
    # Detect risks
    risks = []
    for i, line in enumerate(lines):
        if line.startswith("+") and "password" in line.lower():
            risks.append("Hardcoded password or credential detected")
        if line.startswith("+") and "token" in line.lower() and "=" in line:
            risks.append("Possible token/secret hardcoded")
        if "console.log" in line or "print(" in line:
            risks.append("Debug logging left in code")
        if "TODO" in line or "FIXME" in line:
            risks.append("Unresolved TODO/FIXME in code")
        if "except:" in line or "catch" in line and "Exception" not in line:
            risks.append("Bare except/catch clause (too broad)")
        if "eval(" in line.lower():
            risks.append("Use of eval() — potential security risk")
        if "exec(" in line.lower():
            risks.append("Use of exec() — potential security risk")
    
    # Check test coverage
    has_tests = any("test" in f.lower() or "spec" in f.lower() for f in files_changed)
    has_new_code = any(f for f in files_changed if f.endswith((".py", ".js", ".ts", ".tsx", ".jsx", ".go", ".rs", ".java")))
    
    # Suggestions
    suggestions = []
    if has_new_code and not has_tests:
        suggestions.append("Add tests for the new/modified code")
    
    if additions > 300:
        suggestions.append("Consider splitting into smaller PRs for easier review")
    
    if "package.json" in str(files_changed) or "requirements.txt" in str(files_changed) or "Cargo.toml" in str(files_changed) or "go.mod" in str(files_changed):
        suggestions.append("Verify dependency changes are necessary and don't introduce vulnerabilities")
    
    if ".env" in str(files_changed).lower():
        suggestions.append("Ensure .env file is in .gitignore and not committed")
    
    # Confidence score
    if not risks and has_tests and additions < 100:
        confidence = "High"
    elif len(risks) > 3:
        confidence = "Low"
    else:
        confidence = "Medium"
    
    summary_parts = [f"**{len(files_changed)}** file(s) changed"]
    if additions > 0:
        summary_parts.append(f"**+{additions}** additions")
    if deletions > 0:
        summary_parts.append(f"**-{deletions}** deletions")
    
    summary = f"This PR modifies {'; '.join(summary_parts)}."
    
    # Build output
    output = []
    output.append(f"## 🔍 PR Review: {pr_title}")
    output.append("")
    output.append(f"**Review generated:** {datetime.now().strftime('%Y-%m-%d %H:%M UTC')}")
    output.append("")
    output.append("---")
    output.append("")
    output.append("### 📋 Summary of Changes")
    output.append("")
    output.append(summary)
    
    if files_changed:
        output.append("")
        output.append("**Files changed:**")
        for f in sorted(files_changed)[:20]:
            output.append(f"- `{f}`")
    
    output.append("")
    output.append("### ⚠️ Identified Risks")
    output.append("")
    if risks:
        for r in set(risks):
            output.append(f"- ⚠️ {r}")
    else:
        output.append("- ✅ No significant risks detected")
    
    output.append("")
    output.append("### 💡 Improvement Suggestions")
    output.append("")
    if suggestions:
        for s in suggestions:
            output.append(f"- 💡 {s}")
    else:
        output.append("- None at this time")
    
    output.append("")
    output.append("### 📊 Review Confidence")
    output.append("")
    output.append(f"**Confidence: {confidence}**")
    output.append("")
    confidence_desc = {
        "High": "Changes are small, well-tested, and low-risk.",
        "Medium": "Some concerns identified; moderate complexity.",
        "Low": "Multiple risks or large scope; manual review recommended."
    }
    output.append(confidence_desc.get(confidence, ""))
    
    return "\n".join(output)

def main():
    parser = argparse.ArgumentParser(description="PR Reviewer Agent")
    parser.add_argument("--pr", help="PR number or full URL")
    parser.add_argument("--repo", help="Repository (owner/repo)")
    args = parser.parse_args()
    
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if not token:
        print("Error: GITHUB_TOKEN environment variable required", file=sys.stderr)
        sys.exit(1)
    
    # Parse PR identifier
    pr_url = args.pr
    repo = args.repo
    pr_number = None
    
    if pr_url and pr_url.startswith("http"):
        m = re.search(r"github\.com/([^/]+/[^/]+)/pull/(\d+)", pr_url)
        if m:
            repo = m.group(1)
            pr_number = m.group(2)
    elif pr_url and pr_url.isdigit():
        pr_number = pr_url
    
    if not repo or not pr_number:
        print("Error: Provide --pr URL or --pr NUMBER --repo OWNER/REPO", file=sys.stderr)
        sys.exit(1)
    
    # Fetch PR info
    pr_info = fetch_json(f"https://api.github.com/repos/{repo}/pulls/{pr_number}", token)
    
    # Fetch diff
    diff = fetch(pr_info.get("diff_url", f"https://api.github.com/repos/{repo}/pulls/{pr_number}"), token)
    
    # Analyze
    review = analyze_diff(diff, pr_info.get("title", ""), pr_info.get("body", ""))
    print(review)

if __name__ == "__main__":
    main()
