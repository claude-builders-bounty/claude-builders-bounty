#!/usr/bin/env python3
"""
PR Reviewer — analyzes GitHub PR diffs and returns structured Markdown review.
Usage: python3 claude-review --pr https://github.com/owner/repo/pull/123
"""

import argparse, json, os, re, sys
from urllib.request import Request, urlopen
from urllib.error import HTTPError

GITHUB_TOKEN = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN", "")


def parse_pr_url(url: str):
    m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
    if not m:
        print(f"Error: Invalid PR URL: {url}", file=sys.stderr)
        sys.exit(1)
    return m.group(1), m.group(2), int(m.group(3))


def gh(path: str):
    h = {"Accept": "application/vnd.github.v3+json", "User-Agent": "claude-review/1.0"}
    if GITHUB_TOKEN:
        h["Authorization"] = f"token {GITHUB_TOKEN}"
    try:
        with urlopen(Request(f"https://api.github.com{path}", headers=h)) as r:
            return json.loads(r.read())
    except HTTPError as e:
        print(f"API error: {e}", file=sys.stderr)
        sys.exit(1)


def get_diff(owner, repo, pr_num):
    h = {"Accept": "application/vnd.github.v3.diff", "User-Agent": "claude-review/1.0"}
    if GITHUB_TOKEN:
        h["Authorization"] = f"token {GITHUB_TOKEN}"
    try:
        with urlopen(Request(f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_num}", headers=h)) as r:
            return r.read().decode("utf-8", errors="replace")
    except HTTPError as e:
        print(f"Failed to fetch diff: {e}", file=sys.stderr)
        sys.exit(1)


def analyze(diff):
    adds = len(re.findall(r"^\+(?!\+\+)", diff, re.MULTILINE))
    dels = len(re.findall(r"^-(?!---)", diff, re.MULTILINE))
    files = len(re.findall(r"^diff --git", diff, re.MULTILINE))

    risks = []; score = 0

    if re.search(r"(?i)(secret|password|token|api[_-]?key)", diff) and not re.search(r"(?i)(\.env\.example|placeholder|your-|sk_test)", diff):
        risks.append("- **Credentials**: File contains strings matching secret/password/token. Verify these are not real credentials.")
        score += 3
    if re.search(r"(?i)DROP\s+TABLE|DROP\s+DATABASE|TRUNCATE", diff):
        risks.append("- **Destructive SQL**: Contains DROP TABLE / DROP DATABASE / TRUNCATE.")
        score += 3
    if re.search(r"rm\s+-rf", diff):
        risks.append("- **Dangerous command**: Contains recursive force delete.")
        score += 3
    if re.search(r"console\.(log|warn|error)", diff):
        risks.append("- **Debug logs**: Console statements detected. Remove before production.")
        score += 1
    if re.search(r"TODO|FIXME|HACK|XXX", diff):
        risks.append("- **Unresolved markers**: TODO/FIXME/HACK comments present.")
        score += 1
    if files > 15:
        risks.append(f"- **Large PR**: {files} files. Consider splitting for easier review.")
        score += 2
    if adds > 500:
        risks.append(f"- **Large diff**: {adds}+ lines. May benefit from architecture review.")
        score += 1

    if not risks:
        risks.append("- No obvious risks detected.")
        conf, reason = "High", "No risky patterns detected."
    elif score <= 2:
        conf, reason = "Medium", f"Minor concerns ({score} risk points)."
    else:
        conf, reason = "Low", f"Significant concerns ({score} risk points). Manual review recommended."

    suggestions = []
    if not re.search(r"(test|spec|__tests__)", diff, re.IGNORECASE) and adds > 20:
        suggestions.append("- Consider adding tests. No test files detected in diff.")
    if not suggestions:
        suggestions.append("- Looks clean. Consider edge cases: empty inputs, errors, rate limits.")

    return risks, suggestions, conf, reason, files, adds, dels


def main():
    p = argparse.ArgumentParser(description="PR Reviewer")
    p.add_argument("--pr", required=True, help="GitHub PR URL")
    args = p.parse_args()

    owner, repo, pr_num = parse_pr_url(args.pr)
    pr_data = gh(f"/repos/{owner}/{repo}/pulls/{pr_num}")
    diff = get_diff(owner, repo, pr_num)
    risks, suggestions, conf, reason, files, adds, dels = analyze(diff)

    print(f"""# PR Review: {pr_data.get('title', 'Unknown')}

**PR:** [{owner}/{repo}#{pr_num}]({args.pr})
**Summary:** +{adds} / -{dels} lines across {files} file(s)

## Identified Risks
{chr(10).join(risks)}

## Improvement Suggestions
{chr(10).join(suggestions)}

## Assessment

| Metric | Value |
|--------|-------|
| Confidence | **{conf}** |
| Files | {files} |
| +Lines | +{adds} |
| -Lines | -{dels} |

> {reason}

---
*Generated by claude-review*
""")


if __name__ == "__main__":
    main()
