#!/usr/bin/env bash
#
# claude-review — AI-powered pull request review using Claude Code
#
# Usage:
#   claude-review --pr https://github.com/owner/repo/pull/123
#   claude-review --pr https://github.com/owner/repo/pull/123 --post-comment
#
set -euo pipefail

VERSION="1.0.0"
MAX_DIFF_CHARS=100000
MODEL_FLAG=""
POST_COMMENT=false
PR_URL=""

# ── Colors (disabled when not a tty) ────────────────────────────────────────
if [[ -t 2 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; NC=''
fi

log_error() { echo -e "${RED}error:${NC} $1" >&2; }
log_info()  { echo -e "${GREEN}info:${NC} $1" >&2; }
log_warn()  { echo -e "${YELLOW}warn:${NC} $1" >&2; }

# ── Usage ───────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
claude-review v1.0.0 — AI-powered PR review using Claude Code

USAGE
  claude-review --pr <url> [OPTIONS]

OPTIONS
  --pr <url>            GitHub pull request URL (required)
  --post-comment        Post the review as a comment on the PR
  --model <model>       Claude model to use (passed through to claude CLI)
  -h, --help            Show this help message
  -v, --version         Show version

EXAMPLES
  claude-review --pr https://github.com/octocat/hello-world/pull/42
  claude-review --pr https://github.com/octocat/hello-world/pull/42 --post-comment
  claude-review --pr https://github.com/octocat/hello-world/pull/42 --model claude-sonnet-4-20250514

REQUIREMENTS
  gh      GitHub CLI, authenticated (https://cli.github.com)
  claude  Claude Code CLI (npm i -g @anthropic-ai/claude-code)
  jq      JSON processor (https://jqlang.github.io/jq/)
USAGE
}

# ── Dependency check ────────────────────────────────────────────────────────
check_deps() {
  local missing=()
  command -v gh     &>/dev/null || missing+=("gh")
  command -v claude &>/dev/null || missing+=("claude")
  command -v jq     &>/dev/null || missing+=("jq")
  if [[ ${#missing[@]} -gt 0 ]]; then
    log_error "missing required dependencies: ${missing[*]}"
    echo "  Install gh:      https://cli.github.com" >&2
    echo "  Install claude:  npm i -g @anthropic-ai/claude-code" >&2
    echo "  Install jq:      https://jqlang.github.io/jq/download/" >&2
    exit 1
  fi
}

# ── Parse PR URL ────────────────────────────────────────────────────────────
parse_pr_url() {
  local url="$1"
  if [[ "$url" =~ ^https?://github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    PR_OWNER="${BASH_REMATCH[1]}"
    PR_REPO="${BASH_REMATCH[2]}"
    PR_NUMBER="${BASH_REMATCH[3]}"
    PR_FULL_REPO="${PR_OWNER}/${PR_REPO}"
  else
    log_error "invalid PR URL: $url"
    echo "  Expected format: https://github.com/OWNER/REPO/pull/NUMBER" >&2
    exit 1
  fi
}

# ── Parse CLI arguments ────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case $1 in
    --pr)
      [[ -z "${2:-}" ]] && { log_error "--pr requires a URL argument"; exit 1; }
      PR_URL="$2"; shift 2 ;;
    --post-comment)
      POST_COMMENT=true; shift ;;
    --model)
      [[ -z "${2:-}" ]] && { log_error "--model requires a value"; exit 1; }
      MODEL_FLAG="--model $2"; shift 2 ;;
    -h|--help)
      usage; exit 0 ;;
    -v|--version)
      echo "claude-review v${VERSION}"; exit 0 ;;
    *)
      if [[ -z "$PR_URL" && "$1" =~ ^https?:// ]]; then
        PR_URL="$1"; shift
      else
        log_error "unknown argument: $1"; usage; exit 1
      fi ;;
  esac
done

[[ -z "$PR_URL" ]] && { log_error "no PR URL provided"; usage; exit 1; }

check_deps
parse_pr_url "$PR_URL"

log_info "reviewing ${PR_FULL_REPO}#${PR_NUMBER}"

# ── Fetch PR metadata ──────────────────────────────────────────────────────
log_info "fetching PR metadata..."
PR_JSON=$(gh pr view "$PR_NUMBER" --repo "$PR_FULL_REPO" \
  --json title,body,files,additions,deletions,changedFiles,baseRefName,headRefName,author 2>/dev/null) \
  || { log_error "failed to fetch PR metadata. Check that the PR exists and gh is authenticated."; exit 1; }

PR_TITLE=$(echo "$PR_JSON" | jq -r '.title // "Untitled"')
PR_BODY=$(echo "$PR_JSON" | jq -r '.body // "No description provided."')
PR_AUTHOR=$(echo "$PR_JSON" | jq -r '.author.login // "unknown"')
PR_BASE=$(echo "$PR_JSON" | jq -r '.baseRefName // "main"')
PR_HEAD=$(echo "$PR_JSON" | jq -r '.headRefName // "unknown"')
PR_ADDITIONS=$(echo "$PR_JSON" | jq -r '.additions // 0')
PR_DELETIONS=$(echo "$PR_JSON" | jq -r '.deletions // 0')
PR_CHANGED_FILES=$(echo "$PR_JSON" | jq -r '.changedFiles // 0')
PR_FILE_LIST=$(echo "$PR_JSON" | jq -r '.files[].path' 2>/dev/null | head -50 || echo "(no files)")

log_info "PR: \"${PR_TITLE}\" by ${PR_AUTHOR} (+${PR_ADDITIONS}/-${PR_DELETIONS}, ${PR_CHANGED_FILES} files)"

# ── Fetch diff ──────────────────────────────────────────────────────────────
log_info "fetching diff..."
PR_DIFF=$(gh pr diff "$PR_NUMBER" --repo "$PR_FULL_REPO" 2>/dev/null) \
  || { log_error "failed to fetch PR diff."; exit 1; }

if [[ -z "$PR_DIFF" ]]; then
  log_error "PR diff is empty — nothing to review."
  exit 1
fi

# Truncate oversized diffs to stay within Claude's context window
DIFF_LEN=${#PR_DIFF}
if [[ $DIFF_LEN -gt $MAX_DIFF_CHARS ]]; then
  log_warn "diff is ${DIFF_LEN} chars — truncating to ${MAX_DIFF_CHARS} chars"
  PR_DIFF="${PR_DIFF:0:$MAX_DIFF_CHARS}

... [DIFF TRUNCATED — showing first ${MAX_DIFF_CHARS} of ${DIFF_LEN} total characters] ..."
fi

# ── Build prompt ────────────────────────────────────────────────────────────
PROMPT="You are an expert code reviewer performing a thorough review of a GitHub pull request. Analyze the PR metadata and diff below and produce a structured review.

## Pull Request Metadata
- **Title:** ${PR_TITLE}
- **Author:** ${PR_AUTHOR}
- **Branch:** ${PR_HEAD} → ${PR_BASE}
- **Stats:** +${PR_ADDITIONS} / -${PR_DELETIONS} across ${PR_CHANGED_FILES} file(s)

### PR Description
${PR_BODY}

### Changed Files
${PR_FILE_LIST}

### Diff
\`\`\`diff
${PR_DIFF}
\`\`\`

---

## Output Format

Produce your review in EXACTLY this Markdown structure. Do not add or remove sections.

## 🔍 PR Review: ${PR_TITLE}

### Summary
<Write 2–3 sentences summarizing what this PR does, the approach taken, and the scope of changes.>

### Identified Risks
<Bulleted list. Each bullet describes one concrete risk with a brief explanation of potential impact. Reference specific files and line numbers from the diff. If there are no significant risks, include one bullet explaining why the changes are low-risk.>

### Improvement Suggestions
<Bulleted list. Each bullet is a specific, actionable suggestion. Reference file names and line ranges. If the code is solid, suggest minor polish or explicitly note that it looks good.>

### Confidence Score
<Write EXACTLY one of: **Low**, **Medium**, or **High**>

<One sentence explaining your confidence level — based on diff complexity, test coverage visibility, and how thoroughly you could assess the changes.>

---
*Reviewed by [claude-review](https://github.com/claude-builders-bounty/claude-builders-bounty) — AI-powered PR review using Claude Code*

## Rules
- Be specific — cite files, functions, and line numbers from the diff.
- Be honest — if the changes look good, say so. Do not fabricate issues.
- Be concise — the full review should be readable in under 2 minutes.
- Confidence reflects review quality given diff size and complexity, not whether the code is correct."

# ── Run Claude Code ─────────────────────────────────────────────────────────
log_info "analyzing with Claude Code..."

# Write prompt to a temp file to avoid ARG_MAX limits on large diffs
TMPFILE=$(mktemp "${TMPDIR:-/tmp}/claude-review.XXXXXX")
trap 'rm -f "$TMPFILE"' EXIT
printf '%s' "$PROMPT" > "$TMPFILE"

# shellcheck disable=SC2086
REVIEW=$(claude -p $MODEL_FLAG < "$TMPFILE" 2>/dev/null) \
  || { log_error "claude returned an error. Ensure ANTHROPIC_API_KEY is set and claude CLI is working."; exit 1; }

if [[ -z "$REVIEW" ]]; then
  log_error "claude returned an empty response."
  exit 1
fi

# ── Output ──────────────────────────────────────────────────────────────────
echo "$REVIEW"

# ── Post as PR comment (optional) ──────────────────────────────────────────
if [[ "$POST_COMMENT" == true ]]; then
  log_info "posting review as PR comment..."
  echo "$REVIEW" | gh pr comment "$PR_NUMBER" --repo "$PR_FULL_REPO" --body-file - \
    || { log_error "failed to post comment. Check gh permissions."; exit 1; }
  log_info "comment posted on ${PR_URL}"
fi
