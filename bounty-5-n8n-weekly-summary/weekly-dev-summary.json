{
  "name": "Weekly Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "weekdays": [5]
            },
            {
              "field": "triggerAtHour",
              "hour": 17
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Trigger (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.GITHUB_API }}/repos/{{ $vars.GITHUB_REPO }}/commits?since={{ $now.minus({days:7}).toISO() }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN_CREDENTIALS",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.GITHUB_API }}/repos/{{ $vars.GITHUB_REPO }}/issues?state=closed&since={{ $now.minus({days:7}).toISO() }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN_CREDENTIALS",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.GITHUB_API }}/repos/{{ $vars.GITHUB_REPO }}/pulls?state=closed&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 600],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN_CREDENTIALS",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-data",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [640, 400]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.first().json?.body || [];\nconst issues = $input.first().json?.body || [];\nconst prs = $input.first().json?.body || [];\n\n// Filter PRs to only merged ones from this week\nconst oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\nconst mergedPRs = prs.filter(pr => pr.merged_at && new Date(pr.merged_at) >= new Date(oneWeekAgo));\n\n// Filter issues closed this week\nconst closedIssues = issues.filter(i => i.closed_at && new Date(i.closed_at) >= new Date(oneWeekAgo));\n\n// Build summary data\nconst commitAuthors = [...new Set(commits.map(c => c.commit?.author?.name || 'Unknown'))];\nconst prTitles = mergedPRs.map(pr => `- [#${pr.number}](${pr.html_url}) ${pr.title} (by @${pr.user?.login})`);\nconst issueTitles = closedIssues.map(i => `- [#${i.number}](${i.html_url}) ${i.title}`);\n\nconst summary = {\n  repo: $vars.GITHUB_REPO,\n  week: `${oneWeekAgo.split('T')[0]} to ${new Date().toISOString().split('T')[0]}`,\n  totalCommits: commits.length,\n  uniqueContributors: commitAuthors.length,\n  contributors: commitAuthors.join(', '),\n  mergedPRs: mergedPRs.length,\n  prList: prTitles.join('\\n'),\n  closedIssues: closedIssues.length,\n  issueList: issueTitles.join('\\n'),\n  language: $vars.LANGUAGE || 'EN'\n};\n\nreturn [{ json: summary }];"
      },
      "id": "process-data",
      "name": "Process & Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 400]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "promptType": "define",
        "text": "=You are a developer advocate writing a weekly engineering summary.\n\nGenerate a narrative summary for the following repo activity:\n\n**Repo**: {{ $json.repo }}\n**Week**: {{ $json.week }}\n**Total commits**: {{ $json.totalCommits }}\n**Contributors**: {{ $json.contributors }}\n**Merged PRs** ({{ $json.mergedPRs }}):\n{{ $json.prList }}\n**Closed Issues** ({{ $json.closedIssues }}):\n{{ $json.issueList }}\n\n{{ $json.language === 'FR' ? 'Write the summary in French.' : 'Write the summary in English.' }}\n\nFormat:\n## Weekly Dev Summary — {{ $json.repo }}\n### 📊 By the Numbers\n- X commits by Y contributors\n- Z merged PRs, W closed issues\n\n### 🚀 Highlights\n(2-3 most impactful changes with brief explanations)\n\n### 📋 Merged Pull Requests\n(list with links)\n\n### ✅ Closed Issues\n(list with links)\n\n### 👏 Contributors\n(thank contributors by name)\n\nKeep it concise, professional, and engaging. Focus on what changed and why it matters.",
        "options": {
          "temperature": 0.3,
          "maxTokens": 2048
        }
      },
      "id": "claude-api",
      "name": "Claude Generate Summary",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1,
      "position": [1080, 400],
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CREDENTIALS",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": {{ JSON.stringify($json.text || $json.content || 'Weekly summary generated.') }},\n  \"username\": \"Weekly Dev Summary\"\n}",
        "options": {}
      },
      "id": "send-webhook",
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "fromEmail": "dev-summary@yourdomain.com",
        "toEmail": "={{ $vars.EMAIL_TO }}",
        "subject": "=Weekly Dev Summary — {{ $vars.GITHUB_REPO }}",
        "text": "={{ $json.text || $json.content || 'Summary attached' }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send via Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1300, 500],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIALS",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Weekly Trigger (Friday 5pm)": {
      "main": [
        [
          { "node": "Fetch Commits", "type": "main", "index": 0 },
          { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
          { "node": "Fetch Merged PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [{ "node": "Merge All Data", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [{ "node": "Merge All Data", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [{ "node": "Merge All Data", "type": "main", "index": 0 }]
      ]
    },
    "Merge All Data": {
      "main": [
        [{ "node": "Process & Format Data", "type": "main", "index": 0 }]
      ]
    },
    "Process & Format Data": {
      "main": [
        [{ "node": "Claude Generate Summary", "type": "main", "index": 0 }]
      ]
    },
    "Claude Generate Summary": {
      "main": [
        [
          { "node": "Send to Discord/Slack", "type": "main", "index": 0 },
          { "node": "Send via Email", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "variables": [
      { "name": "GITHUB_REPO", "value": "owner/repo" },
      { "name": "GITHUB_API", "value": "https://api.github.com" },
      { "name": "LANGUAGE", "value": "EN" },
      { "name": "WEBHOOK_URL", "value": "https://discord.com/api/webhooks/YOUR_WEBHOOK" },
      { "name": "EMAIL_TO", "value": "team@yourdomain.com" }
    ]
  },
  "tags": [
    { "name": "weekly-summary" },
    { "name": "claude" },
    { "name": "github" }
  ]
}
