{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 168
            }
          ]
        }
      },
      "name": "Schedule Trigger (Weekly)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "repository": "{{.repository}}",
        "options": {}
      },
      "name": "Get GitHub Activity",
      "type": "n8n-nodes-base.githubTrigger",
      "position": [450, 300]
    },
    {
      "parameters": {
        "text": "=== Weekly Development Summary ===\n\nRepository: {{.repository}}\n\nCommits this week: {{.commits}}\nIssues closed: {{.issues}}\nMerged PRs: {{.pullRequests}}"
      },
      "name": "Generate Summary",
      "type": "n8n-nodes-base.function",
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": {
          "x-api-key": "{{.anthropicApiKey}}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-3-sonnet-20241022",
          "max_tokens": 1000,
          "messages": [
            {
              "role": "user",
              "content": "Generate a narrative summary of this GitHub activity: {{.summary}}"
            }
          ]
        }
      },
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 300]
    },
    {
      "parameters": {
        "channel": "#general",
        "text": "{{.content[0].text}}",
        "webhookUrl": "{{.discordWebhook}}"
      },
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "position": [1050, 300]
    }
  ],
  "connections": {}
}
