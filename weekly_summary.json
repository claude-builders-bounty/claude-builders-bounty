{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "github-commits",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.repo || 'https://api.github.com/repos/owner/repo/commits' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.startOf('week').toISO() }}"
            },
            {
              "name": "until",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        350
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.repo || 'https://api.github.com/repos/owner/repo/issues' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $now.startOf('week').toISO() }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        500
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.repo || 'https://api.github.com/repos/owner/repo/pulls' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "merge-data",
      "name": "Merge GitHub Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        650,
        350
      ],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      }
    },
    {
      "id": "build-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        350
      ],
      "parameters": {
        "language": "python",
        "code": "import json\n\n# Extract data from all inputs\ncommits = items[0].json.get('commits', items[0].json) if isinstance(items[0].json, dict) else items[0].json\nclosed_issues = items[1].json if isinstance(items[1].json, list) else [items[1].json]\nmerged_prs = items[2].json if isinstance(items[2].json, list) else [items[2].json]\n\n# Summarize counts\ncommit_count = len(commits) if isinstance(commits, list) else 1\nissue_count = len(closed_issues)\npr_count = len(merged_prs)\n\n# Build list of key events\ncommit_msgs = []\nif isinstance(commits, list):\n    for c in commits[:20]:\n        msg = c.get('commit', {}).get('message', str(c))[:80]\n        author = c.get('commit', {}).get('author', {}).get('name', 'unknown')\n        commit_msgs.append(f\"- {author}: {msg}\")\n\nissue_titles = []\nfor i in closed_issues[:10]:\n    issue_titles.append(f\"- #{i.get('number','')} {i.get('title','')[:80]}\")\n\npr_titles = []\nfor p in merged_prs[:10]:\n    pr_titles.append(f\"- #{p.get('number','')} {p.get('title','')[:80]}\")\n\nprompt = f'''Generate a concise weekly development summary in Markdown.\n\n## Stats\n- Commits: {commit_count}\n- Issues closed: {issue_count}\n- PRs merged: {pr_count}\n\n## Recent Commits\n{chr(10).join(commit_msgs) if commit_msgs else 'No commits this week'}\n\n## Closed Issues\n{chr(10).join(issue_titles) if issue_titles else 'No issues closed'}\n\n## Merged PRs\n{chr(10).join(pr_titles) if pr_titles else 'No PRs merged'}\n\nFormat as a narrative weekly report with: key achievements, notable changes, areas of focus. 2-3 paragraphs.'''\n\nreturn [{\"prompt\": prompt, \"commit_count\": commit_count, \"issue_count\": issue_count, \"pr_count\": pr_count}]"
      }
    },
    {
      "id": "claude-api",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1050,
        350
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 2048
            },
            {
              "name": "messages",
              "value": [
                {
                  "role": "user",
                  "content": "={{ $json.prompt }}"
                }
              ],
              "parameterType": "json"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "format-output",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        350
      ],
      "parameters": {
        "language": "python",
        "code": "content = items[0].json.get('content', [{}])\nsummary_text = ''\nif isinstance(content, list) and len(content) > 0:\n    for block in content:\n        if block.get('type') == 'text':\n            summary_text += block.get('text', '')\n\nstats = items[0].json.get('input', {}).get('prompt_data', items[0].json)\n\nheader = f'''# 📊 Weekly Dev Summary\n**Repo:** {stats.get('repo', 'your-repo')}\n**Week of:** {__import__('datetime').datetime.now().strftime('%B %d, %Y')}\n**Generated by:** n8n + Claude\n\n---\n\n'''\n\noutput = header + summary_text\n\n# Also add stats footer\noutput += f'''\n\n\n---\n*{stats.get('commit_count', 'N/A')} commits · {stats.get('issue_count', 'N/A')} issues closed · {stats.get('pr_count', 'N/A')} PRs merged*\n\n---\n\n> ⚙️ Generated automatically by [n8n workflow](https://n8n.io)\n'''\n\nreturn [{\"summary\": output}]"
      }
    },
    {
      "id": "webhook-delivery",
      "name": "Send to Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1450,
        350
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhook_url || 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL' }}",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.summary }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Weekly Schedule": {
      "main": [
        [
          {
            "node": "Fetch Weekly Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weekly Commits": {
      "main": [
        [
          {
            "node": "Merge GitHub Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Merge GitHub Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Merge GitHub Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Merge GitHub Data": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Claude Prompt": {
      "main": [
        [
          {
            "node": "Call Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Claude API": {
      "main": [
        [
          {
            "node": "Format Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Summary": {
      "main": [
        [
          {
            "node": "Send to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}