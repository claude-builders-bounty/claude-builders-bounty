#!/usr/bin/env python3
import sys
import argparse
from claude_review import run_review

sys.stdout.reconfigure(encoding='utf-8', errors='replace')

def main():
    parser = argparse.ArgumentParser(description="PR Review Sub-Agent")
    parser.add_argument("--pr", required=True, help="GitHub PR URL (e.g., https://github.com/owner/repo/pull/123)")
    args = parser.parse_args()

    pr_url = args.pr
    try:
        parts = pr_url.strip("/").split("/")
        if "pull" not in parts:
            raise ValueError("Missing 'pull' in URL")
        pull_idx = parts.index("pull")
        owner = parts[pull_idx - 2]
        repo = parts[pull_idx - 1]
        pr_number = parts[pull_idx + 1]
    except Exception as e:
        print(f"Error parsing PR URL '{pr_url}'. Ensure it follows https://github.com/owner/repo/pull/123")
        sys.exit(1)
        
    try:
        result = run_review(owner, repo, pr_number)
        print(result)
    except Exception as e:
        print(f"Error reviewing PR: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
