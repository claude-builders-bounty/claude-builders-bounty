{
  "name": "Weekly GitHub Activity Summary",
  "nodes": [
    {
      "parameters": {
        "cronExpression": "0 17 * * 5"
      },
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.github.com/repos/{{ $json[\"repoOwner\"] }}/{{ $json[\"repoName\"] }}/commits",
        "options": {},
        "queryParametersUi": {
          "parameter": [
            {
              "name": "since",
              "value": "={{$moment().startOf('isoWeek').subtract(7, 'days').toISOString()}}"
            },
            {
              "name": "until",
              "value": "={{$moment().endOf('isoWeek').toISOString()}}"
            }
          ]
        },
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $json[\"githubToken\"] }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        }
      },
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.github.com/repos/{{ $json[\"repoOwner\"] }}/{{ $json[\"repoName\"] }}/issues",
        "options": {},
        "queryParametersUi": {
          "parameter": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{$moment().startOf('isoWeek').subtract(7, 'days').toISOString()}}"
            },
            {
              "name": "until",
              "value": "={{$moment().endOf('isoWeek').toISOString()}}"
            }
          ]
        },
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $json[\"githubToken\"] }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        }
      },
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        500,
        350
      ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.github.com/repos/{{ $json[\"repoOwner\"] }}/{{ $json[\"repoName\"] }}/pulls",
        "options": {},
        "queryParametersUi": {
          "parameter": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
