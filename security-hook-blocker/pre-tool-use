#!/usr/bin/env python3
"""
Claude Code Pre-Tool-Use Hook: Block Destructive Commands
Intercepts dangerous bash commands before execution.
"""

import json
import sys
import re
import os
from datetime import datetime
from pathlib import Path

# Dangerous patterns to block
DANGEROUS_PATTERNS = [
    # File deletion
    (r'rm\s+-rf\s+', 'rm -rf (recursive force delete)'),
    (r'rm\s+-fr\s+', 'rm -fr (recursive force delete)'),
    (r'rm\s+.*-.*r.*f', 'rm with -rf flags'),
    
    # Database operations
    (r'DROP\s+TABLE', 'DROP TABLE (database table deletion)'),
    (r'DROP\s+DATABASE', 'DROP DATABASE (database deletion)'),
    (r'TRUNCATE\s+TABLE', 'TRUNCATE TABLE (delete all rows)'),
    (r'TRUNCATE\s+', 'TRUNCATE (delete all data)'),
    
    # DELETE without WHERE clause
    (r'DELETE\s+FROM\s+\w+\s*;', 'DELETE FROM without WHERE clause'),
    (r'DELETE\s+FROM\s+\w+\s*$', 'DELETE FROM without WHERE clause (EOL)'),
    
    # Git force operations
    (r'git\s+push\s+.*--force', 'git push --force'),
    (r'git\s+push\s+.*-f\b', 'git push -f'),
    
    # File overwrites
    (r'>\s*/dev/sd[a-z]', 'write to disk device'),
    (r'dd\s+if=.*of=/dev/', 'dd to disk device'),
    
    # System modification
    (r'chmod\s+777', 'chmod 777 (insecure permissions)'),
    (r'sudo\s+rm\s+-rf\s+/', 'sudo rm -rf /'),
]

def get_log_path():
    """Get the blocked commands log path."""
    home = Path.home()
    hook_dir = home / '.claude' / 'hooks'
    hook_dir.mkdir(parents=True, exist_ok=True)
    return hook_dir / 'blocked.log'

def log_blocked_command(tool_name, command, pattern_match, project_path):
    """Log blocked command to file."""
    log_path = get_log_path()
    timestamp = datetime.now().isoformat()
    
    log_entry = {
        'timestamp': timestamp,
        'tool': tool_name,
        'command': command,
        'reason': pattern_match,
        'project_path': project_path
    }
    
    with open(log_path, 'a') as f:
        f.write(json.dumps(log_entry) + '\n')

def check_command(command):
    """Check if command contains dangerous patterns."""
    for pattern, description in DANGEROUS_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return description
    return None

def main():
    # Read hook input from stdin
    try:
        hook_data = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        sys.exit(0)  # Silently allow if we can't parse input
    
    tool_name = hook_data.get('tool', '')
    params = hook_data.get('params', {})
    project_path = os.getcwd()
    
    # Only check bash/exec tools
    if tool_name.lower() not in ['bash', 'exec', 'execute', 'shell']:
        sys.exit(0)  # Allow non-bash tools
    
    # Get the command to execute
    command = params.get('command', '') or params.get('cmd', '')
    
    if not command:
        sys.exit(0)  # No command, allow
    
    # Check for dangerous patterns
    blocked_reason = check_command(command)
    
    if blocked_reason:
        # Log the blocked attempt
        log_blocked_command(tool_name, command, blocked_reason, project_path)
        
        # Return error message to Claude
        error_message = {
            'error': 'COMMAND_BLOCKED',
            'message': f"""🚫 **Security Hook: Command Blocked**

The following command was blocked for safety:

```bash
{command}
```

**Reason:** {blocked_reason}

**What happened:**
- This command matches a known destructive pattern
- The attempt was logged to: {get_log_path()}
- Project path: {project_path}

**What to do:**
- If this is intentional, review the command carefully
- Consider using safer alternatives (e.g., `git push` without --force)
- For file deletion, use specific paths instead of wildcards
- For database operations, always include WHERE clauses

**To override this hook:**
Run the command manually in your terminal or disable the hook temporarily by renaming:
`~/.claude/hooks/pre-tool-use` → `~/.claude/hooks/pre-tool-use.disabled`
"""
        }
        
        print(json.dumps(error_message))
        sys.exit(1)  # Block execution
    
    sys.exit(0)  # Allow execution

if __name__ == '__main__':
    main()
