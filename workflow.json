{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 17
            }
          ]
        },
        "triggerOn": "custom",
        "eventTriggerType": "schedule",
        "id": "schedule"
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$json.GITHUB_API_URL}}/repos/{{$json.OWNER}}/{{$json.REPO}}/commits",
        "options": {
          "timeout": 10000
        },
        "id": "get-commits"
      },
      "id": "get-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{$json.GITHUB_API_URL}}/repos/{{$json.OWNER}}/{{$json.REPO}}/issues",
        "options": {
          "timeout": 10000
        },
        "id": "get-issues"
      },
      "id": "get-issues",
      "name": "Get Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 450]
    },
    {
      "parameters": {
        "url": "={{$json.GITHUB_API_URL}}/repos/{{$json.OWNER}}/{{$json.REPO}}/pulls",
        "options": {
          "timeout": 10000
        },
        "id": "get-prs"
      },
      "id": "get-prs",
      "name": "Get Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 600]
    },
    {
      "parameters": {
        "operation": "append",
        "options": {}
      },
      "id": "aggregate-data",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [650, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$credentials.anthropicApiKey}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20241022"
            },
            {
              "name": "max_tokens",
              "value": 1024
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"{{$json.dev_summary_prompt}}\"}]"
            }
          ]
        },
        "id": "generate-summary"
      },
      "id": "claude-summary",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 450]
    },
    {
      "parameters": {
        "webhook": "={{$json.DISCORD_WEBHOOK_URL}}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json.summary}}"
            }
          ]
        },
        "id": "discord-notify"
      },
      "id": "discord",
      "name": "Discord Notify",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "webhook": "={{$json.SLACK_WEBHOOK_URL}}",
        "text": "={{$json.summary}}",
        "id": "slack-notify"
      },
      "id": "slack",
      "name": "Slack Notify",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 3,
      "position": [1050, 450]
    },
    {
      "parameters": {
        "fromEmail": "={{$json.EMAIL_FROM}}",
        "toEmail": "={{$json.EMAIL_TO}}",
        "subject": "Weekly Dev Summary - {{$json.WEEK}}",
        "text": "={{$json.summary}}",
        "id": "email-notify"
      },
      "id": "email",
      "name": "Email Notify",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1050, 600]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Pull Requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Aggregate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Issues": {
      "main": [
        [
          {
            "node": "Aggregate Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Get Pull Requests": {
      "main": [
        [
          {
            "node": "Aggregate Data",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Aggregate Data": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Discord Notify",
            "type": "main",
            "index": 0
          },
          {
            "node": "Slack Notify",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1",
  "id": "n8n-weekly-report",
  "tags": []
}