{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyWeek",
              "hour": 17,
              "minute": 0
            }
        ]
      },
      "name": "Friday 5PM Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node['Set Date Range'].json.endOfWeek}}",
        "options": {
          "splitIntoBatches": {}
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [450, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node['Set Date Range'].json.endOfWeek}}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "GitHub Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node['Set Date Range'].json.endOfWeek}}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "GitHub Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "message": [
            {
              "role": "system",
              "message": "You are a technical writer generating weekly dev summaries. Write a narrative summary (3-4 paragraphs) of the week's GitHub activity. Include highlights, notable changes, and overall progress."
            },
            {
              "role": "user",
              "message": "Generate a weekly summary for {{$node['Set Variables'].json.repo}}.\n\nCommits:\n{{$node['GitHub Commits'].json}}\n\nClosed Issues:\n{{$node['GitHub Closed Issues'].json}}\n\nMerged PRs:\n{{$node['GitHub Merged PRs'].json}}\n\nWrite in {{$node['Set Variables'].json.language}}."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 1000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "apiKey"
      },
      "name": "Claude API",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [650, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node['Set Variables'].json.webhookUrl}}",
        "body": {
          "content": "={{$node['Claude API'].json.content[0].text}}",
          "username": "Weekly Dev Bot",
          "avatar_url": "https://avatars.githubusercontent.com/u/123456?v=4"
        },
        "options": {},
        "authentication": "none"
      },
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo",
              "value": "claude-builders-bounty/claude-builders-bounty"
            },
            {
              "name": "webhookUrl",
              "value": "https://discord.com/api/webhooks/..."
            },
            {
              "name": "language",
              "value": "EN"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "startOfWeek",
              "value": "={{DateTime.fromFormat(Date.now().toString(), 'x').minus({days: 7}).toFormat('yyyy-MM-dd')}}"
            },
            {
              "name": "endOfWeek",
              "value": "={{DateTime.fromFormat(Date.now().toString(), 'x').toFormat('yyyy-MM-dd')}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Date Range",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [250, 200]
    }
  ],
  "connections": {
    "Friday 5PM Cron": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "Set Date Range",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Date Range": {
      "main": [
        [
          {
            "node": "GitHub Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Commits": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Closed Issues": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Merged PRs": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "weekly-dev-summary"
}