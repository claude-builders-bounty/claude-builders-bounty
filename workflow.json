{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "value": 1,
              "weekday": "5",
              "hour": 17
            }
          ]
        }
      },
      "id": "cron_trigger",
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$node[\"Config\"].json[\"repo\"]}}/commits",
        "options": {
          "queryParameters": {
            "since": "={{ $now.minus({days: 7}).toISO() }}"
          }
        }
      },
      "id": "github_commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$node[\"Config\"].json[\"repo\"]}}/pulls?state=closed",
        "options": {
          "queryParameters": {
            "per_page": "100"
          }
        }
      },
      "id": "github_prs",
      "name": "Fetch PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 450]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20240620",
        "prompt": "=Please analyze the following GitHub activity and create a narrative weekly summary in {{$node[\"Config\"].json[\"language\"]}}.\n\nCommits: {{$node[\"Fetch Commits\"].json}}\n\nMerged PRs: {{$node[\"Fetch PRs\"].json}}\n\nFocus on the a-ha moments and technical wins. Format as a professional update for stakeholders.",
        "options": {}
      },
      "id": "claude_ai",
      "name": "Claude AI Summary",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [600, 375]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node[\"Config\"].json[\"webhook_url\"]}}",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{$node[\"Claude AI Summary\"].json[\"text\"]}}"
            }
          ]
        }
      },
      "id": "delivery_webhook",
      "name": "Discord/Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [800, 375]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo",
              "value": "owner/repo"
            },
            {
              "name": "webhook_url",
              "value": "https://webhook.site/your-id"
            },
            {
              "name": "language",
              "value": "EN"
            }
          ]
        }
      },
      "id": "config_node",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [100, 150]
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Claude AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch PRs": {
      "main": [
        [
          {
            "node": "Claude AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude AI Summary": {
      "main": [
        [
          {
            "node": "Discord/Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
