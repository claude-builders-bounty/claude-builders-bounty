{
  "name": "Weekly Dev Summary (AAP)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/user/repos?sort=pushed",
        "authentication": "genericCredentialType",
        "nodeCredentialType": "githubApi"
      },
      "name": "GitHub repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4",
        "messages": [
          {
            "role": "system",
            "content": "你是周报助手, 把本周 commits 汇总成中文开发总结."
          },
          {
            "role": "user",
            "content": "={{ $json.body }}"
          }
        ]
      },
      "name": "Claude summary",
      "type": "n8n-nodes-base.lmChatClaude",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "subject": "本周开发总结",
        "text": "={{ $json.text }}"
      },
      "name": "Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "GitHub repos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub repos": {
      "main": [
        [
          {
            "node": "Claude summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude summary": {
      "main": [
        [
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}