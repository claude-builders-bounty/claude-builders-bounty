      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "fetch-prs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "name": "Fetch merged PRs (7d)",
      "position": [
        -460,
        140
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WEEKLY_SUMMARY_PRS_URL || 'https://api.github.com/repos/OWNER/REPO/pulls?state=closed&sort=updated&direction=desc&per_page=30' }}",
        "sendHeaders": true,
        "options": {
          "timeout": 60000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN || '' }}"
            },
            {
              "name": "Accept",
