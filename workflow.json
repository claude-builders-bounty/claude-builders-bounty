{
  "name": "Weekly Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.github.com/repos/{{$json.repo}}/events",
        "options": {}
      },
      "name": "Fetch GitHub Activity",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "Summarize this activity: {{$json.data}} in {{$json.language}}",
        "authentication": "headerAuth"
      },
      "name": "Claude Sonnet",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "url": "{{$json.discordWebhook}}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "{{$json.summary}}"
            }
          ]
        }
      },
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        600,
        0
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Fetch GitHub Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch GitHub Activity": {
      "main": [
        [
          {
            "node": "Claude Sonnet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Sonnet": {
      "main": [
        [
          {
            "node": "Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}