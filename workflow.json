{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "type": "cron",
          "value": "0 17 * * 5"
        }
      },
      "id": "trigger",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "owner", "value": "claude-builders-bounty" },
            { "name": "repo", "value": "claude-builders-bounty" },
            { "name": "language", "value": "EN" },
            { "name": "webhook_url", "value": "YOUR_DISCORD_WEBHOOK_URL" }
          ]
        }
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [200, 0]
    },
    {
      "parameters": {
        "owner": "={{$json.owner}}",
        "repository": "={{$json.repo}}",
        "resource": "commit",
        "operation": "getAll",
        "since": "={{new Date(new Date().setDate(new Date().getDate() - 7)).toISOString()}}"
      },
      "id": "github-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [400, -200]
    },
    {
      "parameters": {
        "owner": "={{$node['Config'].json.owner}}",
        "repository": "={{$node['Config'].json.repo}}",
        "resource": "issue",
        "operation": "getAll",
        "state": "closed",
        "since": "={{new Date(new Date().setDate(new Date().getDate() - 7)).toISOString()}}"
      },
      "id": "github-issues",
      "name": "Get Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [400, 0]
    },
    {
      "parameters": {
        "owner": "={{$node['Config'].json.owner}}",
        "repository": "={{$node['Config'].json.repo}}",
        "resource": "pullRequest",
        "operation": "getAll",
        "state": "closed"
      },
      "id": "github-prs",
      "name": "Get PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [400, 200]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "commits", "value": "={{$node['Get Commits'].json}}" },
            { "name": "issues", "value": "={{$node['Get Issues'].json}}" },
            { "name": "prs", "value": "={{$node['Get PRs'].json}}" },
            { "name": "language", "value": "={{$node['Config'].json.language}}" },
            { "name": "webhook_url", "value": "={{$node['Config'].json.webhook_url}}" }
          ]
        }
      },
      "id": "aggregate",
      "name": "Aggregate",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "prompt": "Write a weekly narrative summary of this repo activity in {{$json.language}}:\n\nCommits: {{$json.commits}}\nIssues: {{$json.issues}}\nPRs: {{$json.prs}}\n\nWrite a friendly summary for the team."
      },
      "id": "claude",
      "name": "Claude",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [800, 0]
    },
    {
      "parameters": {
        "url": "={{$node['Aggregate'].json.webhook_url}}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "content", "value": "={{$json.text}}" }
          ]
        }
      },
      "id": "discord",
      "name": "Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1000, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          { "node": "Config", "type": "main", "index": 0 }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          { "node": "Get Commits", "type": "main", "index": 0 },
          { "node": "Get Issues", "type": "main", "index": 0 },
          { "node": "Get PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          { "node": "Aggregate", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Issues": {
      "main": [
        [
          { "node": "Aggregate", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get PRs": {
      "main": [
        [
          { "node": "Aggregate", "type": "main", "index": 0 }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          { "node": "Claude", "type": "main", "index": 0 }
        ]
      ]
    },
    "Claude": {
      "main": [
        [
          { "node": "Discord", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
