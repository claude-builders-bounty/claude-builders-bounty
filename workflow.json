{
  "name": "Weekly Dev Summary (n8n + Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "functionCode": "const now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst formatDate = (d) => d.toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    dateFrom: formatDate(sevenDaysAgo),\n    dateTo: formatDate(now),\n    since: sevenDaysAgo.toISOString(),\n    now: now.toISOString(),\n    weekLabel: `${formatDate(sevenDaysAgo)} → ${formatDate(now)}`\n  }\n}];"
      },
      "id": "calc-date",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $vars.GITHUB_REPO }}/commits",
