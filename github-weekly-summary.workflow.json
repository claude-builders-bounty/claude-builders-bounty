{
  "name": "GitHub Weekly Narrative Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 17 * * 5" }]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst since = new Date(now - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    owner: $env.GITHUB_OWNER || 'your-org',\n    repo:  $env.GITHUB_REPO  || 'your-repo',\n    since: since.toISOString(),\n    until: now.toISOString()\n  }\n}];"
      },
      "id": "set-window",
      "name": "Set Date Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "since", "value": "={{$json.since}}" },
            { "name": "until", "value": "={{$json.until}}" },
            { "name": "per_page", "value": "100" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" },
            { "name": "User-Agent", "value": "n8n-weekly-summary" }
          ]
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 180]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$('Set Date Window').item.json.owner}}/{{$('Set Date Window').item.json.repo}}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "state",    "value": "closed" },
            { "name": "since",   "value": "={{$('Set Date Window').item.json.since}}" },
            { "name": "per_page","value": "50" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" },
            { "name": "User-Agent", "value": "n8n-weekly-summary" }
          ]
        }
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$('Set Date Window').item.json.owner}}/{{$('Set Date Window').item.json.repo}}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "state",    "value": "closed" },
            { "name": "per_page","value": "50" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" },
            { "name": "User-Agent", "value": "n8n-weekly-summary" }
          ]
        }
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "jsCode": "const commits = $('Fetch Commits').all().flatMap(i => i.json).slice(0, 30);\nconst issues  = $('Fetch Closed Issues').all().flatMap(i => i.json).filter(i => !i.pull_request).slice(0, 20);\nconst prs     = $('Fetch Merged PRs').all().flatMap(i => i.json).filter(p => p.merged_at).slice(0, 20);\n\nconst window = $('Set Date Window').first().json;\n\nconst commitLines = commits.map(c => `- ${c.commit?.message?.split('\\n')[0]} (@${c.author?.login || 'unknown'})`).join('\\n');\nconst issueLines  = issues.map(i => `- #${i.number} ${i.title}`).join('\\n');\nconst prLines     = prs.map(p => `- #${p.number} ${p.title} by @${p.user?.login}`).join('\\n');\n\nconst prompt = `You are a technical writer. Write a concise, engaging weekly summary for a software team.\n\nPeriod: ${window.since.slice(0,10)} to ${window.until.slice(0,10)}\nRepository: ${window.owner}/${window.repo}\n\nCOMMITS THIS WEEK (${commits.length}):\n${commitLines || '(none)'}\n\nCLOSED ISSUES (${issues.length}):\n${issueLines || '(none)'}\n\nMERGED PULL REQUESTS (${prs.length}):\n${prLines || '(none)'}\n\nWrite a narrative summary (3-5 paragraphs) highlighting:\n1. Key features/fixes shipped\n2. Notable contributors\n3. Open challenges or next priorities\n\nTone: professional but friendly, like a Friday team update.`;\n\nreturn [{ json: { prompt, stats: { commits: commits.length, issues: issues.length, prs: prs.length }, window } }];"
      },
      "id": "build-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model",      "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": "1024" },
            { "name": "messages",   "value": "=[{\"role\":\"user\",\"content\":\"{{$json.prompt}}\"}]" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key",          "value": "={{$env.ANTHROPIC_API_KEY}}" },
            { "name": "anthropic-version",  "value": "2023-06-01" },
            { "name": "content-type",       "value": "application/json" }
          ]
        }
      },
      "id": "call-claude",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "const summary = $json.content?.[0]?.text || 'No summary generated.';\nconst stats   = $('Build Claude Prompt').first().json.stats;\nconst window  = $('Build Claude Prompt').first().json.window;\nconst repo    = `${window.owner}/${window.repo}`;\nconst dateStr = window.until.slice(0,10);\n\nreturn [{ json: {\n  subject: `📊 Weekly Summary — ${repo} — ${dateStr}`,\n  body: `**Weekly Activity Report**\\n**Repo:** ${repo}\\n**Period:** ${window.since.slice(0,10)} → ${dateStr}\\n**Stats:** ${stats.commits} commits | ${stats.issues} issues closed | ${stats.prs} PRs merged\\n\\n---\\n\\n${summary}`,\n  summary\n}}];"
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "webhookUri": "={{$env.DISCORD_WEBHOOK_URL}}",
        "text": "={{$json.subject}}\\n\\n{{$json.body.slice(0, 1900)}}"
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": { "main": [[{ "node": "Set Date Window",    "type": "main", "index": 0 }]] },
    "Set Date Window":          { "main": [[{ "node": "Fetch Commits",       "type": "main", "index": 0 },
                                            { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
                                            { "node": "Fetch Merged PRs",    "type": "main", "index": 0 }]] },
    "Fetch Commits":            { "main": [[{ "node": "Build Claude Prompt", "type": "main", "index": 0 }]] },
    "Fetch Closed Issues":      { "main": [[{ "node": "Build Claude Prompt", "type": "main", "index": 0 }]] },
    "Fetch Merged PRs":         { "main": [[{ "node": "Build Claude Prompt", "type": "main", "index": 0 }]] },
    "Build Claude Prompt":      { "main": [[{ "node": "Call Claude API",     "type": "main", "index": 0 }]] },
    "Call Claude API":          { "main": [[{ "node": "Format Output",       "type": "main", "index": 0 }]] },
    "Format Output":            { "main": [[{ "node": "Send to Discord",     "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "name": "github" }, { "name": "weekly-summary" }, { "name": "claude" }]
}
