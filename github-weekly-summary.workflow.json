{
  "name": "GitHub Weekly Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "dayOfWeek",
              "intervalValue": 1
            }
          ]
        },
        "timezone": "UTC"
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "repository": "={{ $env.GITHUB_REPO }}",
        "owner": "={{ $env.GITHUB_OWNER }}",
        "additionalFields": {
          "since": "={{ $now.minus({ days: 7 }).toISOString() }}"
        }
      },
      "name": "Get Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [200, 0],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "GitHub API"
        }
      }
    },
    {
      "parameters": {
        "prompt": "=Summarize this week's GitHub activity:\n\nCommits: {{ $json.commits | json }}\nIssues Closed: {{ $json.issues | json }}\nPRs Merged: {{ $json.prs | json }}\n\nGenerate a concise narrative summary in {{ $env.LANGUAGE || 'English' }}.",
        "options": {
          "systemMessage": "You are a helpful assistant that summarizes GitHub activity."
        }
      },
      "name": "Claude Summary",
      "type": "@anthropic/claude-code",
      "typeVersion": 1,
      "position": [400, 0],
      "credentials": {
        "anthropicApi": {
          "id": "1",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "embeds",
              "value": "=[{\"title\": \"Weekly GitHub Summary\", \"description\": {{ $json.output | json }}, \"color\": 5814783}]"
            }
          ]
        },
        "options": {}
      },
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [600, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Commits": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
