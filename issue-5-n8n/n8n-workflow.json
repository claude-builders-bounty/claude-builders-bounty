{
  "name": "Weekly Dev Summary via Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "e0e37bc9-53e7-4b68-ab50-9c17abfbb1b9",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "repository",
        "operation": "getIssues",
        "owner": "={{ $json.repoOwner }}",
        "repository": "={{ $json.repoName }}",
        "state": "closed",
        "since": "={{ $today.minus({days: 7}).toISO() }}"
      },
      "id": "c1f7a8b3-3a0c-4e5a-9f7e-12ab34cd56ef",
      "name": "GitHub (Get Issues/PRs)",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "githubOAuth2Api": {
          "id": "github1",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20240620",
        "prompt": "={{ 'You are an engineering manager. Write a concise narrative summary of this week\\'s development activity for our team in ' + $json.language + '. Activity data: ' + JSON.stringify($json.data) }}"
      },
      "id": "b8a9c1d2-7e8f-4b3c-9a1b-3456789abcde",
      "name": "Anthropic (Claude)",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "anthropicApi": {
          "id": "anthropic1",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "webhookUri": "={{ $json.discordWebhookUrl }}",
        "text": "={{ $json.text }}",
        "username": "Weekly Dev Summary Bot"
      },
      "id": "d9e8f7a6-5b4c-3d2e-1f0a-987654321fed",
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "GitHub (Get Issues/PRs)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub (Get Issues/PRs)": {
      "main": [
        [
          {
            "node": "Anthropic (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic (Claude)": {
      "main": [
        [
          {
            "node": "Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
