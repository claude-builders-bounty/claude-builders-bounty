{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtHour": 17,
              "triggerAtDay": 5
            }
          ]
        }
      },
      "id": "schedule-node",
      "name": "Weekly Schedule (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -480,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "repo",
              "value": "Scottcjn/Rustchain",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "language",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "webhook_url",
              "value": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config-node",
      "name": "Config (repo, language, channel)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -240,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $('Config (repo, language, channel)').first().json.repo + '/commits?since=' + $json.week_start + 'T00:00:00Z&per_page=100' }}",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "name": "User-Agent",
                "value": "weekly-dev-summary"
              }
            ]
          }
        }
      },
      "id": "commits-node",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        140
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "commits"
      },
      "id": "aggregate-commits",
      "name": "Aggregate Commits",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        240,
        140
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $('Config (repo, language, channel)').first().json.repo + '/issues?state=closed&since=' + $json.week_start + 'T00:00:00Z&per_page=100' }}",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "name": "User-Agent",
                "value": "weekly-dev-summary"
              }
            ]
          }
        }
      },
      "id": "issues-node",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.pull_request }}",
              "rightValue": null,
              "operator": {
                "type": "object",
                "operation": "notExists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-issues",
      "name": "Filter Out PRs",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "closed_issues"
      },
      "id": "aggregate-issues",
      "name": "Aggregate Issues",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $('Config (repo, language, channel)').first().json.repo + '/pulls?state=closed&sort=updated&direction=desc&per_page=100' }}",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "name": "User-Agent",
                "value": "weekly-dev-summary"
              }
            ]
          }
        }
      },
      "id": "pulls-node",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.merged_at }}",
              "rightValue": null,
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-merged",
      "name": "Keep Merged Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "merged_prs"
      },
      "id": "aggregate-prs",
      "name": "Aggregate PRs",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        480,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config (repo, language, channel)').first().json;\nconst weekAgo = new Date(Date.now() - 7 * 86400000).toISOString();\nconst commits = ($input.first().json.commits || []).filter(c => (c.commit?.committer?.date || '') >= weekAgo);\nconst issues = ($input.first().json.closed_issues || []).filter(i => (i.closed_at || '') >= weekAgo);\nconst prs = ($input.first().json.merged_prs || []).filter(p => (p.merged_at || '') >= weekAgo);\nconst authors = [...new Set(commits.map(c => c.commit?.author?.name).filter(Boolean))];\n\nreturn [{\n  json: {\n    repo: cfg.repo,\n    language: cfg.language,\n    webhook_url: cfg.webhook_url,\n    week_start: weekAgo.slice(0, 10),\n    commits_count: commits.length,\n    issues_closed: issues.length,\n    prs_merged: prs.length,\n    authors: authors.join(', '),\n    commit_subjects: commits.slice(0, 15).map(c => (c.commit?.message || '').split('\\n')[0]),\n    issue_titles: issues.slice(0, 15).map(i => i.title),\n    pr_titles: prs.slice(0, 15).map(p => p.title),\n  }\n}];"
      },
      "id": "shape-node",
      "name": "Shape Week Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-sonnet-4-20250514',\n  max_tokens: 1024,\n  messages: [{\n    role: 'user',\n    content: 'Write a concise narrative summary of this GitHub repository week (language: ' + $json.language + '):\\n' + JSON.stringify({\n      repo: $json.repo,\n      week_start: $json.week_start,\n      commits: $json.commits_count,\n      issues_closed: $json.issues_closed,\n      prs_merged: $json.prs_merged,\n      authors: $json.authors,\n      commit_subjects: $json.commit_subjects,\n      issue_titles: $json.issue_titles,\n      pr_titles: $json.pr_titles\n    })\n  }]\n}) }}",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "anthropic-version",
                "value": "2023-06-01"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "claude-node",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst text = r.content?.[0]?.text || JSON.stringify(r).slice(0, 2000);\nreturn [{ json: { summary: text, delivered_at: new Date().toISOString() } }];"
      },
      "id": "extract-node",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (repo, language, channel)').first().json.webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.summary }) }}",
        "options": {}
      },
      "id": "discord-node",
      "name": "Deliver via Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {},
      "id": "manual-node",
      "name": "Manual Trigger (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -480,
        120
      ]
    }
  ],
  "connections": {
