{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [100, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cron",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "github-commits",
      "name": "Get Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [340, 100],
      "parameters": {
        "url": "={{$env.GITHUB_API_URL}}/repos/={{$vars.REPO}}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.weekStart}}"
            },
            {
              "name": "until",
              "value": "={{$json.weekEnd}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "GitHub API"
        }
      }
    },
    {
      "id": "github-issues",
      "name": "Get Weekly Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [340, 300],
      "parameters": {
        "url": "={{$env.GITHUB_API_URL}}/repos/={{$vars.REPO}}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{$json.weekStart}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "GitHub API"
        }
      }
    },
    {
      "id": "github-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [340, 500],
      "parameters": {
        "url": "={{$env.GITHUB_API_URL}}/repos/={{$vars.REPO}}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "base",
              "value": "main"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "GitHub API"
        }
      }
    },
    {
      "id": "claude-summary",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [620, 300],
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a senior developer writing a weekly narrative summary of a repo's activity. Format with ## Added, ## Fixed, ## Changed, ## Removed sections. Keep it concise and informative."
            },
            {
              "role": "user",
              "content": "Write a weekly dev summary for repo {{$vars.REPO}} covering the period {{$vars.WEEK_START}} to {{$vars.WEEK_END}}.\n\nCommits:\n{{$json.commits}}\n\nClosed Issues:\n{{$json.issues}}\n\nMerged PRs:\n{{$json.prs}}"
            }
          ]
        },
        "options": {
          "maxTokens": 1000,
          "temperature": 0.7
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "Claude API"
        }
      }
    },
    {
      "id": "discord-webhook",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [900, 300],
      "parameters": {
        "webhook": {
          "id": "={{$vars.DISCORD_WEBHOOK_ID}}",
          "name": "={{$vars.DISCORD_WEBHOOK_NAME}}"
        },
        "text": "={{$json.summary}}",
        "options": {}
      }
    }
  ],
  "connections": {
    "cron-trigger": {
      "main": [
        [
          {
            "node": "github-commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "github-issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "github-prs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "github-commits": {
      "main": [
        [
          {
            "node": "claude-summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "github-issues": {
      "main": [
        []
      ]
    },
    "github-prs": {
      "main": [
        []
      ]
    },
    "claude-summary": {
      "main": [
        [
          {
            "node": "discord-webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "meta": {
    "templateCredsSetupCompleted": false,
    "templateId": "weekly-dev-summary"
  }
}
