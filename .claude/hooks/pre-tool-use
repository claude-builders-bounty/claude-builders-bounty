#!/usr/bin/env python3
import sys
import os
import re
from datetime import datetime

def log_blocked(command):
    log_dir = os.path.expanduser("~/.claude/hooks/")
    os.makedirs(log_dir, exist_ok=True)
    log_file = os.path.join(log_dir, "blocked.log")
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(log_file, "a") as f:
        f.write(f"[{timestamp}] Blocked command: {command}\n")

def contains_destructive_command(command):
    """
    Check if the command string contains destructive patterns:
    - rm -rf
    - DROP TABLE (case-insensitive)
    - git push --force
    - TRUNCATE (case-insensitive)
    - DELETE FROM without a WHERE clause (case-insensitive)
    """
    cmd_lower = command.lower()

    # Check rm -rf (allow any spacing between rm and -rf)
    if re.search(r"\brm\s+-rf\b", command):
        return True

    # Check DROP TABLE (case-insensitive)
    if re.search(r"\bdrop\s+table\b", cmd_lower):
        return True

    # Check git push --force (allow variations of force like -f or --force)
    if re.search(r"\bgit\s+push\s+--?force\b", command):
        return True

    # Check TRUNCATE (case-insensitive)
    if re.search(r"\btruncate\b", cmd_lower):
        return True

    # Check DELETE FROM without WHERE clause (case-insensitive)
    # Rough heuristic: if "delete from" is present but no "where" after it in the same command
    delete_match = re.search(r"\bdelete\s+from\b", cmd_lower)
    if delete_match:
        after_delete = cmd_lower[delete_match.end():]
        # If no "where" found after delete from
        if "where" not in after_delete:
            return True

    return False
