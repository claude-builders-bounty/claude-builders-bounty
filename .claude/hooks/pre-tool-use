#!/usr/bin/env python3
import json
import os
import re
import sys
from datetime import datetime, timezone


def parse_command(payload):
    command = ""
    tool_input = payload.get("tool_input", {})
    for key in ("command", "cmd", "arguments"):
        if isinstance(tool_input, dict) and key in tool_input:
            command = tool_input.get(key, "").strip()
            break
    if not command:
        if isinstance(tool_input, dict):
            prompt_args = tool_input.get("code") or tool_input.get("input") or ""
            if isinstance(prompt_args, str):
                command = prompt_args.strip()
        if not command:
            command = (payload.get("command") or "").strip()
            if not command and isinstance(payload.get("input"), str):
                command = payload.get("input", "").strip()

    return command


def is_blocked_command(command):
    lower = command.lower()
    if re.search(r"\brm\s+-rf\b", lower):
        return "rm -rf"
    if re.search(r"\bgit\s+push\s+--force\b", lower):
        return "git push --force"
    if re.search(r"\bdrop\s+table\b", lower):
        return "DROP TABLE"
    if re.search(r"\btruncate\b", lower):
        return "TRUNCATE"

    # Block DELETE FROM statements without WHERE clause.
    statements = re.split(r"[;\n]", lower)
    for statement in statements:
        if re.search(r"\bdelete\s+from\b", statement) and "where" not in statement:
            return "DELETE FROM (without WHERE)"

    return ""


def log_block(project_path, command, reason, log_path):
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    timestamp = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    with open(log_path, "a", encoding="utf-8") as log_file:
        log_file.write(f"{timestamp} | path={project_path} | reason={reason} | command={command}\n")


def main():
    raw_input = sys.stdin.read().strip()
    payload = {}
    if raw_input:
        try:
            payload = json.loads(raw_input)
        except json.JSONDecodeError:
            payload["command"] = raw_input

    command = parse_command(payload)
    if not command:
        return 0

    reason = is_blocked_command(command)
    if not reason:
        return 0

    project_path = payload.get("cwd") or os.getcwd()
    log_path = os.path.expanduser("~/.claude/hooks/blocked.log")
    log_block(project_path, command, reason, log_path)

    print(f"Blocked: {reason} pattern detected in command: {command}", file=sys.stdout)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
