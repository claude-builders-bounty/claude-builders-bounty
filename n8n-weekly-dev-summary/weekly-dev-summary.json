      "id": "c1a1f0d2-1111-4a01-9a01-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -340,
        20
      ],
      "notes": "Everything the workflow needs. Replace the two tokens and the webhook, or point the fields at n8n Variables."
    },
    {
      "parameters": {
        "jsCode": "// Set-node assignments are evaluated against the node input, so `sinceDay: {{ $json.since }}`\n// resolved to an empty string and GitHub rejected the search query with HTTP 422.\n// Computing all window fields here keeps one source of truth.\nconst days = Number($json.days ?? 7);\nconst end = new Date();\nconst start = new Date(end.getTime() - days * 24 * 60 * 60 * 1000);\nconst day = (d) => d.toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    ...$json,\n    since: start.toISOString(),\n    sinceDay: day(start),\n    untilDay: day(end),\n    periodLabel: `${day(start)} to ${day(end)}`,\n  },\n}];"
      },
      "id": "c1a1f0d2-1111-4a01-9a01-000000000004",
      "name": "Reporting Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        20
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/commits",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "c1a1f0d2-1111-4a01-9a01-000000000005",
      "name": "GitHub: Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        -160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/issues",
