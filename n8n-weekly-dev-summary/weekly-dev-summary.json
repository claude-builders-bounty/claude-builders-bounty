        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "c1a1f0d2-1111-4a01-9a01-000000000006",
      "name": "GitHub: Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/search/issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{ $json.owner }}/{{ $json.repo }} is:pr is:merged merged:>={{ $json.sinceDay }}"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "c1a1f0d2-1111-4a01-9a01-000000000007",
      "name": "GitHub: Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Collapse the three GitHub responses into one compact digest for Claude.\nconst cfg = $('Config').first().json;\n// A node that produced zero items is not executed at all, so $(name) would throw.\n// Fall back to an empty list instead of failing the whole workflow.\nconst items = (name) => {\n  try {\n    return $(name).all().map((item) => item.json).filter(Boolean);\n  } catch {\n    return [];\n  }\n};\n\nconst commits = items('GitHub: Commits').filter((c) => c.sha);\nconst rawIssues = items('GitHub: Closed Issues').filter((i) => i.number && !i.pull_request);\nconst prs = items('GitHub: Merged PRs').flatMap((r) => r.items || []).filter((p) => p.number);\n\nconst clip = (text, max) => (text || '').replace(/\\s+/g, ' ').trim().slice(0, max);\n\nconst commitLines = commits.slice(0, 60).map((c) => {\n  const message = (c.commit?.message || '').split('\\n')[0];\n  const author = c.author?.login || c.commit?.author?.name || 'unknown';\n  return `- ${message} (${author}, ${c.sha.slice(0, 7)})`;\n});\n\nconst issueLines = rawIssues.slice(0, 40).map((i) =>\n  `- #${i.number} ${clip(i.title, 120)} [${(i.labels || []).map((l) => l.name).join(', ') || 'no labels'}]`\n);\n\nconst prLines = prs.slice(0, 40).map((p) =>\n  `- #${p.number} ${clip(p.title, 120)} (${p.user?.login || 'unknown'})`\n);\n\nconst owner = cfg.owner;\nconst repo = cfg.repo;\nconst period = $('Reporting Window').first().json.periodLabel;\n\nconst digest = [\n  `Repository: ${owner}/${repo}`,\n  `Period: ${period}`,\n  '',\n  `Commits: ${commits.length}`, commitLines.join('\\n') || '- none',\n  '',\n  `Merged pull requests: ${prs.length}`, prLines.join('\\n') || '- none',\n  '',\n  `Closed issues: ${rawIssues.length}`, issueLines.join('\\n') || '- none',\n].join('\\n');\n\nreturn [{\n  json: {\n    digest,\n    hasActivity: commits.length + prs.length + rawIssues.length > 0,\n    counts: { commits: commits.length, pullRequests: prs.length, issues: rawIssues.length },\n    repository: `${owner}/${repo}`,\n    period,\n    language: (cfg.language || 'en').toLowerCase(),\n  },\n}];"
      },
      "id": "c1a1f0d2-1111-4a01-9a01-000000000008",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.anthropicBaseUrl }}/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.anthropicApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, max_tokens: 1200, temperature: 0.3, system: $json.language === 'fr' ? 'Tu es un staff engineer qui ecrit le point hebdomadaire d une equipe. Ecris en francais. Structure: un paragraphe de synthese (3-4 phrases), puis \"Faits marquants\" (3-5 puces), puis \"A surveiller\" (1-3 puces). Sois factuel, cite les numeros de PR et d issue. N invente rien qui ne soit pas dans les donnees. Pas de titre, pas de conclusion.' : 'You are a staff engineer writing the weekly engineering update for a team. Write in English. Structure: one summary paragraph (3-4 sentences), then \"Highlights\" (3-5 bullets), then \"Worth watching\" (1-3 bullets). Be factual, cite PR and issue numbers. Do not invent anything that is not in the data. No title, no sign-off.', messages: [{ role: 'user', content: $json.digest }] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c1a1f0d2-1111-4a01-9a01-000000000009",
      "name": "Claude: Weekly Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        20
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Turn the Anthropic response into a Discord-ready message.\nconst cfg = $('Config').first().json;\nconst digest = $('Build Digest').first().json;\nconst response = $input.first().json;\n\nconst text = (response.content || [])\n  .filter((block) => block.type === 'text')\n  .map((block) => block.text)\n  .join('\\n')\n  .trim();\n\nif (!text) {\n  throw new Error('Claude returned no text block: ' + JSON.stringify(response).slice(0, 400));\n}\n\nconst usage = response.usage || {};\nconst header = `**Weekly update — ${digest.repository}** (${digest.period})\\n` +\n  `_${digest.counts.commits} commits · ${digest.counts.pullRequests} merged PRs · ${digest.counts.issues} closed issues_\\n\\n`;\n\nlet message = header + text;\n// Discord hard-limits a message to 2000 characters.\nif (message.length > 1900) {\n  message = message.slice(0, 1880) + '\\n\\n… (truncated)';\n}\n\nreturn [{\n  json: {\n    message,\n    hasActivity: digest.hasActivity,\n    repository: digest.repository,\n    period: digest.period,\n    tokens: { input: usage.input_tokens || 0, output: usage.output_tokens || 0 },\n  },\n}];"
      },
      "id": "c1a1f0d2-1111-4a01-9a01-00000000000a",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        20
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-activity",
              "leftValue": "={{ $json.hasActivity }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1a1f0d2-1111-4a01-9a01-00000000000b",
      "name": "Has Activity?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1080,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.message, allowed_mentions: { parse: [] } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "c1a1f0d2-1111-4a01-9a01-00000000000c",
      "name": "Discord: Post Summary",
