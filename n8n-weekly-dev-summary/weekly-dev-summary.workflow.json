{
  "name": "Weekly GitHub Developer Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "weekly-cron",
      "name": "Weekly Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const owner = $vars.githubOwner || 'owner';\nconst repo = $vars.githubRepo || 'repo';\nconst language = ($vars.language || 'EN').toUpperCase();\nconst since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\nreturn [{ json: { owner, repo, language, since, slackWebhookUrl: $vars.slackWebhookUrl } }];"
      },
      "id": "setup-window",
      "name": "Setup Repository Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits?since={{$json.since}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        -220
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{$json.owner}}/{{$json.repo}}+is:issue+closed:>={{$json.since}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "id": "github-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{$json.owner}}/{{$json.repo}}+is:pr+merged:>={{$json.since}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "id": "github-merged-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        220
      ]
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "merge-github-results",
      "name": "Merge GitHub Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -20,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst commits = items[0]?.json || [];\nconst issues = items[1]?.json?.items || [];\nconst prs = items[2]?.json?.items || [];\nconst base = $('Setup Repository Window').first().json;\nconst prompt = `Write a weekly developer activity summary in ${base.language}. Use a concise narrative style with sections for momentum, shipped work, fixes, and next-week watch items. Repository: ${base.owner}/${base.repo}. Since: ${base.since}. Commits: ${JSON.stringify(commits.slice(0, 20))}. Closed issues: ${JSON.stringify(issues.slice(0, 20))}. Merged PRs: ${JSON.stringify(prs.slice(0, 20))}.`;\nreturn [{ json: { prompt, slackWebhookUrl: base.slackWebhookUrl } }];"
      },
      "id": "build-claude-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":1200,\"messages\":[{\"role\":\"user\",\"content\":$json.prompt}]}"
      },
      "id": "call-claude",
      "name": "Generate Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Build Claude Prompt').first().json.slackWebhookUrl}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": $json.content[0].text}"
      },
      "id": "send-slack",
      "name": "Send Slack Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        0
      ]
    }
  ],
  "connections": {
    "Weekly Friday 5pm": {
      "main": [
        [
          {
            "node": "Setup Repository Window",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Setup Repository Window": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Merge GitHub Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Merge GitHub Results",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Merge GitHub Results",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Merge GitHub Results": {
      "main": [
        [
          {
            "node": "Build Claude Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Claude Prompt": {
      "main": [
        [
          {
            "node": "Generate Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Claude Summary": {
      "main": [
        [
          {
            "node": "Send Slack Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "weekly-dev-summary-v1"
}
