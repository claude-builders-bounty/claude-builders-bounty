{
  "name": "Weekly Repo Summary (GitHub + Claude)",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "custom",
              "cronExpression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "3ef7ec58-8a2b-452d-90eb-e7f13208af6c",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        -900,
        160
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "repo_owner",
              "value": "={{$env.GITHUB_REPO_OWNER || 'OWNER'}}"
            },
            {
              "name": "repo_name",
              "value": "={{$env.GITHUB_REPO_NAME || 'REPO'}}"
            },
            {
              "name": "webhook_url",
              "value": "={{$env.DESTINATION_WEBHOOK_URL || ''}}"
            },
            {
              "name": "destination_channel",
              "value": "={{$env.DESTINATION_CHANNEL || '#dev-updates'}}"
            },
            {
              "name": "language",
              "value": "={{($env.SUMMARY_LANGUAGE || 'EN').toUpperCase()}}"
            },
            {
              "name": "claude_api_key",
              "value": "={{$env.CLAUDE_API_KEY || ''}}"
            },
            {
              "name": "claude_model",
              "value": "={{$env.CLAUDE_MODEL || 'claude-3-5-sonnet-latest'}}"
            },
            {
              "name": "github_token",
              "value": "={{$env.GITHUB_TOKEN || ''}}"
            }
          ]
        }
      },
      "id": "8df0169d-93f0-4ac3-a4f8-4ce24f7ff585",
      "name": "Set Run Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        -680,
        160
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.repo_owner}}/{{$json.repo_name}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$now.minus({ days: 7 }).toISO()}}"
            },
            {
              "name": "until",
              "value": "={{$now.toISO()}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.github_token}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "f96138ea-30c6-4529-84fd-5864386e3198",
      "name": "Get Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -420,
        20
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.repo_owner}}/{{$json.repo_name}}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{$now.minus({ days: 7 }).toISO()}}"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.github_token}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "0a2fe204-f048-4ecc-bcc3-3795f22f3c9e",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -420,
        160
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.repo_owner}}/{{$json.repo_name}}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.github_token}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "f6f6cb5e-8679-4ec4-8655-daf9f21695bf",
      "name": "Get Closed PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -420,
        300
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "cb4a99ce-0f45-49ec-bc71-67a4b0d87169",
      "name": "Merge Activity 1",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -180,
        120
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "1cd95f2b-c29c-4dd1-bf5f-dd5f5e5db89e",
      "name": "Merge Activity 2",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        40,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Set Run Config').first().json;\nconst now = new Date();\nconst weekStart = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));\n\nconst commits = $('Get Weekly Commits').all().map((item) => item.json);\nconst issuesRaw = $('Get Closed Issues').all().map((item) => item.json);\nconst pullsRaw = $('Get Closed PRs').all().map((item) => item.json);\n\nconst closedIssues = issuesRaw\n  .filter((issue) => !issue.pull_request)\n  .filter((issue) => issue.closed_at)\n  .filter((issue) => new Date(issue.closed_at) >= weekStart);\n\nconst mergedPrs = pullsRaw\n  .filter((pr) => pr.merged_at)\n  .filter((pr) => new Date(pr.merged_at) >= weekStart);\n\nconst commitLines = commits.slice(0, 25).map((commit) => {\n  const message = (commit.commit?.message || '').split('\\n')[0];\n  const author = commit.commit?.author?.name || 'unknown';\n  return `- ${message} (by ${author})`;\n});\n\nconst issueLines = closedIssues.slice(0, 25).map((issue) => `- #${issue.number}: ${issue.title}`);\nconst prLines = mergedPrs.slice(0, 25).map((pr) => `- #${pr.number}: ${pr.title}`);\n\nconst language = (config.language || 'EN').toUpperCase() === 'FR' ? 'FR' : 'EN';\nconst instruction = language === 'FR'\n  ? 'Rédige le résumé en français (FR). Format: Points clés, Risques, Prochaines étapes.'\n  : 'Write the summary in English (EN). Format: Highlights, Risks, Next steps.';\n\nconst prompt = [\n  `Repository: ${config.repo_owner}/${config.repo_name}`,\n  `Destination channel: ${config.destination_channel}`,\n  `Reporting window UTC: ${weekStart.toISOString()} -> ${now.toISOString()}`,\n  `Closed issues this week: ${closedIssues.length}`,\n  `Merged PRs this week: ${mergedPrs.length}`,\n  `Commits sampled: ${commits.length}`,\n  '',\n  'Commits:',\n  commitLines.length ? commitLines.join('\\n') : '- none',\n  '',\n  'Closed Issues:',\n  issueLines.length ? issueLines.join('\\n') : '- none',\n  '',\n  'Merged PRs:',\n  prLines.length ? prLines.join('\\n') : '- none',\n  '',\n  instruction,\n  'Keep output under 220 words and include concrete counts.'\n].join('\\n');\n\nreturn [{\n  json: {\n    prompt,\n    language,\n    repo_owner: config.repo_owner,\n    repo_name: config.repo_name,\n    destination_channel: config.destination_channel,\n    webhook_url: config.webhook_url,\n    claude_api_key: config.claude_api_key,\n    claude_model: config.claude_model,\n    commits_count: commits.length,\n    closed_issues_count: closedIssues.length,\n    merged_prs_count: mergedPrs.length,\n    week_start_iso: weekStart.toISOString(),\n    week_end_iso: now.toISOString()\n  }\n}];"
      },
      "id": "f2cf754d-b98e-4eb0-9fb6-f25b33a30489",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$json.claude_api_key}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": $json.claude_model,\n  \"max_tokens\": 900,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": $json.prompt\n    }\n  ]\n}",
        "options": {}
      },
      "id": "4191582a-c13b-4b93-a246-cc5f66fb7e90",
      "name": "Generate Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst meta = $('Build Claude Prompt').first().json;\n\nlet summary = '';\nif (Array.isArray(response.content)) {\n  summary = response.content\n    .filter((part) => part.type === 'text')\n    .map((part) => part.text)\n    .join('\\n')\n    .trim();\n}\n\nif (!summary) {\n  summary = `No summary returned by Claude. Stop and inspect API response.`;\n}\n\nconst payload = {\n  text: `Weekly dev summary for ${meta.repo_owner}/${meta.repo_name}\\nChannel: ${meta.destination_channel}\\nWindow: ${meta.week_start_iso} -> ${meta.week_end_iso}\\n\\n${summary}`\n};\n\nreturn [{\n  json: {\n    summary,\n    payload,\n    webhook_url: meta.webhook_url,\n    destination_channel: meta.destination_channel,\n    repo: `${meta.repo_owner}/${meta.repo_name}`,\n    language: meta.language\n  }\n}];"
      },
      "id": "d773c8f2-3410-4d16-ac38-e75a8474d5d1",
      "name": "Prepare Outbound Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.webhook_url}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.payload}}",
        "options": {}
      },
      "id": "43422be0-cb95-4b9d-af4f-5389273fed64",
      "name": "Send Summary To Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        980,
        180
      ]
    }
  ],
