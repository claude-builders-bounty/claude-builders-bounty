{
  "name": "Weekly Dev Summary (Claude Code)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "hours": 17,
              "minute": 0,
              "dayOfWeek": 5
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{$vars.githubRepo}}",
        "options": {}
      },
      "id": "node-set-repo",
      "name": "Set GitHub Repo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "values": {
        "repo": "={{$vars.githubRepo}}",
        "language": "={{$vars.language || 'EN'}}",
        "webhookUrl": "={{$vars.discordWebhook}}"
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/={{$vars.githubRepo}}/commits",
        "options": {
          "queryParameters": {
            "qs": {
              "since": "={{$now.minus(7).toISO()}}",
              "per_page": 30
            }
          }
        }
      },
      "id": "node-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/={{$vars.githubRepo}}/issues",
        "options": {
          "queryParameters": {
            "qs": {
              "state": "closed",
              "since": "={{$now.minus(7).toISO()}}",
              "per_page": 30
            }
          }
        }
      },
      "id": "node-closed-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/={{$vars.githubRepo}}/pulls",
        "options": {
          "queryParameters": {
            "qs": {
              "state": "closed",
              "per_page": 30
            }
          }
        }
      },
      "id": "node-merged-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        600
      ]
    },
    {
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a technical writer creating a weekly development summary."
            }
          ]
        },
        "model": "claude-sonnet-4-20250514",
        "options": {
          "temperature": 0.3,
          "maxTokens": 1500
        }
      },
      "id": "node-claude",
      "name": "Generate Summary (Claude)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{$vars.discordWebhook}}",
        "method": "POST",
        "body": {
          "content": "={{$json.message}}"
        }
      },
      "id": "node-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [
        900,
        400
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Set GitHub Repo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set GitHub Repo": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Generate Summary (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Generate Summary (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Generate Summary (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary (Claude)": {
      "main": [
        [
          {
            "node": "Send to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": []
}