#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "--pr" || -z "${2:-}" ]]; then
  echo "Usage: claude-review --pr https://github.com/owner/repo/pull/123"
  exit 1
fi

PR_URL="$2"
TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT
DIFF_FILE="$TMPDIR/pr.diff"

gh pr diff "$PR_URL" > "$DIFF_FILE"

PROMPT=$(cat <<'EOF'
Review this pull request diff and return ONLY Markdown with sections:
1) Summary (2-3 sentences)
2) Risks (bulleted list)
3) Improvement Suggestions (bulleted list)
4) Confidence: Low|Medium|High
EOF
)

if command -v claude >/dev/null 2>&1; then
  {
    echo "$PROMPT"
    echo
    echo "PR URL: $PR_URL"
    echo
    echo "Diff:"
    cat "$DIFF_FILE"
  } | claude --print --permission-mode bypassPermissions
else
  echo "## Summary"
  echo "Automated fallback: diff fetched successfully but Claude CLI is unavailable in this environment."
  echo
  echo "## Risks"
  echo "- Unable to run semantic AI review without Claude CLI."
  echo
  echo "## Improvement Suggestions"
  echo "- Install Claude CLI and rerun for model-based review."
  echo
  echo "## Confidence"
  echo "Low"
fi
