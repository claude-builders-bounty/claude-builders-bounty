#!/usr/bin/env bash
#
# claude-review — Review a GitHub PR and post a structured Markdown comment
#
# Usage:
#   claude-review --pr https://github.com/owner/repo/pull/123
#   claude-review --pr owner/repo#123
#   claude-review --pr 123                        # when inside a git repo
#
# Requirements: gh CLI (authenticated), claude CLI (or ANTHROPIC_API_KEY set)
#

set -euo pipefail

PR_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr) PR_ARG="$2"; shift 2 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

if [[ -z "$PR_ARG" ]]; then
  echo "Usage: claude-review --pr <PR_URL_OR_REF>"
  echo "  --pr https://github.com/owner/repo/pull/123"
  echo "  --pr owner/repo#123"
  echo "  --pr 123  (when inside a git repo)"
  exit 1
fi

# ── Resolve PR to owner/repo and number ──────────────────────
if [[ "$PR_ARG" =~ ^https://github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
  REPO="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
  PR_NUM="${BASH_REMATCH[3]}"
elif [[ "$PR_ARG" =~ ^([^/]+/[^/]+)#([0-9]+) ]]; then
  REPO="${BASH_REMATCH[1]}"
  PR_NUM="${BASH_REMATCH[2]}"
elif [[ "$PR_ARG" =~ ^[0-9]+$ ]]; then
  PR_NUM="$PR_ARG"
  REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || {
    echo "Cannot determine repo. Use full URL or owner/repo#123 format."
    exit 1
  })
else
  echo "Cannot parse PR reference: $PR_ARG"
  exit 1
fi

echo "Reviewing ${REPO}#${PR_NUM}..."

# ── Fetch PR data ────────────────────────────────────────────
PR_JSON=$(gh pr view "$PR_NUM" --repo "$REPO" --json title,body,author,additions,deletions,changedFiles,url,baseRefName,headRefName)
TITLE=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['title'])")
AUTHOR=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['author']['login'])")
ADDITIONS=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['additions'])")
DELETIONS=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['deletions'])")
CHANGED_FILES=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['changedFiles'])")
BASE=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['baseRefName'])")
HEAD=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['headRefName'])")
PR_URL=$(echo "$PR_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['url'])")

# Fetch the diff
DIFF=$(gh pr diff "$PR_NUM" --repo "$REPO" 2>/dev/null || echo "")

if [[ -z "$DIFF" ]]; then
  echo "Could not fetch diff for PR #$PR_NUM"
  exit 1
fi

# Truncate diff if too large (max ~80k chars for prompt)
MAX_DIFF_LEN=80000
if [[ ${#DIFF} -gt $MAX_DIFF_LEN ]]; then
  DIFF="${DIFF:0:$MAX_DIFF_LEN}"
  DIFF="${DIFF}

... (diff truncated at ${MAX_DIFF_LEN} characters)"
fi

# ── Build review prompt ──────────────────────────────────────
REVIEW_PROMPT="You are an expert code reviewer. Analyze the following pull request diff and produce a structured Markdown review.

## PR Info
- Title: ${TITLE}
- Author: @${AUTHOR}
- Base: ${BASE} ← Head: ${HEAD}
- +${ADDITIONS} / -${DELETIONS} across ${CHANGED_FILES} file(s)

## Diff
\`\`\`diff
${DIFF}
\`\`\`

## Output Format

Produce a Markdown review with exactly these sections:

### Summary
2-3 sentences summarizing what this PR does and why.

### Risks
A bulleted list of potential risks, bugs, or issues found. If none, write "None identified."

### Suggestions
A bulleted list of improvement suggestions. If none, write "None."

### Confidence
One of: Low / Medium / High — how confident are you in this review?

Do not add any other sections or commentary outside this format."

# ── Call Claude API ──────────────────────────────────────────
if command -v claude &>/dev/null; then
  # Use Claude CLI if available
  REVIEW=$(echo "$REVIEW_PROMPT" | claude --print 2>/dev/null)
elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
  # Use API directly
  REVIEW=$(python3 -c "
import os, sys, json, urllib.request

api_key = os.environ['ANTHROPIC_API_KEY']
prompt = sys.stdin.read()

payload = {
    'model': 'claude-sonnet-4-20250514',
    'max_tokens': 4096,
    'messages': [{'role': 'user', 'content': prompt}]
}

req = urllib.request.Request(
    'https://api.anthropic.com/v1/messages',
    data=json.dumps(payload).encode(),
    headers={
        'Content-Type': 'application/json',
        'x-api-key': api_key,
        'anthropic-version': '2023-06-01'
    }
)

with urllib.request.urlopen(req, timeout=120) as resp:
    data = json.loads(resp.read())
    print(data['content'][0]['text'])
" <<< "$REVIEW_PROMPT")
else
  echo "Error: Neither 'claude' CLI nor ANTHROPIC_API_KEY is available."
  echo "Install claude CLI or set ANTHROPIC_API_KEY environment variable."
  exit 1
fi

if [[ -z "$REVIEW" ]]; then
  echo "Error: Claude returned an empty review."
  exit 1
fi

# ── Output the review ────────────────────────────────────────
FULL_COMMENT="## AI Code Review

${REVIEW}

---
*Generated by [claude-review](https://github.com/claude-builders-bounty/claude-builders-bounty) — PR [#${PR_NUM}](${PR_URL})*"

echo "$FULL_COMMENT"
echo ""
echo "──────────────────────────────────────────────"
echo "To post this review as a PR comment, run:"
echo "  gh pr comment ${PR_NUM} --repo ${REPO} --body '...' "
echo "Or use the --post flag (not yet implemented)"
