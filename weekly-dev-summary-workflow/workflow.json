        "options": {}
      },
      "id": "47e3a5ce-111f-4f7d-81b9-357da59a65a3",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -840,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst until = now.toISOString();\nconst sinceDate = new Date(now);\nsinceDate.setUTCDate(sinceDate.getUTCDate() - 7);\n\nreturn [{\n  json: {\n    ...$json,\n    since: sinceDate.toISOString(),\n    until,\n    weekLabel: `${sinceDate.toISOString().slice(0, 10)} to ${until.slice(0, 10)}`\n  }\n}];"
      },
      "id": "afc984fc-36d7-40ee-a044-2e35611b98d1",
      "name": "Calculate Week Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{'https://api.github.com/repos/' + $node['Configuration'].json.githubOwner + '/' + $node['Configuration'].json.githubRepo + '/commits'}}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.since}}"
            },
            {
              "name": "until",
              "value": "={{$json.until}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "f069a54b-6225-4ad6-94c3-9f76b5cc0ac6",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{'repo:' + $node['Configuration'].json.githubOwner + '/' + $node['Configuration'].json.githubRepo + ' type:issue closed:' + $node['Calculate Week Window'].json.since.slice(0, 10) + '..' + $node['Calculate Week Window'].json.until.slice(0, 10)}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "1bcf9fd7-b745-436e-8867-31df54c6b2ae",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{'repo:' + $node['Configuration'].json.githubOwner + '/' + $node['Configuration'].json.githubRepo + ' type:pr is:merged merged:' + $node['Calculate Week Window'].json.since.slice(0, 10) + '..' + $node['Calculate Week Window'].json.until.slice(0, 10)}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "02a4cdb9-9c12-487e-83a8-698dd135c2a6",
      "name": "Fetch Merged Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $node['Configuration'].json;\nconst window = $node['Calculate Week Window'].json;\n\nconst normalizeItems = (nodeName) => $items(nodeName).flatMap((item) => {\n  if (Array.isArray(item.json)) return item.json;\n  if (Array.isArray(item.json.items)) return item.json.items;\n  return [item.json];\n});\n\nconst commits = normalizeItems('Fetch Commits').filter(Boolean).slice(0, 100).map((commit) => ({\n  sha: (commit.sha || '').slice(0, 7),\n  message: commit.commit?.message?.split('\\n')[0] || commit.message || 'Untitled commit',\n  author: commit.commit?.author?.name || commit.author?.login || 'Unknown',\n  url: commit.html_url || commit.url\n}));\n\nconst closedIssues = normalizeItems('Fetch Closed Issues').filter(Boolean).slice(0, 100).map((issue) => ({\n  number: issue.number,\n  title: issue.title,\n  closedAt: issue.closed_at,\n  url: issue.html_url\n}));\n\nconst mergedPullRequests = normalizeItems('Fetch Merged Pull Requests').filter(Boolean).slice(0, 100).map((pr) => ({\n  number: pr.number,\n  title: pr.title,\n  mergedAt: pr.pull_request?.merged_at || pr.closed_at,\n  url: pr.html_url\n}));\n\nconst languageName = config.summaryLanguage === 'FR' ? 'French' : 'English';\nconst payload = {\n  repository: `${config.githubOwner}/${config.githubRepo}`,\n  week: window.weekLabel,\n  language: config.summaryLanguage === 'FR' ? 'FR' : 'EN',\n  commits,\n  closedIssues,\n  mergedPullRequests\n};\n\nreturn [{\n  json: {\n    ...payload,\n    prompt: `Write a concise narrative weekly development summary in ${languageName}. Focus on meaningful themes, user-facing changes, reliability work, and notable risk. Use this JSON activity report:\\n\\n${JSON.stringify(payload, null, 2)}\\n\\nReturn Markdown with: title, short overview, bullets for commits/issues/PRs, and suggested next steps.`\n  }\n}];"
      },
      "id": "3301c5a9-7f57-41ab-9776-285d73144564",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'claude-sonnet-4-20250514', max_tokens: 1200, system: 'You write clear, factual weekly engineering summaries from GitHub activity. Do not invent details that are not present in the activity JSON.', messages: [{ role: 'user', content: $json.prompt }] } }}",
        "options": {}
      },
      "id": "5a0b3f52-b5f5-4e85-bc18-b58158f1c01b",
      "name": "Claude Narrative Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const summary = $json.content?.map((block) => block.text).filter(Boolean).join('\\n\\n') || 'No summary text returned by Claude.';\nconst repo = `${$node['Configuration'].json.githubOwner}/${$node['Configuration'].json.githubRepo}`;\nconst week = $node['Calculate Week Window'].json.weekLabel;\n\nreturn [{\n  json: {\n    content: `**Weekly dev summary: ${repo} (${week})**\\n\\n${summary}`\n  }\n}];"
      },
      "id": "513c07c6-f1ec-4f71-82ef-b01d403df8c7",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ]
    },
