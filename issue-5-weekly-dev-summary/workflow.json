{
  "name": "Weekly GitHub Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "weekly-trigger",
      "name": "Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9e646e54-b5bf-4155-a5bb-885ce4831655",
              "name": "repo",
              "value": "={{$env.GITHUB_REPO || 'owner/repo'}}",
              "type": "string"
            },
            {
              "id": "b2d26cae-4239-4d47-8319-f3a4488e4002",
              "name": "language",
              "value": "={{$env.SUMMARY_LANGUAGE || 'EN'}}",
              "type": "string"
            },
            {
              "id": "07f31e23-e909-45ef-922d-584190287f31",
              "name": "slackWebhook",
              "value": "={{$env.SLACK_WEBHOOK_URL}}",
              "type": "string"
            },
            {
              "id": "15d33441-eafe-4b6f-8cab-78ea1a328b9c",
              "name": "slackChannel",
              "value": "={{$env.SLACK_CHANNEL || ''}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.repo}}/commits?since={{$now.minus({days:7}).toISO()}}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        }
      },
      "id": "commits",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -220
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node['Config'].json.repo}}/issues?state=closed&since={{$now.minus({days:7}).toISO()}}&per_page=100",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        }
      },
      "id": "issues",
      "name": "Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node['Config'].json.repo}}/pulls?state=closed&sort=updated&direction=desc&per_page=100",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        }
      },
      "id": "prs",
      "name": "Closed PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const parse = (name) => $items(name).flatMap(x => { const raw = x.json?.data ?? x.json?.body ?? x.json; if (Array.isArray(raw)) return raw; if (typeof raw === 'string') { try { const v=JSON.parse(raw); return Array.isArray(v) ? v : [v]; } catch { return []; } } return raw && typeof raw === 'object' ? [raw] : []; }); const commits=parse('GitHub Commits'); const issues=parse('Closed Issues').filter(x=>!x.pull_request); const prs=parse('Closed PRs').filter(x=>x.merged_at && new Date(x.merged_at)>=new Date(Date.now()-7*86400000)); return [{json:{repo:$node['Config'].json.repo,language:$node['Config'].json.language,commits:commits.map(c=>({sha:c.sha?.slice(0,7),message:c.commit?.message,author:c.commit?.author?.name})),issues:issues.map(i=>({number:i.number,title:i.title,closed_at:i.closed_at})),prs:prs.map(p=>({number:p.number,title:p.title,merged_at:p.merged_at,user:p.user?.login}))}}];"
      },
      "id": "aggregate",
      "name": "Aggregate Week",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ANTHROPIC_API_URL || 'https://api.anthropic.com/v1/messages'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:1200,messages:[{role:'user',content:'Write a concise weekly development narrative in ' + $json.language + '. Include highlights, shipped work, fixes, and next-watch items. Use only the supplied GitHub data; do not invent activity. Data:\\n' + JSON.stringify($json)}]}) }}"
      },
      "id": "claude",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node['Config'].json.slackWebhook}}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({channel: $node['Config'].json.slackChannel || undefined, text: $json.text}) }}"
      },
      "id": "slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw=$json; let payload=raw?.body ?? raw?.data ?? raw; if (typeof payload==='string') { try { payload=JSON.parse(payload); } catch {} } const text=payload?.content?.[0]?.text || 'Weekly summary unavailable'; return [{json:{text}}];"
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        0
      ]
    }
  ],
