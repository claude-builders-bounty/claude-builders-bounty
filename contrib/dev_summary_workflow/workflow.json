{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {},
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "weekly-dev-summary"
    },
    {
      "parameters": {
        "credentials": {
          "githubApi": {
            "id": "github-cred",
            "name": "GitHub Account"
          }
        },
        "resource": "repository",
        "operation": "getCommits",
        "owner": "={{ $json.owner }}",
        "repository": "={{ $json.repository }}",
        "since": "={{ Date.now() - 7 * 24 * 60 * 60 * 1000 }}",
        "options": {}
      },
      "id": "github-commits",
      "name": "Get GitHub Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "credentials": {
          "githubApi": {
            "id": "github-cred",
            "name": "GitHub Account"
          }
        },
        "resource": "pullRequest",
        "operation": "getAll",
        "owner": "={{ $json.owner }}",
        "repository": "={{ $json.repository }}",
        "state": "open,closed",
        "createdAfter": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}"
      },
      "id": "github-pull-requests",
      "name": "Get GitHub Pull Requests",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        520,
        500
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "summary",
              "value": "="
            }
          ]
        }
      },
      "id": "initialize-summary",
      "name": "Initialize Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.commits.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-commits",
      "name": "Check Commits Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "commitSummary",
              "value": "="
            }
          ]
        }
      },
      "id": "format-commits",
      "name": "Format Commit Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1300,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.pullRequests.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-prs",
      "name": "Check PRs Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1300,
        400
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "prSummary",
              "value": "="
            }
          ]
        }
      },
      "id": "format-prs",
      "name": "Format PR Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "headers": {
          "x-api-key": "={{ $credentials.claudeApiKey }}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-3-sonnet-20240229",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "Generate a concise weekly development summary in Markdown format based on the following data:\n\nCommits:\n{{JSON.stringify($json.commits, null, 2)}}\n\nPull Requests:\n{{JSON.stringify($json.pullRequests, null, 2)}}\n\nPlease format this as a well-structured Markdown document with sections for commits and pull requests, highlighting significant changes and contributions."
            }
          ]
        }
      },
      "id": "claude-api",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1820,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "markdownOutput",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        }
      },
      "id": "extract-response",
      "name": "Extract Claude Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        2080,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "dev_summary_{{Date.now()}}.md",
        "options": {}
      },
      "id": "save-markdown",
      "name": "Save Markdown File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        2340,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get GitHub Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get GitHub Pull Requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get GitHub Commits": {
      "main": [
        [
          {
            "node": "Initialize Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get GitHub Pull Requests": {
      "main": [
        [
          {
            "node": "Initialize Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Summary": {
      "main": [
        [
          {
            "node": "Check Commits Exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Commits Exist": {
      "main": [
        [
          {
            "node": "Format Commit Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check PRs Exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check PRs Exist": {
      "main": [
        [
          {
            "node": "Format PR Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format PR Summary": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Commit Summary": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Extract Claude Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Claude Response": {
      "main": [
        [
          {
            "node": "Save Markdown File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": null,
  "id": "weekly-dev-summary-workflow",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}