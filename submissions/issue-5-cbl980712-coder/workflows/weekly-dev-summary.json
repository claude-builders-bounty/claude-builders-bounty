{
  "name": "Automated Weekly Developer Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-weekly",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -920,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "repo-owner",
              "name": "owner",
              "value": "={{$env.GITHUB_OWNER}}",
              "type": "string"
            },
            {
              "id": "summary-language",
              "name": "language",
              "value": "={{$env.SUMMARY_LANGUAGE || 'EN'}}",
              "type": "string"
            },
            {
              "id": "repo-name",
              "name": "repo",
              "value": "={{$env.GITHUB_REPO}}",
              "type": "string"
            },
            {
              "id": "since-date",
              "name": "since",
              "value": "={{$now.minus({days: 7}).toISO()}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-config",
      "name": "Set Repository Window",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -700,
        120
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits?since={{$json.since}}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Weekly Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -460,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REPLACE_WITH_N8N_CREDENTIAL_ID__",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node[\"Set Repository Window\"].json.owner}}/{{$node[\"Set Repository Window\"].json.repo}}/pulls?state=closed&sort=updated&direction=desc&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-pulls",
      "name": "Fetch Recent Pull Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -460,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REPLACE_WITH_N8N_CREDENTIAL_ID__",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$node[\"Set Repository Window\"].json.owner}}/{{$node[\"Set Repository Window\"].json.repo}}/issues?state=closed&since={{$node[\"Set Repository Window\"].json.since}}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-issues",
      "name": "Fetch Updated Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -460,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REPLACE_WITH_N8N_CREDENTIAL_ID__",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "merge-activity",
      "name": "Merge Commits and Pull Requests",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -190,
        120
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "merge-with-issues",
      "name": "Merge With Issues",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -70,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Set Repository Window').first().json;\nconst owner = cfg.owner;\nconst repo = cfg.repo;\nconst since = cfg.since;\nconst language = String(cfg.language || 'EN').toUpperCase() === 'FR' ? 'FR' : 'EN';\nconst sinceMs = Date.parse(since);\n\nconst all = $input.all().map(item => item.json);\nconst arrays = all.flatMap(value => Array.isArray(value) ? value : [value]);\nconst commits = arrays.filter(x => x.sha && x.commit).slice(0, 60);\nconst pulls = arrays\n  .filter(x => x.html_url && x.merge_commit_sha !== undefined && x.merged_at && Date.parse(x.merged_at) >= sinceMs)\n  .slice(0, 60);\nconst issues = arrays\n  .filter(x => x.html_url && x.pull_request === undefined && x.number !== undefined && x.state === 'closed')\n  .slice(0, 60);\n\nfunction lineCommit(c) {\n  const msg = (c.commit?.message || '').split('\\n')[0];\n  const author = c.commit?.author?.name || c.author?.login || 'unknown';\n  return `- ${msg} (${author}, ${String(c.sha).slice(0, 7)})`;\n}\n\nfunction lineItem(i) {\n  const closed = i.closed_at ? `, closed ${i.closed_at}` : '';\n  const merged = i.merged_at ? `, merged ${i.merged_at}` : '';\n  const author = i.user?.login || 'unknown';\n  return `- #${i.number} ${i.title} by ${author}${merged}${closed}: ${i.html_url}`;\n}\n\nconst payload = {\n  repo: `${owner}/${repo}`,\n  since,\n  language,\n  generatedAt: new Date().toISOString(),\n  commits: commits.map(lineCommit),\n  mergedPulls: pulls.map(lineItem),\n  closedIssues: issues.map(lineItem)\n};\n\npayload.prompt = `You are preparing a weekly narrative developer summary for ${payload.repo}. Write in ${language === 'FR' ? 'French' : 'English'}. Use only the raw GitHub activity below. Produce concise Markdown with these sections: Executive summary, Merged PRs, Notable commits, Closed issues, Risks or follow-ups, Suggested next-week priorities. Be specific, avoid hype, and mention uncertainty if activity is sparse.\\\\n\\\\nRepository: ${payload.repo}\\\\nSince: ${payload.since}\\\\nGenerated: ${payload.generatedAt}\\\\n\\\\nCommits:\\\\n${payload.commits.join('\\\\n') || '- None found'}\\\\n\\\\nMerged PRs:\\\\n${payload.mergedPulls.join('\\\\n') || '- None found'}\\\\n\\\\nClosed issues:\\\\n${payload.closedIssues.join('\\\\n') || '- None found'}`;\n\nreturn [{ json: payload }];"
      },
      "id": "build-summary-prompt",
      "name": "Build Summary Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1400,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": $json.prompt\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "claude-summary",
      "name": "Generate Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        330,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst summary = response.content?.map(part => part.text || '').join('\\n').trim() || 'No summary generated.';\nconst source = $('Build Summary Prompt').first().json;\nreturn [{\n  json: {\n    repo: source.repo,\n    generatedAt: source.generatedAt,\n    markdown: summary,\n    discordPayload: {\n      content: `Weekly developer summary for ${source.repo}`,\n      embeds: [{\n        title: `Weekly developer summary: ${source.repo}`,\n        description: summary.slice(0, 3900),\n        color: 3447003,\n        timestamp: source.generatedAt\n      }]\n    }\n  }\n}];"
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        570,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DISCORD_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.discordPayload}}",
        "options": {}
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        810,
        120
      ]
    }
  ],
