{
  "name": "Weekly Dev Summary (GitHub + Claude)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 17 * * 5" }] } },
      "id": "trigger",
      "name": "Weekly Trigger (Fri 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo || $env.GITHUB_REPO }}/commits?since={{ $now.minus(7, 'days').toISO() }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-commits",
      "name": "Get Commits (7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo || $env.GITHUB_REPO }}/issues?state=closed&since={{ $now.minus(7, 'days').toISO() }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-issues",
      "name": "Get Closed Issues (7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo || $env.GITHUB_REPO }}/pulls?state=closed&sort=updated&direction=desc&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 600]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all()[0].json;\nconst issues = $input.all()[1].json;\nconst prs = $input.all()[2].json;\n\nconst commitList = Array.isArray(commits) ? commits.map(c => `- ${c.commit.message.split('\\n')[0]} (by ${c.commit.author.name})`).join('\\n') : 'No commits';\nconst issueList = Array.isArray(issues) ? issues.filter(i => !i.pull_request).map(i => `- #${i.number}: ${i.title}`).join('\\n') : 'No issues closed';\nconst prList = Array.isArray(prs) ? prs.filter(p => p.merged_at).map(p => `- #${p.number}: ${p.title} (by ${p.user.login})`).join('\\n') : 'No PRs merged';\n\nreturn [{ json: { commitList, issueList, prList, commitCount: Array.isArray(commits) ? commits.length : 0, issueCount: Array.isArray(issues) ? issues.filter(i => !i.pull_request).length : 0, prCount: Array.isArray(prs) ? prs.filter(p => p.merged_at).length : 0 } }];"
      },
      "id": "merge-data",
      "name": "Merge & Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1024, messages: [{ role: 'user', content: `You are a technical writer. Generate a concise, narrative weekly development summary for a software project. Write in ${$env.LANGUAGE || 'English'}.\n\nHere is this week's activity:\n\n## Commits (${$json.commitCount})\n${$json.commitList}\n\n## Closed Issues (${$json.issueCount})\n${$json.issueList}\n\n## Merged PRs (${$json.prCount})\n${$json.prList}\n\nWrite a 3-5 paragraph summary that highlights: key features shipped, bugs fixed, and notable contributions. Use a professional but friendly tone. Include specific PR/issue numbers.` }] }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "claude-summary",
      "name": "Claude API — Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: '## Weekly Dev Summary\\n\\n' + $json.content[0].text }) }}"
      },
      "id": "send-webhook",
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 400]
    }
  ],
  "connections": {
    "Weekly Trigger (Fri 5pm)": { "main": [[{ "node": "Get Commits (7 days)", "type": "main", "index": 0 }, { "node": "Get Closed Issues (7 days)", "type": "main", "index": 0 }, { "node": "Get Merged PRs", "type": "main", "index": 0 }]] },
    "Get Commits (7 days)": { "main": [[{ "node": "Merge & Format Data", "type": "main", "index": 0 }]] },
    "Get Closed Issues (7 days)": { "main": [[{ "node": "Merge & Format Data", "type": "main", "index": 0 }]] },
    "Get Merged PRs": { "main": [[{ "node": "Merge & Format Data", "type": "main", "index": 0 }]] },
    "Merge & Format Data": { "main": [[{ "node": "Claude API — Generate Summary", "type": "main", "index": 0 }]] },
    "Claude API — Generate Summary": { "main": [[{ "node": "Send to Discord/Slack", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
