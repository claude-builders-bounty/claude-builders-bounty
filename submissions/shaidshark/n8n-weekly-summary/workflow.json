{
  "name": "Weekly Dev Summary with Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Monday 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$env.GITHUB_REPO}}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "github-events",
      "name": "Fetch GitHub Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$env.GITHUB_REPO}}/pulls?state=all&sort=updated&direction=desc&per_page=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "github-prs",
      "name": "Fetch Recent PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 200]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{$env.GITHUB_REPO}}/issues?state=all&sort=updated&direction=desc&per_page=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "github-issues",
      "name": "Fetch Recent Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-data",
      "name": "Merge Activity Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [440, 200]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "options": {
          "temperature": 0.3
        },
        "text": "=Summarize this week's development activity into a structured report:\n\n**PRs:** {{ $json.prs }}\n**Issues:** {{ $json.issues }}\n\nFormat as:\n## Weekly Dev Summary\n### Merged PRs\n- ...\n### Open Issues\n- ...\n### Key Metrics\n- PRs merged/open\n- Issues opened/closed\n### Highlights & Action Items"
      },
      "id": "claude-summarize",
      "name": "Claude Summary",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1,
      "position": [660, 200]
    },
    {
      "parameters": {
        "channel": "{{$env.SLACK_CHANNEL}}",
        "text": "={{ $json.content }}",
        "otherOptions": {}
      },
      "id": "slack-post",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [880, 200]
    }
  ],
  "connections": {
    "Every Monday 9AM": {
      "main": [
        [
          { "node": "Fetch GitHub Events", "type": "main", "index": 0 },
          { "node": "Fetch Recent PRs", "type": "main", "index": 0 },
          { "node": "Fetch Recent Issues", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch GitHub Events": {
      "main": [[{ "node": "Merge Activity Data", "type": "main", "index": 0 }]]
    },
    "Fetch Recent PRs": {
      "main": [[{ "node": "Merge Activity Data", "type": "main", "index": 0 }]]
    },
    "Fetch Recent Issues": {
      "main": [[{ "node": "Merge Activity Data", "type": "main", "index": 0 }]]
    },
    "Merge Activity Data": {
      "main": [[{ "node": "Claude Summary", "type": "main", "index": 0 }]]
    },
    "Claude Summary": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
