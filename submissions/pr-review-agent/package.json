{
  "name": "claude-pr-reviewer",
  "version": "1.0.0",
  "description": "Claude-powered PR Reviewer CLI and GitHub Action",
  "main": "dist/index.js",
  "bin": {
    "claude-review": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
