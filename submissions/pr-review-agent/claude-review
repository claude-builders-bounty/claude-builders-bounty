#!/usr/bin/env bash
# claude-review — AI-powered PR review agent
# Usage: claude-review --pr <PR_URL> [--format markdown|json]
set -euo pipefail

VERSION="1.0.0"
FORMAT="markdown"
PR_URL=""

usage() {
  cat <<EOF
claude-review v${VERSION} — AI-powered PR review agent

USAGE:
  claude-review --pr <PR_URL> [OPTIONS]

OPTIONS:
  --pr URL       GitHub PR URL (required)
  --format FMT   Output format: markdown (default) or json
  --help         Show this help
  --version      Show version

EXAMPLES:
  claude-review --pr https://github.com/owner/repo/pull/123
  claude-review --pr https://github.com/owner/repo/pull/42 --format json

REQUIREMENTS:
  - gh CLI authenticated (gh auth login)
  - Claude Code CLI (claude) in PATH
EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr)      PR_URL="$2"; shift 2 ;;
    --format)  FORMAT="$2"; shift 2 ;;
    --help)    usage ;;
    --version) echo "claude-review v${VERSION}"; exit 0 ;;
    *)         echo "Unknown option: $1"; exit 1 ;;
  esac
done

if [[ -z "$PR_URL" ]]; then
  echo "Error: --pr is required. Use --help for usage." >&2
  exit 1
fi

# Parse PR URL: https://github.com/OWNER/REPO/pull/NUMBER
if [[ "$PR_URL" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
  OWNER="${BASH_REMATCH[1]}"
  REPO="${BASH_REMATCH[2]}"
  PR_NUM="${BASH_REMATCH[3]}"
  REPO_FQ="${OWNER}/${REPO}"
else
  echo "Error: Invalid PR URL format. Expected: https://github.com/owner/repo/pull/123" >&2
  exit 1
fi

echo "→ Fetching PR #${PR_NUM} from ${REPO_FQ}..." >&2

# Fetch PR details and diff
PR_DATA=$(gh pr view "${PR_NUM}" --repo "${REPO_FQ}" --json title,body,author,baseRefName,headRefName,additions,deletions,changedFiles,files 2>&1) || {
  echo "Error: Failed to fetch PR data. Is gh CLI authenticated?" >&2
  exit 1
}

PR_DIFF=$(gh pr diff "${PR_NUM}" --repo "${REPO_FQ}" 2>&1) || {
  echo "Error: Failed to fetch PR diff." >&2
  exit 1
}

# Extract key info for the prompt
PR_TITLE=$(echo "$PR_DATA" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('title',''))" 2>/dev/null || echo "Unknown")
PR_AUTHOR=$(echo "$PR_DATA" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('author',{}).get('login','unknown'))" 2>/dev/null || echo "unknown")
PR_ADDITIONS=$(echo "$PR_DATA" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('additions',0))" 2>/dev/null || echo "0")
PR_DELETIONS=$(echo "$PR_DATA" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('deletions',0))" 2>/dev/null || echo "0")
PR_FILES=$(echo "$PR_DATA" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('changedFiles',0))" 2>/dev/null || echo "0")
PR_BODY=$(echo "$PR_DATA" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('body','No description provided.'))" 2>/dev/null || echo "No description provided.")

echo "→ PR: \"${PR_TITLE}\" by @${PR_AUTHOR} (+${PR_ADDITIONS}/-${PR_DELETIONS} across ${PR_FILES} files)" >&2
echo "→ Generating review..." >&2

# Build review prompt
REVIEW_PROMPT="You are a senior code reviewer. Review the following pull request and produce a structured Markdown review.

## PR Information
- **Title**: ${PR_TITLE}
- **Author**: @${PR_AUTHOR}
- **Changes**: +${PR_ADDITIONS} / -${PR_DELETIONS} across ${PR_FILES} files
- **Description**:
${PR_BODY}

## Diff
\`\`\`diff
${PR_DIFF}
\`\`\`

## Required Output Format

Produce EXACTLY this Markdown structure:

# PR Review: ${PR_TITLE}

## Summary
(2-3 sentences summarizing what this PR does and its overall quality)

## Identified Risks
(List each risk as a bullet point. Include security, performance, correctness, and maintainability risks. Mark severity: 🔴 Critical / 🟡 Warning / 🔵 Info)

## Improvement Suggestions
(Numbered list of concrete, actionable improvements. Reference specific code locations.)

## Confidence Score
(One of: Low / Medium / High — with a 1-sentence justification)

---
Review generated by claude-review v${VERSION}"

# Run review through claude CLI
REVIEW_OUTPUT=$(claude --print "${REVIEW_PROMPT}" 2>/dev/null) || {
  echo "Error: Failed to generate review. Is Claude Code CLI available?" >&2
  echo "Fallback: Using raw diff analysis..." >&2
  
  # Fallback: generate a basic review without Claude
  cat <<FALLBACK
# PR Review: ${PR_TITLE}

## Summary
This PR by @${PR_AUTHOR} introduces ${PR_ADDITIONS} additions and ${PR_DELETIONS} deletions across ${PR_FILES} files. ${PR_BODY}

## Identified Risks
- 🔵 Info: Manual review recommended (auto-review fallback mode)

## Improvement Suggestions
1. Review the diff manually for context-specific issues

## Confidence Score
Low — Fallback mode. Install Claude Code CLI for AI-powered review.
FALLBACK
  exit 0
}

if [[ "$FORMAT" == "json" ]]; then
  # Parse and output as JSON
  python3 -c "
import sys, json, re

review = '''${REVIEW_OUTPUT}'''

# Extract sections
def extract_section(text, header):
    pattern = rf'## {header}\s*\n(.*?)(?=\n## |\Z)'
    match = re.search(pattern, text, re.DOTALL)
    return match.group(1).strip() if match else ''

summary = extract_section(review, 'Summary')
risks = extract_section(review, 'Identified Risks')
suggestions = extract_section(review, 'Improvement Suggestions')
confidence_match = re.search(r'\*\*Confidence Score\*\*\s*\n(\w+)', review)
confidence = confidence_match.group(1) if confidence_match else 'Low'

result = {
    'pr': '${PR_URL}',
    'title': '${PR_TITLE}',
    'author': '${PR_AUTHOR}',
    'stats': {'additions': ${PR_ADDITIONS}, 'deletions': ${PR_DELETIONS}, 'files': ${PR_FILES}},
    'review': {
        'summary': summary,
        'risks': risks,
        'suggestions': suggestions,
        'confidence': confidence
    },
    'reviewer': 'claude-review v${VERSION}'
}
print(json.dumps(result, indent=2, ensure_ascii=False))
" 2>/dev/null || echo "{\"error\": \"Failed to parse review as JSON\", \"raw\": \"${REVIEW_OUTPUT}\"}"
else
  echo "$REVIEW_OUTPUT"
fi

echo "" >&2
echo "✓ Review complete." >&2
