#!/usr/bin/env python3
"""
claude-review — Claude Code PR Review Agent
Uses gh CLI + claude CLI to analyze a PR and post a structured review comment.

Usage:
    claude-review --pr https://github.com/owner/repo/pull/123
    claude-review --pr https://github.com/owner/repo/pull/123 --post
    claude-review --pr https://github.com/owner/repo/pull/123 --dry-run
"""

import argparse
import json
import re
import subprocess
import sys
import textwrap
from typing import Optional


# ── helpers ──────────────────────────────────────────────────────────────────

def run(cmd: list[str], *, check: bool = True, capture: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        capture_output=capture,
        text=True,
        check=check,
    )


def die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def parse_pr_url(url: str) -> tuple[str, int]:
    """Return (owner/repo, pr_number) from a GitHub PR URL."""
    m = re.match(
        r"https?://github\.com/([^/]+/[^/]+)/pull/(\d+)",
        url.strip(),
    )
    if not m:
        die(f"Invalid PR URL: {url!r}  (expected https://github.com/owner/repo/pull/N)")
    return m.group(1), int(m.group(2))


# ── data fetching ─────────────────────────────────────────────────────────────

def fetch_pr_metadata(repo: str, pr_number: int) -> dict:
    """Fetch PR title, body, author, base/head info via gh CLI."""
    result = run([
        "gh", "pr", "view", str(pr_number),
        "--repo", repo,
        "--json", "title,body,author,baseRefName,headRefName,additions,deletions,changedFiles,url",
    ])
    return json.loads(result.stdout)


def fetch_pr_diff(repo: str, pr_number: int, max_bytes: int = 80_000) -> str:
    """Return the unified diff of the PR (truncated if too large)."""
    result = run([
        "gh", "pr", "diff", str(pr_number),
        "--repo", repo,
    ])
    diff = result.stdout
    if len(diff) > max_bytes:
        diff = diff[:max_bytes] + f"\n\n[...diff truncated at {max_bytes} bytes...]"
    return diff


def fetch_pr_files(repo: str, pr_number: int) -> list[dict]:
    """Return list of changed files with patch/status via gh API."""
    result = run([
        "gh", "api",
        f"repos/{repo}/pulls/{pr_number}/files",
        "--paginate",
    ])
    return json.loads(result.stdout)


# ── AI analysis ───────────────────────────────────────────────────────────────

SYSTEM_PROMPT = textwrap.dedent("""
    You are an expert code reviewer. Analyze the provided pull request and produce
    a structured review in exactly the Markdown format below — no extra prose outside
    the template.

    Template (fill in every section):

    ## PR Review

    ### Summary of Changes
    <!-- 2-3 sentences describing WHAT changed and WHY -->

    ### Identified Risks
    <!-- Bullet list of concrete bugs, logic errors, edge-case failures, or
         breaking changes.  Write "None identified." if truly none. -->

    ### Improvement Suggestions
    <!-- Bullet list of actionable code-quality, readability, or design
         improvements.  Be specific: reference file/line where possible.
         Write "None." if nothing significant. -->

    ### Confidence Score
    <!-- One of: Low | Medium | High
         Criteria:
           High   — diff is self-contained, no missing context, all paths clear
           Medium — some context is missing (e.g. referenced code not in diff)
           Low    — diff is large, heavily truncated, or domain is unfamiliar -->

    **Confidence: <score>**

    ---
    *Review generated by [claude-review](https://github.com/claude-builders-bounty/claude-builders-bounty/issues/4)*
""").strip()


def build_user_message(meta: dict, diff: str) -> str:
    return textwrap.dedent(f"""
        Repository: {meta.get('url', '')}
        PR Title: {meta['title']}
        Author: {meta['author']['login']}
        Base branch: {meta['baseRefName']} ← {meta['headRefName']}
        Changed files: {meta['changedFiles']}  (+{meta['additions']} / -{meta['deletions']})

        PR Description:
        {meta.get('body') or '(no description)'}

        --- DIFF ---
        {diff}
    """).strip()


def call_claude(prompt: str) -> str:
    """Call claude CLI via subprocess and return its output."""
    result = run(
        ["claude", "-p", prompt, "--system", SYSTEM_PROMPT],
        check=False,
    )
    if result.returncode != 0:
        # Fallback: try without --system (older claude versions)
        combined = f"{SYSTEM_PROMPT}\n\n---\n\n{prompt}"
        result = run(["claude", "-p", combined], check=False)
    if result.returncode != 0:
        die(f"claude CLI failed:\n{result.stderr}")
    return result.stdout.strip()


# ── post comment ──────────────────────────────────────────────────────────────

def post_comment(repo: str, pr_number: int, body: str) -> str:
    """Post a comment on the PR and return the comment URL."""
    result = run([
        "gh", "pr", "comment", str(pr_number),
        "--repo", repo,
        "--body", body,
    ])
    # gh prints the comment URL to stdout
    return result.stdout.strip()


# ── main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Claude Code PR Review Agent — analyzes a PR diff and generates a structured review.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""
            Examples:
              claude-review --pr https://github.com/owner/repo/pull/42
              claude-review --pr https://github.com/owner/repo/pull/42 --post
              claude-review --pr https://github.com/owner/repo/pull/42 --dry-run
        """),
    )
    parser.add_argument("--pr", required=True, metavar="URL", help="GitHub PR URL")
    parser.add_argument(
        "--post", action="store_true",
        help="Post the review as a comment on the PR (requires gh auth)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Print review to stdout only, do not post",
    )
    parser.add_argument(
        "--max-diff", type=int, default=80_000, metavar="BYTES",
        help="Truncate diff at this many bytes (default: 80000)",
    )
    args = parser.parse_args()

    # Validate gh auth
    auth = run(["gh", "auth", "status"], check=False)
    if auth.returncode != 0:
        die("gh CLI is not authenticated. Run: gh auth login")

    repo, pr_number = parse_pr_url(args.pr)

    print(f"Fetching PR #{pr_number} from {repo}...", file=sys.stderr)
    meta = fetch_pr_metadata(repo, pr_number)
    diff = fetch_pr_diff(repo, pr_number, max_bytes=args.max_diff)

    print("Analyzing with Claude...", file=sys.stderr)
    user_msg = build_user_message(meta, diff)
    review = call_claude(user_msg)

    print("\n" + "=" * 72)
    print(review)
    print("=" * 72 + "\n")

    if args.post and not args.dry_run:
        print(f"Posting comment to {args.pr} ...", file=sys.stderr)
        url = post_comment(repo, pr_number, review)
        print(f"Comment posted: {url}", file=sys.stderr)
    elif args.post and args.dry_run:
        print("(dry-run: comment NOT posted)", file=sys.stderr)
    else:
        print("Tip: re-run with --post to publish this review as a PR comment.", file=sys.stderr)


if __name__ == "__main__":
    main()
