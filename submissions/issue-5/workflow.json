        300
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $json.GITHUB_REPO + '/commits?since=' + $now.minus({days: 7}).toISO() + '&per_page=30' }}",
        "sendHeaders": true,
        "headerParameters": {
