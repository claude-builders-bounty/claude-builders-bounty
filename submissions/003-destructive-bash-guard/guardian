#!/usr/bin/env python3
"""Claude Code pre-tool-use hook: blocks destructive bash commands.

Reads the hook event JSON from stdin, inspects Bash tool commands,
and denies any that match dangerous patterns.
"""
import json
import os
import re
import sys
from datetime import datetime, timezone

LOG_DIR = os.path.expanduser("~/.claude/hooks")
LOG_FILE = os.path.join(LOG_DIR, "blocked.log")

DANGEROUS_PATTERNS = [
    # rm -rf variants (rm -rf, rm -fr, rm -r -f)
    (r"\brm\b.*\s-(?:-[a-z]*r[a-z]*f|-[a-z]*f[a-z]*r|[rf]{1,2})\b",
     "rm with force+recursive flags (data loss)"),

    # DROP TABLE / DROP DATABASE
    (r"\bDROP\s+(TABLE|DATABASE|SCHEMA)\b",
     "DROP {group1} statement (schema destruction)"),

    # git push --force / git push -f / git push --force-with-lease
    (r"\bgit\s+push\b.*\s(?:--force|-f|--force-with-lease)\b",
     "git push --force (overwrites remote history)"),

    # TRUNCATE
    (r"\bTRUNCATE\s+(?:TABLE\s+)?\S",
     "TRUNCATE statement (data destruction)"),

    # DELETE FROM without WHERE clause
    (r"\bDELETE\s+FROM\s+\S+(?:(?!WHERE).)*$",
     "DELETE FROM without WHERE clause (mass data deletion)"),

    # chmod 777 (overly permissive)
    (r"\bchmod\b.*\s777\b",
     "chmod 777 (world-writable permissions)"),

    # fork bomb
    (r":\(\)\s*\{[^}]*:[^}]*\|[^}]*&\s*\}[^}]*;",
     "fork bomb pattern (system DoS)"),
]

def log_block(reason, command, cwd):
    os.makedirs(LOG_DIR, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    entry = f"[{timestamp}] BLOCKED | cwd={cwd} | reason={reason} | command={command}\n"
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(entry)

def check_command(command):
    if not command or not isinstance(command, str):
        return None
    for pattern, reason_tmpl in DANGEROUS_PATTERNS:
        m = re.search(pattern, command, re.IGNORECASE | re.DOTALL)
        if m:
            reason = reason_tmpl.replace("{group1}", m.group(1) if m.lastindex and m.lastindex >= 1 else "?")
            return reason
    return None

def main():
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            sys.exit(0)

        event = json.loads(raw)
    except (json.JSONDecodeError, Exception):
        sys.exit(0)

    tool_name = event.get("tool_name", "")
    if tool_name != "Bash":
        sys.exit(0)

    command = event.get("tool_input", {}).get("command", "")
    cwd = event.get("cwd", os.getcwd())

    reason = check_command(command)
    if reason is None:
        sys.exit(0)

    log_block(reason, command, cwd)

    output = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": (
                f"Blocked: {reason}. Command was logged. "
                f"If this is intentional, run it manually in your terminal."
            ),
        }
    }
    print(json.dumps(output))
    sys.exit(0)

if __name__ == "__main__":
    main()
