#!/usr/bin/env python3
"""
Claude Code pre-tool-use hook — Destructive Command Blocker
===========================================================
Intercepts bash commands before execution and blocks dangerous patterns.
Install: copy to ~/.claude/hooks/pre-tool-use

Usage: python3 pre-tool-use < input.json > output.json
"""

import json
import sys
import os
import re
from datetime import datetime, timezone

HOOK_DIR = os.path.expanduser("~/.claude/hooks")
BLOCKED_LOG = os.path.join(HOOK_DIR, "blocked.log")

DESTRUCTIVE_PATTERNS = [
    # Filesystem destruction
    (r"\brm\s+-rf\b", "Recursive force delete — may destroy project files"),
    (r"\brm\s+-r\s+-f\b", "Recursive force delete — may destroy project files"),
    (r"\bsudo\s+rm\b", "Privileged file deletion — irreversible"),
    (r"\bmkfs\.", "Filesystem format — destroys all data on target"),
    (r"\bdd\s+if=", "Raw disk write — may corrupt drives"),

    # Git force push
    (r"\bgit\s+push\s+--force\b", "Force push — overwrites remote history"),
    (r"\bgit\s+push\s+-f\b", "Force push — overwrites remote history"),
    (r"\bgit\s+push\s+.*--delete\b", "Remote branch deletion — removes team's work"),

    # Database destruction
    (r"\bDROP\s+TABLE\b", "SQL DROP TABLE — deletes table and all data"),
    (r"\bDROP\s+DATABASE\b", "SQL DROP DATABASE — destroys entire database"),
    (r"\bTRUNCATE\b", "SQL TRUNCATE — removes all rows from table"),
    (r"\bDELETE\s+FROM\b(?!.*\bWHERE\b)", "SQL DELETE without WHERE — deletes all rows"),

    # System-level danger
    (r"\bchmod\s+-R\s+777\b", "World-writable permissions — security risk"),
    (r"\b:(){ :|:& };:", "Fork bomb — will crash the system"),
    (r">\s*/dev/sda", "Writing directly to disk device — may corrupt partitions"),
]


def log_block(command: str, pattern: str, reason: str) -> None:
    """Log blocked attempt to file."""
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    cwd = os.getcwd()
    entry = (
        f"[{timestamp}] BLOCKED\n"
        f"  Command : {command.strip()[:200]}\n"
        f"  Pattern : {pattern}\n"
        f"  Reason  : {reason}\n"
        f"  CWD     : {cwd}\n"
        f"  ---\n"
    )
    try:
        os.makedirs(HOOK_DIR, exist_ok=True)
        with open(BLOCKED_LOG, "a") as f:
            f.write(entry)
    except OSError:
        pass  # Fail silently if log can't be written


def check_command(command: str) -> str | None:
    """Return block reason if command matches a destructive pattern, else None."""
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, command, re.IGNORECASE):
            return f"{reason} (matched: {pattern})"
    return None


def main():
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        print(json.dumps({"decision": "allow"}))
        return

    tool_name = data.get("tool_name", "")
    tool_input = data.get("tool_input", {})

    # Only check bash commands
    if tool_name != "bash":
        print(json.dumps({"decision": "allow"}))
        return

    command = tool_input.get("command", "")
    if not command:
        print(json.dumps({"decision": "allow"}))
        return

    reason = check_command(command)
    if reason:
        log_block(command, "destructive-pattern", reason)
        print(json.dumps({
            "decision": "block",
            "reason": (
                f"DESTRUCTIVE COMMAND BLOCKED\n\n"
                f"Your command was intercepted by the safety hook:\n"
                f"  {command[:120]}\n\n"
                f"Reason: {reason}\n\n"
                f"If this is intentional and safe, re-run with an explicit "
                f"`--yes-i-know-what-i-am-doing` flag or temporarily disable "
                f"the hook by removing ~/.claude/hooks/pre-tool-use.\n\n"
                f"Blocked attempts are logged to: {BLOCKED_LOG}"
            ),
        }))
    else:
        print(json.dumps({"decision": "allow"}))


if __name__ == "__main__":
    main()
