{
  "name": "GitHub Weekly Dev Summary → Discord",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "var-repo",
              "name": "GITHUB_REPO",
              "value": "={{$vars.GITHUB_REPO || 'anthropics/claude-code'}}",
              "type": "string"
            },
            {
              "id": "var-lang",
              "name": "LANGUAGE",
              "value": "={{$vars.LANGUAGE || 'EN'}}",
              "type": "string"
            },
            {
              "id": "var-since",
              "name": "SINCE",
              "value": "={{ DateTime.now().minus({days: 7}).toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$json.GITHUB_REPO}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.SINCE}}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=token {{$vars.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "get-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$('Set Variables').item.json.GITHUB_REPO}}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{$('Set Variables').item.json.SINCE}}"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=token {{$vars.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "get-issues",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$('Set Variables').item.json.GITHUB_REPO}}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=token {{$vars.GITHUB_TOKEN}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "get-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$vars.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a technical writer generating a weekly development summary for a GitHub repository.\\n\\nRepository: {{ $('Set Variables').item.json.GITHUB_REPO }}\\nLanguage: {{ $('Set Variables').item.json.LANGUAGE }}\\nPeriod: Last 7 days\\n\\nCommits this week ({{ $('Get Commits').all().length }}):\\n{{ $('Get Commits').all().map(c => '- ' + c.json.commit.message.split('\\\\n')[0]).slice(0,20).join('\\\\n') }}\\n\\nClosed Issues ({{ $('Get Closed Issues').all().length }}):\\n{{ $('Get Closed Issues').all().map(i => '- #' + i.json.number + ': ' + i.json.title).slice(0,10).join('\\\\n') }}\\n\\nMerged PRs ({{ $('Get Merged PRs').all().filter(p => p.json.merged_at).length }}):\\n{{ $('Get Merged PRs').all().filter(p => p.json.merged_at).map(p => '- #' + p.json.number + ': ' + p.json.title).slice(0,10).join('\\\\n') }}\\n\\nWrite a concise narrative weekly summary (3-4 short paragraphs) in {{ $('Set Variables').item.json.LANGUAGE === 'FR' ? 'French' : 'English' }}. Start with an overall theme of the week, then highlights, then what's coming. Use plain text — no headers, no markdown.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-summarize",
      "name": "Claude: Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 340]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "extract-summary",
              "name": "summary",
              "value": "={{$json.content[0].text}}",
              "type": "string"
            },
            {
              "id": "extract-repo",
              "name": "repo",
              "value": "={{$('Set Variables').item.json.GITHUB_REPO}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1180, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.DISCORD_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"username\": \"GitHub Weekly\",\n  \"embeds\": [\n    {\n      \"title\": \"📊 Weekly Dev Summary — {{ $json.repo }}\",\n      \"description\": \"{{ $json.summary }}\",\n      \"color\": 5793266,\n      \"footer\": {\n        \"text\": \"{{ new Date().toLocaleDateString('en-US', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) }} · Powered by Claude\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "discord-post",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 340]
    }
  ],
  "connections": {
    "Every Friday 5pm": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "Get Commits",
            "type": "main",
            "index": 0
