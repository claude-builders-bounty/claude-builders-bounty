    },
    "📡 Fetch Issues": {
      "main": [[ { "node": "📊 Aggregate Data", "type": "main", "index": 0 } ]]
    },
    "📊 Aggregate Data": {
      "main": [[ { "node": "🤖 Claude Sonnet", "type": "main", "index": 0 } ]]
    },
    "🤖 Claude Sonnet": {
      "main": [
        [
          { "node": "📧 Email Report", "type": "main", "index": 0 },
          { "node": "💬 Slack Notification", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "pinData": {},
