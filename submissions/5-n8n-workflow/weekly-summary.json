{
  "name": "Weekly Dev Summary — Claude API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "cronExpression", "expression": "0 17 * * 5"}]
        }
      },
      "id": "cron-trigger",
      "name": "Friday 5pm Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.githubRepo }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "Authorization", "value": "Bearer {{ $json.githubToken }}"}
          ]
        },
        "queryParameters": {
          "parameters": [
            {"name": "since", "value": "{{ $now.minus({days: 7}).toISO() }}"},
            {"name": "per_page", "value": 50}
          ]
        }
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 250]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.githubRepo }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "Authorization", "value": "Bearer {{ $json.githubToken }}"}
          ]
        },
        "queryParameters": {
          "parameters": [
            {"name": "state", "value": "closed"},
            {"name": "since", "value": "{{ $now.minus({days: 7}).toISO() }}"},
            {"name": "per_page", "value": 50}
          ]
        }
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.githubRepo }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/vnd.github+json"},
            {"name": "Authorization", "value": "Bearer {{ $json.githubToken }}"}
          ]
        },
        "queryParameters": {
          "parameters": [
            {"name": "state", "value": "closed"},
            {"name": "sort", "value": "updated"},
            {"name": "direction", "value": "desc"},
            {"name": "per_page", "value": 30}
          ]
        }
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 550]
    },
    {
      "parameters": {
        "jsCode": "const commits = $input.all()[0].json;\nconst issues = $input.all()[1].json;\nconst prs = $input.all()[2].json;\n\nconst lang = $('Config').item.json.language || 'EN';\nconst repo = $('Config').item.json.githubRepo;\n\nconst commitList = commits.slice(0, 20).map(c => `- ${c.commit.message.split('\\n')[0]} (${c.commit.author.name})`).join('\\n');\nconst issueList = issues.slice(0, 10).map(i => `- #${i.number} ${i.title}`).join('\\n');\nconst prList = prs.filter(p => p.merged_at).slice(0, 10).map(p => `- #${p.number} ${p.title}`).join('\\n');\n\nconst prompt = `Generate a weekly development summary for ${repo}. Language: ${lang}.\\n\\n## Activity this week\\n\\n### Commits\\n${commitList || 'No commits this week'}\\n\\n### Closed Issues\\n${issueList || 'No issues closed'}\\n\\n### Merged PRs\\n${prList || 'No PRs merged'}\\n\\nPlease write a 3-4 paragraph narrative summary highlighting key accomplishments, themes, and any noteworthy changes.`;\n\nreturn { prompt, lang, repo };\n"
      },
      "id": "aggregate",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "position": [650, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "claude-sonnet-4-20250514"},
            {"name": "max_tokens", "value": 1024},
            {"name": "messages[0][role]", "value": "user"},
            {"name": "messages[0][content]", "value": "={{ $json.prompt }}"}
          ]
        },
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{ $json.claudeApiKey }}"},
            {"name": "anthropic-version", "value": "2023-06-01"}
          ]
        }
      },
      "id": "claude-api",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 400]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst summary = response.content[0].text;\nconst repo = $('Build Prompt').item.json.repo;\nconst now = new Date().toISOString().split('T')[0];\n\nreturn {\n  subject: `Weekly Dev Summary — ${repo} (${now})`,\n  body: summary\n};\n"
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "position": [1050, 400]
    },
    {
      "parameters": {
        "webhookUri": "={{ $json.slackWebhookUrl }}",
        "text": "*{{ $json.subject }}*\n\n{{ $json.body }}"
      },
      "id": "slack-deliver",
      "name": "Deliver to Slack",
      "type": "n8n-nodes-base.slack",
      "position": [1250, 350]
    },
    {
      "parameters": {
        "fromEmail": "noreply@example.com",
        "toEmail": "={{ $json.recipientEmail }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body }}"
      },
      "id": "email-deliver",
      "name": "Deliver via Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [1250, 500]
    }
  ],
  "connections": {
    "Friday 5pm Trigger": {"main": [[{"node": "Fetch Commits", "type": "main", "index": 0}]]},
    "Fetch Commits": {"main": [[{"node": "Build Prompt", "type": "main", "index": 0}]]},
    "Fetch Closed Issues": {"main": [[{"node": "Build Prompt", "type": "main", "index": 1}]]},
    "Fetch Merged PRs": {"main": [[{"node": "Build Prompt", "type": "main", "index": 2}]]},
    "Build Prompt": {"main": [[{"node": "Claude API", "type": "main", "index": 0}]]},
    "Claude API": {"main": [[{"node": "Format Output", "type": "main", "index": 0}]]},
    "Format Output": {"main": [[{"node": "Deliver to Slack", "type": "main", "index": 0}, {"node": "Deliver via Email", "type": "main", "index": 0}]]}
  },
  "settings": {"callerPolicy": "workflowsFromSameOwner"},
  "staticData": null,
  "pinData": {}
}
