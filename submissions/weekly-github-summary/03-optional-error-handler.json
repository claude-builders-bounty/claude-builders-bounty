      "position": [
        -80,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('Error Trigger').first().json;\nconst cfg = $('Alert Configuration').first().json;\n\nconst workflowName = trigger.workflow?.name || 'Unknown workflow';\nconst workflowId = trigger.workflow?.id || 'unknown';\nconst executionId = trigger.execution?.id || 'unknown';\nconst executionUrl = trigger.execution?.url || '';\nconst lastNode = trigger.execution?.lastNodeExecuted || trigger.execution?.error?.node?.name || 'unknown';\nconst message = trigger.execution?.error?.message || trigger.error?.message || 'Unknown execution error';\n\nconst occurredAt = new Date().toISOString();\n\nconst description = [\n  `**Workflow:** ${workflowName}`,\n  `**Workflow ID:** ${workflowId}`,\n  `**Execution ID:** ${executionId}`,\n  `**Last node:** ${lastNode}`,\n  `**Time:** ${occurredAt}`,\n  '',\n  '**Error**',\n  String(message).slice(0, 2500),\n  executionUrl ? `\\n[Open execution](${executionUrl})` : ''\n].join('\\n');\n\nreturn [{\n  json: {\n    webhookUrl: cfg.discordWebhookUrl,\n    body: {\n      username: 'n8n Workflow Alert',\n      embeds: [{\n        title: 'Weekly GitHub Dev Summary \u2014 Execution Failed',\n        description,\n        footer: { text: 'Optional Bulletproof error notification' },\n        timestamp: occurredAt\n      }]\n    }\n  }\n}];"
      },
      "id": "09034187-5015-414e-90e5-a51d49abecc5",
