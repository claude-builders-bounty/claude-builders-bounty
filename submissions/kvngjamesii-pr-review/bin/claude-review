#!/usr/bin/env python3
"""claude-review — structured PR review agent for Claude Code / CLI."""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from typing import Any


API = "https://api.github.com"


@dataclass
class Review:
    summary: str
    risks: list[str] = field(default_factory=list)
    suggestions: list[str] = field(default_factory=list)
    confidence: str = "Medium"
    meta: dict[str, Any] = field(default_factory=dict)

    def to_markdown(self) -> str:
        risks = "\n".join(f"- {r}" for r in self.risks) or "- None identified"
        suggestions = "\n".join(f"- {s}" for s in self.suggestions) or "- None"
        lines = [
            "## PR Review",
            "",
            f"**PR:** {self.meta.get('url', 'n/a')}",
            f"**Title:** {self.meta.get('title', 'n/a')}",
            f"**Author:** {self.meta.get('author', 'n/a')}",
            f"**Files changed:** {self.meta.get('changed_files', '?')} | "
            f"**+{self.meta.get('additions', '?')} / -{self.meta.get('deletions', '?')}",
            "",
            "### Summary",
            self.summary,
            "",
            "### Identified risks",
            risks,
            "",
            "### Improvement suggestions",
            suggestions,
            "",
            f"### Confidence score: **{self.confidence}**",
            "",
            "---",
            f"_Generated by claude-review (KvngJamesII) · mode={self.meta.get('mode', 'heuristic')}_",
        ]
        return "\n".join(lines) + "\n"


def parse_pr_url(url: str) -> tuple[str, str, int]:
    m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
    if not m:
        raise SystemExit(f"Invalid PR URL: {url}")
    return m.group(1), m.group(2), int(m.group(3))


def gh_get(path: str, token: str | None) -> Any:
    req = urllib.request.Request(
        f"{API}{path}",
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "claude-review/1.0",
            **({"Authorization": f"Bearer {token}"} if token else {}),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        raise SystemExit(f"GitHub API {e.code} for {path}: {body[:300]}") from e


def fetch_pr(owner: str, repo: str, number: int, token: str | None) -> tuple[dict, str]:
    pr = gh_get(f"/repos/{owner}/{repo}/pulls/{number}", token)
    # unified diff
    req = urllib.request.Request(
        f"{API}/repos/{owner}/{repo}/pulls/{number}",
        headers={
            "Accept": "application/vnd.github.v3.diff",
            "User-Agent": "claude-review/1.0",
            **({"Authorization": f"Bearer {token}"} if token else {}),
        },
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        diff = resp.read().decode(errors="replace")
    return pr, diff


RISKY_PATTERNS = [
    (r"\brm\s+-rf\b", "Destructive recursive delete (`rm -rf`) in diff"),
    (r"\beval\s*\(", "Use of `eval()` — code injection risk"),
    (r"\bexec\s*\(", "Use of `exec()` — arbitrary code execution risk"),
    (r"password\s*=\s*['\"][^'\"]+['\"]", "Hardcoded password-like string"),
    (r"api[_-]?key\s*=\s*['\"][^'\"]+['\"]", "Hardcoded API key pattern"),
    (r"AKIA[0-9A-Z]{16}", "Possible AWS access key id"),
    (r"-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----", "Private key material in diff"),
    (r"\bsubprocess\.(call|run|Popen).*shell\s*=\s*True", "subprocess with shell=True"),
    (r"dangerouslySetInnerHTML", "XSS vector via dangerouslySetInnerHTML"),
    (r"\binnerHTML\s*=", "Direct innerHTML assignment — XSS risk"),
    (r"DISABLE_.*AUTH|skip.*auth|noverify", "Possible auth bypass flag"),
    (r"git\s+push\s+.*--force", "Force-push referenced in change"),
    (r"DROP\s+TABLE|TRUNCATE\s+", "Destructive SQL in diff"),
]


def heuristic_review(pr: dict, diff: str) -> Review:
    files = pr.get("changed_files") or diff.count("diff --git")
    additions = pr.get("additions", 0)
    deletions = pr.get("deletions", 0)
    title = pr.get("title") or ""
    body = (pr.get("body") or "")[:2000]
    draft = pr.get("draft", False)

    risks: list[str] = []
    suggestions: list[str] = []

    for pat, msg in RISKY_PATTERNS:
        if re.search(pat, diff, re.I):
            risks.append(msg)

    # size / reviewability
    if additions + deletions > 800:
        risks.append(
            f"Large diff (+{additions}/-{deletions}) — harder to review; consider splitting"
        )
    if files and files > 25:
        risks.append(f"{files} files touched — high blast radius")
    if draft:
        risks.append("PR is marked draft — treat findings as provisional")

    # test presence
    test_hit = bool(
        re.search(r"(^|\n)diff --git a/.*(test|spec|__tests__)", diff, re.I)
        or re.search(r"\+.*(describe\(|it\(|pytest|assert )", diff)
    )
    if additions > 50 and not test_hit:
        suggestions.append("No test files/assertions detected in the diff — add coverage for new paths")

    # docs / changelog
    if re.search(r"feat|fix|breaking", title, re.I) and not re.search(
        r"CHANGELOG|README|\.md", diff, re.I
    ):
        suggestions.append("User-facing change without docs/CHANGELOG update — consider documenting")

    # lockfiles alone
    if files and files <= 3 and re.search(r"package-lock\.json|yarn\.lock|pnpm-lock", diff):
        suggestions.append("Mostly lockfile churn — confirm intentional dependency bumps")

    # missing description
    if len(body.strip()) < 40:
        suggestions.append("PR description is thin — expand motivation, risk, and test plan")

    # positive signals
    if re.search(r"Resolves|Fixes|Closes\s+#\d+", body + " " + title, re.I):
        suggestions.append("Linked issue found — good; keep acceptance criteria mapped in checklist")

    if not risks:
        risks.append("No high-severity static patterns matched — still do human review of logic")

    # confidence
    score = "High"
    if additions + deletions > 500 or (files or 0) > 20:
        score = "Medium"
    if len([r for r in risks if "Hardcoded" in r or "Private key" in r or "eval" in r]) >= 1:
        score = "Medium"
    if draft or additions + deletions > 1500:
        score = "Low"

    summary = (
        f"This PR ({title!r}) changes ~{files} file(s) with +{additions}/-{deletions} lines. "
        f"Static analysis scanned the unified diff for destructive commands, secrets, XSS, and SQL hazards. "
        f"{'Several risk signals fired.' if len(risks) > 1 else 'Overall risk surface looks contained from heuristics.'}"
    )

    return Review(
        summary=summary,
        risks=risks[:12],
        suggestions=suggestions[:10] or ["Consider adding a short test plan checklist to the PR body"],
        confidence=score,
        meta={
            "title": title,
            "author": (pr.get("user") or {}).get("login"),
            "url": pr.get("html_url"),
            "changed_files": files,
            "additions": additions,
            "deletions": deletions,
            "mode": "heuristic",
        },
    )


def claude_review(pr: dict, diff: str, api_key: str) -> Review | None:
    """Optional Anthropic path — falls back if unavailable."""
    model = os.environ.get("ANTHROPIC_MODEL", "claude-sonnet-4-20250514")
    prompt = {
        "model": model,
        "max_tokens": 1200,
        "messages": [
            {
                "role": "user",
                "content": (
                    "Review this GitHub pull request. Reply with ONLY JSON keys: "
                    "summary (2-3 sentences string), risks (string array), "
                    "suggestions (string array), confidence (Low|Medium|High).\n\n"
                    f"Title: {pr.get('title')}\n"
                    f"Author: {(pr.get('user') or {}).get('login')}\n"
                    f"Body:\n{(pr.get('body') or '')[:1500]}\n\n"
                    f"Diff (truncated):\n{diff[:24000]}"
                ),
            }
        ],
    }
    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=json.dumps(prompt).encode(),
        headers={
            "content-type": "application/json",
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=90) as resp:
            data = json.loads(resp.read().decode())
        text = data["content"][0]["text"]
        m = re.search(r"\{[\s\S]*\}", text)
        if not m:
            return None
        parsed = json.loads(m.group(0))
        return Review(
            summary=str(parsed.get("summary", "")).strip(),
            risks=list(parsed.get("risks") or []),
            suggestions=list(parsed.get("suggestions") or []),
            confidence=str(parsed.get("confidence", "Medium")),
            meta={
                "title": pr.get("title"),
                "author": (pr.get("user") or {}).get("login"),
                "url": pr.get("html_url"),
                "changed_files": pr.get("changed_files"),
                "additions": pr.get("additions"),
                "deletions": pr.get("deletions"),
                "mode": f"claude:{model}",
            },
        )
    except Exception as e:  # noqa: BLE001 — intentional soft fallback
        print(f"[claude-review] Anthropic call failed ({e}); using heuristic mode", file=sys.stderr)
        return None


def main() -> None:
    p = argparse.ArgumentParser(description="Structured Markdown PR review agent")
    p.add_argument("--pr", required=True, help="GitHub PR URL")
    p.add_argument("--token", default=os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN"))
    p.add_argument("--out", help="Write Markdown to this path")
    p.add_argument("--json", action="store_true", help="Also print JSON to stdout after Markdown")
    p.add_argument("--heuristic-only", action="store_true", help="Skip Anthropic even if key set")
    args = p.parse_args()

    owner, repo, number = parse_pr_url(args.pr)
    pr, diff = fetch_pr(owner, repo, number, args.token)

    review = None
    key = os.environ.get("ANTHROPIC_API_KEY")
    if key and not args.heuristic_only:
        review = claude_review(pr, diff, key)
    if review is None:
        review = heuristic_review(pr, diff)

    md = review.to_markdown()
    if args.out:
        with open(args.out, "w", encoding="utf-8") as f:
            f.write(md)
    print(md, end="")
    if args.json:
        print(json.dumps({
            "summary": review.summary,
            "risks": review.risks,
            "suggestions": review.suggestions,
            "confidence": review.confidence,
            "meta": review.meta,
        }, indent=2))


if __name__ == "__main__":
    main()
