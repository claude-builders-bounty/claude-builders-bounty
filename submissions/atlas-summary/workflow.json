{
  "name": "Weekly GitHub Summary by Atlas",
  "nodes": [
    {
      "parameters": {
        "rule": "0 17 * * 5"
      },
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "getMany",
        "resource": "commit",
        "filters": {
          "since": "={{$now.minus({ days: 7 }).toISO()}}"
        }
      },
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20240620",
        "prompt": "Summarize these technical updates into a weekly narrative for the engineering team. Language: {{$node[\"Config\"].json[\"language\"]}}"
      },
      "name": "Claude AI Summary",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {}
}
