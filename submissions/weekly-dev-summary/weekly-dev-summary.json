{
  "id": "8511fce0-147c-4948-989d-788c302bfa21",
  "name": "Weekly Dev Summary (n8n + Claude Code)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1400,
        200
      ]
    },
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1400,
        420
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "repoOwner",
              "type": "string",
              "value": "claude-builders-bounty"
            },
            {
              "id": "a2",
              "name": "repoName",
              "type": "string",
              "value": "claude-builders-bounty"
            },
            {
              "id": "a3",
              "name": "destinationType",
              "type": "string",
              "value": "discord"
            },
            {
              "id": "a4",
              "name": "destinationWebhookUrl",
              "type": "string",
              "value": "https://discord.com/api/webhooks/REPLACE_ME"
            },
            {
              "id": "a5",
              "name": "destinationEmail",
              "type": "string",
              "value": "you@example.com"
            },
            {
              "id": "a6",
              "name": "language",
              "type": "string",
              "value": "EN"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\nconst now = new Date().toISOString();\nreturn [{ json: { ...items[0].json, since, now } }];"
      },
      "id": "compute-range",
      "name": "Compute Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -940,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repoOwner }}/{{ $json.repoName }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "weekly-dev-summary-workflow"
            }
          ]
        },
        "options": {}
      },
      "id": "get-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -720,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Compute Date Range').item.json.repoOwner }}/{{ $('Compute Date Range').item.json.repoName }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Compute Date Range').item.json.since }}"
            },
            {
              "name": "filter",
              "value": "all"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "weekly-dev-summary-workflow"
            }
          ]
        },
        "options": {}
      },
      "id": "get-closed-issues",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=repo:{{ $('Compute Date Range').item.json.repoOwner }}/{{ $('Compute Date Range').item.json.repoName }} is:pr is:merged merged:>{{ $('Compute Date Range').item.json.since.slice(0,10) }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "weekly-dev-summary-workflow"
            }
          ]
        },
        "options": {}
      },
      "id": "get-merged-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Compute Date Range').item.json;\nconst commits = $('Get Commits').all().map(i => i.json);\nconst issuesRaw = $('Get Closed Issues').all().map(i => i.json);\nconst closedIssues = issuesRaw.filter(i => !i.pull_request);\nconst mergedPRs = ($('Get Merged PRs').first().json.items || []);\n\nconst commitLines = commits.slice(0, 30).map(c => `- ${c.commit.message.split('\\n')[0]} (${c.commit.author.name})`).join('\\n') || 'None';\nconst issueLines = closedIssues.slice(0, 30).map(i => `- #${i.number} ${i.title}`).join('\\n') || 'None';\nconst prLines = mergedPRs.slice(0, 30).map(p => `- #${p.number} ${p.title}`).join('\\n') || 'None';\n\nconst languageNote = cfg.language === 'FR' ? 'Write the summary in French.' : 'Write the summary in English.';\n\nconst prompt = `You are a helpful release-notes assistant. Summarize this week's GitHub activity for ${cfg.repoOwner}/${cfg.repoName} in a short, friendly narrative (max 200 words), grouped into Commits, Closed Issues, and Merged Pull Requests. ${languageNote}\\n\\nCommits:\\n${commitLines}\\n\\nClosed Issues:\\n${issueLines}\\n\\nMerged Pull Requests:\\n${prLines}`;\n\nreturn [{ json: { ...cfg, commitCount: commits.length, closedIssueCount: closedIssues.length, mergedPRCount: mergedPRs.length, prompt } }];"
      },
      "id": "build-prompt",
      "name": "Build Summary Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-4-20250514\", max_tokens: 1024, messages: [{ role: \"user\", content: $json.prompt }] }) }}",
        "options": {}
      },
      "id": "call-claude",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropic-header-auth",
          "name": "Anthropic API Key (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Build Summary Prompt').item.json;\nconst res = items[0].json;\nconst summaryText = res.content && res.content[0] ? res.content[0].text : JSON.stringify(res);\nreturn [{ json: { ...cfg, summaryText } }];"
      },
      "id": "extract-summary",
      "name": "Extract Summary Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.destinationType }}",
                    "rightValue": "email",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.destinationType }}",
                    "rightValue": "discord",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Discord"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "c3",
                    "leftValue": "={{ $json.destinationType }}",
                    "rightValue": "slack",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Slack"
            }
          ]
        },
        "options": {}
      },
      "id": "route-destination",
      "name": "Route By Destination",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.destinationEmail }}",
        "toEmail": "={{ $json.destinationEmail }}",
        "subject": "=Weekly Dev Summary - {{ $json.repoOwner }}/{{ $json.repoName }}",
        "text": "={{ $json.summaryText }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        860,
        100
      ],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.destinationWebhookUrl }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `**Weekly Dev Summary - ${$json.repoOwner}/${$json.repoName}**\\n\\n${$json.summaryText}` }) }}",
        "options": {}
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.destinationWebhookUrl }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `*Weekly Dev Summary - ${$json.repoOwner}/${$json.repoName}*\\n\\n${$json.summaryText}` }) }}",
        "options": {}
      },
      "id": "send-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        500
      ]
    }
  ],
