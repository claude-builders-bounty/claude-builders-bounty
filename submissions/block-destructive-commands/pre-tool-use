#!/usr/bin/env python3
"""Claude Code pre-tool-use hook -- blocks destructive Bash / SQL commands."""
import json, sys, os, re, logging
from datetime import datetime, timezone

LOG_DIR = os.path.expanduser("~/.claude/hooks")
LOG_FILE = os.path.join(LOG_DIR, "blocked.log")
BLOCKED_EXIT = 2

DANGER = [
    (r"\brm\s+-r[af]\b",                     "rm -rf (recursive force delete)"),
    (r"\brm\s+-[a-zA-Z]*[rf][a-zA-Z]*\b",     "rm with force / recursive flags"),
    (r"\bDROP\s+TABLE\b",                    "DROP TABLE"),
    (r"\bDROP\s+DATABASE\b",                 "DROP DATABASE"),
    (r"\bTRUNCATE\s+(TABLE\s+)?",            "TRUNCATE TABLE"),
    (r"\bDELETE\s+FROM\s+\S+((?!WHERE).)*$", "DELETE FROM without WHERE clause"),
    (r"\bgit\s+push\s+.*--force",            "git push --force"),
    (r"\bgit\s+push\s+.*-[a-zA-Z]*f\b",      "git push -f (force push)"),
    (r">\s*/dev/sd[a-z]",                    "overwrite raw block device"),
    (r"\bchmod\s+(-R\s+)?777\b",             "chmod 777 (world-writable)"),
    (r"\bformat\s+C:",                       "format Windows system drive"),
    (r"\bdd\s+if=",                          "dd (raw disk copy)"),
    (r"\bmkfs\.",                            "mkfs (format filesystem)"),
]


def log_block(command: str, pattern: str, cwd: str) -> None:
    os.makedirs(LOG_DIR, exist_ok=True)
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    entry = f'{ts} | BLOCKED | {pattern} | cmd="{command[:200]}" | cwd={cwd}\n'
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(entry)


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)

    tool_name = data.get("tool_name", "")
    tool_input = data.get("tool_input", {})
    command = tool_input.get("command", "") if isinstance(tool_input, dict) else str(tool_input)
    cwd = data.get("cwd", os.getcwd())

    if tool_name.lower() not in ("bash", "shell") or not command.strip():
        print(json.dumps({"decision": "allow"}))
        sys.exit(0)

    for pattern, desc in DANGER:
        if re.search(pattern, command, re.IGNORECASE | re.MULTILINE):
            log_block(command, desc, cwd)
            msg = (
                f"BLOCKED: {desc}\n"
                f"  Command: {command[:200]}\n"
                f"  If safe, run manually or disable this hook temporarily.\n"
            )
            print(json.dumps({"decision": "block", "reason": msg}))
            sys.exit(BLOCKED_EXIT)

    print(json.dumps({"decision": "allow"}))


if __name__ == "__main__":
    main()