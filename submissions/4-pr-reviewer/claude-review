#!/usr/bin/env python3
"""
claude-review — Claude Code agent that reviews a GitHub PR and posts a structured comment.
Usage: claude-review --pr https://github.com/owner/repo/pull/123
"""
import sys, os, json, subprocess, argparse, re
from urllib.request import Request, urlopen
from urllib.error import HTTPError

def fetch_pr_diff(pr_url):
    """Fetch PR diff from GitHub API."""
    m = re.match(r'https?://github\.com/([^/]+)/([^/]+)/pull/(\d+)', pr_url)
    if not m:
        raise ValueError(f"Invalid PR URL: {pr_url}")
    owner, repo, pr_num = m.groups()
    token = os.environ.get('GITHUB_TOKEN') or os.environ.get('GH_TOKEN')

    api_url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_num}"
    headers = {'Accept': 'application/vnd.github.v3.diff', 'User-Agent': 'claude-review'}
    if token:
        headers['Authorization'] = f"Bearer {token}"

    req = Request(api_url, headers=headers)
    try:
        with urlopen(req, timeout=30) as resp:
            diff = resp.read().decode('utf-8', errors='replace')
    except HTTPError as e:
        raise RuntimeError(f"GitHub API error {e.code}: {e.reason}")

    pr_req = Request(f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_num}",
                     headers={'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'claude-review'})
    if token:
        pr_req.headers['Authorization'] = f"Bearer {token}"
    with urlopen(pr_req, timeout=30) as resp:
        pr_data = json.loads(resp.read().decode())

    return {
        'diff': diff[:15000],  # Truncate to keep within context limits
        'title': pr_data.get('title', ''),
        'author': pr_data.get('user', {}).get('login', 'unknown'),
        'base': pr_data.get('base', {}).get('ref', ''),
        'head': pr_data.get('head', {}).get('ref', ''),
    }

PROMPT_TEMPLATE = """You are a senior code reviewer. Analyze this pull request diff and produce a structured Markdown review.

## PR Context
- Title: {title}
- Author: {author}
- Branch: {head} → {base}

## Diff
```diff
{diff}
```

## Output Format (exactly this structure, no preamble):

### Summary
[2–3 sentences describing what this PR changes and why]

### Risks
- [Specific risk 1]
- [Specific risk 2]
(if no risks found, write: - No significant risks identified)

### Suggestions
- [Actionable improvement 1]
- [Actionable improvement 2]

### Confidence
[Low / Medium / High] — [one sentence explaining why]

Only flag real issues. Don't invent problems. If the code is clean, say so."""

def main():
    parser = argparse.ArgumentParser(description='Claude PR Reviewer')
    parser.add_argument('--pr', required=True, help='GitHub PR URL')
    args = parser.parse_args()

    print(f"Fetching PR: {args.pr}...", file=sys.stderr)
    pr = fetch_pr_diff(args.pr)

    prompt = PROMPT_TEMPLATE.format(**pr)

    # Write prompt to temp file, invoke Claude Code
    prompt_file = '/tmp/claude-review-prompt.md'
    with open(prompt_file, 'w') as f:
        f.write(prompt)

    print(f"Analyzing PR: {pr['title']} by {pr['author']}", file=sys.stderr)
    print(f"Diff size: {len(pr['diff'])} chars", file=sys.stderr)

    # Output the prompt for Claude Code to process
    # When used as a Claude Code agent, this prompt is consumed automatically
    with open(prompt_file) as f:
        print(f.read())

if __name__ == '__main__':
    main()
