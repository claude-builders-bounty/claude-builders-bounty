{
  "name": "GitHub Weekly Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "expression": "1"
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "weekly-trigger"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_OWNER }}/{{ $env.GITHUB_REPO }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $getTimestamp(-7, 'days') }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_OWNER }}/{{ $env.GITHUB_REPO }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $getTimestamp(-7, 'days') }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 400]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_OWNER }}/{{ $env.GITHUB_REPO }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filter PRs merged in the last 7 days\nconst oneWeekAgo = new Date();\noneWeekAgo.setDate(oneWeekAgo.getDate() - 7);\n\nconst mergedPRs = items[0].json.filter(pr => {\n  if (!pr.merged_at) return false;\n  const mergedDate = new Date(pr.merged_at);\n  return mergedDate >= oneWeekAgo;\n});\n\nreturn [{\n  json: {\n    merged_prs: mergedPRs,\n    count: mergedPRs.length\n  }\n}];"
      },
      "id": "filter-prs",
      "name": "Filter Recent PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "You are a technical writer creating weekly development summaries. Write in a clear, engaging narrative style."
            },
            {
              "role": "user",
              "content": "=Generate a weekly development summary for {{ $env.GITHUB_OWNER }}/{{ $env.GITHUB_REPO }} in {{ $env.LANGUAGE || 'EN' }}.\n\nCOMMITS ({{ $json.commits?.length || 0 }}):\n{{ JSON.stringify($json.commits?.slice(0, 20), null, 2) }}\n\nCLOSED ISSUES ({{ $json.issues?.length || 0 }}):\n{{ JSON.stringify($json.issues?.slice(0, 10), null, 2) }}\n\nMERGED PRs ({{ $json.merged_prs?.length || 0 }}):\n{{ JSON.stringify($json.merged_prs?.slice(0, 10), null, 2) }}\n\nWrite a narrative summary with:\n1. Overview paragraph\n2. Key highlights (bullet points)\n3. Notable contributions\n4. What's coming next\n\nKeep it concise but informative."
            }
          ]
        }
      },
      "id": "claude-summary",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.DESTINATION_CHANNEL }}",
        "text": "={{ $json.content[0].text }}",
        "options": {}
      },
      "id": "slack-send",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "toRecipients": "={{ $env.EMAIL_RECIPIENTS }}",
        "subject": "=Weekly Dev Summary - {{ $env.GITHUB_REPO }}",
        "text": "={{ $json.content[0].text }}",
        "options": {}
      },
      "id": "email-send",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1250, 400]
    }
  ],
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Filter Recent PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Recent PRs": {
      "main": [
        [
          {
            "node": "Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary": {
      "main": [
        [
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
