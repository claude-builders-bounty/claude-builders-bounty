{
  "name": "Weekly GitHub Dev Summary via Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "node-cron",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "GITHUB_OWNER",
              "value": "your-org",
              "type": "string"
            },
            {
              "id": "2",
              "name": "GITHUB_REPO",
              "value": "your-repo",
              "type": "string"
            },
            {
              "id": "3",
              "name": "LANGUAGE",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "4",
              "name": "DESTINATION_CHANNEL",
              "value": "discord",
              "type": "string"
            },
            {
              "id": "5",
              "name": "WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/YOUR_WEBHOOK_URL",
              "type": "string"
            },
            {
              "id": "6",
              "name": "GITHUB_TOKEN",
              "value": "PLACEHOLDER_GH_TOKEN",
              "type": "string"
            },
            {
              "id": "7",
              "name": "SINCE_DATE",
              "value": "={{ $now.minus(7, 'days').toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-config",
      "name": "Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.GITHUB_OWNER }}/{{ $('Config Variables').item.json.GITHUB_REPO }}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $('Config Variables').item.json.SINCE_DATE }}"
            },
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Variables').item.json.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-commits",
      "name": "Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.GITHUB_OWNER }}/{{ $('Config Variables').item.json.GITHUB_REPO }}/issues",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Config Variables').item.json.SINCE_DATE }}"
            },
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Variables').item.json.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-issues",
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config Variables').item.json.GITHUB_OWNER }}/{{ $('Config Variables').item.json.GITHUB_REPO }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Variables').item.json.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-prs",
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config Variables').item.json;\n\nconst rawCommits = $('Get Commits').all().map(i => i.json);\nconst rawIssues  = $('Get Closed Issues').all().map(i => i.json);\nconst rawPRs     = $('Get Merged PRs').all().map(i => i.json);\n\nconst since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst mergedPRs    = rawPRs.filter(pr => pr.merged_at && new Date(pr.merged_at) > since);\nconst closedIssues = rawIssues.filter(i => !i.pull_request);\n\nconst commitLines = rawCommits.length > 0\n  ? rawCommits.slice(0, 15).map(c => `- ${c.commit.message.split('\\n')[0].substring(0,80)} (${c.commit.author.name})`).join('\\n')\n  : 'No commits this week';\n\nconst issueLines = closedIssues.length > 0\n  ? closedIssues.slice(0, 8).map(i => `- #${i.number}: ${i.title.substring(0,80)}`).join('\\n')\n  : 'No closed issues this week';\n\nconst prLines = mergedPRs.length > 0\n  ? mergedPRs.slice(0, 8).map(pr => `- #${pr.number}: ${pr.title.substring(0,80)} (by ${pr.user.login})`).join('\\n')\n  : 'No merged PRs this week';\n\nconst repo = `${cfg.GITHUB_OWNER}/${cfg.GITHUB_REPO}`;\nconst stats = `${rawCommits.length} commits - ${closedIssues.length} issues closed - ${mergedPRs.length} PRs merged`;\nconst lang = cfg.LANGUAGE === 'FR' ? 'French' : 'English';\n\nconst prompt = `Generate a weekly development summary in ${lang} for the GitHub repository ${repo}.\\n\\nWeekly stats: ${stats}\\n\\nCommits this week:\\n${commitLines}\\n\\nClosed Issues:\\n${issueLines}\\n\\nMerged Pull Requests:\\n${prLines}\\n\\nWrite a concise narrative summary (3-5 paragraphs) for a team Slack/Discord update. Highlight key achievements, velocity, and any patterns worth noting.`;\n\nreturn [{\n  json: {\n    repo,\n    stats,\n    prompt,\n    destination: cfg.DESTINATION_CHANNEL,\n    webhook_url: cfg.WEBHOOK_URL,\n    commits_count: rawCommits.length,\n    issues_count: closedIssues.length,\n    prs_count: mergedPRs.length\n  }\n}];\n"
      },
      "id": "node-aggregate",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "PLACEHOLDER_ANTHROPIC_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-sonnet-4-6\",\"max_tokens\":1024,\"messages\":[{\"role\":\"user\",\"content\":{{ JSON.stringify($json.prompt) }}}]}",
        "options": {}
      },
      "id": "node-claude",
      "name": "Claude API (Sonnet)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "summary_text",
              "value": "={{ $json.content[0].text }}",
              "type": "string"
            },
            {
              "id": "p2",
              "name": "destination",
              "value": "={{ $('Aggregate Data').item.json.destination }}",
              "type": "string"
            },
            {
              "id": "p3",
              "name": "webhook_url",
              "value": "={{ $('Aggregate Data').item.json.webhook_url }}",
              "type": "string"
            },
            {
              "id": "p4",
              "name": "repo",
              "value": "={{ $('Aggregate Data').item.json.repo }}",
              "type": "string"
            },
            {
              "id": "p5",
              "name": "stats",
              "value": "={{ $('Aggregate Data').item.json.stats }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-parse",
      "name": "Parse Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.destination }}",
              "rightValue": "discord",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-route",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.webhook_url }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.discord_body }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "node-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.webhook_url }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.slack_body }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "node-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $input.item.json;\nconst text = d.summary_text || '';\n\nconst discord_body = JSON.stringify({\n  username: \"GitHub Weekly Summary\",\n  embeds: [{\n    title: \"Weekly Dev Summary — \" + d.repo,\n    description: text.substring(0, 4000),\n    color: 5814783,\n    fields: [{name: \"This week\", value: d.stats, inline: true}],\n    footer: {text: \"Generated by Claude Sonnet · n8n\"},\n    timestamp: new Date().toISOString()\n  }]\n});\n\nconst slack_body = JSON.stringify({\n  text: \"*Weekly Dev Summary — \" + d.repo + \"*\\n_\" + d.stats + \"_\\n\\n\" + text\n});\n\nreturn [{json: {\n  summary_text: d.summary_text,\n  destination:  d.destination,\n  webhook_url:  d.webhook_url,\n  repo:         d.repo,\n  stats:        d.stats,\n  discord_body,\n  slack_body\n}}];\n"
      },
      "id": "node-build-payloads",
      "name": "Build Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        300
      ]
    }
  ],
