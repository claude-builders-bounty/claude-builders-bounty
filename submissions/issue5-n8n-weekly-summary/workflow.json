{
  "name": "Weekly GitHub Repo Summary via Claude API",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "var-001",
              "name": "GITHUB_REPO",
              "value": "owner/repo",
              "type": "string"
            },
            {
              "id": "var-002",
              "name": "SLACK_WEBHOOK_URL",
              "value": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
              "type": "string"
            },
            {
              "id": "var-003",
              "name": "LANGUAGE",
              "value": "EN",
              "type": "string"
            },
            {
              "id": "var-004",
              "name": "ANTHROPIC_API_KEY",
              "value": "={{ $env.ANTHROPIC_API_KEY }}",
              "type": "string"
            },
            {
              "id": "var-005",
              "name": "GITHUB_TOKEN",
              "value": "={{ $env.GITHUB_TOKEN }}",
              "type": "string"
            },
            {
              "id": "var-006",
              "name": "SINCE_DATE",
              "value": "={{ DateTime.now().minus({days: 7}).toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "GitHub Get Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 160],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Variables').item.json.GITHUB_REPO }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Variables').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $('Set Variables').item.json.SINCE_DATE }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "GitHub Get Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Variables').item.json.GITHUB_REPO }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Variables').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "since",
              "value": "={{ $('Set Variables').item.json.SINCE_DATE }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "GitHub Get Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 440],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Set Variables').item.json.GITHUB_REPO }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Variables').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Format Data for Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collect data from all three GitHub API nodes\nconst commits = $('GitHub Get Commits').all().map(item => item.json);\nconst issues = $('GitHub Get Closed Issues').all().map(item => item.json);\nconst prs = $('GitHub Get Merged PRs').all().map(item => item.json);\n\nconst vars = $('Set Variables').first().json;\nconst repo = vars.GITHUB_REPO;\nconst language = vars.LANGUAGE || 'EN';\nconst sinceDate = vars.SINCE_DATE;\n\n// Filter merged PRs (GitHub returns all closed PRs including rejected ones)\nconst sevenDaysAgo = new Date(sinceDate);\nconst mergedPRs = prs.filter(pr => {\n  if (!pr.merged_at) return false;\n  return new Date(pr.merged_at) >= sevenDaysAgo;\n});\n\n// Filter closed issues (exclude PRs — GitHub issues API returns PRs as issues too)\nconst closedIssues = issues.filter(issue => !issue.pull_request);\n\n// Format commits summary\nconst commitSummary = commits.slice(0, 30).map(c => {\n  const sha = (c.sha || '').substring(0, 7);\n  const msg = (c.commit && c.commit.message) ? c.commit.message.split('\\n')[0] : 'no message';\n  const author = (c.commit && c.commit.author && c.commit.author.name) ? c.commit.author.name : 'unknown';\n  const date = (c.commit && c.commit.author && c.commit.author.date) ? c.commit.author.date.substring(0, 10) : '';\n  return `- [${sha}] ${msg} (${author}, ${date})`;\n}).join('\\n');\n\n// Format closed issues summary\nconst issueSummary = closedIssues.slice(0, 20).map(issue => {\n  const num = issue.number;\n  const title = issue.title || 'untitled';\n  const closedAt = issue.closed_at ? issue.closed_at.substring(0, 10) : '';\n  const labels = (issue.labels || []).map(l => l.name).join(', ');\n  return `- #${num}: ${title}${labels ? ` [${labels}]` : ''} (closed ${closedAt})`;\n}).join('\\n');\n\n// Format merged PRs summary\nconst prSummary = mergedPRs.slice(0, 20).map(pr => {\n  const num = pr.number;\n  const title = pr.title || 'untitled';\n  const author = (pr.user && pr.user.login) ? pr.user.login : 'unknown';\n  const mergedAt = pr.merged_at ? pr.merged_at.substring(0, 10) : '';\n  return `- #${num}: ${title} by @${author} (merged ${mergedAt})`;\n}).join('\\n');\n\n// Build stats\nconst stats = {\n  commits: commits.length,\n  closedIssues: closedIssues.length,\n  mergedPRs: mergedPRs.length,\n};\n\n// Build the language instruction\nconst langInstruction = language === 'FR'\n  ? 'Write the summary in French.'\n  : 'Write the summary in English.';\n\n// Build the user prompt\nconst userPrompt = `You are a developer productivity assistant. Generate a concise, narrative weekly summary for the GitHub repository \"${repo}\".\n\n${langInstruction}\n\nHere is the activity data for the past 7 days:\n\n## Statistics\n- Commits: ${stats.commits}\n- Closed Issues: ${stats.closedIssues}\n- Merged Pull Requests: ${stats.mergedPRs}\n\n## Recent Commits (up to 30)\n${commitSummary || 'No commits this week.'}\n\n## Closed Issues (up to 20)\n${issueSummary || 'No issues closed this week.'}\n\n## Merged Pull Requests (up to 20)\n${prSummary || 'No PRs merged this week.'}\n\nWrite a 3-5 paragraph narrative summary that:\n1. Opens with a one-sentence overview of the week's activity level\n2. Highlights the most notable changes, features, or fixes\n3. Mentions any significant contributors\n4. Closes with a brief outlook or notable patterns\n\nKeep it clear and factual. Format using plain text suitable for Slack (no markdown headers, use *bold* for emphasis).`;\n\nreturn [{\n  json: {\n    apiKey: vars.ANTHROPIC_API_KEY,\n    slackWebhook: vars.SLACK_WEBHOOK_URL,\n    repo: repo,\n    language: language,\n    stats: stats,\n    userPrompt: userPrompt,\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Claude API Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 1024,
          "messages": [
            {
              "role": "user",
              "content": "={{ $json.userPrompt }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          },
          "timeout": 60000
        }
      }
    },
    {
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Format Data for Claude').first().json.slackWebhook }}",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "text": "=*Weekly GitHub Summary: {{ $('Format Data for Claude').first().json.repo }}*\n\n{{ $json.content[0].text }}\n\n_Stats: {{ $('Format Data for Claude').first().json.stats.commits }} commits | {{ $('Format Data for Claude').first().json.stats.closedIssues }} issues closed | {{ $('Format Data for Claude').first().json.stats.mergedPRs }} PRs merged_"
        },
        "options": {}
      }
    }
  ],
