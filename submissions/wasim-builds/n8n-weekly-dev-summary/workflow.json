{
  "name": "Weekly Dev Summary - Claude + GitHub",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "value": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{ $json.repository || 'owner/repo' }}/commits",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({weeks: 1}).toISO() }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{ $json.repository || 'owner/repo' }}/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({weeks: 1}).toISO() }}"
            },
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{ $json.repository || 'owner/repo' }}/pulls",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "closed"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "operation": "summarize",
        "model": "claude-3-5-sonnet-20240620",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a technical writer. Generate a concise weekly development summary from GitHub activity. Focus on: shipped features, bug fixes, and notable refactors. Output in markdown."
            },
            {
              "role": "user",
              "content": "Generate a weekly dev summary from this GitHub activity.\n\nCommits (7d):\n{{ $json.commits.map(c => `- ${c.sha.slice(0,7)} ${c.commit.message.split('\\n')[0]}`).join('\\n') }}\n\nClosed Issues (7d):\n{{ $json.issues.map(i => `- #${i.number} ${i.title}`).join('\\n') }}\n\nMerged PRs (7d):\n{{ $json.prs.map(p => `- #${p.number} ${p.title} (by @${p.user.login})`).join('\\n') }}\n\nFormat: title, 3-5 bullet highlights, and a short outlook."
            }
          ]
        },
        "options": {
          "maxTokens": 1000
        }
      },
      "id": "claude-summary",
      "name": "Claude Summary",
      "type": "n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "content": "={{ $json.output }}",
        "options": {
          "raw": true
        }
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "channelId": {
          "__rl": true,
          "value": "channel-id",
          "mode": "list"
        },
        "text": "📋 *Weekly Dev Summary*\n\n{{ $json.content }}\n\n_Generated by n8n + Claude Code_",
        "otherOptions": {
          "linkNames": false,
          "parseMode": "MarkdownV2"
        }
      },
      "id": "slack-delivery",
      "name": "Deliver to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "sendTo": "admin@example.com",
        "subject": "📋 Weekly Dev Summary - {{ $now.format('YYYY-MM-DD') }}",
        "message": "Weekly dev summary:\n\n{{ $json.content }}\n\n— Sent via n8n + Claude Code",
        "options": {
          "priority": "normal"
        }
      },
      "id": "email-delivery",
      "name": "Deliver via Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1120,
        400
      ]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Merged PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Merged PRs": {
      "main": [
        [
          {
            "node": "Claude Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary": {
      "main": [
        [
          {
            "node": "Format Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Output": {
      "main": [
        [
          {
            "node": "Deliver to Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Deliver via Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
