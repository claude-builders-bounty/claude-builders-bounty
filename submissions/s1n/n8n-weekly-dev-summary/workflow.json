      "id": "f5ce2f88-274b-563c-b935-68540d5f1b00",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $json;\nconst sinceDate = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst since = sinceDate.toISOString();\nconst until = new Date().toISOString();\nconst owner = String(cfg.GITHUB_OWNER || '').trim();\nconst repo = String(cfg.GITHUB_REPO || '').trim();\nif (!owner || !repo) {\n  throw new Error('Set GITHUB_OWNER and GITHUB_REPO in the Config node');\n}\nreturn [{\n  json: {\n    ...cfg,\n    owner,\n    repo,\n    full_name: `${owner}/${repo}`,\n    since,\n    until,\n    language: String(cfg.LANGUAGE || 'EN').toUpperCase() === 'FR' ? 'FR' : 'EN',\n    maxItems: Number(cfg.MAX_ITEMS || 40)\n  }\n}];"
      },
      "id": "2883d689-0684-5c30-b13e-a70bb26a38dc",
      "name": "Compute Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{$json.since}}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "User-Agent",
              "value": "s1n-n8n-weekly-summary"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "response": {
                "neverError": true
              }
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "b2e3094f-39fe-5cb4-9e31-f6cc5602eba5",
