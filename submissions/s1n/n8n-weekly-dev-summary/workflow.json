    {
      "parameters": {
        "mode": "chooseBranch",
        "numberInputs": 3
      },
      "id": "29fd1f0c-06a4-571d-b997-b6626098ce37",
      "name": "Wait All GitHub",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "function asArray(data) {\n  if (data == null) return [];\n  if (Array.isArray(data)) return data;\n  if (Array.isArray(data.body)) return data.body;\n  // n8n may expand array responses into multiple items\n  return [data];\n}\n\nconst win = $('Compute Window').first().json;\nconst sinceMs = Date.parse(win.since);\nconst maxItems = win.maxItems || 40;\n\n// Prefer named node outputs (reliable) over merge payload shape\nconst commitItems = asArray($('GitHub Commits').all().map(i => i.json)).flatMap(asArray);\nconst issueItems = asArray($('GitHub Closed Issues').all().map(i => i.json)).flatMap(asArray);\nconst prItems = asArray($('GitHub Closed PRs').all().map(i => i.json)).flatMap(asArray);\n\nconst commits = commitItems\n  .filter(c => c && c.sha && c.commit)\n  .slice(0, maxItems)\n  .map(c => ({\n    sha: String(c.sha).slice(0, 7),\n    message: String(c.commit.message || '').split('\\n')[0].slice(0, 160),\n    author: c.commit.author?.name || c.author?.login || 'unknown',\n    date: c.commit.author?.date || null\n  }));\n\nconst closed_issues = issueItems\n  .filter(i => i && i.number && !i.pull_request && i.state === 'closed')\n  .filter(i => {\n    const t = Date.parse(i.closed_at || i.updated_at || 0);\n    return !Number.isNaN(t) ? t >= sinceMs : true;\n  })\n  .slice(0, maxItems)\n  .map(i => ({\n    number: i.number,\n    title: String(i.title || '').slice(0, 160),\n    labels: (i.labels || []).map(l => l.name).slice(0, 5)\n  }));\n\nconst merged_prs = prItems\n  .filter(p => p && p.number && p.merged_at)\n  .filter(p => Date.parse(p.merged_at) >= sinceMs)\n  .slice(0, maxItems)\n  .map(p => ({\n    number: p.number,\n    title: String(p.title || '').slice(0, 160),\n    user: p.user?.login || 'unknown',\n    merged_at: p.merged_at\n  }));\n\nconst activity = {\n  repo: win.full_name,\n  window: { since: win.since, until: win.until },\n  counts: {\n    commits: commits.length,\n    closed_issues: closed_issues.length,\n    merged_prs: merged_prs.length\n  },\n  commits,\n  closed_issues,\n  merged_prs\n};\n\nconst langName = win.language === 'FR' ? 'French' : 'English';\nconst prompt = [\n  `You are a staff engineering writer.`,\n  `Write a concise weekly development narrative in ${langName}.`,\n  `Repo: ${activity.repo}`,\n  `Window: ${activity.window.since} \u2192 ${activity.window.until}`,\n  `Rules:`,\n  `- Use ONLY the activity JSON below. Do not invent commits/PRs/issues.`,\n  `- Structure with short headings: Highlights, Shipped, Fixes & Closed Issues, Follow-ups.`,\n  `- Max ~350 words. Neutral professional tone.`,\n  `- If activity is empty, say so clearly and suggest checking repo/token/window.`,\n  ``,\n  `ACTIVITY_JSON:`,\n  JSON.stringify(activity, null, 2)\n].join('\\n');\n\nreturn [{\n  json: {\n    model: win.CLAUDE_MODEL || 'claude-sonnet-4-20250514',\n    delivery: String(win.DELIVERY || 'discord').toLowerCase(),\n    webhook: win.DISCORD_WEBHOOK_URL,\n    language: win.language,\n    activity,\n    prompt\n  }\n}];"
      },
      "id": "422b9288-b487-56c0-b418-5894b5262849",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, max_tokens: 900, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {}
      },
      "id": "9e55a2ff-526d-5a37-8b8e-c0a7cc3b35e4",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ANTHROPIC_X_API_KEY",
          "name": "Anthropic (x-api-key header)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const claude = $json;\nconst built = $('Build Prompt').first().json;\nconst text = Array.isArray(claude.content)\n  ? claude.content.map(c => c.text || '').join('\\n').trim()\n  : String(claude.content || claude.error || JSON.stringify(claude)).slice(0, 2000);\n\nconst counts = built.activity.counts;\nconst header = `**Weekly Dev Summary \u2014 ${built.activity.repo}**\\n` +\n  `_Window: ${built.activity.window.since.slice(0,10)} \u2192 ${built.activity.window.until.slice(0,10)} \u00b7 ` +\n  `${counts.commits} commits \u00b7 ${counts.merged_prs} merged PRs \u00b7 ${counts.closed_issues} closed issues \u00b7 lang ${built.language}_\\n\\n`;\n\nconst content = (header + text).slice(0, 1900);\nreturn [{\n  json: {\n    content,\n    webhook: built.webhook,\n    delivery: built.delivery,\n    activity: built.activity,\n    summary_text: text\n  }\n}];"
      },
      "id": "bed15f20-fdf3-5d76-bc2a-25a86291a0df",
