      "id": "87b87e67-3892-5a1a-b46d-4a6df47f475f",
      "name": "GitHub Closed PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        460
      ],
