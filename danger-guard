#!/usr/bin/env python3
"""Claude Code pre-tool-use hook: blocks dangerous bash commands."""
import sys, os, json, re, time

LOG_FILE = os.path.expanduser('~/.claude/hooks/blocked.log')
DANGEROUS = [
    (r'rm\s+-rf\s+/', 'recursive force delete on root directory'),
    (r'rm\s+-rf\s+\S', 'recursive force delete'),
    (r'DROP\s+TABLE', 'DROP TABLE — permanent table deletion'),
    (r'TRUNCATE\s+(TABLE\s+)?\S', 'TRUNCATE — removes all rows'),
    (r'DELETE\s+FROM\s+\S+(?!.*WHERE)', 'DELETE FROM without WHERE clause'),
    (r'git\s+push\s+--force\s+(origin\s+)?(main|master)', 'force push to main/master'),
    (r'git\s+push\s+-f\s+(origin\s+)?(main|master)', 'force push to main/master'),
    (r'chmod\s+-R\s+777\s+/', 'recursive 777 on root'),
]

def main():
    try:
        data = json.load(sys.stdin)
    except:
        sys.exit(0)
    
    command = data.get('command', '')
    project = data.get('cwd', os.getcwd())
    
    for pattern, reason in DANGEROUS:
        if re.search(pattern, command, re.IGNORECASE):
            timestamp = time.strftime('%Y-%m-%d %H:%M:%S')
            log_entry = f'[{timestamp}] BLOCKED | Project: {project} | Command: {command} | Reason: {reason}'
            
            os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
            with open(LOG_FILE, 'a') as f:
                f.write(log_entry + '\n')
            
            result = {
                'decision': 'block',
                'message': f'BLOCKED: {reason}\nCommand: {command}\n\nThis command has been blocked and logged. Use a safer alternative.'
            }
            print(json.dumps(result))
            sys.exit(0)
    
    print(json.dumps(data))
    sys.exit(0)

if __name__ == '__main__':
    main()
