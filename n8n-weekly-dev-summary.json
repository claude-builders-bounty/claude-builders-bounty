{
  "name": "Weekly Dev Summary",
  "nodes": [
    {
      "id": "c1f2a3b4-5d6e-7f8a-9b0c-1d2e3f4a5b6c",
      "name": "Weekly Cron (Friday 5pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": ["everyWeek"],
          "weeklyOn": [5],
          "hour": 17,
          "minute": 0
        }
      }
    },
    {
      "id": "d2e3f4a5-6b7c-8d9e-0f1a-2b3c4d5e6f7a",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [200, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repoOwner",
              "value": "owner"
            },
            {
              "name": "repoName",
              "value": "repo"
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "webhookUrl",
              "value": "https://discord.com/api/webhooks/placeholder"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e3f4a5b6-7c8d-9e0f-1a2b-3c4d5e6f7a8b",
      "name": "GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 100],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $node[\"Set Variables\"].json.repoOwner }}/{{ $node[\"Set Variables\"].json.repoName }}/commits?since={{ $now.minus({ days: $now.weekday + 6 }).toFormat(\"yyyy-MM-dd\") }}&per_page=50",
        "authentication": "none",
        "sendQuery": false,
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "f4a5b6c7-8d9e-0f1a-2b3c-4d5e6f7a8b9c",
      "name": "GitHub Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $node[\"Set Variables\"].json.repoOwner }}/{{ $node[\"Set Variables\"].json.repoName }}/issues?state=closed&since={{ $now.minus({ days: $now.weekday + 6 }).toFormat(\"yyyy-MM-dd\") }}&per_page=50",
        "authentication": "none",
        "sendQuery": false,
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "a5b6c7d8-9e0f-1a2b-3c4d-5e6f7a8b9c0d",
      "name": "GitHub PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 500],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $node[\"Set Variables\"].json.repoOwner }}/{{ $node[\"Set Variables\"].json.repoName }}/pulls?state=closed&since={{ $now.minus({ days: $now.weekday + 6 }).toFormat(\"yyyy-MM-dd\") }}&per_page=50",
        "authentication": "none",
        "sendQuery": false,
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "b6c7d8e9-0f1a-2b3c-4d5e-6f7a8b9c0d1e",
      "name": "Merge Commits & Issues",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [600, 200],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "c7d8e9f0-1a2b-3c4d-5e6f-7a8b9c0d1e2f",
      "name": "Merge with PRs",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [800, 300],
      "parameters": {
        "mode": "combine",
        "combinationMode": "append"
      }
    },
    {
      "id": "d8e9f0a1-2b3c-4d5e-6f7a-8b9c0d1e2f3a",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendBody": true,
        "bodyContentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 2000
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"Generate a weekly development summary in {{ $node[\\\"Set Variables\\\"].json.language }} for {{ $node[\\\"Set Variables\\\"].json.repoOwner }}/{{ $node[\\\"Set Variables\\\"].json.repoName }}.\\n\\nCommits this week:\\n{{ JSON.stringify($node[\\\"GitHub Commits\\\"].json) }}\\n\\nClosed issues this week:\\n{{ JSON.stringify($node[\\\"GitHub Issues\\\"].json) }}\\n\\nMerged PRs this week:\\n{{ JSON.stringify($node[\\\"GitHub PRs\\\"].json) }}\\n\\nFormat as a narrative with sections: Key achievements, Challenges, Next week focus.\"}]"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $node[\"Set Variables\"].json.claudeApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "e9f0a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b",
      "name": "Send to Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Set Variables\"].json.webhookUrl }}",
        "authentication": "none",
        "sendBody": true,
        "bodyContentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f0a1b2c3-4d5e-6f7a-8b9c-0d1e2f3a4b5c",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1400, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\":true,\"message\":\"Weekly dev summary generated and sent.\"}"
      }
    }
  ],
  "connections": {
    "Weekly Cron (Friday 5pm)": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "GitHub Commits",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Commits": {
      "main": [
        [
          {
            "node": "Merge Commits & Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Issues": {
      "main": [
        [
          {
            "node": "Merge Commits & Issues",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Commits & Issues": {
      "main": [
        [
          {
            "node": "Merge with PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub PRs": {
      "main": [
        [
          {
            "node": "Merge with PRs",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge with PRs": {
      "main": [
        [
          {
            "node": "Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude API": {
      "main": [
        [
          {
            "node": "Send to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Webhook": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "weekly-dev-summary",
  "tags": []
}
