{
  "name": "Weekly Dev Summary with Claude Code",
  "nodes": [
    {
      "parameters": {
        "rules": [
          {
            "rule": {
              "interval": 7,
              "mode": "days"
            }
          }
        ]
      },
      "id": "trigger-node",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Collect repo info from env\nconst repos = ($env.GITHUB_REPOS || '').split(',');\nconst days = 7;\nconst since = new Date(Date.now() - days * 24 * 60 * 60 * 1000).toISOString();\nreturn repos.map(repo => ({ repo: repo.trim(), since }));"
      },
      "id": "setup-node",
      "name": "Setup Request Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/={{ $json.repo }}/commits?since={{ $json.since }}&per_page=50",
        "options": {},
        "sendQuery": false,
        "sendBody": false,
        "authentication": "genericCredentialType",
        "nodeCredentialType": "githubApi"
      },
      "id": "github-node",
      "name": "Fetch GitHub Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const repo = $input.all()[0].json.repo;\nconst commits = $input.all().slice(1).map(i => i.json);\n\nlet summary = `## Weekly Dev Summary\n\n`;\nsummary += `**Repository:** ${repo}\\n`;\nsummary += `**Period:** last 7 days\\n`;\nsummary += `**Commits:** ${commits.length}\\n\\n`;\n\ncommits.forEach(c => {\n  summary += `- \\`${(c.sha || '').substring(0, 7)}\\` ${(c.commit?.message || '').split('\\n')[0]}\\n`;\n});\n\nsummary += `\\n---\\n_Generated by Claude Code + n8n_`;\n\nreturn { summary, repo, commitCount: commits.length };"
      },
      "id": "format-node",
      "name": "Format Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": 2000 },
            {
              "name": "messages",
              "value": "=[\n  {\n    \"role\": \"user\",\n    \"content\": \"Generate a concise weekly dev summary from these commits. Group by theme and highlight key changes.\\n\\n\" + $json.summary\n  }\n]"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none"
      },
      "id": "claude-node",
      "name": "Claude Code Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst content = response.content?.[0]?.text || JSON.stringify(response);\nreturn { report: content };"
      },
      "id": "extract-node",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "subject": "={{ \"Weekly Dev Summary - \" + $now.format('yyyy-MM-dd') }}",
        "textBody": "={{ $json.report }}",
        "options": {}
      },
      "id": "email-node",
      "name": "Send Email Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1450, 300]
    }
  ],
  "connections": {
    "Weekly Trigger": { "main": [[ { "node": "Setup Request Data", "type": "main", "index": 0 } ]] },
    "Setup Request Data": { "main": [[ { "node": "Fetch GitHub Commits", "type": "main", "index": 0 } ]] },
    "Fetch GitHub Commits": { "main": [[ { "node": "Format Commits", "type": "main", "index": 0 } ]] },
    "Format Commits": { "main": [[ { "node": "Claude Code Summary", "type": "main", "index": 0 } ]] },
    "Claude Code Summary": { "main": [[ { "node": "Extract Summary", "type": "main", "index": 0 } ]] },
    "Extract Summary": { "main": [[ { "node": "Send Email Report", "type": "main", "index": 0 } ]] }
  },
  "active": false,
  "settings": {},
  "tags": ["claude-code", "weekly-summary", "automation"],
  "versionId": "1.0.0"
}
