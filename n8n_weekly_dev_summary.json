      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [320, 500]
    },
    {
      "parameters": {
        "jsCode": "// Compile GitHub data into a summary prompt\nconst commits = $input.first()?.json || [];\nconst issues = $('Fetch Closed Issues').first()?.json || [];\nconst prs = $('Fetch Merged PRs').first()?.json || [];\n\nconst lastWeek = new Date();\nlastWeek.setDate(lastWeek.getDate() - 7);\nconst weekStr = lastWeek.toISOString().split('T')[0];\n\nconst commitList = commits.map(c => `- ${c.commit.message.split('\\n')[0]} (@${c.author?.login || 'unknown'})`).join('\\n');\nconst issueList = issues.map(i => `- [#${i.number}] ${i.title} (closed)`).join('\\n');\nconst prList = prs.filter(p => p.merged_at).map(p => `- [#${p.number}] ${p.title} (merged by @${p.user?.login})`).join('\\n');\n\nconst prompt = `Write a concise weekly development summary in ${$env.LANGUAGE || 'English'} based on this week's GitHub activity for ${$env.GITHUB_REPO}.\n\n## Commits (${commits.length})\n${commitList || '- No commits this week'}\n\n## Closed Issues (${issues.length})\n${issueList || '- No closed issues'}\n\n## Merged PRs (${prs.filter(p => p.merged_at).length})\n${prList || '- No merged PRs'}\n\nFormat as a friendly team update, 3-5 paragraphs. Highlight significant achievements. Use a warm but professional tone.`;\n\nreturn [{ json: { prompt, week: weekStr, counts: { commits: commits.length, issues: issues.length, prs: prs.filter(p => p.merged_at).length } } }];"
      },
      "id": "compile-prompt",
      "name": "Compile Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 350]
    },
