{
  "name": "Weekly GitHub Dev Summary (Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Schedule Trigger (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "github_owner",
              "value": "your-github-username"
            },
            {
              "name": "github_repo",
              "value": "your-repo-name"
            },
            {
              "name": "discord_webhook",
              "value": "https://discord.com/api/webhooks/..."
            },
            {
              "name": "language",
              "value": "English"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Config Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "=https://api.github.com/repos/{{$json.github_owner}}/{{$json.github_repo}}/commits?since={{$today.minus(7, 'days').toISO()}}",
        "options": {}
      },
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [400, 0]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "=https://api.github.com/repos/{{$json.github_owner}}/{{$json.github_repo}}/issues?state=closed&since={{$today.minus(7, 'days').toISO()}}",
        "options": {}
      },
      "name": "Fetch Closed Issues/PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [600, 0]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20240620"
            },
            {
              "name": "max_tokens",
              "value": "1000"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"You are a senior developer. Please write a weekly narrative summary of the following GitHub activity for the week in {{$node['Set Config Variables'].json.language}}. Highlight major features and bugs fixed. Be highly readable. Commits: {{$node['Fetch Commits'].json}} Closed Issues/PRs: {{$node['Fetch Closed Issues/PRs'].json}}\"}]"
            }
          ]
        },
        "options": {}
      },
      "name": "Anthropic Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 0]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "url": "={{$node['Set Config Variables'].json.discord_webhook}}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{$json.content[0].text}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 0]
    }
  ],
  "connections": {
    "Schedule Trigger (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Set Config Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Config Variables": {
      "main": [
        [
          {
            "node": "Fetch Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [
        [
          {
            "node": "Fetch Closed Issues/PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Closed Issues/PRs": {
      "main": [
        [
          {
            "node": "Anthropic Claude API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic Claude API": {
      "main": [
        [
          {
            "node": "Send Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}