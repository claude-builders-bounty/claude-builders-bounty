From c036e278dd950aaa09877dda75d063596050c6ef Mon Sep 17 00:00:00 2001
From: codeboost-tr <codeboost.tr@gmail.com>
Date: Tue, 9 Jun 2026 08:08:17 +0300
Subject: [PATCH] fix(mcp-server): correct type paths in exports metadata

This change updates the 'types' fields in package.json exports to point to the compiled .d.ts files instead of .ts source files, fixing module resolution issues for TypeScript consumers.
---
 packages/mcp-cloudflare/package.json |  2 +-
 packages/mcp-core/package.json       | 56 ++++++++++++++--------------
 packages/mcp-server/package.json     |  4 +-
 3 files changed, 31 insertions(+), 31 deletions(-)

diff --git a/packages/mcp-cloudflare/package.json b/packages/mcp-cloudflare/package.json
index 91c1f694..96512f91 100644
--- a/packages/mcp-cloudflare/package.json
+++ b/packages/mcp-cloudflare/package.json
@@ -9,7 +9,7 @@
   ],
   "exports": {
     ".": {
-      "types": "./dist/index.ts",
+      "types": "./dist/index.d.ts",
       "default": "./dist/index.js"
     }
   },
