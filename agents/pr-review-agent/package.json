{
  "name": "claude-review",
  "version": "0.1.0",
  "description": "Claude Code sub-agent that takes a PR diff and returns a structured Markdown review",
  "type": "module",
  "bin": {
    "claude-review": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "test:smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
