#!/usr/bin/env python3
"""Generate a structured Markdown review for a GitHub pull request."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable


PR_RE = re.compile(r"^https://github\.com/(?P<owner>[^/]+)/(?P<repo>[^/]+)/pull/(?P<number>\d+)")


@dataclass
class FileChange:
    path: str
    added: int = 0
    removed: int = 0
    hunks: int = 0
    risks: list[str] = field(default_factory=list)
    suggestions: list[str] = field(default_factory=list)


@dataclass
class PullRequest:
    url: str
    owner: str
    repo: str
    number: str
    title: str = "Pull request"
    body: str = ""
    diff: str = ""


def parse_pr_url(url: str) -> tuple[str, str, str]:
    match = PR_RE.match(url.strip())
    if not match:
        raise ValueError("Expected PR URL like https://github.com/owner/repo/pull/123")
    return match.group("owner"), match.group("repo"), match.group("number")


def run_gh(args: list[str]) -> str | None:
    try:
        completed = subprocess.run(
            ["gh", *args],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
        )
        return completed.stdout
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None


def fetch_url(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": "claude-review-agent"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8", errors="replace")


def fetch_pr(pr_url: str) -> PullRequest:
    owner, repo, number = parse_pr_url(pr_url)
    pr = PullRequest(url=pr_url, owner=owner, repo=repo, number=number)

    gh_json = run_gh(
        [
            "pr",
            "view",
            number,
            "--repo",
            f"{owner}/{repo}",
            "--json",
            "title,body",
        ]
    )
    if gh_json:
        data = json.loads(gh_json)
        pr.title = data.get("title") or pr.title
        pr.body = data.get("body") or ""
    else:
        try:
            data = json.loads(fetch_url(f"https://api.github.com/repos/{owner}/{repo}/pulls/{number}"))
            pr.title = data.get("title") or pr.title
            pr.body = data.get("body") or ""
        except (urllib.error.URLError, json.JSONDecodeError):
            pass

    gh_diff = run_gh(["pr", "diff", number, "--repo", f"{owner}/{repo}"])
    pr.diff = gh_diff if gh_diff is not None else fetch_url(f"{pr_url}.diff")
    return pr


def iter_changed_files(diff: str) -> Iterable[FileChange]:
    current: FileChange | None = None

    for line in diff.splitlines():
        if line.startswith("diff --git "):
            if current:
                yield current
            parts = line.split()
            path = parts[3][2:] if len(parts) >= 4 and parts[3].startswith("b/") else "unknown"
            current = FileChange(path=path)
            continue

        if current is None:
            continue

        if line.startswith("@@"):
            current.hunks += 1
        elif line.startswith("+") and not line.startswith("+++"):
            current.added += 1
            inspect_added_line(current, line[1:])
        elif line.startswith("-") and not line.startswith("---"):
            current.removed += 1

    if current:
        yield current


def inspect_added_line(change: FileChange, line: str) -> None:
    lowered = line.lower()
    stripped = line.strip()

    if re.search(r"\b(todo|fixme|hack)\b", lowered):
        change.risks.append("Introduces TODO/FIXME/HACK markers that may hide incomplete behavior.")

    if re.search(r"\b(password|secret|token|api[_-]?key)\b", lowered) and re.search(r"['\"][^'\"]{8,}['\"]", line):
        change.risks.append("Adds a string that looks like a hard-coded secret or token.")

    if "subprocess" in lowered or "shell=true" in lowered or "exec(" in lowered:
        change.risks.append("Adds command execution surface; input validation and shell escaping need review.")

    if re.search(r"\brm\s+-[a-z]*r[a-z]*f|\bgit\s+push\b.*--force|\bdrop\s+table\b", lowered):
        change.risks.append("Adds destructive command text; ensure it is guarded or used only in documentation/tests.")

    if re.search(r"\bexcept\s*:\s*$|\bcatch\s*\([^)]*\)\s*\{\s*\}", stripped):
        change.risks.append("Adds broad or empty error handling that may hide failures.")

    if len(line) > 160:
        change.suggestions.append("Consider wrapping very long lines to improve reviewability.")


def summarize_files(changes: list[FileChange]) -> str:
    if not changes:
        return "No file-level diff was available for this PR."

    top = sorted(changes, key=lambda item: item.added + item.removed, reverse=True)[:4]
    file_list = ", ".join(change.path for change in top)
    total_added = sum(change.added for change in changes)
    total_removed = sum(change.removed for change in changes)
    return f"The diff touches {len(changes)} file(s), led by {file_list}. It adds {total_added} line(s) and removes {total_removed} line(s)."


def infer_summary(pr: PullRequest, changes: list[FileChange]) -> str:
    title = pr.title.rstrip(".")
    file_summary = summarize_files(changes)
    return (
        f"This PR appears to implement: {title}. "
        f"{file_summary} "
        "The review below is based on static diff inspection, so runtime behavior and project-specific intent still need maintainer confirmation."
    )


def collect_risks(changes: list[FileChange]) -> list[str]:
    risks: list[str] = []

    total_added = sum(change.added for change in changes)
    total_removed = sum(change.removed for change in changes)
    if total_added + total_removed > 500:
        risks.append("Large diff size increases review risk; consider splitting if the changes are not tightly coupled.")

    if any(change.path.endswith((".yml", ".yaml")) and ".github/workflows/" in change.path for change in changes):
        risks.append("Workflow changes can alter CI permissions or secret exposure; verify triggers and token scopes.")

    if any("package.json" in change.path or change.path.endswith(("requirements.txt", "pyproject.toml")) for change in changes):
        risks.append("Dependency or script changes can affect installation, CI, or supply-chain behavior.")

    if not any("test" in change.path.lower() or "sample" in change.path.lower() for change in changes):
        risks.append("No obvious test or sample file changed; behavior may be under-validated.")

    seen: set[str] = set()
    for change in changes:
        for risk in change.risks:
            message = f"{change.path}: {risk}"
            if message not in seen:
                seen.add(message)
                risks.append(message)

    return risks or ["No major static risks found in the diff."]


def collect_suggestions(changes: list[FileChange]) -> list[str]:
    suggestions: list[str] = []

    if any(change.path.lower().endswith((".md", ".rst")) for change in changes):
        suggestions.append("Check that documentation examples were run or at least smoke-tested.")

    if any(change.path.endswith((".py", ".js", ".ts", ".tsx", ".go", ".rs")) for change in changes):
        suggestions.append("Run the repository's formatter, linter, and relevant unit tests before merge.")

    if any("test" not in change.path.lower() for change in changes) and not any("test" in change.path.lower() for change in changes):
        suggestions.append("Add or reference tests that cover the main behavior introduced by this PR.")

    seen: set[str] = set(suggestions)
    for change in changes:
        for suggestion in change.suggestions:
            message = f"{change.path}: {suggestion}"
            if message not in seen:
                seen.add(message)
                suggestions.append(message)

    return suggestions or ["No additional improvement suggestions from static analysis."]


def confidence(changes: list[FileChange], risks: list[str]) -> str:
    if not changes:
        return "Low"
    total = sum(change.added + change.removed for change in changes)
    if total > 500 or len(risks) >= 4:
        return "Low"
    if total > 200 or len(risks) >= 2:
        return "Medium"
    return "High"


def markdown_list(items: list[str]) -> str:
    return "\n".join(f"- {item}" for item in items)


def render_review(pr: PullRequest) -> str:
    changes = list(iter_changed_files(pr.diff))
    risks = collect_risks(changes)
    suggestions = collect_suggestions(changes)
    score = confidence(changes, risks)
    summary = infer_summary(pr, changes)

    changed_table = "\n".join(
        f"- `{change.path}`: +{change.added} / -{change.removed} across {change.hunks} hunk(s)"
        for change in changes[:12]
    )
    if len(changes) > 12:
        changed_table += f"\n- ...and {len(changes) - 12} more file(s)"
    if not changed_table:
        changed_table = "- No changed files detected."

    return (
        f"## PR Review: {pr.title}\n\n"
        f"Source: {pr.url}\n\n"
        "### Summary\n\n"
        f"{summary}\n\n"
        "### Changed Files\n\n"
        f"{changed_table}\n\n"
        "### Identified Risks\n\n"
        f"{markdown_list(risks)}\n\n"
        "### Improvement Suggestions\n\n"
        f"{markdown_list(suggestions)}\n\n"
        "### Confidence\n\n"
        f"{score}\n"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate a structured Markdown PR review.")
    parser.add_argument("--pr", required=True, help="GitHub PR URL, e.g. https://github.com/owner/repo/pull/123")
    parser.add_argument("--output", help="Optional path to write the Markdown review")
    args = parser.parse_args()

    try:
        review = render_review(fetch_pr(args.pr))
    except Exception as exc:  # noqa: BLE001 - CLI should report cleanly.
        print(f"claude-review: {exc}", file=sys.stderr)
        return 1

    if args.output:
        Path(args.output).parent.mkdir(parents=True, exist_ok=True)
        Path(args.output).write_text(review, encoding="utf-8")
    else:
        print(review)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
