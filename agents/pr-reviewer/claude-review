#!/usr/bin/env bash
# Claude Code PR Reviewer CLI wrapper
# Enables direct execution: claude-review --pr https://github.com/owner/repo/pull/123

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_EXEC="python3"

if ! command -v python3 >/dev/null 2>&1; then
    if command -v python >/dev/null 2>&1; then
        PYTHON_EXEC="python"
    else
        echo "Error: Python 3 is required to run claude-review." >&2
        exit 1
    fi
fi

exec "$PYTHON_EXEC" "$SCRIPT_DIR/claude_review.py" "$@"
