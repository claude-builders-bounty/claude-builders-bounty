#!/usr/bin/env bash
set -euo pipefail
PR_URL=""
for a in "$@"; do case "$a" in --pr=*) PR_URL="${a#--pr=}";; --pr) shift; PR_URL="$1";; http*) PR_URL="$a";; esac; done
[ -z "$PR_URL" ] && { echo "usage: claude-review --pr URL" >&2; exit 1; }
R="$(echo "$PR_URL" | sed -n 's#.*github.com/\([^/]*/[^/]*\)/pull/\([0-9]*\)#\1 \2#p')"
OWNER_REPO="${R%% *}"; NUM="${R##* }"
M="$(gh pr view "$NUM" --repo "$OWNER_REPO" --json title,additions,deletions,changedFiles,author)"
T="$(echo "$M"|jq -r .title)"; A="$(echo "$M"|jq -r .additions)"; D="$(echo "$M"|jq -r .deletions)"; F="$(echo "$M"|jq -r .changedFiles)"
cat <<EOF
## PR Review: $T
### Summary
+$A/-$D across $F files.
### Identified risks
- Review diff for secrets and large deletions.
### Improvement suggestions
- Add tests; document breaking changes.
### Confidence score: **Medium**
EOF
