#!/usr/bin/env python3
"""Structured PR review CLI for Claude Code workflows."""

from __future__ import annotations

import argparse
import json
import re
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Iterable


PR_RE = re.compile(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)")


@dataclass
class PullRequest:
    owner: str
    repo: str
    number: str
    title: str
    author: str
    changed_files: int
    additions: int
    deletions: int
    diff: str


def parse_pr_url(url: str) -> tuple[str, str, str]:
    match = PR_RE.fullmatch(url.strip())
    if not match:
        raise ValueError("Expected PR URL like https://github.com/owner/repo/pull/123")
    return match.group(1), match.group(2), match.group(3)


def github_get_json(url: str) -> dict:
    request = urllib.request.Request(url, headers={"User-Agent": "claude-review-agent"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def github_get_text(url: str) -> str:
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": "claude-review-agent",
            "Accept": "application/vnd.github.v3.diff",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8", errors="replace")


def fetch_pull_request(pr_url: str) -> PullRequest:
    owner, repo, number = parse_pr_url(pr_url)
    api_base = f"https://api.github.com/repos/{owner}/{repo}/pulls/{number}"
    meta = github_get_json(api_base)
    diff = github_get_text(f"{api_base}.diff")
    return PullRequest(
        owner=owner,
        repo=repo,
        number=number,
        title=meta.get("title", "(untitled)"),
        author=(meta.get("user") or {}).get("login", "unknown"),
        changed_files=int(meta.get("changed_files") or 0),
        additions=int(meta.get("additions") or 0),
        deletions=int(meta.get("deletions") or 0),
        diff=diff,
    )


def changed_paths(diff: str) -> list[str]:
    paths: list[str] = []
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            paths.append(line.removeprefix("+++ b/"))
        elif line.startswith("diff --git a/") and " b/" in line:
            paths.append(line.rsplit(" b/", 1)[1])
    return list(dict.fromkeys(paths))


def added_lines(diff: str) -> Iterable[str]:
    for line in diff.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            yield line[1:]


def risks_for(pr: PullRequest, paths: list[str], lines: list[str]) -> list[str]:
    risks: list[str] = []
    lower_paths = [path.lower() for path in paths]
    joined_lines = "\n".join(lines).lower()

    if pr.changed_files > 20 or pr.additions + pr.deletions > 1000:
        risks.append("Large change set may hide behavioral regressions; split or add focused tests if possible.")
    if any(path.endswith((".sql", "schema.prisma")) or "migration" in path for path in lower_paths):
        risks.append("Database or migration changes can affect existing production data and rollback safety.")
    if any(".github/workflows/" in path for path in lower_paths):
        risks.append("Workflow changes can alter CI, release, or permission behavior.")
    if any("auth" in path or "session" in path or "permission" in path for path in lower_paths):
        risks.append("Authentication or authorization paths need explicit negative-case tests.")
    if re.search(r"(api[_-]?key|secret|token|password)\s*[:=]\s*['\"][^'\"]+", joined_lines):
        risks.append("Potential hard-coded secret or credential-like value appears in added lines.")
    if re.search(r"\b(delete\s+from|drop\s+table|truncate)\b", joined_lines):
        risks.append("Destructive SQL appears in added lines; confirm WHERE clauses and migration safeguards.")
    if not risks:
        risks.append("No obvious high-risk pattern found from the diff; review should still check project-specific behavior.")
    return risks


def suggestions_for(pr: PullRequest, paths: list[str], lines: list[str]) -> list[str]:
    suggestions: list[str] = []
    lower_paths = [path.lower() for path in paths]
    has_tests = any(("test" in path or "spec" in path) for path in lower_paths)
    has_docs = any(path.endswith((".md", ".mdx")) for path in lower_paths)

    if not has_tests:
        suggestions.append("Add or update tests that exercise the new behavior and the main failure case.")
    if has_docs:
        suggestions.append("Verify documentation examples match the final command names, paths, and configuration.")
    if any(path.endswith((".py", ".ts", ".tsx", ".js", ".mjs")) for path in lower_paths):
        suggestions.append("Run the relevant formatter, type checker, and unit tests before merge.")
    if pr.changed_files > 10:
        suggestions.append("Consider grouping the review by feature area so maintainers can approve smaller parts confidently.")
    if not suggestions:
        suggestions.append("Keep the PR description tied to the acceptance criteria and include exact local verification commands.")
    return suggestions


def confidence_for(pr: PullRequest, paths: list[str], risks: list[str]) -> str:
    if pr.changed_files > 25 or pr.additions + pr.deletions > 1500:
        return "Low"
    if any("No obvious high-risk pattern" not in risk for risk in risks):
        return "Medium"
    if any("test" in path.lower() or "spec" in path.lower() for path in paths):
        return "High"
    return "Medium"


def render_review(pr: PullRequest) -> str:
    paths = changed_paths(pr.diff)
    lines = list(added_lines(pr.diff))
    risks = risks_for(pr, paths, lines)
    suggestions = suggestions_for(pr, paths, lines)
    confidence = confidence_for(pr, paths, risks)

    summary = (
        f"PR #{pr.number} in `{pr.owner}/{pr.repo}` changes {pr.changed_files} file(s) "
        f"with {pr.additions} additions and {pr.deletions} deletions. "
        f"The diff touches {', '.join(paths[:5]) if paths else 'no parsed file paths'}"
        f"{' and more' if len(paths) > 5 else ''}."
    )

    return "\n".join(
        [
            "## Claude PR Review",
            "",
            f"**PR:** #{pr.number} - {pr.title}",
            f"**Author:** @{pr.author}",
            "",
            "### Summary",
            summary,
            "",
            "### Identified Risks",
            *[f"- {risk}" for risk in risks],
            "",
            "### Improvement Suggestions",
            *[f"- {suggestion}" for suggestion in suggestions],
            "",
            f"### Confidence: {confidence}",
            "",
        ]
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Generate a structured Markdown review for a GitHub PR.")
    parser.add_argument("--pr", required=True, help="GitHub pull request URL")
    args = parser.parse_args(argv)

    try:
        pr = fetch_pull_request(args.pr)
    except (ValueError, urllib.error.URLError, urllib.error.HTTPError) as exc:
        print(f"claude-review: {exc}", file=sys.stderr)
        return 1

    print(render_review(pr))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
