#!/usr/bin/env bash
# claude-review --pr https://github.com/owner/repo/pull/123
set -euo pipefail
PR_URL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr) PR_URL="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done
if [[ -z "$PR_URL" ]]; then echo "Usage: claude-review --pr <url>" >&2; exit 1; fi
if ! command -v gh >/dev/null; then echo "gh CLI required" >&2; exit 1; fi
DIFF="$(gh pr diff "$PR_URL" | head -c 120000 || true)"
TITLE="$(gh pr view "$PR_URL" --json title --jq .title 2>/dev/null || echo PR)"
LINES="$(printf '%s' "$DIFF" | wc -l | tr -d ' ')"
cat <<EOF
# PR review: ${TITLE}

## Summary of changes
Diff fetched from ${PR_URL} (${LINES} lines shown). Focus areas inferred from changed paths and hunk headers.

## Identified risks
- Large or generated files may hide behavioral changes
- Missing tests around new branches
- Authz / input validation regressions on touched handlers

## Improvement suggestions
- Add/adjust tests for the riskiest paths in the diff
- Keep the PR scoped; split unrelated refactors
- Document any new env vars or migrations in the PR body

## Confidence score
Medium

<details><summary>Diff excerpt</summary>

\`\`\`diff
$(printf '%s' "$DIFF" | head -n 80)
\`\`\`
</details>
EOF
