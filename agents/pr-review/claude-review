#!/usr/bin/env python3
"""claude-review: Claude Code PR Review Agent.

Usage:
  claude-review --pr https://github.com/owner/repo/pull/123
  claude-review --pr <url> [--output review.md]
  claude-review --pr <url> --post     # also post comment to PR

Requires:
  export DEEPSEEK_API_KEY=sk-...
  export GITHUB_TOKEN=ghp_...
"""

import argparse
import os
import sys

from claude_review.fetcher import PRFetcher
from claude_review.reviewer import Reviewer
from claude_review.formatter import format_review


def main():
    parser = argparse.ArgumentParser(description="Claude Code PR Review Agent")
    parser.add_argument("--pr", required=True, help="GitHub PR URL")
    parser.add_argument("--output", help="Save review to file")
    parser.add_argument("--post", action="store_true", help="Post review as PR comment")
    parser.add_argument("--model", default=None, help="Override LLM model")
    args = parser.parse_args()

    deepseek_key = os.getenv("DEEPSEEK_API_KEY")
    github_token = os.getenv("GITHUB_TOKEN")

    if not deepseek_key:
        print("[ERROR] DEEPSEEK_API_KEY is required")
        sys.exit(1)
    if not github_token:
        print("[ERROR] GITHUB_TOKEN is required")
        sys.exit(1)

    # Step 1: Fetch PR
    print(f"[1/3] Fetching PR: {args.pr}")
    fetcher = PRFetcher(github_token)
    try:
        pr_data = fetcher.fetch_pr(args.pr)
    except Exception as e:
        print(f"[ERROR] Failed to fetch PR: {e}")
        sys.exit(1)

    print(f"       Files: {pr_data['files_changed']} | "
          f"+{pr_data['additions']} -{pr_data['deletions']}")

    # Step 2: Review
    print("[2/3] Generating review via DeepSeek...")
    reviewer = Reviewer(deepseek_key)
    review_text = reviewer.review(pr_data)

    # Step 3: Format & output
    print("[3/3] Formatting output...")
    output = format_review(pr_data, review_text)

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(output)
        print(f"       Review saved to: {args.output}")
    else:
        print()
        print(output)

    # Optional: post as comment
    if args.post:
        import httpx
        url = (f"https://api.github.com/repos/{pr_data['owner']}/{pr_data['repo']}"
               f"/issues/{pr_data['number']}/comments")
        headers = {
            "Authorization": f"token {github_token}",
            "Accept": "application/vnd.github.v3+json",
        }
        resp = httpx.post(url, headers=headers, json={"body": output}, timeout=30)
        if resp.status_code == 201:
            print(f"       Comment posted: {resp.json().get('html_url', '')}")
        else:
            print(f"       [WARN] Failed to post: {resp.status_code} {resp.text[:200]}")


if __name__ == "__main__":
    main()
