# Copy to .github/workflows/pr-structured-review.yml when your token has workflow scope.
name: pr-structured-review
on:
  pull_request:
    types: [opened, synchronize, reopened]
jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Run structured review script
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          chmod +x agents/pr-review/claude-review
          agents/pr-review/claude-review --pr "${{ github.event.pull_request.html_url }}" > /tmp/review.md
          cat /tmp/review.md >> "$GITHUB_STEP_SUMMARY"
