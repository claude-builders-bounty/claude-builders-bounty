#!/bin/bash
# Claude Code Agent: PR Review
# Analyzes a PR diff and generates a structured review

set -euo pipefail

PR_URL="${1:-}"
PR_NUMBER="${2:-}"

if [ -z "$PR_URL" ] && [ -z "$PR_NUMBER" ]; then
    echo "Usage: review-pr <pr-url>"
    echo "       review-pr <repo> <pr-number>"
    exit 1
fi

if [ -z "$PR_URL" ] && [ -n "$PR_NUMBER" ]; then
    PR_URL="https://github.com/${REPO:-claude-builders-bounty/claude-builders-bounty}/pull/$PR_NUMBER"
fi

echo "🔍 Analyzing PR: $PR_URL"
echo ""
echo "## PR Review"
echo ""

# Extract PR diff
DIFF=$(curl -sL -H "Accept: application/vnd.github.v3.diff" "$PR_URL.diff" 2>/dev/null || echo "")

if [ -z "$DIFF" ]; then
    echo "⚠️  Could not fetch diff. Make sure the PR is accessible."
    exit 1
fi

# Count changes
ADDITIONS=$(echo "$DIFF" | grep -c '^+[^+]' 2>/dev/null || echo "0")
DELETIONS=$(echo "$DIFF" | grep -c '^-[^-]' 2>/dev/null || echo "0")
FILES_CHANGED=$(echo "$DIFF" | grep -c '^diff --git' 2>/dev/null || echo "0")

echo "### Summary"
echo "- **Files changed:** $FILES_CHANGED"
echo "- **Additions:** $ADDITIONS"
echo "- **Deletions:** $DELETIONS"
echo ""

# Categorize files
echo "### Changed Files"
echo "$DIFF" | grep '^diff --git' | sed 's/diff --git a\/\(.*\) b\/.*/  - `\1`/' || true
echo ""

# Check for common issues
echo "### Checklist"

# Check for debug statements
if echo "$DIFF" | grep -q 'console\.log\|debugger\|print(\|println(' 2>/dev/null; then
    echo "- ⚠️  Contains debug statements (console.log, print, etc.)"
fi

# Check for TODO/FIXME comments
if echo "$DIFF" | grep -i -q 'TODO\|FIXME\|XXX' 2>/dev/null; then
    echo "- ℹ️  Contains TODO/FIXME comments"
fi

# Check for large files
LARGE_FILES=$(echo "$DIFF" | awk '/^diff --git/ {if (length > 0) print}' | wc -l)
if [ "$LARGE_FILES" -gt 10 ]; then
    echo "- ⚠️  Large PR (${LARGE_FILES}+ files). Consider splitting."
fi

# Check for test changes
if ! echo "$DIFF" | grep -q 'test\|spec\|__tests__' 2>/dev/null; then
    echo "- ⚠️  No test changes detected"
fi

echo ""
echo "### Recommendations"
echo "1. Ensure all new code follows project conventions"
echo "2. Verify backward compatibility"
echo "3. Check for proper error handling"
echo "4. Confirm documentation is updated if needed"
echo ""
echo "---"
echo "*Generated by claude-agent-pr-review*"
