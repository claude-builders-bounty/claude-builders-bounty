{
  "name": "QuickOps Weekly Dev Summary (Claude)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "repository",
        "operation": "get",
        "owner": "={{ $json.repo_owner }}",
        "repository": "={{ $json.repo_name }}"
      },
      "name": "GitHub Activity",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "claude-3-sonnet-20240229",
        "prompt": "=Generate a narrative weekly summary for the following GitHub activity: {{ $json.activity }}",
        "options": {
          "systemPrompt": "You are a senior technical writer. Create a professional, narrative summary of the week's commits, issues, and PRs."
        }
      },
      "name": "Claude AI",
      "type": "n8n-nodes-base.anthropicChatModel",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.webhook_url }}",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.message }}"
            }
          ]
        }
      },
      "name": "Discord/Slack Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [[{ "node": "GitHub Activity", "type": "main", "index": 0 }]]
    },
    "GitHub Activity": {
      "main": [[{ "node": "Claude AI", "type": "main", "index": 0 }]]
    },
    "Claude AI": {
      "main": [[{ "node": "Discord/Slack Notification", "type": "main", "index": 0 }]]
    }
  }
}
