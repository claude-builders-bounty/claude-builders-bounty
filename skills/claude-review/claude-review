#!/usr/bin/env python3
"""
claude-review — AI-powered PR review analysis CLI.
Fetches GitHub PR diffs and produces structured Markdown review output.
Minimal dependencies: only 'requests'.
"""

import argparse
import json
import os
import re
import sys
import textwrap
from collections import defaultdict

try:
    import requests
except ImportError:
    print("ERROR: 'requests' is required. Install with: pip install requests", file=sys.stderr)
    sys.exit(1)


# ── helpers ────────────────────────────────────────────────────────────

def get_github_token():
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        token = os.environ.get("GH_TOKEN")
    if token:
        return token
    try:
        token = input("GitHub token (or set GITHUB_TOKEN env var): ").strip()
        if token:
            return token
    except (EOFError, KeyboardInterrupt):
        pass
    print("ERROR: GitHub token required. Set GITHUB_TOKEN or GH_TOKEN.", file=sys.stderr)
    sys.exit(1)


def parse_pr_url(url):
    """Extract owner, repo, pr_number from a GitHub PR URL."""
    m = re.match(r'https?://github\.com/([^/]+)/([^/]+)/pull/(\d+)', url)
    if not m:
        print(f"ERROR: Invalid GitHub PR URL: {url}", file=sys.stderr)
        sys.exit(1)
    return m.group(1), m.group(2), int(m.group(3))


def build_headers(token):
    return {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3.diff",
        "User-Agent": "claude-review/1.0",
    }


def build_headers_json(token):
    h = build_headers(token)
    h["Accept"] = "application/vnd.github.v3+json"
    return h


def fetch_pr_diff(owner, repo, pr_number, token):
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    resp = requests.get(url, headers=build_headers(token))
    if resp.status_code == 404:
        print(f"ERROR: PR not found (404). Check URL and token scopes.", file=sys.stderr)
        sys.exit(1)
    if resp.status_code == 403:
        print(f"ERROR: API rate limited or insufficient permissions (403).", file=sys.stderr)
        sys.exit(1)
    if resp.status_code != 200:
        print(f"ERROR: GitHub API returned HTTP {resp.status_code}", file=sys.stderr)
        sys.exit(1)
    return resp.text


def fetch_pr_metadata(owner, repo, pr_number, token):
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}"
    resp = requests.get(url, headers=build_headers_json(token))
    if resp.status_code != 200:
        return {"title": "Unknown", "body": "", "changed_files": 0, "additions": 0, "deletions": 0}
    data = resp.json()
    return {
        "title": data.get("title", "Unknown"),
        "body": data.get("body") or "",
        "changed_files": data.get("changed_files", 0),
        "additions": data.get("additions", 0),
        "deletions": data.get("deletions", 0),
    }


def fetch_pr_files(owner, repo, pr_number, token):
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_number}/files"
    resp = requests.get(url, headers=build_headers_json(token))
    if resp.status_code != 200:
        return []
    return resp.json()


# ── diff parsing ───────────────────────────────────────────────────────

def parse_diff_per_file(diff_text):
    """Split unified diff into per-file chunks with metadata."""
    files = []
    current = None
    current_lines = []
    file_pat = re.compile(r'^diff --git a/(.+?) b/(.+?)$')
    hunk_pat = re.compile(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@')

    for line in diff_text.splitlines():
        m = file_pat.match(line)
        if m:
            if current is not None:
                files.append(_finalize_file(current, current_lines))
            current = {"old_path": m.group(1), "new_path": m.group(2)}
            current_lines = [line]
            continue
        if current is not None:
            current_lines.append(line)

    if current is not None:
        files.append(_finalize_file(current, current_lines))

    return files


def _finalize_file(info, lines):
    info["diff_lines"] = lines
    additions = 0
    deletions = 0
    for line in lines:
        if line.startswith("+") and not line.startswith("+++"):
            additions += 1
        elif line.startswith("-") and not line.startswith("---"):
            deletions += 1
    info["additions"] = additions
    info["deletions"] = deletions
    info["total_changes"] = additions + deletions
    return info


