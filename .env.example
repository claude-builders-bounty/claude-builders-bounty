# ============================================================
# n8n + Claude weekly dev summary — required env vars
# Set these in the n8n instance environment (self-hosted) or
# n8n Cloud -> Instance Settings -> Environment Variables.
# ============================================================

# --- Claude API -------------------------------------------------
# Direct: leave ANTHROPIC_BASE_URL as the Anthropic API.
# Proxy:  point at any Anthropic-compatible base URL, e.g. a local proxy.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx
# Any model the endpoint serves
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- GitHub ------------------------------------------------------
# Token needs: repo contents read + issues:write on the target repo
GITHUB_TOKEN=ghp_xxx
# Source repo: last-week activity (commits / closed issues / merged PRs)
WEEKLY_SUMMARY_REPO_URL=https://api.github.com/repos/YOUR_ORG/YOUR_REPO/commits?per_page=30
WEEKLY_SUMMARY_ISSUES_URL=https://api.github.com/repos/YOUR_ORG/YOUR_REPO/issues?state=closed&sort=updated&direction=desc&per_page=30
WEEKLY_SUMMARY_PRS_URL=https://api.github.com/repos/YOUR_ORG/YOUR_REPO/pulls?state=closed&sort=updated&direction=desc&per_page=30
# Where the summary is posted (issue comments API)
GITHUB_REPORT_URL=https://api.github.com/repos/YOUR_ORG/YOUR_REPO/issues/42/comments

# --- Summary language: EN or FR ---------------------------------
SUMMARY_LANGUAGE=EN

# --- Slack (optional, leave empty to skip) -----------------------
SLACK_WEBHOOK_URL=
