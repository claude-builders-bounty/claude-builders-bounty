              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"username\": \"Weekly Dev Summary Bot\",\n  \"avatar_url\": \"https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png\",\n  \"embeds\": [\n    {\n      \"title\": \"📊 Weekly Dev Summary — {{ $('Code: Format Data').item.json.repo }}\",\n      \"description\": {{ JSON.stringify($json.content[0].text.substring(0, 4000)) }},\n      \"color\": 5814783,\n      \"footer\": {\n        \"text\": \"Week of {{ $('Code: Format Data').item.json.weekStartStr }} · {{ $('Code: Format Data').item.json.commitCount }} commits · {{ $('Code: Format Data').item.json.prCount }} PRs · {{ $('Code: Format Data').item.json.issueCount }} issues closed\"\n      }\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    }
