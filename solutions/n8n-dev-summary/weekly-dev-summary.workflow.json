    {
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Code: Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Retrieve data from previous nodes\nconst vars = $('Set Variables').first().json;\nconst language = vars.LANGUAGE || 'EN';\nconst repo = vars.GITHUB_REPO || 'unknown/repo';\nconst weekStart = new Date(vars.WEEK_START);\nconst weekStartStr = weekStart.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });\n\n// Get commits\nlet commits = [];\ntry {\n  commits = $('HTTP Request: Get Commits').all().map(item => item.json).flat();\n  if (!Array.isArray(commits)) commits = [];\n} catch(e) { commits = []; }\n\n// Get issues (filter out PRs — GitHub returns PRs as issues too)\nlet allIssues = [];\ntry {\n  allIssues = $('HTTP Request: Get Issues').all().map(item => item.json).flat();\n  if (!Array.isArray(allIssues)) allIssues = [];\n} catch(e) { allIssues = []; }\nconst issues = allIssues.filter(i => !i.pull_request && new Date(i.closed_at) >= weekStart);\n\n// Get PRs — filter merged only within last 7 days\nlet allPRs = [];\ntry {\n  allPRs = $('HTTP Request: Get PRs').all().map(item => item.json).flat();\n  if (!Array.isArray(allPRs)) allPRs = [];\n} catch(e) { allPRs = []; }\nconst prs = allPRs.filter(pr => pr.merged_at && new Date(pr.merged_at) >= weekStart);\n\n// Format commit list\nconst commitLines = commits.slice(0, 20).map(c => {\n  const msg = c.commit && c.commit.message ? c.commit.message.split('\\n')[0] : 'No message';\n  const author = (c.commit && c.commit.author && c.commit.author.name) ? c.commit.author.name : 'Unknown';\n  return `- ${msg} (by ${author})`;\n}).join('\\n') || '- No commits this week';\n\n// Format PR list\nconst prLines = prs.slice(0, 20).map(pr => {\n  return `- ${pr.title} (#${pr.number})`;\n}).join('\\n') || '- No merged PRs this week';\n\n// Format issue list\nconst issueLines = issues.slice(0, 20).map(i => {\n  return `- ${i.title} (#${i.number})`;\n}).join('\\n') || '- No closed issues this week';\n\n// Build Claude prompt based on language\nconst langInstruction = language === 'FR'\n  ? 'Réponds UNIQUEMENT en français. La réponse doit être entièrement en français.'\n  : 'Respond ONLY in English.';\n\nconst prompt = `${langInstruction}\n\nYou are a developer advocate writing a weekly newsletter digest for engineers.\nBased on this GitHub repository activity for the week of ${weekStartStr}, write a compelling narrative summary.\n\nRepository: ${repo}\n\n## Commits this week (${commits.length} total):\n${commitLines}\n\n## Merged Pull Requests this week (${prs.length} total):\n${prLines}\n\n## Closed Issues this week (${issues.length} total):\n${issueLines}\n\n---\n\nWrite a narrative Markdown summary with:\n1. An opening paragraph summarizing the week's theme/highlights\n2. A **Commits (${commits.length})** section with brief narrative\n3. A **Merged PRs (${prs.length})** section listing each PR with a bullet\n4. A **Closed Issues (${issues.length})** section listing each issue with a bullet\n5. An **Overall** closing sentence\n\nStart the response with a header like:\n## 📊 Weekly Dev Summary — ${repo} (Week of ${weekStartStr})\n\nKeep the tone professional but friendly. Be concise.`;\n\nreturn [{\n  json: {\n    prompt,\n    repo,\n    weekStartStr,\n    language,\n    commitCount: commits.length,\n    prCount: prs.length,\n    issueCount: issues.length,\n    claudeApiKey: vars.CLAUDE_API_KEY,\n    discordWebhookUrl: vars.DISCORD_WEBHOOK_URL\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "HTTP Request: Claude API",
      "type": "n8n-nodes-base.httpRequest",
