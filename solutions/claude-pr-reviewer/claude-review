#!/usr/bin/env python3
import os
import sys
import json
import re
import urllib.request
import urllib.parse
import ssl

# Ensure UTF-8 output encoding
if sys.stdout.encoding != 'utf-8':
    try:
        sys.stdout.reconfigure(encoding='utf-8')
    except AttributeError:
        pass

def log(msg):
    print(f"[claude-review] {msg}", file=sys.stderr)

def parse_pr_url(pr_url):
    """
    Parses a GitHub PR URL and returns a dict with owner, repo, and pr_number.
    E.g. https://github.com/owner/repo/pull/123 -> {owner, repo, number}
    """
    match = re.search(r'github\.com/([^/]+)/([^/]+)/pull/(\d+)', pr_url)
    if not match:
        raise ValueError(f"Invalid GitHub PR URL: {pr_url}")
    return {
        "owner": match.group(1),
        "repo": match.group(2),
        "number": match.group(3)
    }

def get_pr_url_from_event():
    """
    If running inside a GitHub Action, try to read the PR URL from the event payload.
    """
    event_path = os.getenv("GITHUB_EVENT_PATH")
    if not event_path or not os.path.exists(event_path):
        return None
    try:
        with open(event_path, "r", encoding="utf-8") as f:
            event = json.load(f)
        # Pull request event
        if "pull_request" in event:
            return event["pull_request"].get("html_url")
        # Issue comment event on a PR
        if "issue" in event and "pull_request" in event["issue"]:
            return event["issue"]["pull_request"].get("html_url")
    except Exception as e:
        log(f"Warning: Failed to parse GITHUB_EVENT_PATH: {e}")
    return None

def fetch_diff(owner, repo, number, github_token=None):
    """
    Fetches the raw git diff of a PR from GitHub API.
    """
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{number}"
    headers = {
        "Accept": "application/vnd.github.v3.diff",
        "User-Agent": "claude-pr-reviewer-action"
    }
    if github_token:
        headers["Authorization"] = f"token {github_token}"

    log(f"Fetching diff from: {url}")
    req = urllib.request.Request(url, headers=headers)
    ctx = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(req, context=ctx) as resp:
            diff_bytes = resp.read()
            return diff_bytes.decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Failed to fetch PR diff from GitHub (HTTP {e.code}): {e.read().decode('utf-8', errors='replace')}")
    except Exception as e:
        raise RuntimeError(f"Failed to fetch PR diff from GitHub: {e}")

def call_claude(diff_text, anthropic_key, model="claude-3-5-sonnet-latest"):
    """
    Sends the diff to the Anthropic Claude API for review.
    """
    url = "https://api.anthropic.com/v1/messages"
    headers = {
        "x-api-key": anthropic_key,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
        "User-Agent": "claude-pr-reviewer-action"
    }

    # Count total files in original diff
    total_files = len(re.findall(r'^diff --git ', diff_text, re.MULTILINE))
    if total_files == 0 and diff_text.strip():
        total_files = 1

    # Truncate diff if it's extremely long to avoid exceeding context limits
    # 100,000 characters is a safe threshold (~25,000 tokens)
    if len(diff_text) > 100000:
        log("Warning: PR diff is very large. Truncating diff to fit context window.")
        diff_text = diff_text[:100000] + "\n\n[Diff truncated due to size limit]"

    # Count reviewed files in truncated diff
    reviewed_files = len(re.findall(r'^diff --git ', diff_text, re.MULTILINE))
    if reviewed_files == 0 and diff_text.strip():
        reviewed_files = 1
    
    system_prompt = (
        "You are an expert software engineer performing an automated code review.\n"
        "Analyze the provided Git diff of a Pull Request and return a structured review comment in Markdown.\n\n"
        "Your review MUST follow this exact structure:\n"
        "### Summary of Changes\n"
        "Provide a concise summary of the changes introduced in this PR (2-3 sentences max).\n\n"
        "### Identified Risks\n"
        "List any potential bugs, security issues, performance pitfalls, edge cases, or regression risks. If no risks are found, state 'No major risks identified.'\n\n"
        "### Improvement Suggestions\n"
        "List concrete, actionable suggestions to improve code quality, style, test coverage, or maintainability.\n\n"
        "### Confidence Score\n"
        f"State your confidence score exactly in the format: **Confidence score**: [Low / Medium / High] (reviewed {reviewed_files} of {total_files} files)\n\n"
        "Be constructive, professional, and focus only on the actual code diff provided."
    )

    payload = {
        "model": model,
        "max_tokens": 1500,
        "system": system_prompt,
        "messages": [
            {
                "role": "user",
                "content": f"Please review the following git diff of a Pull Request:\n\n```diff\n{diff_text}\n```"
            }
        ]
    }

    log(f"Calling Anthropic API with model '{model}'...")
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    ctx = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(req, context=ctx) as resp:
            resp_data = json.loads(resp.read().decode("utf-8"))
            review_md = resp_data["content"][0]["text"]
            
            # Post-process to ensure the file count metadata is always present next to the Confidence score
            pattern = r"(\*\*Confidence score\*\*:\s*(?:Low|Medium|High))(?!\s*\(reviewed)"
            replacement = f"\\1 (reviewed {reviewed_files} of {total_files} files)"
            review_md = re.sub(pattern, replacement, review_md, flags=re.IGNORECASE)
            return review_md
            
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Anthropic API call failed (HTTP {e.code}): {e.read().decode('utf-8', errors='replace')}")
    except Exception as e:
        raise RuntimeError(f"Anthropic API call failed: {e}")

def post_github_comment(owner, repo, number, body_text, github_token):
    """
    Posts the review as a comment on the PR on GitHub.
    """
    url = f"https://api.github.com/repos/{owner}/{repo}/issues/{number}/comments"
    headers = {
        "Authorization": f"token {github_token}",
        "Accept": "application/vnd.github.v3+json",
        "Content-Type": "application/json",
        "User-Agent": "claude-pr-reviewer-action"
    }
    payload = {"body": body_text}
    
    log(f"Posting review comment to PR #{number}...")
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    ctx = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(req, context=ctx) as resp:
            log("Review comment posted successfully.")
    except urllib.error.HTTPError as e:
        log(f"Error posting comment (HTTP {e.code}): {e.read().decode('utf-8', errors='replace')}")
    except Exception as e:
        log(f"Error posting comment: {e}")

def main():
    import argparse
    parser = argparse.ArgumentParser(description="Review a GitHub PR using Claude.")
    parser.add_argument("--pr", "-p", help="The URL of the GitHub Pull Request (e.g. https://github.com/owner/repo/pull/123)")
    parser.add_argument("--model", default=os.getenv("ANTHROPIC_MODEL", "claude-3-5-sonnet-latest"), help="Anthropic model to use.")
    args = parser.parse_args()

    # Determine PR URL
    pr_url = args.pr or os.getenv("GITHUB_PR_URL") or get_pr_url_from_event()
    if not pr_url:
        log("Error: No PR URL provided. Use --pr, set GITHUB_PR_URL, or run within a GitHub Action pull_request event.")
        sys.exit(1)

    # Determine API keys
    anthropic_key = os.getenv("ANTHROPIC_API_KEY")
    if not anthropic_key:
        log("Error: ANTHROPIC_API_KEY environment variable not set.")
        sys.exit(1)

    github_token = os.getenv("GITHUB_TOKEN")

    try:
        pr_info = parse_pr_url(pr_url)
        diff_text = fetch_diff(pr_info["owner"], pr_info["repo"], pr_info["number"], github_token)
        
        if not diff_text.strip():
            log("Warning: PR diff is empty. Nothing to review.")
            review_md = "### Summary of Changes\nNo changes detected in this Pull Request.\n\n**Confidence score**: High (reviewed 0 of 0 files)"
        else:
            review_md = call_claude(diff_text, anthropic_key, args.model)
        
        # Print review markdown to stdout
        print(review_md)

        # In GitHub Actions mode with GITHUB_TOKEN, post comment back to PR
        if os.getenv("GITHUB_ACTIONS") == "true" and github_token:
            post_github_comment(pr_info["owner"], pr_info["repo"], pr_info["number"], review_md, github_token)

    except Exception as e:
        log(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
