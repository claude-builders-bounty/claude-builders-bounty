    },
    "Set Repo Info": {
      "main": [[{"node": "Schedule Trigger (Friday 5pm)", "type": "main", "index": 0}]]
    },
    "Set Language": {
      "main": [[{"node": "Schedule Trigger (Friday 5pm)", "type": "main", "index": 0}]]
