{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cron",
              "hours": 17,
              "minutes": 0,
              "dayOfWeek": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "githubRepo",
              "value": "owner/repo"
            },
            {
              "name": "githubToken",
              "value": ""
            },
            {
              "name": "discordWebhook",
              "value": ""
            },
            {
              "name": "emailTo",
              "value": ""
            },
            {
              "name": "emailHost",
              "value": "smtp.example.com"
            },
            {
              "name": "emailPort",
              "value": 587
            },
            {
              "name": "emailUser",
              "value": ""
            },
            {
              "name": "emailPass",
              "value": ""
            },
            {
              "name": "language",
              "value": "EN"
            },
            {
              "name": "deliveryMethod",
              "value": "discord"
            }
          ]
        },
        "options": {
          "dotNotation": true
        }
      },
      "id": "config-set",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1.1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.githubRepo }}/commits"
      },
      "id": "github-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [540, 100]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.githubRepo }}/issues?state=closed&per_page=50"
      },
      "id": "github-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [540, 200]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.githubRepo }}/pulls?state=closed&per_page=50"
      },
      "id": "github-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [540, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{ $('Configuration').item.json.githubRepo }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').item.json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        }
      },
      "id": "fetch-commits",
      "name": "GitHub Commits API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 100]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{ $('Configuration').item.json.githubRepo }}/issues?state=closed&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').item.json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        }
      },
      "id": "fetch-issues",
      "name": "GitHub Issues API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 200]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/{{ $('Configuration').item.json.githubRepo }}/pulls?state=closed&per_page=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').item.json.githubToken }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        }
      },
      "id": "fetch-prs",
      "name": "GitHub PRs API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filter commits from the last 7 days\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst commits = $input.all();\nconst recentCommits = commits.filter(commit => {\n  const date = new Date(commit.json.commit.committer.date);\n  return date >= sevenDaysAgo;\n}).map(commit => ({\n  sha: commit.json.sha,\n  message: commit.json.commit.message,\n  author: commit.json.commit.author.name,\n  date: commit.json.commit.committer.date\n}));\n\nreturn recentCommits;"
      },
      "id": "process-commits",
      "name": "Process Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 100]
    },
    {
      "parameters": {
        "jsCode": "// Filter closed issues from the last 7 days\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst issues = $input.all();\nconst recentIssues = issues.filter(issue => {\n  if (!issue.json.closed_at) return false;\n  const date = new Date(issue.json.closed_at);\n  return date >= sevenDaysAgo;\n}).map(issue => ({\n  number: issue.json.number,\n  title: issue.json.title,\n  closed_by: issue.json.closed_by?.login || 'unknown',\n  closed_at: issue.json.closed_at\n}));\n\nreturn recentIssues;"
      },
      "id": "process-issues",
      "name": "Process Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "jsCode": "// Filter merged PRs from the last 7 days\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst prs = $input.all();\nconst mergedPRs = prs.filter(pr => {\n  if (!pr.json.merged_at) return false;\n  const date = new Date(pr.json.merged_at);\n  return date >= sevenDaysAgo;\n}).map(pr => ({\n  number: pr.json.number,\n  title: pr.json.title,\n  merged_by: pr.json.merged_by?.login || 'unknown',\n  merged_at: pr.json.merged_at\n}));\n\nreturn mergedPRs;"
      },
      "id": "process-prs",
      "name": "Process PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=You are a technical writer creating a weekly development summary. Generate a clear, concise summary in {{ $('Configuration').item.json.language }} language. Format with headings, bullet points, and emoji. Focus on significant changes."
            },
            {
              "role": "user",
              "content": "=Generate a weekly development summary based on this data:\n\n## Commits ({{ $json.commits.length }} total)\n{{ $json.commits.map(c => `- ${c.sha.substring(0,7)}: ${c.message.split('\\n')[0]} (${c.author})`).join('\\n') }}\n\n## Closed Issues ({{ $json.issues.length }} total)\n{{ $json.issues.map(i => `- #${i.number}: ${i.title} (closed by ${i.closed_by})`).join('\\n') }}\n\n## Merged PRs ({{ $json.prs.length }} total)\n{{ $json.prs.map(p => `- #${p.number}: ${p.title} (merged by ${p.merged_by})`).join('\\n') }}\n\nFormat as a professional weekly dev report with sections for highlights, commits summary, closed issues, and merged PRs."
            }
          ]
        },
        "options": {
          "maxTokens": 2000,
          "temperature": 0.7
        }
      },
      "id": "claude-summary",
      "name": "Claude Summary Generation",
      "type": "@n8n/n8n-nodes-langchain.llmChain",
      "typeVersion": 1.4,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "url": "={{ $('Configuration').item.json.discordWebhook }}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "=📊 **Weekly Development Summary**\n\n{{ $json.summary }}"
            }
          ]
        },
        "options": {}
      },
      "id": "discord-webhook",
      "name": "Send Discord Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1420, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "to": "={{ $('Configuration').item.json.emailTo }}",
        "subject": "Weekly Development Summary",
        "body": "={{ $json.summary }}",
        "options": {
          "from": "={{ $('Configuration').item.json.emailUser }}",
          "html": false
        },
        "sendSsl": true,
        "host": "={{ $('Configuration').item.json.emailHost }}",
        "port": "={{ $('Configuration').item.json.emailPort }}",
        "user": "={{ $('Configuration').item.json.emailUser }}",
        "password": "={{ $('Configuration').item.json.emailPass }}"
      },
      "id": "email-node",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.1,
      "position": [1420, 350],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Merge all data and determine delivery\nconst config = $('Configuration').first().json;\n\nreturn [{\n  json: {\n    commits: $('Process Commits').all().map(c => c.json),\n    issues: $('Process Issues').all().map(i => i.json),\n    prs: $('Process PRs').all().map(p => p.json),\n    deliveryMethod: config.deliveryMethod,\n    discordWebhook: config.discordWebhook,\n    emailTo: config.emailTo,\n    language: config.language\n  }\n}];"
      },
      "id": "merge-data",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 100]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "GitHub Commits API",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub Issues API",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub PRs API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Commits API": {
      "main": [
        [
          {
            "node": "Process Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Issues API": {
      "main": [
        [
          {
            "node": "Process Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub PRs API": {
      "main": [
        [
          {
            "node": "Process PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Commits": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Issues": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process PRs": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          {
            "node": "Claude Summary Generation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Summary Generation": {
      "main": [
        [
          {
            "node": "Send Discord Message",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["github", "claude", "weekly", "summary", "automation"]
}
